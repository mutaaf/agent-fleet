#!/bin/bash
# shellcheck disable=SC1090  # we source manifests discovered at runtime; paths are not constants
# fleet — one-glance status across every project running fleet agents.
#
# Usage:
#   fleet status              survey all projects (default)
#   fleet status <slug>       just one
#   fleet list                list discovered projects and their manifests
#   fleet doctor              diagnose every installed project (PASS/WARN/FAIL)
#   fleet doctor --json       machine-readable summary for fleet-control
#   fleet doctor --slug NAME  restrict to one project
#   fleet weekly              Sunday ROI rollup over the trailing 7d window
#                             (ticket 0025 — pure consumer of telemetry)
#   fleet badge <slug>        one-line ROI badge for the project's README
#                             (ticket 0027 — md/svg/txt; network-free)
#   fleet prompts-sha         print the SHA256 of the kit's prompts/ tree
#                             (ticket 0005 — for PROMPTS_SHA pinning)
#   fleet prompts-revert <sha> --reason "<text>"
#                             pin prompts/ back to a known-good SHA (opens revert/ PR)
#                             (ticket 0035 — full/short SHA or YYYY-MM-DD date stamp)
#   fleet lessons-promote <slug> --lesson "<title>"
#                             curate one lesson into cross-fleet
#                             (ticket 0028 — operator's curation primitive)
#   fleet lessons-prune --dry-run
#                             list expired LESSONS entries (operator-invoked archival)
#                             (ticket 0039 — --commit --cause "<text>" moves to LESSONS-ARCHIVE.md)
#   fleet provenance <slug> <pr>  one-command audit receipt for a shipped PR
#                             (ticket 0029 — text/md/json; network-free reader)
#   fleet resume <slug>       re-enable a ship_paused project (safety-checked)
#                             (ticket 0030 — --force/--reason for audited override)
#   fleet atlas               fleet-wide infra-flake catalog with per-pattern frequency (text/json)
#                             (ticket 0031 — --since/--slug/--json; pure reader, no new event types)
#   fleet preflight <repo>    dry-adopt a candidate project; print what install.sh would do (read-only)
#                             (ticket 0032 — 10 PASS/WARN/FAIL rows + verdict; --json; never writes)
#   fleet onboarding-check <repo>  verify a freshly-installed project end-to-end (post-install)
#                             (ticket 0041 — 11 GREEN/YELLOW/RED checks + synthetic ship cycle;
#                              phase=onboarding-check on the four core events; --json; read-only)
#   fleet morning             one-command daily briefing (digest + inbox [+ Sunday weekly])
#                             (ticket 0036 — composes existing readers; --no-weekly/--weekly/--json/--slug)
#   fleet incident --since <Nh|Nd>  assemble a post-mortem from the event channel
#                             (ticket 0037 — timeline + cluster summary + open recovery actions;
#                              --slug/--json/--out; pure consumer of events.jsonl, no new event types)
#   fleet diff <slug-a> <slug-b>  side-by-side ROI / posture comparison
#                             (ticket 0038 — 8 metric rows + DIVERGENCE + HYPOTHESES;
#                              --since Nh|Nd default 14d, --json; pure reader)
#   fleet self-check          run the LESSONS-derived static linter against the kit's own shell
#                             (ticket 0040 — 12 patterns keyed to LESSONS dates;
#                              --list/--pattern/--json; FLEET_SELF_CHECK_GATE=1 emits self_check_failed)
#
# Discovers projects by scanning for */agents.config.sh under FLEET_PROJECTS_ROOT
# (default ~/Desktop/projects). Run interactively — it reads from ~/Desktop, so
# it is not subject to the launchd TCC restriction the agents are.
#
# The doctor subcommand honours FLEET_DISCOVERY_ROOT (default ~/Desktop/projects)
# as the single scan root. This is what tests/doctor.sh uses to point at a
# fixture instead of the host's real ~/Desktop tree. Set
# FLEET_SKIP_INSTALLED_LIB_SHA=1 to skip the installed-vs-repo lib SHA check
# (it WARNs anyway when ~/.local/share/agent-fleet/lib is absent — the env
# override is mostly for test hosts that intentionally have no install).

set -uo pipefail

ROOT="${FLEET_PROJECTS_ROOT:-$HOME/Desktop/projects}"
INSTALLED="$HOME/.local/share/agent-fleet/projects"
DOMAIN="gui/$UID"
CMD="${1:-status}"
WANT="${2:-}"

c_dim=$'\033[2m'; c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'
c_bld=$'\033[1m'; c_rst=$'\033[0m'

# Manifests live in two places: the repo working tree (may be on a branch that
# doesn't have it yet) and the TCC-safe install location (what's actually
# deployed). Union both and de-dup by SLUG so a project shows whether its
# manifest has merged to main or is still on a PR branch. Working-tree copies are
# listed first, so they win the de-dup (they sit next to docs/LESSONS.md).
discover() {
  local _seen=""
  { find "$ROOT" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$INSTALLED" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    # shellcheck disable=SC1090  # path is discovered at runtime
    local slug; slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    case " $_seen " in *" $slug "*) ;; *) _seen="$_seen $slug"; echo "$m";; esac
  done
}

human_age() {  # $1 = epoch seconds of an mtime → "3m" / "2h" / "5d" / "—"
  [ -z "${1:-}" ] && { echo "—"; return; }
  local now diff; now=$(date +%s); diff=$(( now - $1 ))
  if   [ $diff -lt 3600 ];  then echo "$(( diff/60 ))m ago"
  elif [ $diff -lt 86400 ]; then echo "$(( diff/3600 ))h ago"
  else echo "$(( diff/86400 ))d ago"; fi
}

days_until() {  # $1 = YYYYMMDD → integer days from today (may be negative)
  local target; target=$(date -j -f "%Y%m%d" "$1" +%s 2>/dev/null) || { echo 999; return; }
  local today; today=$(date -j -f "%Y%m%d" "$(date +%Y%m%d)" +%s)
  echo $(( (target - today) / 86400 ))
}

newest_log_epoch() {  # $1 = log dir → mtime of newest *.log, or empty
  local d="$1"; [ -d "$d" ] || return
  local f; f=$(ls -t "$d"/*.log 2>/dev/null | head -1) || return
  [ -n "$f" ] && stat -f %m "$f" 2>/dev/null
}

# --- doctor ---------------------------------------------------------------
# `fleet doctor` scans FLEET_DISCOVERY_ROOT (default ~/Desktop/projects) for
# */agents.config.sh, then runs seven named checks per project. Output is
# either one block per project (default) or a single JSON document keyed by
# {"projects":[{"slug":..,"checks":[{"name":..,"status":..,"reason":..}]}]}.
# Exit 0 if no FAIL across any project; exit 1 if any check is FAIL. WARN
# never fails the exit code — it's an "ok but look at me" signal.
#
# Checks (run in this order, names are the JSON-stable contract):
#   config             agents.config.sh parseable; SLUG/REPO_URL/SELF_CANCEL set
#   self_cancel        SELF_CANCEL not in the past (FAIL), >3 days out (PASS)
#   agents_md          AGENTS.md present + "## Agent parameters" section
#   backlog            docs/backlog/README.md + scripts/check-backlog.mjs exist
#   launchd_loaded     com.<slug>.agent-{ship,groom,review} are loaded
#                      (+ eng if ENG_ENABLED=1)
#   installed_lib_sha  ~/.local/share/agent-fleet/lib SHA matches the repo's
#                      lib/ SHA (WARN when either side is absent)
#   gh_auth            `gh auth status` exits 0
#   prompts_pinned     manifest's PROMPTS_SHA matches the kit's current
#                      prompts/ SHA (ticket 0005). PASS if set + matches,
#                      WARN if unset, FAIL if mismatched.

DOCTOR_ROOT="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"

# Repo lib/ dir — relative to this script (bin/fleet → ../lib).
doctor_repo_lib() {
  local self; self="$( cd "$( dirname "$0" )" && pwd )"
  echo "$self/../lib"
}

# Sum of `shasum` over every *.sh under a lib dir, sorted, joined. Stable
# across machines because we sort the filenames first. Echoes empty string if
# the dir is missing or contains no shell files.
doctor_lib_sha() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  (cd "$dir" && find . -type f -name '*.sh' | sort | xargs shasum 2>/dev/null) | shasum | awk '{print $1}'
}

# --- prompts-sha ----------------------------------------------------------
# Ticket 0005. Prints the SHA256 of the concatenation of every *.md under the
# kit's prompts/ dir, with filenames sorted for cross-machine determinism.
# This is the value an operator pins via `PROMPTS_SHA=...` in their manifest
# so a future prompt edit surfaces as a `prompts_drift` warning in the runner.
#
# Defined above the doctor block because doctor's prompts_pinned check calls
# it directly — bash needs the function defined before it's referenced.
#
# Resolution order:
#   1. $FLEET_KIT_ROOT/prompts (escape hatch for fleet-control / tests)
#   2. The repo this script lives in: bin/fleet → ../prompts
#   3. The installed kit at ~/.local/share/agent-fleet/prompts
# First hit wins. Falls through with exit 1 + a stderr message if none exist
# so `PROMPTS_SHA=$(fleet prompts-sha)` doesn't silently bake in an empty pin.
fleet_prompts_sha() {
  local self prompts_dir=""
  self="$( cd "$( dirname "$0" )" && pwd )"
  for cand in \
    "${FLEET_KIT_ROOT:-}/prompts" \
    "$self/../prompts" \
    "$HOME/.local/share/agent-fleet/prompts"; do
    if [ -n "$cand" ] && [ -d "$cand" ]; then
      prompts_dir="$cand"
      break
    fi
  done
  if [ -z "$prompts_dir" ]; then
    echo "fleet prompts-sha: no prompts/ dir found (looked in FLEET_KIT_ROOT, $self/../prompts, ~/.local/share/agent-fleet/prompts)" >&2
    return 1
  fi
  # The ticket's formula verbatim. `find | sort` makes the order stable;
  # `xargs cat` concatenates contents; `shasum -a 256` is on every macOS.
  ( cd "$prompts_dir/.." && find prompts -type f -name '*.md' | sort | xargs cat ) \
    | shasum -a 256 | awk '{print $1}'
}

if [ "$CMD" = "prompts-sha" ]; then
  fleet_prompts_sha
  exit $?
fi

# --- prompts-diff ---------------------------------------------------------
# Ticket 0013. `fleet prompts-diff` explains the WHY behind a
# `prompts_drift` warning (ticket 0005). Three modes:
#
#   fleet prompts-diff
#     Unified diff of every *.md under the installed prompts tree
#     (~/.local/share/agent-fleet/prompts) against the kit's current
#     prompts/. Exit 1 if any file differs; 0 otherwise. The operator
#     reads this in tandem with `fleet doctor` to see what changed.
#
#   fleet prompts-diff --since <SHA>
#     Walk `git log -- prompts/` to find the commit whose subtree SHA
#     matches the operator's old pin, then `git diff <commit>..HEAD
#     -- prompts/`. Used after an install.sh re-pin to see what the
#     bump actually changed.
#
#   fleet prompts-diff --changelog
#     Print all prompts/CHANGELOG.md entries verbatim that are NEWER
#     than the installed-prompts SHA. "Newer" is decided by walking
#     the CHANGELOG top-down (newest entries first by convention) and
#     stopping at the entry whose body cites the installed SHA — when
#     no installed-SHA stamp exists, every entry is surfaced.
#
# Naming (LESSONS 2026-05-26): the dispatch function is named
# `prompts_diff_cmd` rather than `prompts_diff` so it never shadows the
# system `diff` binary (we shell out to `diff -u` from inside this very
# function). Same trap that bit `tail()` in ticket 0015.
#
# Resolution: KIT_ROOT is derived from this script's location
# (bin/fleet → ..). $FLEET_KIT_ROOT overrides it for tests.

prompts_diff_kit_root() {
  local self
  self="$( cd "$( dirname "$0" )" && pwd )"
  echo "${FLEET_KIT_ROOT:-$(cd "$self/.." && pwd)}"
}

# Print prompts/CHANGELOG.md, optionally filtered to entries newer than
# the operator's pinned SHA. Filtering logic:
#
#   * Discover the operator's pin by reading
#     `~/.local/share/agent-fleet/projects/*/agents.config.sh` and grabbing
#     the first `PROMPTS_SHA="..."` value (install.sh stamps every
#     installed manifest with the same pin — same kit, same SHA).
#   * If no pin is discoverable OR the pin equals the kit's current
#     prompts SHA → print the full CHANGELOG (no cutoff to apply).
#   * Otherwise, walk `git log -- prompts/CHANGELOG.md` to find the
#     commit whose CHANGELOG-version corresponds to the operator's pin
#     era. We use a simple heuristic: take the FIRST heading present in
#     the historical CHANGELOG at that commit and treat it as the
#     cutoff — everything above that heading in the kit CHANGELOG is
#     "newer than the operator's install."
#
# When git history isn't queryable (test fixture without a .git dir) we
# fall through to printing the full CHANGELOG, which matches the
# "surface everything" semantics callers expect when no pin info exists.
prompts_diff_changelog() {
  local kit_root="$1"
  local kit_chg="$kit_root/prompts/CHANGELOG.md"
  if [ ! -f "$kit_chg" ]; then
    echo "fleet prompts-diff --changelog: no CHANGELOG at $kit_chg" >&2
    return 1
  fi

  # Discover the operator's pin. Empty when no installed manifest yet.
  local pin=""
  local installed_root="$HOME/.local/share/agent-fleet/projects"
  if [ -d "$installed_root" ]; then
    local m
    for m in "$installed_root"/*/agents.config.sh; do
      [ -f "$m" ] || continue
      pin="$(sed -nE 's/^PROMPTS_SHA="?([0-9a-f]+)"?.*/\1/p' "$m" | head -1)"
      [ -n "$pin" ] && break
    done
  fi

  # Compute kit SHA. When it matches the pin OR no pin exists → surface
  # the full CHANGELOG. The point of --changelog is to be informational;
  # silence is the wrong default.
  local kit_sha=""
  kit_sha="$( ( cd "$kit_root" && find prompts -type f -name '*.md' | sort | xargs cat ) \
                | shasum -a 256 | awk '{print $1}' )"
  if [ -z "$pin" ] || [ "$pin" = "$kit_sha" ]; then
    cat "$kit_chg"
    return 0
  fi

  # Pin differs from the kit. Try git to find the historical CHANGELOG
  # at the pinned era; if git isn't usable, fall back to the full file.
  if ! ( cd "$kit_root" && git rev-parse HEAD >/dev/null 2>&1 ); then
    cat "$kit_chg"
    return 0
  fi
  local match=""
  while IFS= read -r commit; do
    [ -z "$commit" ] && continue
    local sha
    sha="$( cd "$kit_root" \
            && git ls-tree -r --name-only "$commit" -- prompts 2>/dev/null \
                 | sort \
                 | while read -r f; do
                     git show "$commit:$f" 2>/dev/null
                   done \
                 | shasum -a 256 | awk '{print $1}' )"
    if [ "$sha" = "$pin" ]; then
      match="$commit"
      break
    fi
  done < <(cd "$kit_root" && git log -200 --format=%H -- prompts 2>/dev/null)

  if [ -z "$match" ]; then
    cat "$kit_chg"
    return 0
  fi

  # Use the FIRST heading from the historical CHANGELOG as cutoff.
  local cutoff
  cutoff="$( cd "$kit_root" && git show "$match:prompts/CHANGELOG.md" 2>/dev/null \
              | awk '/^## [0-9]{4}-[0-9]{2}-[0-9]{2}/ { print; exit }' )"
  if [ -z "$cutoff" ]; then
    cat "$kit_chg"
    return 0
  fi
  awk -v cutoff="$cutoff" '
    BEGIN { surf = 1 }
    {
      if ($0 == cutoff) { surf = 0 }
      if (surf) print
    }
  ' "$kit_chg"
}

# Compare two prompt trees via `diff -u`. Echoes the unified diff to
# stdout. Returns 0 when identical, 1 on any difference, 2 on error.
prompts_diff_trees() {
  local installed="$1" kit_prompts="$2"
  if [ ! -d "$kit_prompts" ]; then
    echo "fleet prompts-diff: no kit prompts dir at $kit_prompts" >&2
    return 2
  fi
  if [ ! -d "$installed" ]; then
    echo "fleet prompts-diff: no installed prompts dir at $installed" >&2
    echo "(re-run install.sh from any project to populate it)" >&2
    return 2
  fi
  # `diff -ruN` walks both directories, prints unified diffs per file,
  # treats missing files on either side as empty. Exit 0 = identical,
  # 1 = different, 2 = error.
  diff -ruN "$installed" "$kit_prompts"
  return $?
}

# Walk `git log -- prompts/` for a commit whose prompts/ tree-SHA matches
# the operator's old pin, then diff that commit's prompts/ against HEAD's.
# The pin is the SHA produced by `bin/fleet prompts-sha`, NOT a git SHA —
# we compute the kit's formula at each ancestor commit until we find a
# match (bounded to the last 200 commits to avoid runaway scans).
prompts_diff_since() {
  local kit_root="$1" pin="$2"
  if [ -z "$pin" ]; then
    echo "fleet prompts-diff --since: missing <SHA> argument" >&2
    return 2
  fi
  if ! ( cd "$kit_root" && git rev-parse HEAD >/dev/null 2>&1 ); then
    echo "fleet prompts-diff --since: $kit_root is not a git checkout" >&2
    return 2
  fi
  local match=""
  while IFS= read -r commit; do
    [ -z "$commit" ] && continue
    local sha
    sha="$( cd "$kit_root" \
            && git show "$commit:prompts" >/dev/null 2>&1 \
            && git ls-tree -r --name-only "$commit" -- prompts \
                 | sort \
                 | while read -r f; do
                     git show "$commit:$f" 2>/dev/null
                   done \
                 | shasum -a 256 | awk '{print $1}' )"
    if [ "$sha" = "$pin" ]; then
      match="$commit"
      break
    fi
  done < <(cd "$kit_root" && git log -200 --format=%H -- prompts)
  if [ -z "$match" ]; then
    echo "fleet prompts-diff --since: no commit in the last 200 matched pin $pin" >&2
    return 1
  fi
  ( cd "$kit_root" && git diff "$match"..HEAD -- prompts )
  return $?
}

prompts_diff_cmd() {
  shift  # drop the leading "prompts-diff"
  local mode="tree" since_sha=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --changelog) mode="changelog"; shift ;;
      --since)     mode="since"; since_sha="${2:-}"; shift 2 ;;
      --since=*)   mode="since"; since_sha="${1#--since=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet prompts-diff — explain WHAT changed in the kit's prompts since install.

Usage:
  fleet prompts-diff                       unified diff installed vs kit
  fleet prompts-diff --since <SHA>         diff against a historical pin
  fleet prompts-diff --changelog           CHANGELOG entries newer than pin

Exit 1 on any difference (so it composes with \`&&\` for scripts); 0
when the installed prompts match the kit's current tree.

The kit root resolves to this script's parent (bin/fleet -> ..) unless
\$FLEET_KIT_ROOT overrides it. Installed prompts live at
~/.local/share/agent-fleet/prompts (populated by lib/install.sh).
USAGE
        exit 0 ;;
      --) shift ;;
      -*) echo "fleet prompts-diff: unknown flag '$1'" >&2; exit 2 ;;
      *)  echo "fleet prompts-diff: unexpected argument '$1'" >&2; exit 2 ;;
    esac
  done

  local kit_root; kit_root="$(prompts_diff_kit_root)"
  local kit_prompts="$kit_root/prompts"
  local installed="$HOME/.local/share/agent-fleet/prompts"

  case "$mode" in
    changelog)
      prompts_diff_changelog "$kit_root"
      exit $?
      ;;
    since)
      prompts_diff_since "$kit_root" "$since_sha"
      exit $?
      ;;
    tree|*)
      prompts_diff_trees "$installed" "$kit_prompts"
      exit $?
      ;;
  esac
}

if [ "$CMD" = "prompts-diff" ]; then
  prompts_diff_cmd "$@"
fi

# --- prompts-revert -------------------------------------------------------
# Ticket 0035. `fleet prompts-revert <sha> --reason "<one-line>"` is the
# operator's one-command undo for a bad prompts merge — the parallel of
# `fleet rollback` (ticket 0017) for code. Resolves <sha> against the
# kit's git history (full SHA, ≥7-char short SHA, or YYYY-MM-DD CHANGELOG
# date stamp), runs `git checkout <sha> -- prompts/`, commits, pushes a
# `revert/prompts-<short-sha>` branch, opens a PR with the
# `Reinstall: all projects` trailer (LESSONS 2026-05-25), and emits one
# `prompts_reverted {from, to, pr, reason}` event to the kit-as-project
# events.jsonl (per the lessons_promote pattern from ticket 0028).
#
# Hard NO: this command never touches lib/ or AGENTS.md — it is strictly
# for prompts SHA pinning. Mixing in lib/ reverts is `fleet rollback`'s
# job (per-PR), not this command's.
#
# Defends against (per ticket 0035 § LESSONS-to-defend list):
#   * 2026-05-25 — Reinstall: all projects trailer is auto-added to PR body
#   * 2026-05-26 — naming `prompts_revert` does not shadow any binary
#   * 2026-05-26 — tests put stubs under $HOME/.local/bin (out-of-band)
#   * 2026-05-27 — no `$(cat)` round-trips (PR body is composed via tmp file)
#   * 2026-05-28 — `printf -- '%s'` for every $reason render (leading-dash)
#   * 2026-05-30 — help text grep uses `grep -qF --` in tests (out-of-band)
#   * 2026-06-01 — multi-line bodies pass through tmp files, not `--body`
#                  (`gh pr create --body-file`) and not `awk -v`
#   * 2026-06-01 — every code path exits explicitly (no dispatcher fall-through)
#   * 2026-06-03 — reason is restricted to ASCII for v1 (UTF-8 sign-extension)
#   * 2026-06-05 — every helper this function calls is defined ABOVE the
#                  dispatcher block; specifically `fleet_prompts_sha` (line
#                  ~142) and the local helpers below. `fleet_emit_event` is
#                  sourced inside a subshell from lib/common.sh.

# Resolve <sha> argument into a full 40-char SHA. Accepts:
#   * a full 40-char hex SHA   → `git rev-parse <sha>` echoes the same
#   * a ≥7-char short SHA      → `git rev-parse` resolves to full
#   * a YYYY-MM-DD date stamp  → `git log -G "^## $date" -- prompts/CHANGELOG.md`
# Echoes the resolved full SHA, or empty on failure (caller emits the
# "not a valid git ref" error + exits 2).
prompts_revert_resolve_sha() {
  local kit_root="$1" arg="$2" full=""
  # Date stamp branch: YYYY-MM-DD.
  if [[ "$arg" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    full="$( cd "$kit_root" \
             && git log --format=%H -G "^## $arg" -- prompts/CHANGELOG.md 2>/dev/null \
                | head -1 )"
    [ -n "$full" ] && echo "$full"
    return 0
  fi
  # Hex SHA branch (full or short).
  if [[ "$arg" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    full="$( cd "$kit_root" && git rev-parse --verify "$arg" 2>/dev/null )"
    [ -n "$full" ] && echo "$full"
    return 0
  fi
  return 0
}

# Echo the prompts/ tree object SHA at <sha>. Used to short-circuit AC#5
# (target byte-identical to current).
prompts_revert_compute_target_tree_sha() {
  local kit_root="$1" sha="$2"
  ( cd "$kit_root" && git rev-parse --verify "$sha:prompts" 2>/dev/null )
}

# Compose the PR body to a tmp file and echo its path. Per LESSONS
# 2026-06-01 we NEVER pass a multi-line value via `--body "$body"` (the
# awk -v family trap); the file goes through `gh pr create --body-file`.
# Per LESSONS 2026-05-28 every $reason render uses `printf -- '%s'`.
prompts_revert_compose_pr_body() {
  local from="$1" to="$2" reason="$3"
  local body_file; body_file="$(mktemp -t fleet-prompts-revert-body.XXXXXX)"
  {
    printf -- '[FLEET prompts-revert] pin prompts/ back to %s\n\n' "$to"
    printf -- 'from: %s\n' "$from"
    printf -- 'to:   %s\n' "$to"
    printf -- 'reason: '
    printf -- '%s' "$reason"
    printf -- '\n\n'
    printf -- 'Reinstall: all projects\n'
    printf -- '\n'
    printf -- 'Emitted prompts_reverted {from, to, pr, reason} to the kit-as-project\n'
    printf -- 'events.jsonl on open. See AGENTS.md § Telemetry for the contract.\n'
  } > "$body_file"
  echo "$body_file"
}

# Compose the commit message to a tmp file and echo its path. The
# multi-line message is passed via `git commit -F <file>` — same
# defensive shape as the PR body (LESSONS 2026-06-01).
prompts_revert_compose_commit_msg() {
  local to="$1" reason="$2"
  local msg_file; msg_file="$(mktemp -t fleet-prompts-revert-msg.XXXXXX)"
  {
    printf -- 'revert: pin prompts/ back to %s\n\n' "$to"
    printf -- 'reason: '
    printf -- '%s' "$reason"
    printf -- '\n\n'
    printf -- 'Reinstall: all projects\n'
    printf -- '\n'
    printf -- 'Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\n'
  } > "$msg_file"
  echo "$msg_file"
}

# Emit the prompts_reverted event into the AGENT-FLEET project's
# events.jsonl. Mirrors lessons_promote_emit_event (line ~7988).
# Sources lib/common.sh in a subshell so SLUG/CACHE_DIR/FLEET_PHASE
# scope to this emit only.
prompts_revert_emit_event() {
  local from="$1" to="$2" pr="$3" reason="$4"
  local kit_root; kit_root="$( cd "$( dirname "$0" )/.." && pwd )"
  [ -f "$kit_root/lib/common.sh" ] || return 0
  local cache_dir="$HOME/.cache/agent-fleet-agent"
  mkdir -p "$cache_dir"
  (
    export SLUG="agent-fleet"
    export CACHE_DIR="$cache_dir"
    export FLEET_PHASE="revert"
    # shellcheck disable=SC1090
    source "$kit_root/lib/common.sh" >/dev/null 2>&1
    fleet_emit_event prompts_reverted \
      "from=$from" "to=$to" "pr=$pr" "reason=$reason"
  ) || true
}

prompts_revert() {
  shift  # drop the leading "prompts-revert"
  local sha_arg="" reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --reason)
        reason="${2:-}"; shift 2 ;;
      --reason=*)
        reason="${1#--reason=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet prompts-revert — pin the kit's prompts/ tree back to a known-good SHA.

Usage:
  fleet prompts-revert <sha> --reason "<one-line>"
  fleet prompts-revert --help

Arguments:
  <sha>       full 40-char SHA, short SHA (>=7 chars), OR a YYYY-MM-DD
              CHANGELOG date stamp (resolved via
              git log --format=%H -G "^## <date>" -- prompts/CHANGELOG.md).
  --reason    MANDATORY one-line operator rationale (ASCII; v1 limit).
              Recorded verbatim in the PR body, the commit message,
              AND the prompts_reverted event payload.

On success: runs git checkout <sha> -- prompts/, commits on branch
revert/prompts-<short-sha>, pushes, opens a PR via gh, emits one
prompts_reverted {from, to, pr, reason} event with phase=revert
to the kit-as-project events.jsonl, and exits 0.

The PR body carries 'Reinstall: all projects' so the post-merge
fleet-wide reinstall is unambiguous (LESSONS 2026-05-25).

Idempotent: a target whose prompts/ tree is byte-identical to the
current working tree is a no-op (no commit, no push, no event).
USAGE
        exit 0 ;;
      --)
        shift ;;
      -*)
        printf -- 'prompts-revert: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        if [ -z "$sha_arg" ]; then
          sha_arg="$1"; shift
        else
          printf -- 'prompts-revert: unexpected extra argument %s\n' "$1" >&2
          exit 2
        fi ;;
    esac
  done

  # AC#1 / general: require <sha>.
  if [ -z "$sha_arg" ]; then
    echo "prompts-revert: missing <sha> (usage: fleet prompts-revert <sha> --reason \"<one-line>\")" >&2
    exit 2
  fi

  # AC#3: --reason is MANDATORY.
  if [ -z "$reason" ]; then
    echo "prompts-revert: --reason \"<one-line>\" is required (auditable override)" >&2
    exit 2
  fi

  # AC: reason is restricted to ASCII for v1 (LESSONS 2026-06-03 —
  # _json_escape sign-extends multi-byte UTF-8 under LC_ALL=C). The
  # check is a single bash pattern: any byte > 0x7F triggers refusal.
  if LC_ALL=C printf -- '%s' "$reason" | LC_ALL=C grep -q '[^[:print:][:space:]]'; then
    echo "prompts-revert: --reason must be ASCII for v1 (see ticket 0035 note)" >&2
    exit 2
  fi

  # Resolve the kit root. Same shape as prompts_diff_cmd: $FLEET_KIT_ROOT
  # wins; else bin/fleet → ..
  local kit_root; kit_root="$(prompts_diff_kit_root)"

  # AC#7: resolve <sha> → full SHA via the three-form helper.
  local target_full
  target_full="$(prompts_revert_resolve_sha "$kit_root" "$sha_arg")"
  if [ -z "$target_full" ]; then
    printf -- 'prompts-revert: %s is not a valid git ref in this kit checkout\n' "$sha_arg" >&2
    exit 2
  fi
  local target_short="${target_full:0:7}"

  # AC#6: refuse on a dirty working tree.
  local porc
  porc="$( cd "$kit_root" && git status --porcelain 2>/dev/null )"
  if [ -n "$porc" ]; then
    echo "prompts-revert: working tree has uncommitted changes — commit, stash, or discard them first" >&2
    exit 2
  fi

  # Compute the current prompts SHA on disk (the kit's
  # `find prompts -type f -name '*.md' | sort | xargs cat | shasum -a 256`
  # formula). This is the value pinned in PROMPTS_SHA= manifests and the
  # value the prompts_reverted event records as `from`.
  local from_sha; from_sha="$(fleet_prompts_sha)"
  if [ -z "$from_sha" ]; then
    echo "prompts-revert: could not compute current prompts SHA" >&2
    exit 1
  fi

  # AC#5: byte-identical target → idempotent no-op. We compare the
  # tree-object SHA at the target commit's prompts/ against the
  # tree-object SHA at HEAD's prompts/. When git can resolve both AND
  # they match, the working tree (which we just verified is clean) is
  # byte-identical to what the checkout would produce — no work to do.
  local target_tree current_tree
  target_tree="$(prompts_revert_compute_target_tree_sha "$kit_root" "$target_full")"
  current_tree="$(prompts_revert_compute_target_tree_sha "$kit_root" "HEAD")"
  if [ -n "$target_tree" ] && [ -n "$current_tree" ] \
     && [ "$target_tree" = "$current_tree" ]; then
    printf -- "prompts-revert: %s's prompts/ tree is identical to the current working tree (sha=%s) — nothing to do.\n" \
      "$target_full" "$from_sha"
    exit 0
  fi

  # --- Execute the revert. ---------------------------------------------
  printf -- 'fleet prompts-revert: checking out prompts/ at %s …\n' "$target_full"
  printf -- '  current prompts_sha: %s\n' "$from_sha"
  printf -- '  target prompts_sha:  %s\n' "$target_full"

  # `git checkout <sha> -- prompts/` writes the historical tree into the
  # working tree's prompts/ dir. Errors here are hard-fail (network
  # is N/A — this is a local-history checkout).
  if ! ( cd "$kit_root" && git checkout "$target_full" -- prompts/ ) >/dev/null 2>&1; then
    echo "prompts-revert: git checkout $target_full -- prompts/ failed" >&2
    exit 1
  fi

  # Stage and commit. Multi-line message goes through a tmp file via
  # `git commit -F` (LESSONS 2026-06-01 family).
  local revert_branch="revert/prompts-$target_short"
  if ! ( cd "$kit_root" && git checkout -b "$revert_branch" ) >/dev/null 2>&1; then
    # Branch may already exist from a prior aborted run; try a plain checkout.
    if ! ( cd "$kit_root" && git checkout "$revert_branch" ) >/dev/null 2>&1; then
      echo "prompts-revert: could not create or switch to branch $revert_branch" >&2
      exit 1
    fi
  fi
  if ! ( cd "$kit_root" && git add prompts/ ) >/dev/null 2>&1; then
    echo "prompts-revert: git add prompts/ failed" >&2
    exit 1
  fi
  local msg_file; msg_file="$(prompts_revert_compose_commit_msg "$target_full" "$reason")"
  if ! ( cd "$kit_root" && git commit -F "$msg_file" ) >/dev/null 2>&1; then
    rm -f "$msg_file"
    echo "prompts-revert: git commit failed" >&2
    exit 1
  fi
  rm -f "$msg_file"

  if ! ( cd "$kit_root" && git push -u origin "$revert_branch" ) >/dev/null 2>&1; then
    echo "prompts-revert: git push -u origin $revert_branch failed" >&2
    exit 1
  fi

  # Compose the PR body via tmp file and open the PR.
  local body_file; body_file="$(prompts_revert_compose_pr_body "$from_sha" "$target_full" "$reason")"
  local create_out new_pr_number=""
  create_out="$(gh pr create \
                  --repo mutaaf/agent-fleet \
                  --head "mutaaf:$revert_branch" \
                  --base main \
                  --title "[FLEET prompts-revert] pin prompts/ back to $target_short" \
                  --body-file "$body_file" \
                  2>&1 || true)"
  rm -f "$body_file"
  echo "$create_out"
  new_pr_number="$(echo "$create_out" | sed -nE 's#.*/pull/([0-9]+).*#\1#p' | head -1)"
  if [ -z "$new_pr_number" ]; then
    echo "prompts-revert: could not parse new PR number from 'gh pr create' output" >&2
    exit 1
  fi

  printf -- '\nopening revert PR …\n'
  printf -- '  branch:  %s\n' "$revert_branch"
  printf -- '  PR:      #%s\n' "$new_pr_number"
  printf -- '  reason:  '
  printf -- '%s' "$reason"
  printf -- '\n'

  # Emit the prompts_reverted event.
  prompts_revert_emit_event "$from_sha" "$target_full" "$new_pr_number" "$reason"

  printf -- '\nemitted prompts_reverted from=%s to=%s pr=%s reason=' \
    "$from_sha" "$target_full" "$new_pr_number"
  printf -- '%s' "$reason"
  printf -- '\n'
  printf -- '\nNEXT: the review subagent will grade this PR like any other.\n'
  printf -- '      After merge, run install.sh across every project per the\n'
  printf -- "      'Reinstall: all projects' convention (LESSONS 2026-05-25).\n"
  exit 0
}

if [ "$CMD" = "prompts-revert" ]; then
  prompts_revert "$@"
fi

# --- onboard --------------------------------------------------------------
# Ticket 0011. `fleet onboard <project-path>` scaffolds a fresh project with
# the full kit contract — manifest, AGENTS.md, docs/LESSONS.md stub, the
# backlog README+template, scripts/check-backlog.mjs, and the three Claude
# subagent files under .claude/agents/. Then by default calls
# `bash $KIT_ROOT/lib/install.sh <project-path>` so the operator gets a fully
# installed loop in one shot. Flags:
#   --dry-run        list files that would be written; create nothing; exit 0
#   --force          overwrite existing contract files; emit `[OK] reset <file>`
#   --skip-install   scaffold only; do not call install.sh
# If `$FLEET_INSTALL_CMD` is set, that command is invoked instead of
# `bash $KIT_ROOT/lib/install.sh` — the test rig uses this to stub install.
#
# Resolution: templates live next to this script (bin/fleet → ../templates).
# A project is considered "already onboarded" if its agents.config.sh exists.

onboard_kit_root() {
  local self; self="$( cd "$( dirname "$0" )" && pwd )"
  ( cd "$self/.." && pwd )
}

# All files the scaffolder writes, paired with how each is sourced. Each row
# is `dest|kind|source` where:
#   kind=template  — copy templates/<source> verbatim
#   kind=manifest  — render the manifest from inline derivations (slug, etc.)
#   kind=agents-md — render AGENTS.md by prepending a slug header to
#                    templates/AGENTS.section.md
#   kind=lessons   — write the empty docs/LESSONS.md stub inline
onboard_file_list() {
  cat <<'LIST'
agents.config.sh|manifest|
AGENTS.md|agents-md|AGENTS.section.md
docs/LESSONS.md|lessons|
docs/backlog/README.md|inline-backlog-readme|
docs/backlog/_template.md|template|backlog/_template.md
scripts/check-backlog.mjs|template|scripts/check-backlog.mjs
.claude/agents/implementation-dev.md|template|claude-agents/implementation-dev.md
.claude/agents/gtm-innovation.md|template|claude-agents/gtm-innovation.md
.claude/agents/review.md|template|claude-agents/review.md
LIST
}

# Render the manifest for a given project dir + slug. Mirrors
# manifest.example.sh's structure but substitutes the derived values.
onboard_render_manifest() {
  local slug="$1" proj_dir="$2"
  local repo_url self_cancel namespace
  repo_url=$( (cd "$proj_dir" && git remote get-url origin 2>/dev/null) || echo "" )
  # Today + 21 days UTC, YYYYMMDD. macOS BSD date uses -v; GNU date uses -d.
  self_cancel=$(date -u -v+21d +%Y%m%d 2>/dev/null \
                 || date -u -d "+21 days" +%Y%m%d)
  namespace="com.$slug"
  cat <<MANIFEST
# agents.config.sh — per-project fleet manifest (PLUMBING ONLY).
#
# This file holds the values the SHELL needs (identity, schedule, spend
# bound). Everything the AGENT needs at runtime (gating checks, branch
# prefixes, the local gate command, voice, hard NOs) lives in this project's
# AGENTS.md "## Agent parameters" section — NOT here.
#
# After editing, re-deploy: bash <kit>/lib/install.sh /abs/path/to/project

# --- identity -------------------------------------------------------------
PROJECT_NAME="$slug"
SLUG="$slug"
NAMESPACE="$namespace"
REPO_URL="$repo_url"
MODEL="claude-opus-4-7"

# Commits the agents author under this identity.
GIT_AUTHOR_NAME="$slug Agent"
GIT_AUTHOR_EMAIL="noreply@anthropic.com"

# --- spend bound ----------------------------------------------------------
# YYYYMMDD UTC. After this date all agents no-op until you bump it + reinstall.
SELF_CANCEL="$self_cancel"

# Optional per-slug daily cap in USD. Unset = no cap.
# MAX_DAILY_USD=5

# Optional trainee-mode gate: first N feature PRs require manual merge.
# TRAINEE_PR_COUNT=5

# --- cadence --------------------------------------------------------------
SHIP_MINUTE=41
GROOM_HOURS="0 6 12 18"
GROOM_MINUTE=17
REVIEW_INTERVAL=300

# --- engineering queue (optional second worker) ---------------------------
ENG_ENABLED=0
ENG_HOURS="3 9 15 21"
ENG_MINUTE=23
MANIFEST
}

# Render AGENTS.md by stitching a slug header onto templates/AGENTS.section.md
# (which carries the canonical "## Agent parameters" + "## Hard NOs" content).
onboard_render_agents_md() {
  local slug="$1" kit_root="$2"
  cat <<HEADER
# AGENTS.md — $slug

This file is the **contract** between the autonomous loop and this repo.
The shared engine in \`lib/\` reads \`agents.config.sh\`; the \`claude\`
agent that runs each ship/groom/review cycle reads **this file**, in a
fresh checkout, every single time.

> Replace every bracketed value below before the first run. The dev agent
> takes "## Agent parameters" as ground truth — wrong values silently break
> gating and branch handling.

HEADER
  # AGENTS.section.md already contains the "## Agent parameters" and
  # "## Hard NOs" sections. Drop its leading HTML comment block (the
  # "paste these two sections" instruction is for humans, not the project).
  awk 'started || /^## /{started=1} started' "$kit_root/templates/AGENTS.section.md"
}

# Render the docs/backlog/README.md scaffold. Inline so we don't have to ship
# another template file just for one paragraph + an empty table.
onboard_render_backlog_readme() {
  local slug="$1"
  cat <<README
# Backlog — $slug

Tickets here ship via the kit: \`implementation-dev\` picks the top groomed
row, \`gtm-innovation\` proposes new ones, \`review\` grades them.

## Conventions

- \`id\` is a 4-digit zero-padded integer; the filename is
  \`NNNN-kebab-title.md\`.
- \`status\` is one of: \`proposed\`, \`groomed\`, \`in-progress\`, \`shipped\`,
  \`rejected\`, \`needs-discovery\`.
- \`priority\` is \`P0\` (oncall-now), \`P1\` (this week), \`P2\` (next),
  \`P3\` (later).
- \`area\` is project-specific — set the allowed list in AGENTS.md
  "## Agent parameters · Backlog areas".
- The table below MUST stay in sync with the frontmatter of each ticket file.
  CI gate \`validate\` runs \`node scripts/check-backlog.mjs\` and rejects drift.

## Index

| id | title | priority | status | area |
|----|-------|----------|--------|------|
README
}

# Write one scaffold file. Honours $force (overwrite-with-OK-line) and
# $dry_run (print "would create" and skip the write).
onboard_write_one() {
  local dest_rel="$1" kind="$2" source_rel="$3"
  local proj_dir="$4" slug="$5" kit_root="$6"
  local force="$7" dry_run="$8"
  local dest="$proj_dir/$dest_rel"

  if [ "$dry_run" = "1" ]; then
    echo "would create $dest_rel"
    return 0
  fi

  if [ -e "$dest" ] && [ "$force" != "1" ]; then
    # The top-level guard already caught agents.config.sh; for other files
    # this is a quiet skip — the operator may have edited them. We do
    # nothing rather than silently clobber.
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  case "$kind" in
    manifest)
      onboard_render_manifest "$slug" "$proj_dir" > "$dest"
      ;;
    agents-md)
      onboard_render_agents_md "$slug" "$kit_root" > "$dest"
      ;;
    lessons)
      printf '# LESSONS\n\nOperational memory.\n' > "$dest"
      ;;
    inline-backlog-readme)
      onboard_render_backlog_readme "$slug" > "$dest"
      ;;
    template)
      /bin/cp -f "$kit_root/templates/$source_rel" "$dest"
      ;;
    *)
      echo "fleet onboard: unknown render kind '$kind' for $dest_rel" >&2
      return 1
      ;;
  esac

  if [ "$force" = "1" ]; then
    echo "[OK] reset $dest_rel"
  fi
}

onboard() {
  shift  # drop the leading "onboard"
  local dry_run=0 force=0 skip_install=0 proj_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      --force) force=1; shift ;;
      --skip-install) skip_install=1; shift ;;
      -h|--help)
        cat <<USAGE
fleet onboard — scaffold a fresh project with the kit contract.

Usage:
  fleet onboard <project-path>            scaffold + run install.sh
  fleet onboard --dry-run <project-path>  print what would be written
  fleet onboard --force <project-path>    overwrite existing contract files
  fleet onboard --skip-install <path>     scaffold only; skip install.sh

The project-path must already be a git repo with an 'origin' remote. The
manifest pulls REPO_URL from \`git remote get-url origin\` and derives SLUG
from the basename. Edit agents.config.sh and AGENTS.md after — the bracketed
values (gating checks, local gate command, backlog areas) are project-specific.
USAGE
        exit 0 ;;
      --) shift; proj_arg="${1:-}"; shift || true; break ;;
      -*) echo "fleet onboard: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$proj_arg" ]; then proj_arg="$1"; shift
        else echo "fleet onboard: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$proj_arg" ]; then
    echo "fleet onboard: missing <project-path>" >&2
    echo "usage: fleet onboard [--dry-run|--force|--skip-install] <project-path>" >&2
    exit 2
  fi
  if [ ! -d "$proj_arg" ]; then
    echo "fleet onboard: $proj_arg is not a directory" >&2
    exit 2
  fi

  local proj_dir; proj_dir="$( cd "$proj_arg" && pwd )"
  local slug; slug="$(basename "$proj_dir")"
  local kit_root; kit_root="$(onboard_kit_root)"

  # Already-onboarded guard — exact wording per ticket 0011.
  if [ -f "$proj_dir/agents.config.sh" ] && [ "$force" != "1" ] && [ "$dry_run" != "1" ]; then
    echo "already onboarded — use 'fleet onboard --force' to overwrite" >&2
    exit 1
  fi

  # Scaffold each file. On dry-run we just print the list and exit before
  # any side-effects (including the install.sh call).
  while IFS='|' read -r dest_rel kind source_rel; do
    [ -z "$dest_rel" ] && continue
    onboard_write_one "$dest_rel" "$kind" "$source_rel" \
                      "$proj_dir" "$slug" "$kit_root" \
                      "$force" "$dry_run"
  done < <(onboard_file_list)

  if [ "$dry_run" = "1" ]; then
    exit 0
  fi

  # Install unless explicitly skipped. The test harness sets
  # FLEET_INSTALL_CMD to point at a stub; production runs use the real
  # lib/install.sh sitting alongside this script.
  if [ "$skip_install" != "1" ]; then
    local install_cmd="${FLEET_INSTALL_CMD:-}"
    if [ -n "$install_cmd" ]; then
      "$install_cmd" "$proj_dir" || {
        echo "fleet onboard: install command failed: $install_cmd" >&2
        exit 1
      }
    else
      bash "$kit_root/lib/install.sh" "$proj_dir" || {
        echo "fleet onboard: install.sh failed" >&2
        exit 1
      }
    fi
  fi

  echo
  echo "next: 'launchctl kickstart -k gui/\$UID/com.${slug}.agent-ship' to trigger the first run"
  exit 0
}

if [ "$CMD" = "onboard" ]; then
  onboard "$@"
fi

# --- preflight ------------------------------------------------------------
# Ticket 0032. `fleet preflight <repo-path>` dry-adopts a candidate project
# and prints a 10-row PASS/WARN/FAIL table + a one-line verdict, mirroring
# `doctor`'s shape but running BEFORE install.sh against ONE candidate path
# (not all discovered projects). The command writes ZERO files outside the
# candidate repo's working tree and never invokes a `launchctl` mutation
# verb — only read-only `print` / `print-disabled` / `list`. Exit codes:
#   0 → zero FAILs (safe to install)
#   1 → at least one FAIL
#   2 → usage error (bad path, unknown flag, missing argument)
#
# Per LESSONS 2026-06-03 the JSON renderer uses its own UTF-8-safe escape
# (`preflight_json_escape`), NOT `doctor_json_escape`. Per LESSONS
# 2026-06-01 every code path ends with an explicit `exit N`. Per LESSONS
# 2026-05-28 every printf of a path or slug uses `printf -- '%s'`.

# UTF-8-safe JSON string escape — copy of provenance_json_escape's fix
# (LESSONS 2026-06-03): guard the control-char branch on `code >= 0` so
# sign-extended high bytes (negative codes under LC_ALL=C) pass through
# unescaped rather than emitting `￿ffffff…` garbage.
preflight_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *)
        printf -v code '%d' "'$ch"
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v out '%s\\u%04x' "$out" "$code"
        else
          out+="$ch"
        fi
        ;;
    esac
  done
  printf -- '%s' "$out"
}

# Each check helper echoes `STATUS<TAB>DETAIL` on a single line. Renderer
# turns that into either a human row or a JSON object. Independent — no
# shared mutable state — so the renderer can call them in fixed order.

# check 1: manifest (agents.config.sh) exists + parses + sets the required
# vars. Reads SLUG and NAMESPACE in a subshell so vars don't leak.
preflight_check_manifest() {
  local proj_dir="$1"
  local manifest="$proj_dir/agents.config.sh"
  if [ ! -f "$manifest" ]; then
    printf 'FAIL\tno agents.config.sh at %s\n' "$proj_dir"
    return 0
  fi
  local slug ns
  # shellcheck disable=SC1090  # discovered at runtime
  slug="$( ( source "$manifest" 2>/dev/null; printf -- '%s' "${SLUG:-}" ) )"
  # shellcheck disable=SC1090
  ns="$( ( source "$manifest" 2>/dev/null; printf -- '%s' "${NAMESPACE:-}" ) )"
  if [ -z "$slug" ]; then
    printf 'FAIL\tagents.config.sh sets no SLUG\n'
    return 0
  fi
  if [ -z "$ns" ]; then
    printf 'FAIL\tagents.config.sh sets no NAMESPACE\n'
    return 0
  fi
  printf 'PASS\tSLUG=%s, NAMESPACE=%s\n' "$slug" "$ns"
}

# check 2: AGENTS.md has the contract anchor heading the runners read.
preflight_check_agents_md_section() {
  local proj_dir="$1"
  local am="$proj_dir/AGENTS.md"
  if [ ! -f "$am" ]; then
    printf 'FAIL\tAGENTS.md not found at %s\n' "$am"
    return 0
  fi
  if ! grep -qE '^##[[:space:]]+Agent parameters' "$am"; then
    printf 'FAIL\tAGENTS.md missing %s section\n' "'## Agent parameters'"
    return 0
  fi
  printf 'PASS\tgating section present\n'
}

# check 3: docs/backlog/README.md exists + has at least one ticket row.
preflight_check_backlog_scaffolding() {
  local proj_dir="$1"
  local readme="$proj_dir/docs/backlog/README.md"
  if [ ! -f "$readme" ]; then
    printf 'FAIL\tdocs/backlog/README.md not found at %s\n' "$readme"
    return 0
  fi
  # Count ticket rows (lines beginning with `| NNNN |`). Per LESSONS
  # 2026-06-01 we count with awk so `grep -c | || echo 0` cannot
  # double-print on zero matches.
  local n
  n="$(awk '/^\|[[:space:]]*[0-9]{4}[[:space:]]*\|/ { n++ } END { print (n+0) }' "$readme")"
  printf 'PASS\tdocs/backlog/README.md, %s tickets\n' "$n"
}

# check 4: scripts/check-backlog.mjs exists (kit-wide convention).
preflight_check_backlog_validator() {
  local proj_dir="$1"
  local validator="$proj_dir/scripts/check-backlog.mjs"
  if [ ! -f "$validator" ]; then
    printf 'WARN\tscripts/check-backlog.mjs missing — install.sh template will scaffold it\n'
    return 0
  fi
  printf 'PASS\tscripts/check-backlog.mjs exists\n'
}

# check 5: .claude/agents/ holds the three required subagent prompts
# (implementation-dev, gtm-innovation, review). eng-dev is optional unless
# ENG_ENABLED=1.
preflight_check_subagents() {
  local proj_dir="$1" eng_enabled="${2:-0}"
  local agents_dir="$proj_dir/.claude/agents"
  if [ ! -d "$agents_dir" ]; then
    printf 'WARN\t.claude/agents/ missing — install.sh template will scaffold it\n'
    return 0
  fi
  local missing="" req
  for req in implementation-dev gtm-innovation review; do
    if [ ! -f "$agents_dir/$req.md" ]; then
      missing="$missing $req.md"
    fi
  done
  if [ -n "$missing" ]; then
    printf 'FAIL\tmissing required subagents:%s\n' "$missing"
    return 0
  fi
  # eng-dev: WARN if missing AND ENG_ENABLED=1; informational WARN
  # otherwise (matches the ticket's golden output for the happy path).
  if [ ! -f "$agents_dir/eng-dev.md" ]; then
    if [ "$eng_enabled" = "1" ]; then
      printf 'FAIL\teng-dev.md missing but ENG_ENABLED=1 in manifest\n'
    else
      printf 'WARN\teng-dev.md missing — ENG_ENABLED=0 in manifest, OK\n'
    fi
    return 0
  fi
  printf 'PASS\tall four subagents present\n'
}

# check 6: gh auth status — readable (best-effort scope extract).
preflight_check_gh_auth() {
  if ! command -v gh >/dev/null 2>&1; then
    printf 'FAIL\tgh CLI not installed (https://cli.github.com/)\n'
    return 0
  fi
  local raw
  raw="$(gh auth status 2>&1 || true)"
  if ! printf -- '%s' "$raw" | grep -qE 'Logged in to'; then
    printf 'FAIL\tgh auth status failed — run gh auth login\n'
    return 0
  fi
  # Extract account + scopes one-liner. BSD grep + sed for portability.
  local account scopes
  account="$(printf -- '%s' "$raw" | sed -n 's/.*account \([A-Za-z0-9_-]\{1,\}\).*/\1/p' | head -1)"
  scopes="$(printf -- '%s' "$raw" | sed -n 's/.*Token scopes: //p' | head -1)"
  if [ -n "$account" ] && [ -n "$scopes" ]; then
    printf 'PASS\t%s, scopes: %s\n' "$account" "$scopes"
  elif [ -n "$account" ]; then
    printf 'PASS\t%s\n' "$account"
  else
    printf 'PASS\tauthenticated\n'
  fi
}

# check 7: claude CLI present on PATH.
preflight_check_claude_on_path() {
  local cpath
  cpath="$(command -v claude 2>/dev/null || true)"
  if [ -z "$cpath" ]; then
    printf 'FAIL\tclaude CLI not on PATH (https://docs.anthropic.com/claude/docs/claude-code)\n'
    return 0
  fi
  printf 'PASS\t%s\n' "$cpath"
}

# check 8: ~/.local/share/agent-fleet writable (where install.sh copies
# the TCC-safe engine). The dir may not exist yet; we test by attempting
# to mkdir + a tmpfile inside it, then removing the tmpfile only.
preflight_check_share_writable() {
  local share="$HOME/.local/share/agent-fleet"
  if [ ! -d "$share" ]; then
    if ! mkdir -p "$share" 2>/dev/null; then
      printf 'FAIL\tcannot create %s (parent unwritable?)\n' "$share"
      return 0
    fi
  fi
  local probe="$share/.preflight-probe.$$"
  if : > "$probe" 2>/dev/null; then
    rm -f "$probe"
    printf 'PASS\t%s\n' "$share"
  else
    printf 'FAIL\t%s not writable\n' "$share"
  fi
}

# check 9: launchd namespace not already claimed by ANOTHER slug. We look
# for any loaded label of the form `<ns>.agent-{ship,groom,review,eng}`
# via read-only `launchctl print` against gui/$UID. If any of those four
# resolve AND the candidate has not yet been installed (no manifest in
# the installed copy with the same SLUG), the namespace is claimed by
# someone else.
preflight_check_launchd_namespace() {
  local ns="$1" slug="$2"
  if [ -z "$ns" ]; then
    printf 'WARN\tNAMESPACE unset — skipped\n'
    return 0
  fi
  local uid="${UID:-$(id -u)}"
  local domain="gui/$uid"
  local job conflict=""
  for job in ship groom review eng; do
    if launchctl print "$domain/$ns.agent-$job" >/dev/null 2>&1; then
      conflict="$conflict $ns.agent-$job"
    fi
  done
  if [ -z "$conflict" ]; then
    printf 'PASS\tno existing %s.* labels\n' "$ns"
    return 0
  fi
  # Determine whether the conflict is THIS slug (already-installed, fine)
  # or ANOTHER slug. We check the installed manifest tree for a matching
  # SLUG with the same NAMESPACE.
  local installed_slug=""
  local m
  for m in "$HOME/.local/share/agent-fleet/projects/"*/agents.config.sh; do
    [ -f "$m" ] || continue
    # shellcheck disable=SC1090
    local m_ns m_slug
    m_ns="$( ( source "$m" 2>/dev/null; printf -- '%s' "${NAMESPACE:-}" ) )"
    m_slug="$( ( source "$m" 2>/dev/null; printf -- '%s' "${SLUG:-}" ) )"
    if [ "$m_ns" = "$ns" ]; then
      installed_slug="$m_slug"
      break
    fi
  done
  if [ -n "$installed_slug" ] && [ "$installed_slug" = "$slug" ]; then
    printf 'WARN\t%s.* already loaded for this slug (re-install will refresh)\n' "$ns"
    return 0
  fi
  local other="${installed_slug:-another project}"
  printf 'FAIL\tlaunchd namespace %s.* already claimed by %s\n' "$ns" "$other"
}

# check 10: SELF_CANCEL is at least 7 days in the future. WARN < 7d
# (preflight is meant for NEW projects; the operator likely set
# SELF_CANCEL too tight). FAIL if expired (would make ship_paused fire
# on first run). PASS otherwise. Reuses the top-of-file `days_until`.
preflight_check_self_cancel_horizon() {
  local sc="$1"
  if [ -z "$sc" ]; then
    printf 'FAIL\tSELF_CANCEL unset — agents will refuse to run\n'
    return 0
  fi
  local days
  days="$(days_until "$sc")"
  case "$days" in
    ''|*[!0-9-]*) printf 'FAIL\tSELF_CANCEL=%s does not parse as YYYYMMDD\n' "$sc"; return 0 ;;
  esac
  if [ "$days" -lt 0 ]; then
    printf 'FAIL\tSELF_CANCEL=%s expired %sd ago\n' "$sc" "${days#-}"
    return 0
  fi
  if [ "$days" -lt 7 ]; then
    printf 'WARN\tSELF_CANCEL=%s — only %sd; consider 30d+ for a new project\n' "$sc" "$days"
    return 0
  fi
  printf 'PASS\tSELF_CANCEL=%s\n' "$sc"
}

# Visible width of a UTF-8 string — counts code points, not bytes, so the
# `§` in "AGENTS.md § Agent parameters:" pads correctly across locales.
# Forces LC_ALL=C inside the function so `${#s}` returns BYTE count
# regardless of the caller's LANG, then walks the byte stream and counts:
#   - 0x00-0x7F (ASCII): one display column
#   - 0xC0-0xFF (UTF-8 lead byte): one display column
#   - 0x80-0xBF (UTF-8 continuation byte): zero (already counted by lead)
# Cheap; good enough for the kit's ASCII + a-few-punct label set.
preflight_visible_width() {
  # Bash 3.2 caches its locale-sensitive operations at startup, so flipping
  # LC_ALL=C mid-script does not always flip `${#s}` from char-count to
  # byte-count — under en_US.UTF-8 the loop sees ONE character "§" with
  # code 167 (the trailing continuation byte) and misses the +1 entirely.
  # Side-step the locale dance: take the byte count via `wc -c`, then
  # subtract the UTF-8 continuation-byte count (0x80..0xBF) via awk under
  # LC_ALL=C so the substring extraction is guaranteed byte-mode.
  local s="${1-}" total cont
  total="$(printf -- '%s' "$s" | LC_ALL=C wc -c | tr -d ' ')"
  cont="$(printf -- '%s' "$s" | LC_ALL=C awk '
    BEGIN {
      for (k=0; k<256; k++) ord[sprintf("%c", k)] = k
      n = 0
    }
    {
      for (i=1; i<=length($0); i++) {
        v = ord[substr($0, i, 1)]
        if (v >= 128 && v < 192) n++
      }
    }
    END { print n+0 }
  ')"
  printf '%d' "$(( total - cont ))"
}

# Pad $1 to display width $2 with trailing spaces. Used instead of
# `printf %-Ns` because that pads on BYTE length, which over-counts
# multi-byte chars like the section sign §.
preflight_pad_right() {
  local s="$1" target="$2" cur pad
  cur="$(preflight_visible_width "$s")"
  pad=$(( target - cur ))
  if [ "$pad" -lt 0 ]; then pad=0; fi
  printf -- '%s' "$s"
  if [ "$pad" -gt 0 ]; then
    printf -- '%*s' "$pad" ""
  fi
}

# Human renderer. Reads a stream of `LABEL|STATUS|DETAIL` lines on stdin
# and emits the table + verdict + next-line. Returns exit code via stdout
# `__PREFLIGHT_EXIT__<TAB>N` sentinel so the dispatcher can act.
preflight_render_text() {
  local repo="$1"
  printf -- 'fleet preflight: dry-adopting %s …\n\n' "$repo"
  local pass=0 warn=0 fail=0
  local label status detail padded
  while IFS='|' read -r label status detail; do
    [ -z "$label" ] && continue
    case "$status" in
      PASS) pass=$(( pass + 1 )) ;;
      WARN) warn=$(( warn + 1 )) ;;
      FAIL) fail=$(( fail + 1 )) ;;
    esac
    padded="$(preflight_pad_right "  $label" 40)"
    if [ -n "$detail" ]; then
      printf -- '%s%s  (%s)\n' "$padded" "$status" "$detail"
    else
      printf -- '%s%s\n' "$padded" "$status"
    fi
  done
  printf -- '\n'
  local verdict_msg
  if [ "$fail" -gt 0 ]; then
    verdict_msg="DO NOT install yet."
  else
    verdict_msg="safe to install."
  fi
  printf -- 'verdict: %s PASS, %s WARN, %s FAIL — %s\n' "$pass" "$warn" "$fail" "$verdict_msg"
  printf -- 'next:   bash lib/install.sh %s\n' "$repo"
  if [ "$fail" -gt 0 ]; then
    printf '__PREFLIGHT_EXIT__\t1\n'
  else
    printf '__PREFLIGHT_EXIT__\t0\n'
  fi
}

# JSON renderer. Reads same stream and emits one JSON object per row
# (NDJSON-style — same shape as fleet inbox --json / atlas --json) plus
# a final summary row. Per LESSONS 2026-06-03 the escape is UTF-8-safe.
preflight_render_json() {
  local pass=0 warn=0 fail=0
  local label status detail
  while IFS='|' read -r label status detail; do
    [ -z "$label" ] && continue
    case "$status" in
      PASS) pass=$(( pass + 1 )) ;;
      WARN) warn=$(( warn + 1 )) ;;
      FAIL) fail=$(( fail + 1 )) ;;
    esac
    printf -- '{"check":"%s","status":"%s","detail":"%s"}\n' \
      "$(preflight_json_escape "$label")" \
      "$(preflight_json_escape "$status")" \
      "$(preflight_json_escape "$detail")"
  done
  local verdict
  if [ "$fail" -gt 0 ]; then verdict="do_not_install"; else verdict="safe"; fi
  printf -- '{"summary":true,"pass":%s,"warn":%s,"fail":%s,"verdict":"%s"}\n' \
    "$pass" "$warn" "$fail" "$verdict"
  if [ "$fail" -gt 0 ]; then
    printf '__PREFLIGHT_EXIT__\t1\n'
  else
    printf '__PREFLIGHT_EXIT__\t0\n'
  fi
}

preflight() {
  shift  # drop the leading "preflight"
  local want_json=0 repo_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      -h|--help)
        cat <<USAGE
fleet preflight — dry-adopt a candidate project before running install.sh.

Usage:
  fleet preflight <repo-path>          print 10 PASS/WARN/FAIL rows + verdict
  fleet preflight --json <repo-path>   one JSON object per row + summary row
  fleet preflight --help               this banner

Read-only by definition: never writes a file under ~/.local/share/agent-fleet,
~/Library/LaunchAgents, or ~/.cache/<slug>-agent; never calls a launchctl
mutation verb. Exit codes: 0 = zero FAILs, 1 = at least one FAIL, 2 = usage.
USAGE
        exit 0 ;;
      --) shift; repo_arg="${1:-}"; shift || true; break ;;
      -*) echo "fleet preflight: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$repo_arg" ]; then repo_arg="$1"; shift
        else echo "fleet preflight: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$repo_arg" ]; then
    echo "fleet preflight: missing <repo-path>" >&2
    echo "usage: fleet preflight [--json] <repo-path>" >&2
    exit 2
  fi
  if [ ! -d "$repo_arg" ]; then
    printf -- 'fleet preflight: no such directory %s\n' "$repo_arg" >&2
    exit 2
  fi

  local proj_dir; proj_dir="$( cd "$repo_arg" && pwd )"

  # Resolve manifest values once (eng_enabled, namespace, slug, sc) so
  # downstream checks can reuse them without re-sourcing.
  local slug="" ns="" sc="" eng="0"
  if [ -f "$proj_dir/agents.config.sh" ]; then
    # shellcheck disable=SC1090
    local probe
    probe="$(
      ( source "$proj_dir/agents.config.sh" 2>/dev/null
        printf 'SLUG=%s\n' "${SLUG:-}"
        printf 'NAMESPACE=%s\n' "${NAMESPACE:-}"
        printf 'SELF_CANCEL=%s\n' "${SELF_CANCEL:-}"
        printf 'ENG_ENABLED=%s\n' "${ENG_ENABLED:-0}"
      ) 2>/dev/null
    )"
    slug="$(printf -- '%s' "$probe" | sed -n 's/^SLUG=//p')"
    ns="$(printf -- '%s' "$probe" | sed -n 's/^NAMESPACE=//p')"
    sc="$(printf -- '%s' "$probe" | sed -n 's/^SELF_CANCEL=//p')"
    eng="$(printf -- '%s' "$probe" | sed -n 's/^ENG_ENABLED=//p')"
  fi

  # Build the row stream. Each check emits `STATUS<TAB>DETAIL`; we prepend
  # the human label to form `LABEL|STATUS|DETAIL`. Stable order, ten rows.
  local stream=""
  local row label out s d
  # The tilde in "~/.local/share/agent-fleet writable:" is a LITERAL label
  # for the operator, not a path; the actual writability check resolves
  # `$HOME/.local/share/agent-fleet` inside `preflight_check_share_writable`.
  # shellcheck disable=SC2088  # tilde is part of a display label, not a path
  for spec in \
    "manifest (agents.config.sh):|preflight_check_manifest $(printf '%q' "$proj_dir")" \
    "AGENTS.md § Agent parameters:|preflight_check_agents_md_section $(printf '%q' "$proj_dir")" \
    "backlog scaffolding:|preflight_check_backlog_scaffolding $(printf '%q' "$proj_dir")" \
    "backlog validator:|preflight_check_backlog_validator $(printf '%q' "$proj_dir")" \
    "subagents under .claude/agents/:|preflight_check_subagents $(printf '%q' "$proj_dir") $(printf '%q' "$eng")" \
    "gh auth status:|preflight_check_gh_auth" \
    "claude CLI on PATH:|preflight_check_claude_on_path" \
    "~/.local/share/agent-fleet writable:|preflight_check_share_writable" \
    "launchd namespace free:|preflight_check_launchd_namespace $(printf '%q' "$ns") $(printf '%q' "$slug")" \
    "SELF_CANCEL >= today + 7d:|preflight_check_self_cancel_horizon $(printf '%q' "$sc")" \
  ; do
    label="${spec%%|*}"
    row="${spec#*|}"
    # Run the helper; capture STATUS<TAB>DETAIL.
    out="$(eval "$row")"
    # Split on the first tab without invoking awk -v (LESSONS 2026-06-01).
    s="${out%%	*}"
    d="${out#*	}"
    [ "$s" = "$d" ] && d=""
    stream+="$label|$s|$d"$'\n'
  done

  # Renderer prints + emits `__PREFLIGHT_EXIT__<TAB>N` sentinel; we strip
  # the sentinel and propagate the exit code. Per LESSONS 2026-06-01,
  # every code path ends in an explicit exit.
  local rendered exit_code
  if [ "$want_json" = "1" ]; then
    rendered="$(printf -- '%s' "$stream" | preflight_render_json)"
  else
    rendered="$(printf -- '%s' "$stream" | preflight_render_text "$proj_dir")"
  fi
  exit_code="$(printf -- '%s' "$rendered" | awk -F'\t' '/^__PREFLIGHT_EXIT__/ { print $2 }')"
  printf -- '%s' "$rendered" | grep -v '^__PREFLIGHT_EXIT__'
  case "$exit_code" in
    0) exit 0 ;;
    1) exit 1 ;;
    *) exit 1 ;;
  esac
}

if [ "$CMD" = "preflight" ]; then
  preflight "$@"
fi

# --- onboarding-check -----------------------------------------------------
# Ticket 0041. `fleet onboarding-check <repo-path>` is the AFTER-install
# verifier in the acquisition trio (kickstart --demo → preflight → install
# → onboarding-check). It walks 11 read-only checks against a freshly-
# installed project + a synthetic ship cycle (NO real claude spawn, NO
# real PR, NO heal-counter advance). Each check returns GREEN | YELLOW |
# RED with a one-line remediation hint.
#
# Telemetry: REUSES the four core event types from kickstart --demo with
# a new `phase=onboarding-check` discriminator (per AGENTS.md § Telemetry
# Demo path paragraph — this is a CONSUMER of the existing contract, not
# a new channel). Synthetic events land in the AGENT-FLEET kit-as-project
# events.jsonl (per the lesson_promoted / prompts_reverted pattern — the
# kit IS a project for telemetry purposes) so they do NOT pollute the
# verified project's ROI rollup.
#
# Hard NOs the helpers respect:
#   - never call fleet_run_claude (AC#9 — claude stub records zero hits)
#   - never call `gh pr create` (the gh stub log assertion)
#   - never touch ~/.local/share/agent-fleet, ~/Library/LaunchAgents, or
#     ~/.cache/<other-slug>-agent (read-only by design)
#
# All helpers below this header are defined ABOVE the dispatcher block at
# the END of this section per LESSONS 2026-06-05 (forward-reference trap).
# Every check helper prints one TSV record `result<TAB>hint` to stdout.
# The consumer remaps empty hints from a `-` sentinel per LESSONS
# 2026-06-08 (IFS=$'\t' middle-empty-field trap).

# Pad a label to display-width N for the text renderer. Reuses preflight's
# UTF-8-aware width helper so the section sign § in any future check label
# pads correctly across locales.
onboarding_check_pad() {
  local s="$1" target="$2" cur pad
  cur="$(preflight_visible_width "$s")"
  pad=$(( target - cur ))
  if [ "$pad" -lt 0 ]; then pad=0; fi
  printf -- '%s' "$s"
  if [ "$pad" -gt 0 ]; then
    printf -- '%*s' "$pad" ""
  fi
}

# check 1: agents.config.sh present + sources cleanly. RED if missing or
# fails to source. GREEN otherwise (the deeper "is SLUG set" check is
# already covered by preflight; here we only confirm the manifest is
# reachable from the project tree the operator just installed against).
onboarding_check_agents_config() {
  local proj_dir="$1"
  local manifest="$proj_dir/agents.config.sh"
  if [ ! -f "$manifest" ]; then
    printf 'red\tagents.config.sh missing — re-run install.sh against this repo\n'
    return 0
  fi
  # shellcheck disable=SC1090
  if ! ( source "$manifest" 2>/dev/null ); then
    printf 'red\tagents.config.sh fails to source — open it and fix the syntax error\n'
    return 0
  fi
  printf 'green\t-\n'
}

# check 2: AGENTS.md has the gating-contract section header.
onboarding_check_agents_md_section() {
  local proj_dir="$1"
  local am="$proj_dir/AGENTS.md"
  if [ ! -f "$am" ]; then
    printf 'red\tAGENTS.md missing — copy templates/AGENTS.section.md into place\n'
    return 0
  fi
  if ! grep -qE '^##[[:space:]]+Agent parameters' "$am"; then
    printf 'red\tAGENTS.md lacks the "## Agent parameters" section header\n'
    return 0
  fi
  printf 'green\t-\n'
}

# check 3: docs/backlog/README.md index file is present.
onboarding_check_backlog_index() {
  local proj_dir="$1"
  local readme="$proj_dir/docs/backlog/README.md"
  if [ ! -f "$readme" ]; then
    printf 'red\tdocs/backlog/README.md missing — install.sh template scaffolds it\n'
    return 0
  fi
  printf 'green\t-\n'
}

# check 4: ~/.local/share/agent-fleet/lib/ present (the TCC-safe engine
# copy install.sh writes). RED if absent — operator hasn't installed yet.
onboarding_check_lib_copied() {
  local share="$HOME/.local/share/agent-fleet/lib"
  if [ ! -d "$share" ]; then
    printf 'red\tno lib/ at %s — re-run install.sh\n' "$share"
    return 0
  fi
  printf 'green\t-\n'
}

# check 5: both launchd plists installed under ~/Library/LaunchAgents.
# RED if either is missing.
onboarding_check_plists_present() {
  local ns="$1"
  if [ -z "$ns" ]; then
    printf 'red\tNAMESPACE unset in agents.config.sh — cannot resolve plist paths\n'
    return 0
  fi
  local dir="$HOME/Library/LaunchAgents"
  local missing="" job
  for job in ship groom; do
    if [ ! -f "$dir/$ns.agent-$job.plist" ]; then
      missing="$missing $ns.agent-$job.plist"
    fi
  done
  if [ -n "$missing" ]; then
    printf 'red\tmissing plist(s):%s — re-run install.sh\n' "$missing"
    return 0
  fi
  printf 'green\t-\n'
}

# check 6: launchd labels enabled. YELLOW (not RED) when one is disabled —
# the operator may deliberately disable agent-groom to ship from a
# hand-curated backlog. We probe via `launchctl print-disabled gui/$UID`
# which is read-only (per ticket "Out of scope" no mutation verbs).
onboarding_check_labels_enabled() {
  local ns="$1"
  if [ -z "$ns" ]; then
    printf 'red\tNAMESPACE unset — cannot probe labels\n'
    return 0
  fi
  local uid="${UID:-$(id -u)}"
  local domain="gui/$uid"
  local job out disabled=""
  for job in ship groom; do
    out="$(launchctl print-disabled "$domain" "$ns.agent-$job" 2>/dev/null || true)"
    if printf -- '%s' "$out" | grep -qF -- "disabled"; then
      disabled="$disabled $ns.agent-$job"
    fi
  done
  if [ -n "$disabled" ]; then
    printf 'yellow\tlabel disabled:%s — launchctl enable %s/%s.agent-{ship,groom}\n' \
      "$disabled" "$domain" "$ns"
    return 0
  fi
  printf 'green\t-\n'
}

# check 7: $CACHE_DIR/events.jsonl writable. We touch a sentinel file in
# the cache dir (creating the dir if necessary, just like the runners do)
# and remove it. Operates against the TARGET project's cache, not the
# kit's.
onboarding_check_events_writable() {
  local slug="$1"
  if [ -z "$slug" ]; then
    printf 'red\tSLUG unset — cannot resolve $CACHE_DIR\n'
    return 0
  fi
  local cache="$HOME/.cache/${slug}-agent"
  if ! mkdir -p "$cache" 2>/dev/null; then
    printf 'red\tcannot create %s (parent unwritable?)\n' "$cache"
    return 0
  fi
  local probe="$cache/.onboarding-check-probe.$$"
  if : > "$probe" 2>/dev/null; then
    rm -f "$probe"
    printf 'green\t-\n'
  else
    printf 'red\t%s not writable\n' "$cache"
  fi
}

# check 8: gh CLI is on PATH and reports an authenticated session.
onboarding_check_gh_auth() {
  if ! command -v gh >/dev/null 2>&1; then
    printf 'red\tgh CLI not on PATH — install from https://cli.github.com/\n'
    return 0
  fi
  local raw
  raw="$(gh auth status 2>&1 || true)"
  if ! printf -- '%s' "$raw" | grep -qE 'Logged in to'; then
    printf 'red\tgh not authenticated — run `gh auth login` and re-run\n'
    return 0
  fi
  printf 'green\t-\n'
}

# check 9: claude CLI on PATH.
onboarding_check_claude_cli() {
  if ! command -v claude >/dev/null 2>&1; then
    printf 'red\tclaude CLI not on PATH — install Claude Code and re-run\n'
    return 0
  fi
  printf 'green\t-\n'
}

# check 10: prompts SHA pin in the project's manifest matches the kit's
# current prompts SHA. Unset PROMPTS_SHA = YELLOW (drift events will fire
# silently forever); mismatch = YELLOW too (operator can re-install).
# Match = GREEN.
onboarding_check_prompts_sha() {
  local proj_dir="$1"
  local pin=""
  if [ -f "$proj_dir/agents.config.sh" ]; then
    # shellcheck disable=SC1090
    pin="$( ( source "$proj_dir/agents.config.sh" 2>/dev/null
              printf -- '%s' "${PROMPTS_SHA:-}" ) )"
  fi
  # Compute the kit's current prompts SHA the same way `fleet prompts-sha`
  # does (find prompts -type f -name '*.md' | sort | xargs cat | shasum).
  # We resolve the kit root via this script's path, the same way kickstart
  # --demo does (BASH_SOURCE-relative, no `dirname` dependency in case
  # PATH is minimal).
  local script_path bin_dir kit_root cur=""
  script_path="${BASH_SOURCE[0]}"
  case "$script_path" in
    /*) ;;
    *)  script_path="$PWD/$script_path" ;;
  esac
  bin_dir="${script_path%/*}"
  kit_root="${bin_dir%/*}"
  if [ -d "$kit_root/prompts" ]; then
    cur="$( cd "$kit_root" && find prompts -type f -name '*.md' 2>/dev/null \
              | sort | xargs cat 2>/dev/null | shasum -a 256 | awk '{print $1}' )"
  fi
  if [ -z "$pin" ]; then
    printf 'yellow\tPROMPTS_SHA unset — drift events will fire silently forever\n'
    return 0
  fi
  if [ -z "$cur" ]; then
    printf 'yellow\tcould not compute kit prompts SHA (run from the source checkout)\n'
    return 0
  fi
  if [ "$pin" = "$cur" ]; then
    printf 'green\t-\n'
    return 0
  fi
  printf 'yellow\tPROMPTS_SHA differs from installed copy — re-run install.sh to bump\n'
}

# check 11: synthetic ship cycle. The load-bearing helper. Picks a 6-hex
# random slug, points CACHE_DIR at a kit-as-project location, and emits
# the four core event types directly via fleet_emit_event (NOT via
# fleet_run_claude per AC#9). Sets up its own SLUG / CACHE_DIR / FLEET_PHASE
# so common.sh's emit helper writes to the right channel; we do NOT call
# fleet_log_init because it redirects stdout to a logfile.
#
# Per LESSONS 2026-06-05 (export-inside-$(...) trap), this helper is
# called WITHOUT command substitution from the dispatcher so the sourced
# common.sh's exports survive — that's why this helper prints its TSV
# line LAST (after the emits) but uses a temp file to capture the result.
onboarding_check_synthetic_cycle() {
  # Generate a 6-hex random slug.
  local rand
  rand="$(od -An -tx1 -N3 /dev/urandom 2>/dev/null | tr -d ' \n' || true)"
  if [ -z "$rand" ]; then
    rand="$(printf '%06x' "$RANDOM$RANDOM" | cut -c1-6)"
  fi
  local synth_slug="onboarding-check-$rand"

  # Resolve the kit root the same way the prompts SHA check does.
  local script_path bin_dir kit_root
  script_path="${BASH_SOURCE[0]}"
  case "$script_path" in
    /*) ;;
    *)  script_path="$PWD/$script_path" ;;
  esac
  bin_dir="${script_path%/*}"
  kit_root="${bin_dir%/*}"

  # Source common.sh so fleet_emit_event is in scope. lib/common.sh
  # resets PATH — that's fine because we are not shelling out to anything
  # except shasum/find which all live on the restored PATH.
  if [ ! -f "$kit_root/lib/common.sh" ]; then
    printf 'red\tcannot find kit lib/common.sh — run from the source checkout\n'
    return 0
  fi
  # Run the whole emit pass in a subshell so SLUG / CACHE_DIR / FLEET_PHASE
  # only affect the synthetic channel, not whatever the operator's shell
  # has set. Per LESSONS 2026-06-05 we DO call this from the dispatcher
  # without $(...) so the subshell's emits still write the JSONL file (the
  # writes go to disk, not to an exported guard env). The TSV record is
  # printed AFTER the subshell exits.
  (
    # shellcheck source=/dev/null
    source "$kit_root/lib/common.sh" >/dev/null 2>&1 || true
    SLUG="$synth_slug"; export SLUG
    CACHE_DIR="$HOME/.cache/${synth_slug}-agent"; export CACHE_DIR
    FLEET_PHASE="onboarding-check"; export FLEET_PHASE
    mkdir -p "$CACHE_DIR"
    fleet_emit_event run_started "pid=$$" || true
    fleet_emit_event pr_opened "number=0" "branch=synthetic" || true
    fleet_emit_event lesson_draft_emitted "pr=0" "headline=onboarding-check synthetic send-back" || true
    fleet_emit_event run_completed "exit=0" "duration_ms=0" || true
  ) || true

  # Verify the channel grew by four lines as a defensive check.
  local channel="$HOME/.cache/${synth_slug}-agent/events.jsonl"
  local n
  n="$(awk 'END { print NR+0 }' "$channel" 2>/dev/null || echo 0)"
  if [ "$n" -lt 4 ]; then
    printf 'red\tsynthetic cycle emitted %s events (want >=4) — events.jsonl unreachable?\n' "$n"
    return 0
  fi
  printf 'green\t4 events emitted (slug=%s phase=onboarding-check)\n' "$synth_slug"
}

# Text renderer. Consumes the stream of `LABEL|RESULT|HINT` records and
# prints the table + summary + NEXT block. The exit-code sentinel mirrors
# preflight's pattern so the dispatcher reads it back without polluting
# the rendered output.
onboarding_check_render_text() {
  local repo="$1"
  printf -- 'fleet onboarding-check: verifying %s …\n\n' "$repo"
  printf -- '%s%s\n' "$(onboarding_check_pad "CHECK" 40)" "RESULT"
  local g=0 y=0 r=0
  local label result hint padded RR next_lines=""
  while IFS='|' read -r label result hint; do
    [ -z "$label" ] && continue
    case "$result" in
      green)  g=$(( g + 1 )); RR="GREEN"  ;;
      yellow) y=$(( y + 1 )); RR="YELLOW" ;;
      red)    r=$(( r + 1 )); RR="RED"    ;;
      *)      RR="$result" ;;
    esac
    padded="$(onboarding_check_pad "  $label" 40)"
    if [ -n "$hint" ] && [ "$hint" != "-" ]; then
      printf -- '%s%s — %s\n' "$padded" "$RR" "$hint"
    else
      printf -- '%s%s\n' "$padded" "$RR"
    fi
    # Build the per-red NEXT lines so the RED summary lists each
    # remediation hint as a copy-pasteable bullet (per AC#7).
    if [ "$result" = "red" ] && [ -n "$hint" ] && [ "$hint" != "-" ]; then
      next_lines+="  - ${label}: ${hint}"$'\n'
    fi
  done
  printf -- '\n'
  local total=$(( g + y + r ))
  if [ "$r" -gt 0 ]; then
    printf -- 'onboarding-check: %s/%s green, %s yellow, %s red.\n' "$g" "$total" "$y" "$r"
    printf -- '\n'
    printf -- 'NEXT\n'
    if [ -n "$next_lines" ]; then
      printf -- '%s' "$next_lines"
    fi
    printf -- '__ONBOARDING_EXIT__\t1\n'
    return 0
  fi
  if [ "$y" -gt 0 ]; then
    printf -- 'onboarding-check: %s/%s green, %s yellow.\n' "$g" "$total" "$y"
  else
    printf -- 'onboarding-check: %s/%s green; loop is ready to fire.\n' "$g" "$total"
  fi
  printf -- '\n'
  printf -- 'NEXT\n'
  printf -- '  - the next hourly :37 mark will fire your first real ship.\n'
  printf -- '  - to fire now: launchctl kickstart -k gui/$UID/<your-namespace>.agent-ship\n'
  printf -- '  - to watch the loop: fleet tail --slug <your-slug>\n'
  printf -- '__ONBOARDING_EXIT__\t0\n'
}

# JSON renderer. NDJSON-style — one JSON object per check + a final
# summary object. Per LESSONS 2026-06-03 the escape goes through
# preflight_json_escape (UTF-8-safe).
onboarding_check_render_json() {
  local g=0 y=0 r=0
  local label result hint hint_out
  while IFS='|' read -r label result hint; do
    [ -z "$label" ] && continue
    case "$result" in
      green)  g=$(( g + 1 )) ;;
      yellow) y=$(( y + 1 )) ;;
      red)    r=$(( r + 1 )) ;;
    esac
    hint_out="$hint"
    [ "$hint_out" = "-" ] && hint_out=""
    printf -- '{"check":"%s","result":"%s","hint":"%s"}\n' \
      "$(preflight_json_escape "$label")" \
      "$(preflight_json_escape "$result")" \
      "$(preflight_json_escape "$hint_out")"
  done
  local ec=0
  [ "$r" -gt 0 ] && ec=1
  printf -- '{"summary":{"green":%s,"yellow":%s,"red":%s,"exit":%s}}\n' \
    "$g" "$y" "$r" "$ec"
  printf -- '__ONBOARDING_EXIT__\t%s\n' "$ec"
}

onboarding_check() {
  shift  # drop the leading "onboarding-check"
  local want_json=0 repo_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      -h|--help)
        cat <<USAGE
fleet onboarding-check — verify a freshly-installed project is end-to-end healthy.

Usage:
  fleet onboarding-check <repo-path>          11 GREEN/YELLOW/RED checks + verdict
  fleet onboarding-check --json <repo-path>   one JSON object per check + summary
  fleet onboarding-check --help               this banner

Checks performed (in order):
  1.  agents.config.sh present + sources cleanly
  2.  AGENTS.md gating section ("## Agent parameters") present
  3.  docs/backlog/README.md index present
  4.  ~/.local/share/agent-fleet/lib/ copied (TCC-safe engine)
  5.  launchd plists installed (agent-ship + agent-groom)
  6.  launchd labels enabled in gui/\$UID/
  7.  \$CACHE_DIR/events.jsonl writable
  8.  gh CLI authenticated
  9.  claude CLI on \$PATH
  10. prompts SHA pinned + matches installed copy
  11. synthetic ship cycle emits four core events (phase=onboarding-check)

Read-only by design — never calls launchctl mutation verbs, never opens a
real PR, never spawns the real claude binary. Exit codes: 0 = no RED rows
(GREEN-only or GREEN+YELLOW), 1 = at least one RED row, 2 = usage error.
USAGE
        exit 0 ;;
      --) shift; repo_arg="${1:-}"; shift || true; break ;;
      -*) echo "onboarding-check: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$repo_arg" ]; then repo_arg="$1"; shift
        else echo "onboarding-check: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$repo_arg" ]; then
    echo "onboarding-check: usage: bin/fleet onboarding-check <repo-path>" >&2
    exit 2
  fi
  if [ ! -d "$repo_arg" ]; then
    printf -- 'onboarding-check: %s: not a directory\n' "$repo_arg" >&2
    exit 2
  fi

  local proj_dir; proj_dir="$( cd "$repo_arg" && pwd )"

  # Resolve manifest values once so the per-check helpers can reuse them.
  local slug="" ns=""
  if [ -f "$proj_dir/agents.config.sh" ]; then
    # shellcheck disable=SC1090
    local probe
    probe="$(
      ( source "$proj_dir/agents.config.sh" 2>/dev/null
        printf 'SLUG=%s\n' "${SLUG:-}"
        printf 'NAMESPACE=%s\n' "${NAMESPACE:-}"
      ) 2>/dev/null
    )"
    slug="$(printf -- '%s' "$probe" | sed -n 's/^SLUG=//p')"
    ns="$(printf -- '%s' "$probe" | sed -n 's/^NAMESPACE=//p')"
  fi

  # Build the row stream. Each helper emits `RESULT<TAB>HINT`; we prepend
  # the human label to form `LABEL|RESULT|HINT`. Empty hints carry the
  # `-` sentinel per LESSONS 2026-06-08 to survive the IFS=$'\t' read in
  # the renderers (the IFS='|' read here has the same trap shape).
  local stream=""
  local row label out s d
  # The tilde in "~/.local/share/agent-fleet/lib copied:" is a LITERAL display
  # label for the operator, NOT a path; the actual presence check resolves
  # $HOME/.local/share/agent-fleet/lib inside onboarding_check_lib_copied.
  # Same shellcheck disable rationale as preflight's identical row.
  # shellcheck disable=SC2088
  for spec in \
    "agents.config.sh present + parses:|onboarding_check_agents_config $(printf '%q' "$proj_dir")" \
    "AGENTS.md \xc2\xa7 Agent parameters block:|onboarding_check_agents_md_section $(printf '%q' "$proj_dir")" \
    "docs/backlog/README.md index present:|onboarding_check_backlog_index $(printf '%q' "$proj_dir")" \
    "~/.local/share/agent-fleet/lib copied:|onboarding_check_lib_copied" \
    "launchd plist installed (ship/groom):|onboarding_check_plists_present $(printf '%q' "$ns")" \
    "launchd labels enabled:|onboarding_check_labels_enabled $(printf '%q' "$ns")" \
    "\$CACHE_DIR/events.jsonl writable:|onboarding_check_events_writable $(printf '%q' "$slug")" \
    "gh CLI auth + push to remote:|onboarding_check_gh_auth" \
    "claude CLI on \$PATH:|onboarding_check_claude_cli" \
    "prompts SHA pinned + matches installed:|onboarding_check_prompts_sha $(printf '%q' "$proj_dir")" \
    "synthetic ship cycle (NO real PR):|onboarding_check_synthetic_cycle" \
  ; do
    label="${spec%%|*}"
    row="${spec#*|}"
    out="$(eval "$row")"
    s="${out%%	*}"
    d="${out#*	}"
    [ "$s" = "$d" ] && d=""
    stream+="$label|$s|$d"$'\n'
  done

  # Render + extract sentinel exit, then strip it before printing.
  local rendered exit_code
  if [ "$want_json" = "1" ]; then
    rendered="$(printf -- '%s' "$stream" | onboarding_check_render_json)"
  else
    rendered="$(printf -- '%s' "$stream" | onboarding_check_render_text "$proj_dir")"
  fi
  exit_code="$(printf -- '%s' "$rendered" | awk -F'\t' '/^__ONBOARDING_EXIT__/ { print $2 }')"
  printf -- '%s' "$rendered" | grep -v '^__ONBOARDING_EXIT__'
  case "$exit_code" in
    0) exit 0 ;;
    1) exit 1 ;;
    *) exit 1 ;;
  esac
}

if [ "$CMD" = "onboarding-check" ]; then
  onboarding_check "$@"
fi

# --- self-check -----------------------------------------------------------
# Ticket 0040. `fleet self-check` is a static linter that greps the kit's
# own shell (`bin/fleet`, every file under `lib/`, every `.mjs` file under
# `scripts/`) for the call-shape footprints docs/LESSONS.md warns against.
# Each pattern in the catalog is keyed to its LESSONS date so a hit in
# the output reads as "the call shape on line N is the one LESSONS
# YYYY-MM-DD documents — re-read the paragraph and fix the call." Exit
# codes: 0 = zero hits, 1 = at least one hit, 2 = usage error. When
# `FLEET_SELF_CHECK_GATE=1` is set (the local-gate / pre-push path),
# every hit ALSO emits one `self_check_failed` event to the agent-fleet
# kit-as-project events.jsonl so fleet-control / `fleet weekly` can
# render "lint debt over time" without scraping stdout.
#
# All `self_check_*` helpers are defined ABOVE the inline dispatcher
# block per LESSONS 2026-06-05 (forward-reference trap). JSON escape
# goes through `preflight_json_escape` (line ~1064) per LESSONS
# 2026-06-03 (UTF-8 sign-extension). Width comp goes through
# `preflight_visible_width` (line ~1331) per LESSONS 2026-06-05
# (bash 3.2 LC_ALL caching). `self_check()` ends with explicit
# `exit N` on every branch per LESSONS 2026-06-01 (dispatcher
# fall-through). The catalog TSV uses `-` sentinels in middle empty
# columns per LESSONS 2026-06-08 (IFS=$'\t' middle-empty-field).

# Catalog: one TSV line per pattern.
#   name<TAB>lesson_date<TAB>description<TAB>kind<TAB>approximate(0|1)
# Where `kind` selects the scanner dispatch:
#   re:<regex>             plain `grep -nE` against each source file
#   ax:<id>                custom awk handler keyed by `<id>`
# `description` is the human label rendered in the text table. The
# `-` sentinel is reserved for empty middle columns (LESSONS 2026-06-08)
# but every column here is non-empty so the sentinel does not appear.
self_check_catalog() {
  # Heredoc kept single-quoted so $ in regexes is literal — awk and
  # grep both see the bytes verbatim.
  cat <<'CATALOG'
printf-leading-dash	2026-05-28	printf leading-dash	re:printf ['"]-[^-]	0
cat-roundtrip	2026-05-27	$(cat file) round-trip	ax:cat-roundtrip	1
awk-v-multiline	2026-06-01	awk -v multi-line value	re:awk -v [A-Za-z_]+="\$\((cat|<)	1
grep-F-flag-pattern	2026-05-30	grep -F flag pattern	re:grep -[a-zA-Z]*F[a-zA-Z]* ['"]--[a-zA-Z]	0
grep-c-double-print	2026-06-01	grep -c result feeding shell math	re:grep -[a-zA-Z]*c[a-zA-Z]* .* \|\| echo 0	0
dispatcher-missing-exit	2026-06-01	dispatcher missing exit 0	ax:dispatcher-missing-exit	1
dispatcher-forward-reference	2026-06-05	dispatcher forward-reference	ax:dispatcher-forward-reference	1
json-escape-sign-extension	2026-06-03	_json_escape sign-extension	ax:json-escape-sign-extension	1
IFS-tab-empty-middle	2026-06-08	IFS=$'\t' read with empty middles	ax:IFS-tab-empty-middle	1
bash-32-lc_all-string-length	2026-06-05	bash 3.2 ${#s} on UTF-8	ax:bash-32-lc_all-string-length	1
export-in-command-substitution	2026-06-05	export inside $(...)	ax:export-in-command-substitution	1
function-shadow-coreutils	2026-05-26	tail()/head()/cat() function shadow	ax:function-shadow-coreutils	1
CATALOG
}

# List the files the scanner targets, given a kit root. Stable order
# bin/fleet → lib/*.sh → scripts/*.mjs so the row counts match the
# documented "union of kit shell-and-script source". A missing dir is
# silently skipped; the scanner just emits zero hits across nothing.
self_check_source_files() {
  local kit_root="$1"
  [ -f "$kit_root/bin/fleet" ] && printf -- '%s\n' "$kit_root/bin/fleet"
  if [ -d "$kit_root/lib" ]; then
    find "$kit_root/lib" -type f -name '*.sh' 2>/dev/null | sort
  fi
  if [ -d "$kit_root/scripts" ]; then
    find "$kit_root/scripts" -type f -name '*.mjs' 2>/dev/null | sort
  fi
}

# Awk handlers — one per `ax:<id>` catalog entry. Each handler reads a
# file path and emits one hit line per match in the shape
# `LINENO<TAB>SNIPPET`. Caller adds pattern + file context. Keeping the
# handlers in awk (and not bash regexes) means the trickier multi-line
# / function-body / dependency checks have one tool, not three.

# cat-roundtrip: `VAR=$(cat file)` somewhere AND `printf '%s' "$VAR" >`
# (or `printf "%s" "$VAR" >`) later in the SAME file. The LESSON trap
# is the byte-mutating round-trip — a bare `$(cat ...)` capture used
# only for grep/comparison is safe and we do not flag it.
self_check_ax_cat_roundtrip() {
  awk '
    function process_file(   v, i, line, write_pat) {
      for (v in captured) {
        # Build a regex matching `printf '%s' "$v" >` or similar
        # write-back patterns. We only flag if a corresponding
        # write-to-disk for the same variable name appears later
        # in the file.
        write_pat = "printf[[:space:]]+([\"'"'"']?--[\"'"'"']?[[:space:]]+)?[\"'"'"']%s[\"'"'"'][[:space:]]+\"\\$" v "\"[[:space:]]*>"
        for (i = captured[v]; i <= last_nr; i++) {
          if (match(buf[i], write_pat)) {
            printf "%s\t%d\t%s\n", cur_file, captured[v], buf[captured[v]]
            break
          }
        }
      }
    }
    FNR == 1 {
      if (cur_file != "") process_file()
      cur_file = FILENAME
      last_nr = 0
      delete buf
      delete captured
    }
    {
      buf[FNR] = $0
      last_nr = FNR
      # Skip comments.
      if ($0 ~ /^[[:space:]]*#/) next
      # Detect `VAR=$(cat ...)` or `VAR="$(cat ...)"`. Reject the
      # `cat <<` heredoc form (which is unrelated).
      if (match($0, /[A-Za-z_][A-Za-z0-9_]*=\"?\$\(cat[[:space:]]+[^<]/)) {
        s = substr($0, RSTART, RLENGTH)
        eq = index(s, "=")
        v = substr(s, 1, eq - 1)
        # Strip leading whitespace.
        sub(/^[[:space:]]+/, "", v)
        if (!(v in captured)) captured[v] = FNR
      }
    }
    END { if (cur_file != "") process_file() }
  ' "$@"
}

# dispatcher-missing-exit: function definitions (e.g. `name() {`) whose
# body's last 5 non-blank non-`}` lines do NOT contain
# `^[[:space:]]*exit [0-2][[:space:]]*$`. Approximate: closing brace
# tracking is brace-count based, so case statements / heredocs with
# stray `{` `}` may skew counts.
self_check_ax_dispatcher_missing_exit() {
  awk '
    function process_file(   i, line, fn_name, fn_line, fn_header, in_fn, nlines, j, k, has_exit) {
      # Pass 2: walk functions, check ones whose name appears as a CMD
      # dispatcher target. Trap is specific to NEW subcommand
      # functions called via inline `if [ "$CMD" = "<name>" ]; then
      # <name> "$@"; fi` — utility helpers legitimately fall through.
      in_fn = 0
      for (i = 1; i <= last_nr; i++) {
        line = buf[i]
        if (match(line, /^[a-z_][a-z_0-9]*\(\)[[:space:]]*\{?[[:space:]]*$/)) {
          if (in_fn) {
            # Flush previous function.
            has_exit = 0
            k = 0
            for (j = nlines; j >= 1 && k < 5; j--) {
              if (body[j] ~ /^[[:space:]]*$/) continue
              if (body[j] ~ /^[[:space:]]*}[[:space:]]*$/) continue
              k++
              if (body[j] ~ /exit[[:space:]]+[0-2][[:space:]]*(;;)?[[:space:]]*$/) {
                has_exit = 1; break
              }
            }
            if (!has_exit && (fn_name in dispatched)) {
              printf "%s\t%d\t%s\n", cur_file, fn_line, fn_header
            }
            in_fn = 0
            delete body
          }
          fn_name = substr(line, RSTART, RLENGTH - 2)
          gsub(/\(\)/, "", fn_name)
          gsub(/[[:space:]{]/, "", fn_name)
          fn_line = i
          fn_header = line
          in_fn = 1
          nlines = 0
          continue
        }
        if (in_fn) {
          if (line ~ /^\}[[:space:]]*$/) {
            nlines++
            body[nlines] = line
            # Flush.
            has_exit = 0
            k = 0
            for (j = nlines; j >= 1 && k < 5; j--) {
              if (body[j] ~ /^[[:space:]]*$/) continue
              if (body[j] ~ /^[[:space:]]*}[[:space:]]*$/) continue
              k++
              if (body[j] ~ /exit[[:space:]]+[0-2][[:space:]]*(;;)?[[:space:]]*$/) {
                has_exit = 1; break
              }
            }
            if (!has_exit && (fn_name in dispatched)) {
              printf "%s\t%d\t%s\n", cur_file, fn_line, fn_header
            }
            in_fn = 0
            delete body
            continue
          }
          nlines++
          body[nlines] = line
        }
      }
    }
    FNR == 1 {
      if (cur_file != "") process_file()
      cur_file = FILENAME
      last_nr = 0
      delete buf
      delete dispatched
    }
    {
      buf[FNR] = $0
      last_nr = FNR
      # Track subcommand dispatchers: `if [ "$CMD" = "<sub>" ]; then`.
      if (match($0, /\[[[:space:]]*"\$CMD"[[:space:]]*=[[:space:]]*"[^"]+"[[:space:]]*\]/)) {
        s = substr($0, RSTART, RLENGTH)
        if (match(s, /"[^"]+"[[:space:]]*\]/)) {
          tok = substr(s, RSTART, RLENGTH)
          gsub(/["[:space:]\]]/, "", tok)
          # Dispatcher target name may have `-`; the function name
          # uses `_`. Normalize: map `-` to `_` so e.g. `self-check`
          # ↔ `self_check`.
          gsub(/-/, "_", tok)
          dispatched[tok] = 1
        }
      }
    }
    END { if (cur_file != "") process_file() }
  ' "$@"
}

# dispatcher-forward-reference: build a name→line index of all
# `^[a-z_][a-z_0-9]*\(\)` headers, then for each header find call sites
# inside its body to a NAME whose definition line is LATER than the
# header's own line. Approximate: words that happen to match a known
# function name in a comment or string are still flagged. The cheap
# defense is to namespace helpers (LESSONS 2026-06-05).
self_check_ax_dispatcher_forward_reference() {
  awk '
    function process_file(   i, line, fn_name, fn_start, in_fn, tok, disp_line) {
      in_fn = 0
      for (i = 1; i <= last_nr; i++) {
        line = buf[i]
        if (match(line, /^[a-z_][a-z_0-9]*\(\)/)) {
          fn_name = substr(line, RSTART, RLENGTH - 2)
          fn_start = i
          in_fn = 1
          continue
        }
        if (!in_fn) continue
        if (line ~ /^\}[[:space:]]*$/) { in_fn = 0; continue }
        if (line ~ /^[[:space:]]*#/) continue
        if (line ~ /^[[:space:]]*$/) continue
        if (match(line, /^[[:space:]]*[a-z_][a-z_0-9]*/)) {
          tok = substr(line, RSTART, RLENGTH)
          sub(/^[[:space:]]*/, "", tok)
          if (tok == fn_name) continue
          if (tok in def_line && def_line[tok] > fn_start) {
            # Real forward-reference trap fires only when the
            # ENCLOSING function is invoked via an inline `if [
            # "$CMD" = "<sub>" ]; then <sub> "$@"; fi` dispatcher
            # that lives BEFORE the called helpers definition.
            # Without a dispatcher entry, the function is utility
            # code that runs AFTER the whole file is parsed (e.g.
            # the toplevel `fleet status` block) and forward refs
            # are safe.
            if (!(fn_name in disp_at)) continue
            disp_line = disp_at[fn_name]
            if (disp_line < def_line[tok]) {
              printf "%s\t%d\t%s\n", cur_file, i, line
            }
          }
        }
      }
    }
    FNR == 1 {
      if (cur_file != "") process_file()
      cur_file = FILENAME
      last_nr = 0
      delete buf
      delete def_line
      delete disp_at
    }
    {
      if (match($0, /^[a-z_][a-z_0-9]*\(\)/)) {
        name = substr($0, RSTART, RLENGTH - 2)
        def_line[name] = FNR
      }
      # Track dispatcher line for each subcommand: `if [ "$CMD" =
      # "<sub>" ]; then`. Map `-` to `_` so e.g. `self-check` maps
      # to the function `self_check`.
      if (match($0, /\[[[:space:]]*"\$CMD"[[:space:]]*=[[:space:]]*"[^"]+"[[:space:]]*\]/)) {
        s = substr($0, RSTART, RLENGTH)
        if (match(s, /"[^"]+"[[:space:]]*\]/)) {
          tok = substr(s, RSTART, RLENGTH)
          gsub(/["[:space:]\]]/, "", tok)
          gsub(/-/, "_", tok)
          disp_at[tok] = FNR
        }
      }
      buf[FNR] = $0
      last_nr = FNR
    }
    END { if (cur_file != "") process_file() }
  ' "$@"
}

# json-escape-sign-extension: any function named `*_json_escape` (with
# a non-empty alpha prefix) whose body does NOT contain the
# `code -ge 0` guard. The canonical `_json_escape` in lib/common.sh is
# intentionally NOT matched (no prefix) — a follow-up ticket lifts the
# guard there; this PR holds lib/common.sh byte-stable per AC#11.
self_check_ax_json_escape_sign_extension() {
  awk '
    function flush(   has_guard) {
      if (!in_fn) return
      has_guard = 0
      for (i = 1; i <= nlines; i++) {
        if (body[i] ~ /code"?[[:space:]]*-ge[[:space:]]+0/) { has_guard = 1; break }
      }
      if (!has_guard) {
        printf "%s\t%d\t%s\n", cur_file, fn_line, fn_header
      }
      in_fn = 0
      nlines = 0
      delete body
    }
    FNR == 1 {
      flush()
      cur_file = FILENAME
    }
    {
      if (match($0, /^[a-z_][a-z_0-9]*_json_escape\(\)/)) {
        flush()
        name = substr($0, RSTART, RLENGTH - 2)
        if (name == "_json_escape") next
        in_fn = 1
        fn_line = FNR
        fn_header = $0
        nlines = 0
        next
      }
      if (in_fn) {
        if ($0 ~ /^\}[[:space:]]*$/) {
          flush()
          next
        }
        nlines++
        body[nlines] = $0
      }
    }
    END { flush() }
  ' "$@"
}

# IFS-tab-empty-middle: `IFS=$'\t' read -r v1 v2 v3 v4 [v5 ...]` (4+
# names) where the SAME file does NOT contain a `[ "$X" = "-" ]`-style
# sentinel remap on any of the captured variables. Approximate: a file
# may legitimately read 4 fields where the middle columns CANNOT be
# empty by construction. The cheap defense is the sentinel.
self_check_ax_IFS_tab_empty_middle() {
  awk '
    function process_file(   i, line) {
      for (i = 1; i <= last_nr; i++) {
        line = buf[i]
        if (match(line, /IFS=\$'"'"'\\t'"'"'[[:space:]]+read[[:space:]]+-r[[:space:]]+[A-Za-z_][A-Za-z0-9_]*([[:space:]]+[A-Za-z_][A-Za-z0-9_]*){3,}/)) {
          if (!sentinel_seen) {
            printf "%s\t%d\t%s\n", cur_file, i, line
          }
        }
      }
    }
    FNR == 1 {
      if (cur_file != "") process_file()
      cur_file = FILENAME
      sentinel_seen = 0
      last_nr = 0
      delete buf
    }
    {
      if ($0 ~ /=[[:space:]]*"-"/) sentinel_seen = 1
      if ($0 ~ /"-"[[:space:]]*\][[:space:]]*&&/) sentinel_seen = 1
      buf[FNR] = $0
      last_nr = FNR
    }
    END { if (cur_file != "") process_file() }
  ' "$@"
}

# bash-32-lc_all-string-length: a function body that ALSO contains
# `LC_ALL=` AND uses `${#var}` or `${var:N:1}` for string-length /
# substring extraction. Approximate: a function may legitimately set
# LC_ALL for an external command and use ${#s} on a known-ASCII value.
self_check_ax_bash_32_lc_all_string_length() {
  awk '
    function flush(   has_lc, has_lenop) {
      if (!in_fn) return
      has_lc = 0; has_lenop = 0
      for (i = 1; i <= nlines; i++) {
        # Skip comment-only lines — references to ${#s} / LC_ALL=
        # inside a # comment are documentation, not a real trap.
        if (body[i] ~ /^[[:space:]]*#/) continue
        if (body[i] ~ /LC_ALL=[A-Za-z_]/) has_lc = 1
        if (body[i] ~ /\$\{#[A-Za-z_][A-Za-z0-9_]*\}/) has_lenop = 1
        if (body[i] ~ /\$\{[A-Za-z_][A-Za-z0-9_]*:[0-9ij]+:1\}/) has_lenop = 1
      }
      if (has_lc && has_lenop) {
        printf "%s\t%d\t%s\n", cur_file, fn_line, fn_header
      }
      in_fn = 0
      nlines = 0
      delete body
    }
    FNR == 1 {
      flush()
      cur_file = FILENAME
    }
    {
      if (match($0, /^[a-z_][a-z_0-9]*\(\)[[:space:]]*\{?[[:space:]]*$/)) {
        flush()
        in_fn = 1
        fn_line = FNR
        fn_header = $0
        nlines = 0
        next
      }
      if (in_fn) {
        if ($0 ~ /^\}[[:space:]]*$/) {
          flush()
          next
        }
        nlines++
        body[nlines] = $0
      }
    }
    END { flush() }
  ' "$@"
}

# export-in-command-substitution: any `export FOO=` that lives inside a
# `$( ... )` block. Detect by tracking `$(` open / `)` close on a
# line-by-line basis. Approximate: heredocs and quoted parens may skew
# the depth count.
self_check_ax_export_in_command_substitution() {
  # Fast path: only walk per-char on lines that COULD change the
  # depth. Lines without `$(` or `)` cannot mutate depth, so we
  # short-circuit them and only check for `export …` matches when
  # depth > 0.
  awk '
    function count_substr(s, t,    n, p) {
      n = 0
      p = index(s, t)
      while (p > 0) {
        n++
        s = substr(s, p + length(t))
        p = index(s, t)
      }
      return n
    }
    FNR == 1 { cur_file = FILENAME; depth = 0 }
    {
      line = $0
      opens = count_substr(line, "$(")
      closes = count_substr(line, ")")
      # Strip the `)` count by the `$(` count (each `$(` consumes a
      # matching `)` later — but on this line specifically we cannot
      # match. Use a simple depth bookkeeping: depth in/out per line.
      depth_in = depth
      if (opens > 0) depth += opens
      if (closes > 0) depth -= closes
      if (depth < 0) depth = 0
      # We flag exports if the line is INSIDE a `$( ... )` block
      # (depth_in > 0 OR opens > 0 with the export AFTER the open
      # before the matching close). Cheap approximation: depth_in > 0.
      if (depth_in > 0) {
        if (line ~ /\bexport[[:space:]]+[A-Z_][A-Z0-9_]*=/ \
            || line ~ /^[[:space:]]*export[[:space:]]+[A-Z_]/) {
          printf "%s\t%d\t%s\n", cur_file, FNR, line
        }
      }
    }
  ' "$@"
}

# function-shadow-coreutils: a function definition for a coreutils
# binary name AND a shell-out to the same binary in the same file.
# Approximate: the shell-out might be intentional (e.g. via `command
# tail` to bypass the shadow), which we cannot detect statically.
self_check_ax_function_shadow_coreutils() {
  awk '
    function process_file(   name, i, line, re) {
      for (name in def_line) {
        for (i = 1; i <= last_nr; i++) {
          if (i == def_line[name]) continue
          line = buf[i]
          if (line ~ /^[[:space:]]*#/) continue
          re = "(^|[^A-Za-z0-9_/])" name "[[:space:]]+-[a-zA-Z]"
          if (match(line, re)) {
            printf "%s\t%d\t%s\n", cur_file, def_line[name], def_header[name]
            break
          }
        }
      }
    }
    BEGIN {
      split("tail head cat sort uniq find grep awk sed cut tr wc", names, " ")
      for (k in names) want[names[k]] = 1
    }
    FNR == 1 {
      if (cur_file != "") process_file()
      cur_file = FILENAME
      last_nr = 0
      delete buf
      delete def_line
      delete def_header
    }
    {
      buf[FNR] = $0
      last_nr = FNR
      if (match($0, /^[a-z]+\(\)/)) {
        name = substr($0, RSTART, RLENGTH - 2)
        if (name in want) {
          def_line[name] = FNR
          def_header[name] = $0
        }
      }
    }
    END { if (cur_file != "") process_file() }
  ' "$@"
}

# Scan ONE pattern across an arbitrary list of files (passed as $@).
# Each pattern runs ONE subprocess chain over all files (awk + optional
# grep), so total scan cost is ~12 subprocess pairs not ~12*N pairs.
# Echoes one hit per line in the shape
# `PATTERN_NAME<TAB>LESSON_DATE<TAB>FILE<TAB>LINENO<TAB>SNIPPET<TAB>APPROX`
# where APPROX is `0` or `1`. Caller renders or JSON-emits.
self_check_scan_one() {
  local name="$1" lesson="$2" desc="$3" kind="$4" approx="$5"
  shift 5
  case "$kind" in
    re:*)
      local re="${kind#re:}"
      local skip_re=""
      case "$name" in
        printf-leading-dash) skip_re='printf -- |printf -v ' ;;
        grep-F-flag-pattern) skip_re='grep -[a-zA-Z]*F[a-zA-Z]* -- ' ;;
        cat-roundtrip) skip_re='cat <<' ;;
      esac
      # grep -nH prints `file:lineno:content`. -E for ERE.
      grep -nHE -- "$re" "$@" 2>/dev/null | awk \
        -v name="$name" -v lesson="$lesson" -v approx="$approx" \
        -v skip="$skip_re" '
        {
          line = $0
          if (skip != "" && match(line, skip)) next
          # `file:line:snippet` — file may itself contain `:` so use
          # the FIRST two colons only.
          c1 = index(line, ":")
          rest = substr(line, c1 + 1)
          c2 = index(rest, ":")
          file = substr(line, 1, c1 - 1)
          lineno = substr(rest, 1, c2 - 1)
          snippet = substr(rest, c2 + 1)
          # Cheap comment-line skip: a leading `#` (whitespace OK)
          # means the call shape lives inside a comment, not actual
          # code. LESSONS paragraphs in code comments would otherwise
          # be flagged on every scan.
          if (snippet ~ /^[[:space:]]*#/) next
          printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, lesson, file, lineno, snippet, approx
        }'
      ;;
    ax:*)
      local id="${kind#ax:}"
      case "$id" in
        cat-roundtrip) self_check_ax_cat_roundtrip "$@" ;;
        dispatcher-missing-exit) self_check_ax_dispatcher_missing_exit "$@" ;;
        dispatcher-forward-reference) self_check_ax_dispatcher_forward_reference "$@" ;;
        json-escape-sign-extension) self_check_ax_json_escape_sign_extension "$@" ;;
        IFS-tab-empty-middle) self_check_ax_IFS_tab_empty_middle "$@" ;;
        bash-32-lc_all-string-length) self_check_ax_bash_32_lc_all_string_length "$@" ;;
        export-in-command-substitution) self_check_ax_export_in_command_substitution "$@" ;;
        function-shadow-coreutils) self_check_ax_function_shadow_coreutils "$@" ;;
      esac | awk \
        -v name="$name" -v lesson="$lesson" -v approx="$approx" \
        -F'\t' '
        NF >= 2 && $1 != "" {
          printf "%s\t%s\t%s\t%s\t%s\t%s\n", name, lesson, $1, $2, $3, approx
        }'
      ;;
  esac
}

# Render the text table: one row per pattern, columns:
#   TRAP        LESSON       FILES SCANNED   HITS   (approximate suffix)
# All formatting happens in a single awk pass that consumes the hits
# TSV stream + the filtered catalog — avoids the per-row wc+awk
# subprocess fan-out the original implementation incurred. Label widths
# are byte-based; the catalog labels are ASCII except for the trailing
# `≈` (U+2248, 3 bytes) and we add the 3-byte adjustment explicitly.
self_check_render_text() {
  local hits_file="$1" patterns_seen="$2" n_files="$3" lesson_min="$4" lesson_max="$5"
  # Filter catalog by patterns_seen (space-separated names) and stream
  # both the filtered catalog + hits_file into one awk that builds
  # per-pattern counts and renders. Catalog lines are tagged "C\t…",
  # hits lines are tagged "H\t…", so awk can tell them apart in one
  # pass.
  {
    self_check_catalog | awk -v want="$patterns_seen" '
      BEGIN {
        n = split(want, a, " ")
        for (i = 1; i <= n; i++) keep[a[i]] = 1
      }
      {
        split($0, f, "\t")
        if (f[1] in keep) print "C\t" $0
      }'
    awk -F'\t' '{ print "H\t" $0 }' "$hits_file"
  } | awk -v n_files="$n_files" \
        -v lesson_min="$lesson_min" -v lesson_max="$lesson_max" \
        -F'\t' '
    {
      tag = $1
      if (tag == "C") {
        # f1=name f2=lesson f3=desc f4=kind f5=approx
        cat_idx++
        c_name[cat_idx] = $2
        c_lesson[cat_idx] = $3
        c_desc[cat_idx] = $4
        c_approx[cat_idx] = $6
        order[$2] = cat_idx
      } else if (tag == "H") {
        # f1=pattern f2=lesson f3=file f4=line f5=match f6=approx
        n_hits[$2]++
        if (!($2 in first_file)) {
          first_file[$2] = $4
          first_line[$2] = $5
        }
        total_hits++
      }
    }
    function pad_right(s, w,    cur, pad) {
      cur = length(s)
      # `≈` adds 3 bytes for 1 visible col — adjust if present.
      if (index(s, "≈")) cur -= 2
      pad = w - cur
      if (pad < 0) pad = 0
      printf "%s", s
      while (pad-- > 0) printf " "
    }
    END {
      # Header.
      pad_right("TRAP", 38)
      pad_right("LESSON", 14)
      pad_right("FILES SCANNED", 15)
      printf "HITS\n"
      # Body.
      for (i = 1; i <= cat_idx; i++) {
        label = c_desc[i]
        if (c_approx[i] == "1") label = label " ≈"
        pad_right(label, 38)
        pad_right(c_lesson[i], 14)
        pad_right(n_files "", 15)
        nh = n_hits[c_name[i]] + 0
        if (nh > 0) {
          printf "%d  ← %s:%s\n", nh, first_file[c_name[i]], first_line[c_name[i]]
        } else {
          printf "0\n"
        }
      }
      printf "\n"
      hit_word = (total_hits == 1) ? "hit" : "hits"
      n_patterns = cat_idx
      if (lesson_min != "" && lesson_max != "" && lesson_min != lesson_max) {
        printf "self-check: %d %s across %d patterns (LESSONS %s..%s)\n", \
          total_hits, hit_word, n_patterns, lesson_min, lesson_max
      } else {
        printf "self-check: %d %s across %d patterns\n", \
          total_hits, hit_word, n_patterns
      }
    }'
}

# Render JSON: one object per hit (NDJSON-style). Empty hits file → no
# output. Approximate flag flows through.
self_check_render_json() {
  local hits_file="$1"
  local name lesson file lineno snippet approx
  while IFS=$'\t' read -r name lesson file lineno snippet approx; do
    [ -z "$name" ] && continue
    local approx_json="false"
    [ "$approx" = "1" ] && approx_json="true"
    printf -- '{"pattern":"%s","lesson":"%s","file":"%s","line":%s,"match":"%s","approximate":%s}\n' \
      "$(preflight_json_escape "$name")" \
      "$(preflight_json_escape "$lesson")" \
      "$(preflight_json_escape "$file")" \
      "$lineno" \
      "$(preflight_json_escape "$snippet")" \
      "$approx_json"
  done < "$hits_file"
}

# Emit one self_check_failed event per hit when FLEET_SELF_CHECK_GATE=1
# is set. Sources lib/common.sh in a subshell so SLUG / CACHE_DIR /
# FLEET_PHASE scope to this emit only. Mirrors lessons_prune_emit_event
# (~line 10920) and prompts_revert_emit_event (~line 534).
self_check_emit_event() {
  local name="$1" lesson="$2" file="$3" lineno="$4"
  local lib_root; lib_root="$( cd "$( dirname "$0" )/.." && pwd )"
  [ -f "$lib_root/lib/common.sh" ] || return 0
  local cache_dir="$HOME/.cache/agent-fleet-agent"
  mkdir -p "$cache_dir"
  (
    export SLUG="agent-fleet"
    export CACHE_DIR="$cache_dir"
    export FLEET_PHASE="self-check"
    # shellcheck disable=SC1090
    source "$lib_root/lib/common.sh" >/dev/null 2>&1
    fleet_emit_event self_check_failed \
      "pattern=$name" \
      "lesson_date=$lesson" \
      "file=$file" \
      "line=$lineno"
  ) || true
}

self_check() {
  shift  # drop the leading "self-check"

  local want_json=0 want_list=0 want_help=0 want_pattern=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      --list) want_list=1; shift ;;
      --pattern)
        want_pattern="${2:-}"; shift 2 || true ;;
      --pattern=*)
        want_pattern="${1#--pattern=}"; shift ;;
      -h|--help) want_help=1; shift ;;
      --) shift; break ;;
      -*)
        printf -- 'self-check: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        printf -- 'self-check: unexpected positional argument %s\n' "$1" >&2
        exit 2 ;;
    esac
  done

  if [ "$want_help" = "1" ]; then
    cat <<'USAGE'
fleet self-check — static linter for LESSONS-derived call-shape traps.

Usage:
  fleet self-check                  scan the kit's own shell and print the table
  fleet self-check --json           one JSON object per hit (NDJSON)
  fleet self-check --list           list the catalog of patterns + LESSONS dates
  fleet self-check --pattern <name> restrict the scan to a single pattern
  fleet self-check --help           this banner

Exit codes: 0 = zero hits, 1 = at least one hit, 2 = usage error.

When FLEET_SELF_CHECK_GATE=1 is exported (the local-gate / pre-push call
shape), every hit ALSO emits one self_check_failed event to the
agent-fleet kit-as-project events.jsonl. Unset env = no event.
USAGE
    exit 0
  fi

  # --list: print the catalog and exit, no scan.
  if [ "$want_list" = "1" ]; then
    local name lesson desc kind approx
    while IFS=$'\t' read -r name lesson desc kind approx; do
      [ -z "$name" ] && continue
      local suffix=""
      [ "$approx" = "1" ] && suffix=" ≈"
      printf -- '%-34s %s  %s%s\n' "$name" "$lesson" "$desc" "$suffix"
    done < <(self_check_catalog)
    exit 0
  fi

  # Validate --pattern <name>: must be in the catalog.
  if [ -n "$want_pattern" ]; then
    local known
    known="$(self_check_catalog | awk -F'\t' -v p="$want_pattern" '$1 == p { print $1; exit }')"
    if [ -z "$known" ]; then
      printf -- 'self-check: unknown pattern "%s" (run --list to see available)\n' \
        "$want_pattern" >&2
      exit 2
    fi
  fi

  # Resolve the kit root. FLEET_SELF_CHECK_ROOT overrides for tests.
  local kit_root="${FLEET_SELF_CHECK_ROOT:-}"
  if [ -z "$kit_root" ]; then
    kit_root="$( cd "$( dirname "$0" )/.." && pwd )"
  fi

  # Build the list of files to scan. We use a bash array so each
  # pattern's awk/grep gets the full file list as separate args.
  local files=()
  local f
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    files+=("$f")
  done < <(self_check_source_files "$kit_root")
  local n_files="${#files[@]}"

  # Walk the catalog, run each pattern across the full file list in one
  # subprocess chain. Run patterns in PARALLEL via `&` + a per-pattern
  # tmp file so the 12 awk/grep invocations don't serialize (a stock
  # macOS laptop has 8+ cores and the scan workload is CPU-bound). The
  # per-pattern outputs are concatenated after `wait` in the catalog
  # order so the renderer sees a stable hits stream.
  local hits_file; hits_file="$(mktemp)"
  : > "$hits_file"
  local tmpdir; tmpdir="$(mktemp -d)"
  local patterns_seen=""
  local lesson_min="" lesson_max=""
  local name lesson desc kind approx
  local pat_idx=0
  local -a pat_files=()
  while IFS=$'\t' read -r name lesson desc kind approx; do
    [ -z "$name" ] && continue
    if [ -n "$want_pattern" ] && [ "$want_pattern" != "$name" ]; then
      continue
    fi
    patterns_seen="$patterns_seen $name"
    if [ -z "$lesson_min" ] || [ "$lesson" \< "$lesson_min" ]; then lesson_min="$lesson"; fi
    if [ -z "$lesson_max" ] || [ "$lesson" \> "$lesson_max" ]; then lesson_max="$lesson"; fi
    if [ "$n_files" -gt 0 ]; then
      local pat_out="$tmpdir/pat-$pat_idx"
      pat_files+=("$pat_out")
      self_check_scan_one "$name" "$lesson" "$desc" "$kind" "$approx" "${files[@]}" > "$pat_out" &
      pat_idx=$(( pat_idx + 1 ))
    fi
  done < <(self_check_catalog)
  wait
  # Stable concatenation in catalog order.
  if [ "$pat_idx" -gt 0 ]; then
    cat "${pat_files[@]}" > "$hits_file"
  fi
  rm -rf "$tmpdir"

  # Strip patterns_seen leading space.
  patterns_seen="${patterns_seen# }"

  # Total hit count.
  local total_hits
  total_hits="$(awk 'NF { n++ } END { print n+0 }' "$hits_file")"

  # Render.
  if [ "$want_json" = "1" ]; then
    self_check_render_json "$hits_file"
  else
    self_check_render_text "$hits_file" "$patterns_seen" "$n_files" "$lesson_min" "$lesson_max"
  fi

  # Telemetry: emit one self_check_failed event per hit under the gate
  # env. Path is OUTSIDE any command substitution per LESSONS
  # 2026-06-05 so the function-scope exports inside the subshell apply
  # cleanly (the helper itself runs in a `( ... )` subshell that
  # exports SLUG/CACHE_DIR/FLEET_PHASE only for the fleet_emit_event
  # call — caller's environment is unaffected).
  if [ "${FLEET_SELF_CHECK_GATE:-}" = "1" ] && [ "$total_hits" -gt 0 ]; then
    local h_name h_lesson h_file h_line h_snippet h_approx
    while IFS=$'\t' read -r h_name h_lesson h_file h_line h_snippet h_approx; do
      [ -z "$h_name" ] && continue
      # h_snippet and h_approx are captured to consume the tab-delimited
      # row in full but are intentionally unused — the event payload is
      # narrow on purpose (pattern, lesson_date, file, line).
      _=$h_snippet
      _=$h_approx
      self_check_emit_event "$h_name" "$h_lesson" "$h_file" "$h_line"
    done < "$hits_file"
  fi

  rm -f "$hits_file"

  if [ "$total_hits" -gt 0 ]; then
    exit 1
  fi
  exit 0
}

if [ "$CMD" = "self-check" ]; then
  self_check "$@"
fi

# Hand-rolled JSON string escape — same intent as common.sh _json_escape but
# bin/fleet doesn't source common.sh. Keep this in sync if either grows.
doctor_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *) printf -v code '%d' "'$ch"
         if [ "$code" -lt 32 ]; then printf -v out '%s\\u%04x' "$out" "$code"
         else out+="$ch"; fi ;;
    esac
  done
  printf '%s' "$out"
}

# Run all seven checks for one manifest. Echoes one "name|status|reason" line
# per check on stdout. Caller renders or JSON-encodes.
doctor_run_checks() {
  local manifest="$1"
  local proj_dir; proj_dir="$(dirname "$manifest")"
  local slug="" ns="" sc="" eng="0" repo_url=""

  # check: config -- subshell so vars don't leak across projects
  local cfg_status="PASS" cfg_reason=""
  local probe
  probe=$(
    # shellcheck disable=SC1090  # discovered at runtime
    ( source "$manifest" 2>/dev/null
      echo "SLUG=${SLUG:-}"
      echo "NAMESPACE=${NAMESPACE:-com.fleet.${SLUG:-x}}"
      echo "SELF_CANCEL=${SELF_CANCEL:-}"
      echo "ENG_ENABLED=${ENG_ENABLED:-0}"
      echo "REPO_URL=${REPO_URL:-}"
      echo "PROMPTS_SHA=${PROMPTS_SHA:-}"
      echo "TRAINEE_PR_COUNT=${TRAINEE_PR_COUNT:-0}"
    ) 2>/dev/null
  ) || true
  slug="$(echo "$probe" | sed -n 's/^SLUG=//p')"
  ns="$(echo "$probe" | sed -n 's/^NAMESPACE=//p')"
  sc="$(echo "$probe" | sed -n 's/^SELF_CANCEL=//p')"
  eng="$(echo "$probe" | sed -n 's/^ENG_ENABLED=//p')"
  repo_url="$(echo "$probe" | sed -n 's/^REPO_URL=//p')"
  local pinned_sha; pinned_sha="$(echo "$probe" | sed -n 's/^PROMPTS_SHA=//p')"
  local trainee_cap; trainee_cap="$(echo "$probe" | sed -n 's/^TRAINEE_PR_COUNT=//p')"
  if [ -z "$slug" ] || [ -z "$repo_url" ] || [ -z "$sc" ]; then
    cfg_status="FAIL"
    cfg_reason="manifest missing required vars (SLUG/REPO_URL/SELF_CANCEL)"
  fi
  echo "config|$cfg_status|$cfg_reason"
  # Tell the caller which slug we resolved so it can name the block.
  echo "__SLUG__|$slug|"

  # check: self_cancel
  local sc_status="PASS" sc_reason="" days=""
  if [ -z "$sc" ]; then
    sc_status="FAIL"; sc_reason="SELF_CANCEL not set"
  else
    days=$(days_until "$sc")
    if [ "$days" -lt 0 ]; then
      sc_status="FAIL"; sc_reason="SELF_CANCEL expired ${days}d ago ($sc)"
    elif [ "$days" -le 3 ]; then
      sc_status="WARN"; sc_reason="SELF_CANCEL within ${days}d ($sc)"
    fi
  fi
  echo "self_cancel|$sc_status|$sc_reason"

  # check: agents_md — file present + "## Agent parameters" section
  local am="$proj_dir/AGENTS.md"
  local am_status="PASS" am_reason=""
  if [ ! -f "$am" ]; then
    am_status="FAIL"; am_reason="AGENTS.md not found at $am"
  elif ! grep -q '^##[[:space:]]\+Agent parameters' "$am"; then
    am_status="FAIL"; am_reason="AGENTS.md missing '## Agent parameters' section"
  fi
  echo "agents_md|$am_status|$am_reason"

  # check: backlog — README.md and check-backlog.mjs
  local bl_status="PASS" bl_reason="" missing=""
  [ -f "$proj_dir/docs/backlog/README.md" ] || missing="$missing docs/backlog/README.md"
  [ -f "$proj_dir/scripts/check-backlog.mjs" ] || missing="$missing scripts/check-backlog.mjs"
  if [ -n "$missing" ]; then
    bl_status="FAIL"; bl_reason="missing:${missing}"
  fi
  echo "backlog|$bl_status|$bl_reason"

  # check: launchd_loaded -- ship/groom/review always expected; eng iff ENG_ENABLED
  local ld_status="PASS" ld_reason=""
  local jobs="ship groom review"
  [ "$eng" = "1" ] && jobs="$jobs eng"
  local missing_jobs=""
  for j in $jobs; do
    if ! launchctl print "$DOMAIN/$ns.agent-$j" >/dev/null 2>&1; then
      missing_jobs="$missing_jobs $j"
    fi
  done
  if [ -n "$missing_jobs" ]; then
    ld_status="FAIL"; ld_reason="launchd jobs not loaded:${missing_jobs}"
  fi
  echo "launchd_loaded|$ld_status|$ld_reason"

  # check: installed_lib_sha
  local ls_status="PASS" ls_reason=""
  if [ -n "${FLEET_SKIP_INSTALLED_LIB_SHA:-}" ]; then
    ls_status="WARN"; ls_reason="skipped via FLEET_SKIP_INSTALLED_LIB_SHA"
  else
    local installed_dir="$HOME/.local/share/agent-fleet/lib"
    local repo_dir; repo_dir="$(doctor_repo_lib)"
    if [ ! -d "$installed_dir" ]; then
      ls_status="WARN"; ls_reason="$installed_dir not present — run install.sh"
    elif [ ! -d "$repo_dir" ]; then
      ls_status="WARN"; ls_reason="repo lib/ not resolvable from $0"
    else
      local installed_sha repo_sha
      installed_sha="$(doctor_lib_sha "$installed_dir")"
      repo_sha="$(doctor_lib_sha "$repo_dir")"
      if [ -z "$installed_sha" ] || [ -z "$repo_sha" ]; then
        ls_status="WARN"; ls_reason="could not compute one of the lib SHAs"
      elif [ "$installed_sha" != "$repo_sha" ]; then
        ls_status="WARN"
        ls_reason="installed lib SHA differs from repo lib SHA — reinstall kit"
      fi
    fi
  fi
  echo "installed_lib_sha|$ls_status|$ls_reason"

  # check: gh_auth
  local gh_status="PASS" gh_reason=""
  if ! command -v gh >/dev/null 2>&1; then
    gh_status="FAIL"; gh_reason="gh CLI not installed"
  elif ! gh auth status >/dev/null 2>&1; then
    gh_status="FAIL"; gh_reason="gh auth status failed — run gh auth login"
  fi
  echo "gh_auth|$gh_status|$gh_reason"

  # check: prompts_pinned (ticket 0005)
  # Compare the manifest's PROMPTS_SHA against the kit's current prompts/ SHA.
  # PASS = matches, WARN = unset (operator hasn't pinned yet — non-fatal),
  # FAIL = mismatch (a reinstall has drifted behavior; operator needs to
  # acknowledge by bumping the pin, or revert).
  local pp_status="PASS" pp_reason="" current_sha=""
  current_sha="$(fleet_prompts_sha 2>/dev/null || echo "")"
  if [ -z "$current_sha" ]; then
    pp_status="WARN"; pp_reason="could not compute current prompts SHA"
  elif [ -z "$pinned_sha" ]; then
    pp_status="WARN"; pp_reason="PROMPTS_SHA unset — re-run install.sh to stamp"
  elif [ "$pinned_sha" != "$current_sha" ]; then
    pp_status="FAIL"
    pp_reason="pinned=$pinned_sha actual=$current_sha — reinstall kit to bump"
  fi
  echo "prompts_pinned|$pp_status|$pp_reason"

  # check: trainee_mode (ticket 0014)
  # Surfaces whether the project still requires manual operator merge on
  # feature PRs. PASS = disabled (TRAINEE_PR_COUNT unset/0) or graduated
  # (no PRs remain). WARN = active, with the remaining-count in the
  # reason string so the operator sees "trainee mode active: N PRs
  # remaining" without having to crack open the manifest. FAIL is reserved
  # — trainee mode being active is informational, not an error.
  local tm_status="PASS" tm_reason=""
  case "$trainee_cap" in
    ''|0|*[!0-9]*)
      : ;;  # disabled -> PASS, no reason
    *)
      # Compute merged feat/ PR count via gh (best-effort).
      local merged=0 raw=""
      if command -v gh >/dev/null 2>&1; then
        local repo_slug; repo_slug="$(echo "$repo_url" | sed -E 's#https?://github.com/##; s#\.git$##')"
        raw="$(gh pr list \
                  --state merged \
                  --search "head:feat/ base:main" \
                  --json number \
                  --limit 100 \
                  ${repo_slug:+--repo "$repo_slug"} \
                2>/dev/null || true)"
        if [ -n "$raw" ] && [ "$raw" != "[]" ]; then
          if command -v jq >/dev/null 2>&1; then
            merged="$(printf '%s' "$raw" | jq 'length' 2>/dev/null || echo 0)"
          else
            merged="$(printf '%s' "$raw" | tr -cd '{' | wc -c | tr -d ' ')"
          fi
        fi
      fi
      case "$merged" in ''|*[!0-9]*) merged=0 ;; esac
      local remaining=$(( trainee_cap - merged ))
      [ "$remaining" -lt 0 ] && remaining=0
      if [ "$remaining" -gt 0 ]; then
        tm_status="WARN"
        tm_reason="trainee mode active: $remaining PRs remaining (cap=$trainee_cap)"
      else
        tm_reason="trainee mode graduated (cap=$trainee_cap, $merged merged)"
      fi
      ;;
  esac
  echo "trainee_mode|$tm_status|$tm_reason"

  # check: events_size (ticket 0016)
  # Surfaces the health of $CACHE_DIR/events.jsonl per project:
  #   PASS when the file is under FLEET_EVENTS_MAX_BYTES (default 1 MiB) OR
  #        the events.jsonl.archive directory shows a rotation marker file
  #        mtime within the last 7 days (rotation is doing its job).
  #   WARN when the file is at/above the threshold AND no recent rotation
  #        marker exists — `lib/common.sh` will rotate on the next emit,
  #        but if a host has gone quiet (no agents firing) the file may be
  #        oversized for a while and the operator should know.
  #   FAIL when ANY line in events.jsonl does not parse as JSON. Best-
  #        effort: a missing file is PASS (nothing to check). The malformed
  #        case never aborts the doctor pass — we always emit the row.
  local es_status="PASS" es_reason=""
  local es_cache="$HOME/.cache/${slug}-agent"
  local es_events="$es_cache/events.jsonl"
  local es_archive_dir="$es_cache/events.jsonl.archive"
  local es_max="${FLEET_EVENTS_MAX_BYTES:-1048576}"
  if [ -f "$es_events" ]; then
    # Malformed-line check first: any single line failing JSON.parse promotes
    # to FAIL regardless of size. We use python3 (ships with macOS Command
    # Line Tools) to avoid a node hard-dep here; fall back to node if python3
    # is missing. If neither exists we silently skip the parse check (PASS).
    local es_bad=""
    if command -v python3 >/dev/null 2>&1; then
      es_bad="$(python3 - "$es_events" <<'PY' 2>/dev/null || true
import json, sys
path = sys.argv[1]
try:
  with open(path, encoding="utf-8") as f:
    for i, line in enumerate(f, start=1):
      s = line.strip()
      if not s:
        continue
      try:
        json.loads(s)
      except Exception:
        print(i)
        break
except Exception:
  pass
PY
)"
    elif command -v node >/dev/null 2>&1; then
      es_bad="$(node -e '
        const fs = require("fs");
        const lines = fs.readFileSync(process.argv[1], "utf8").split("\n");
        for (let i = 0; i < lines.length; i++) {
          const s = lines[i].trim();
          if (!s) continue;
          try { JSON.parse(s); }
          catch (e) { console.log(i + 1); process.exit(0); }
        }
      ' "$es_events" 2>/dev/null || true)"
    fi
    if [ -n "$es_bad" ]; then
      es_status="FAIL"
      es_reason="events.jsonl line $es_bad does not parse as JSON"
    else
      # Size check + rotation-marker freshness.
      local es_size
      es_size=$(stat -f %z "$es_events" 2>/dev/null || stat -c %s "$es_events" 2>/dev/null || echo 0)
      if [ "$es_size" -ge "$es_max" ]; then
        # Look for a recent (< 7d) archive file: a rotation has fired
        # recently and the next emit will rotate this one too.
        local es_now es_recent=""
        es_now=$(date -u +%s)
        if [ -d "$es_archive_dir" ]; then
          local f
          for f in "$es_archive_dir"/*.jsonl; do
            [ -f "$f" ] || continue
            local fm fage
            fm=$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)
            fage=$(( es_now - fm ))
            if [ "$fage" -lt 604800 ]; then
              es_recent="$f"
              break
            fi
          done
        fi
        if [ -z "$es_recent" ]; then
          es_status="WARN"
          es_reason="events.jsonl is ${es_size}B (>= ${es_max}B) with no rotation in the last 7d"
        fi
      fi
    fi
  fi
  echo "events_size|$es_status|$es_reason"

  # check: groom_cadence (ticket 0007)
  # Surfaces whether `lib/groom.sh` has throttled itself because the
  # backlog ran dry. The signal is the per-slug marker file
  # `$CACHE_DIR/groom-slowed-since` written by fleet_check_groom_cadence.
  # PASS = no marker, OR marker is stale (>=12h old → next groom will
  # clear it and proceed). WARN = marker is fresh; the reason string
  # carries the marker timestamp so operators see the throttle's age.
  # We never FAIL here — throttling is by design, not an error.
  local gc_status="PASS" gc_reason=""
  local gc_marker="$HOME/.cache/${slug}-agent/groom-slowed-since"
  if [ -f "$gc_marker" ]; then
    local gc_now gc_mtime gc_age
    gc_now=$(date -u +%s)
    gc_mtime=$(stat -f %m "$gc_marker" 2>/dev/null || stat -c %Y "$gc_marker" 2>/dev/null || echo "$gc_now")
    gc_age=$(( gc_now - gc_mtime ))
    if [ "$gc_age" -lt 43200 ]; then
      local gc_ts; gc_ts="$(cat "$gc_marker" 2>/dev/null || echo "?")"
      gc_status="WARN"
      gc_reason="groom throttled since $gc_ts (empty_backlog; ${gc_age}s of 12h floor)"
    fi
  fi
  echo "groom_cadence|$gc_status|$gc_reason"
}

# Build the per-project block (human form). Reads check rows on stdin, decides
# the project status (FAIL > WARN > PASS), and prints one block.
doctor_render_human() {
  local slug="$1"
  local rows="$2"   # newline-joined name|status|reason lines
  local worst="PASS"
  while IFS='|' read -r name status reason; do
    [ -z "$name" ] && continue
    [ "$name" = "__SLUG__" ] && continue
    if [ "$status" = "FAIL" ]; then worst="FAIL"
    elif [ "$status" = "WARN" ] && [ "$worst" != "FAIL" ]; then worst="WARN"
    fi
  done <<<"$rows"

  local color="$c_grn"
  [ "$worst" = "WARN" ] && color="$c_ylw"
  [ "$worst" = "FAIL" ] && color="$c_red"
  printf '%b[%s]%b %s\n' "$color" "$worst" "$c_rst" "$slug"
  while IFS='|' read -r name status reason; do
    [ -z "$name" ] && continue
    [ "$name" = "__SLUG__" ] && continue
    if [ "$status" != "PASS" ]; then
      printf '  %-18s %s  %s\n' "$name" "$status" "$reason"
    else
      printf '  %-18s %s\n' "$name" "$status"
    fi
  done <<<"$rows"
  echo
}

doctor() {
  local want_json=0 slug_filter=""
  shift  # drop the leading "doctor"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      --slug) slug_filter="${2:-}"; shift 2 ;;
      --slug=*) slug_filter="${1#--slug=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet doctor — diagnose every installed project (PASS/WARN/FAIL)

Usage:
  fleet doctor               survey FLEET_DISCOVERY_ROOT (default ~/Desktop/projects)
  fleet doctor --json        machine-readable summary
  fleet doctor --slug NAME   restrict to one project
USAGE
        exit 0 ;;
      *) echo "fleet doctor: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  local manifests=()
  while IFS= read -r m; do
    [ -n "$m" ] && manifests+=("$m")
  done < <(find "$DOCTOR_ROOT" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)

  local any_fail=0
  local json_projects=""
  for m in "${manifests[@]:-}"; do
    [ -z "$m" ] && continue
    local rows; rows="$(doctor_run_checks "$m")"
    local slug; slug="$(echo "$rows" | sed -n 's/^__SLUG__|\(.*\)|.*/\1/p' | head -1)"
    [ -n "$slug_filter" ] && [ "$slug" != "$slug_filter" ] && continue

    # Track project-level status for exit code.
    if echo "$rows" | grep -q '|FAIL|'; then any_fail=1; fi

    if [ "$want_json" = "1" ]; then
      local checks_json=""
      while IFS='|' read -r name status reason; do
        [ -z "$name" ] && continue
        [ "$name" = "__SLUG__" ] && continue
        local esc_name esc_status esc_reason
        esc_name="$(doctor_json_escape "$name")"
        esc_status="$(doctor_json_escape "$status")"
        esc_reason="$(doctor_json_escape "$reason")"
        [ -n "$checks_json" ] && checks_json+=","
        checks_json+="{\"name\":\"$esc_name\",\"status\":\"$esc_status\",\"reason\":\"$esc_reason\"}"
      done <<<"$rows"
      [ -n "$json_projects" ] && json_projects+=","
      json_projects+="{\"slug\":\"$(doctor_json_escape "$slug")\",\"checks\":[$checks_json]}"
    else
      doctor_render_human "$slug" "$rows"
    fi
  done

  if [ "$want_json" = "1" ]; then
    printf '{"projects":[%s]}\n' "$json_projects"
  fi

  [ "$any_fail" = "1" ] && exit 1
  exit 0
}

if [ "$CMD" = "doctor" ]; then
  doctor "$@"
fi

# --- digest ---------------------------------------------------------------
# Ticket 0012. `fleet digest` prints one line per discovered project
# summarising the last 24h (configurable via --since Nh|Nd): state tag,
# `N opened / M merged` PRs, $X.YY spend, and the most recent event type
# (or the last LESSONS.md line if no events in 7d).
#
# Discovery uses FLEET_DISCOVERY_ROOT — same root as doctor (0003). The
# output is intentionally line-oriented so an operator can pipe it into
# `mail`, `grep`, or a tmux status bar.
#
# Output contract (one line per project, slug-alpha):
#   <slug>  <STATE>  N opened / M merged  $X.YY  <last-event-or-lesson>
# State priority (red → quiet):
#   EXPIRED       past SELF_CANCEL
#   OVER-BUDGET   today's spend ≥ MAX_DAILY_USD
#   PAUSED        launchd label <ns>.agent-ship is disabled
#   THROTTLED     $CACHE_DIR/groom-slowed-since exists (ticket 0007)
#   STUCK         an open agent PR is >24h old with no activity in 6h
#   OK            none of the above
# Exit code 1 if ANY project is red (EXPIRED/OVER-BUDGET/STUCK); else 0.
#
# --json mode emits a JSON array with the same fields plus structured
# sub-fields (slug, state, prs_opened, prs_merged, spend_usd, last,
# self_cancel, since_seconds). The schema is the source of truth for any
# downstream consumer (fleet-control, cron-mailed digests).

DIGEST_ROOT="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"

# Parse "Nh" or "Nd" → seconds. Echoes 0 + returns 1 on bad input.
digest_parse_since() {
  local s="$1" n unit
  case "$s" in
    *h) unit=h; n="${s%h}" ;;
    *d) unit=d; n="${s%d}" ;;
    *)  return 1 ;;
  esac
  case "$n" in
    ''|*[!0-9]*) return 1 ;;
  esac
  if [ "$unit" = "h" ]; then echo $(( n * 3600 ))
  else                       echo $(( n * 86400 )); fi
}

# Convert an ISO8601-ish UTC timestamp to epoch seconds. Returns "" on parse
# failure so the caller can skip the record without aborting the whole digest.
# macOS BSD date wants -j -f; GNU date takes -d directly.
digest_iso_to_epoch() {
  local ts="$1"
  [ -z "$ts" ] && return 0
  # Strip trailing Z + any sub-second fraction.
  local clean; clean="$(echo "$ts" | sed -E 's/\.[0-9]+Z$/Z/; s/Z$//')"
  date -u -j -f '%Y-%m-%dT%H:%M:%S' "$clean" +%s 2>/dev/null \
    || date -u -d "$ts" +%s 2>/dev/null \
    || true
}

# Sum total_cost_usd in runs.jsonl whose ts_start ≥ cutoff_epoch. Echoes a
# number like "1.50". Tolerates a missing file (echoes 0).
digest_spend_since() {
  local runs="$1" cutoff="$2"
  [ -f "$runs" ] || { echo "0"; return 0; }
  awk -v cutoff="$cutoff" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; cost=0
      if (match($0, /"ts_start"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts_start"[[:space:]]*:[[:space:]]*"/, "", ts)
        sub(/".*/, "", ts)
      }
      if (match($0, /"total_cost_usd"[[:space:]]*:[[:space:]]*-?[0-9.eE+-]+/)) {
        c=substr($0, RSTART, RLENGTH)
        sub(/.*:[[:space:]]*/, "", c)
        cost = c + 0
      }
      if (ts == "") next
      ep = iso2ep(ts)
      if (ep >= cutoff) total += cost
    }
    END { printf("%.2f", total + 0) }
  ' "$runs"
}

# Count events of a given type in events.jsonl whose ts ≥ cutoff.
digest_event_count_since() {
  local events="$1" cutoff="$2" want_type="$3"
  [ -f "$events" ] || { echo 0; return 0; }
  awk -v cutoff="$cutoff" -v want="$want_type" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; type=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (type != want) next
      if (iso2ep(ts) >= cutoff) n++
    }
    END { print (n+0) }
  ' "$events"
}

# Print the .type of the most recent event in events.jsonl. Echoes empty if
# none. Most recent = last line (file is append-only). Caller decides whether
# to fall back to LESSONS.md based on age.
digest_last_event() {
  local events="$1"
  [ -f "$events" ] || return 0
  local line
  line="$(tail -n 1 "$events" 2>/dev/null)"
  [ -z "$line" ] && return 0
  echo "$line" | sed -nE 's/.*"type"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p'
}

# Echo the ts of the most recent event as epoch seconds, or empty.
digest_last_event_epoch() {
  local events="$1"
  [ -f "$events" ] || return 0
  local line; line="$(tail -n 1 "$events" 2>/dev/null)"
  [ -z "$line" ] && return 0
  local ts; ts="$(echo "$line" | sed -nE 's/.*"ts"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p')"
  digest_iso_to_epoch "$ts"
}

# Echo the last non-empty line of LESSONS.md, truncated to 60 chars. Empty
# if the file doesn't exist.
digest_last_lesson() {
  local proj_dir="$1"
  local lf
  for lf in "$proj_dir/docs/LESSONS.md" "$proj_dir/LESSONS.md"; do
    [ -f "$lf" ] || continue
    awk 'NF { last=$0 } END { print last }' "$lf" | cut -c1-60
    return 0
  done
}

# Compute the state tag per the ticket's priority order. Echoes one of
# EXPIRED | OVER-BUDGET | PAUSED | THROTTLED | STUCK | OK.
digest_state() {
  local self_cancel="$1" spend_today="$2" cap="$3" namespace="$4" cache_dir="$5"
  # EXPIRED — SELF_CANCEL is YYYYMMDD (UTC).
  local today; today="$(date -u +%Y%m%d)"
  case "$self_cancel" in
    ''|*[!0-9]*) ;;
    *) if [ "$today" -ge "$self_cancel" ]; then echo "EXPIRED"; return 0; fi ;;
  esac
  # OVER-BUDGET — today's spend ≥ cap (when cap is set).
  if [ -n "$cap" ]; then
    if awk -v s="$spend_today" -v c="$cap" 'BEGIN { exit !(s + 0 >= c + 0) }'; then
      echo "OVER-BUDGET"; return 0
    fi
  fi
  # PAUSED — launchctl print-disabled lists the agent-ship label.
  if command -v launchctl >/dev/null 2>&1; then
    if launchctl print-disabled "gui/$UID" 2>/dev/null \
         | grep -q "\"$namespace.agent-ship\" => true"; then
      echo "PAUSED"; return 0
    fi
  fi
  # THROTTLED — groom-slowed-since marker exists (ticket 0007).
  if [ -f "$cache_dir/groom-slowed-since" ]; then
    echo "THROTTLED"; return 0
  fi
  # STUCK — defer to caller (needs `gh`); the digest opts out of STUCK when
  # gh is unavailable. We treat STUCK as out-of-scope unless explicitly
  # surfaced via `FLEET_DIGEST_STUCK=1` + a non-empty stuck signal file
  # (kept simple for the v1 — STUCK is the noisiest signal to compute).
  if [ -f "$cache_dir/stuck-pr" ]; then
    echo "STUCK"; return 0
  fi
  echo "OK"
}

# Today's UTC-day spend, used for the OVER-BUDGET check (which is per
# calendar day, not per --since window).
digest_spend_today() {
  local runs="$1"
  [ -f "$runs" ] || { echo "0"; return 0; }
  local today; today="$(date -u +%Y-%m-%d)"
  awk -v day="$today" '
    {
      ts=""; cost=0
      if (match($0, /"ts_start"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts_start"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"total_cost_usd"[[:space:]]*:[[:space:]]*-?[0-9.eE+-]+/)) {
        c=substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*/, "", c); cost = c + 0
      }
      if (index(ts, day) == 1) total += cost
    }
    END { printf("%.2f", total + 0) }
  ' "$runs"
}

# Render one project line in human form. All inputs pre-computed.
digest_render_human() {
  local slug="$1" state="$2" opened="$3" merged="$4" spend="$5" last="$6"
  printf '%s  %s  %s opened / %s merged  $%s  %s\n' \
    "$slug" "$state" "$opened" "$merged" "$spend" "$last"
}

digest() {
  shift  # drop "digest"
  local want_json=0 slug_filter="" since="24h" emoji=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)  want_json=1; shift ;;
      --emoji) emoji=1; shift ;;
      --slug)  slug_filter="${2:-}"; shift 2 ;;
      --slug=*) slug_filter="${1#--slug=}"; shift ;;
      --since) since="${2:-}"; shift 2 ;;
      --since=*) since="${1#--since=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet digest — one-line summary per project for the trailing window.

Usage:
  fleet digest                       survey all projects, last 24h
  fleet digest --slug NAME           restrict to one project
  fleet digest --since 7d            widen the window (Nh or Nd)
  fleet digest --json                machine-readable array
  fleet digest --emoji               (reserved; non-ASCII state glyphs)

Output (one line per project, slug-alpha order):
  <slug>  <STATE>  N opened / M merged  \$X.YY  <last-event-or-lesson>

States, priority order: EXPIRED, OVER-BUDGET, PAUSED, THROTTLED, STUCK, OK.

JSON schema (one object per project):
  { slug, state, prs_opened, prs_merged, spend_usd, last,
    self_cancel, since_seconds }

Exit code: 1 if any project is in a red state
(EXPIRED, OVER-BUDGET, STUCK); else 0.
USAGE
        exit 0 ;;
      *) echo "fleet digest: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  # We don't currently use --emoji's value, but accepting the flag now lets
  # us add glyphs later without breaking callers. Reference it once so the
  # static analyzer doesn't complain about an unread variable.
  : "$emoji"

  local since_seconds
  if ! since_seconds="$(digest_parse_since "$since")"; then
    echo "fleet digest: --since must be Nh or Nd (got '$since')" >&2
    exit 2
  fi
  local now cutoff
  now=$(date -u +%s)
  cutoff=$(( now - since_seconds ))
  local seven_days_ago=$(( now - 7 * 86400 ))

  # Discover manifests under FLEET_DISCOVERY_ROOT — same pattern as doctor.
  local manifests=()
  while IFS= read -r m; do
    [ -n "$m" ] && manifests+=("$m")
  done < <(find "$DIGEST_ROOT" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)

  local any_red=0
  local json_rows=""
  local m
  for m in "${manifests[@]:-}"; do
    [ -z "$m" ] && continue
    local proj_dir; proj_dir="$(dirname "$m")"
    # Load manifest in a subshell, echo back the fields we need.
    local probe slug namespace self_cancel cap
    probe=$(
      # shellcheck disable=SC1090
      ( source "$m" 2>/dev/null
        echo "SLUG=${SLUG:-}"
        echo "NAMESPACE=${NAMESPACE:-com.fleet.${SLUG:-x}}"
        echo "SELF_CANCEL=${SELF_CANCEL:-}"
        echo "MAX_DAILY_USD=${MAX_DAILY_USD:-}"
      ) 2>/dev/null
    ) || true
    slug="$(echo "$probe" | sed -n 's/^SLUG=//p')"
    namespace="$(echo "$probe" | sed -n 's/^NAMESPACE=//p')"
    self_cancel="$(echo "$probe" | sed -n 's/^SELF_CANCEL=//p')"
    cap="$(echo "$probe" | sed -n 's/^MAX_DAILY_USD=//p')"
    [ -z "$slug" ] && continue
    [ -n "$slug_filter" ] && [ "$slug" != "$slug_filter" ] && continue

    local cache_dir="$HOME/.cache/${slug}-agent"
    local runs="$cache_dir/runs.jsonl"
    local events="$cache_dir/events.jsonl"

    # PR counts — events.jsonl is the source of truth (per AC#2). pr_opened
    # is emitted today; pr_merged is reserved for when a runner emits it.
    local opened merged
    opened="$(digest_event_count_since "$events" "$cutoff" "pr_opened")"
    merged="$(digest_event_count_since "$events" "$cutoff" "pr_merged")"

    # Spend in the requested window (display column) AND today's spend
    # (used for OVER-BUDGET, which is calendar-day per AC#4).
    local spend spend_today
    spend="$(digest_spend_since "$runs" "$cutoff")"
    spend_today="$(digest_spend_today "$runs")"

    local state
    state="$(digest_state "$self_cancel" "$spend_today" "$cap" "$namespace" "$cache_dir")"

    case "$state" in
      EXPIRED|OVER-BUDGET|STUCK) any_red=1 ;;
    esac

    # last-event-or-lesson. If newest event ≥ 7d ago, use type; otherwise
    # fall back to the trailing LESSONS.md line, truncated to 60 chars.
    local last last_type last_epoch
    last_type="$(digest_last_event "$events")"
    last_epoch="$(digest_last_event_epoch "$events")"
    if [ -n "$last_type" ] && [ -n "$last_epoch" ] && [ "$last_epoch" -ge "$seven_days_ago" ]; then
      last="$last_type"
      # Trim to 60 chars (the type alone is short; this is defensive).
      last="$(printf '%s' "$last" | cut -c1-60)"
    else
      last="$(digest_last_lesson "$proj_dir")"
      [ -z "$last" ] && last="-"
    fi

    if [ "$want_json" = "1" ]; then
      local esc_slug esc_state esc_last esc_sc
      esc_slug="$(doctor_json_escape "$slug")"
      esc_state="$(doctor_json_escape "$state")"
      esc_last="$(doctor_json_escape "$last")"
      esc_sc="$(doctor_json_escape "$self_cancel")"
      [ -n "$json_rows" ] && json_rows+=","
      json_rows+="{\"slug\":\"$esc_slug\",\"state\":\"$esc_state\""
      json_rows+=",\"prs_opened\":$opened,\"prs_merged\":$merged"
      json_rows+=",\"spend_usd\":$spend"
      json_rows+=",\"last\":\"$esc_last\""
      json_rows+=",\"self_cancel\":\"$esc_sc\""
      json_rows+=",\"since_seconds\":$since_seconds}"
    else
      digest_render_human "$slug" "$state" "$opened" "$merged" "$spend" "$last"
    fi
  done

  if [ "$want_json" = "1" ]; then
    printf '[%s]\n' "$json_rows"
  fi

  [ "$any_red" = "1" ] && exit 1
  exit 0
}

if [ "$CMD" = "digest" ]; then
  digest "$@"
fi

# --- weekly (ticket 0025) ------------------------------------------------
# `fleet weekly` prints a one-screen Sunday ROI rollup per project covering
# the trailing 7 days (configurable via --since Nh|Nd). Pure consumer of
# events.jsonl + runs.jsonl — emits NO new event types (P-6: telemetry is
# the source of truth; readers compose, they do not invent).
#
# Discovery reuses the same root-redirect pattern as `digest` / `overview`
# (FLEET_DISCOVERY_ROOT). Render is deliberately separate from `digest`
# because the column set differs (no LAST line; adds DRAFTS, PAUSED, INFRA).
# All per-row math reuses the digest helpers above:
#   digest_parse_since, digest_iso_to_epoch, digest_spend_since,
#   digest_event_count_since
# plus three thin wrappers named for the event type they count
# (weekly_draft_count_since / weekly_heal_count_since /
#  weekly_infra_flake_count_since) so the call sites read like English.
#
# Test seam: FLEET_WEEKLY_FAKE_NOW (epoch seconds) overrides "now" so the
# WEEK header, the cutoff math, and the self-cancel countdown all become
# deterministic for tests/weekly.sh.
#
# Naming clash check (LESSONS 2026-05-26): `weekly` is not a coreutils
# binary on macOS or Linux; no `_cmd` suffix needed.

WEEKLY_ROOT="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
WEEKLY_INSTALLED="$HOME/.local/share/agent-fleet/projects"

# Discover (slug, manifest_path) rows union of the two roots, de-duped by
# SLUG, slug-alpha sorted. Working-tree manifests win over installed
# copies (same convention as `overview_discover`).
weekly_discover() {
  local _seen="" m slug
  { find "$WEEKLY_ROOT"      -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$WEEKLY_INSTALLED" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    [ -z "$slug" ] && continue
    case " $_seen " in *" $slug "*) continue ;; esac
    _seen="$_seen $slug"
    printf '%s\t%s\n' "$slug" "$m"
  done | sort -t $'\t' -k1,1
}

# Thin, intent-named wrappers around digest_event_count_since so call
# sites read clearly. Each just counts one event type in the window.
weekly_draft_count_since() {        # $1 = events.jsonl, $2 = cutoff epoch
  digest_event_count_since "$1" "$2" "lesson_draft_emitted"
}
weekly_heal_count_since() {         # $1 = events.jsonl, $2 = cutoff epoch
  digest_event_count_since "$1" "$2" "gate_failed"
}
weekly_infra_flake_count_since() {  # $1 = events.jsonl, $2 = cutoff epoch
  digest_event_count_since "$1" "$2" "infra_flake_rerun"
}

# Count SHIP-prefixed runs.jsonl rows whose ts_start is in window. The
# result_head's "SHIP <ticket-id>" prefix is the dev agent's standard
# exit-line format (per prompts/ship.prompt.md line 159); we treat it as
# the proxy for "merged agent PR" since the offline rule (AC#2) forbids
# us from cross-referencing gh's mergedAt.
weekly_ship_count_since() {  # $1 = runs.jsonl, $2 = cutoff epoch
  local runs="$1" cutoff="$2"
  [ -f "$runs" ] || { echo 0; return 0; }
  awk -v cutoff="$cutoff" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; head=""
      if (match($0, /"ts_start"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts_start"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"result_head"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        head=substr($0, RSTART, RLENGTH)
        sub(/.*"result_head"[[:space:]]*:[[:space:]]*"/, "", head); sub(/".*/, "", head)
      }
      if (ts == "" || head == "") next
      if (substr(head, 1, 5) != "SHIP ") next
      if (iso2ep(ts) < cutoff) next
      n++
    }
    END { print (n+0) }
  ' "$runs"
}

# Days since the project's agent-ship plist was last touched (proxy for
# "how long has this project been paused?"). The mtime of
# ~/Library/LaunchAgents/com.<slug>.agent-ship.plist updates on each
# install.sh; if a project has been paused for less than the time since
# the last install, this OVERSTATES — acceptable for v1 per the ticket
# engineering notes. Echoes a non-negative integer, or empty when no
# plist exists.
weekly_paused_days() {  # $1 = namespace (e.g. com.courtiq)
  local namespace="$1"
  local plist="$HOME/Library/LaunchAgents/${namespace}.agent-ship.plist"
  [ -f "$plist" ] || { echo ""; return 0; }
  local mtime now
  mtime="$(stat -f %m "$plist" 2>/dev/null || stat -c %Y "$plist" 2>/dev/null)"
  [ -n "$mtime" ] || { echo ""; return 0; }
  now="${FLEET_WEEKLY_FAKE_NOW:-$(date -u +%s)}"
  local diff=$(( now - mtime ))
  [ "$diff" -lt 0 ] && diff=0
  echo $(( diff / 86400 ))
}

# Is the project currently paused (agent-ship label disabled in launchctl)?
# Echoes "1" yes, "0" no. Skipped silently when launchctl is unavailable.
weekly_is_paused() {  # $1 = namespace
  local namespace="$1"
  command -v launchctl >/dev/null 2>&1 || { echo 0; return 0; }
  if launchctl print-disabled "gui/$UID" 2>/dev/null \
       | grep -q "\"$namespace.agent-ship\" => true"; then
    echo 1
  else
    echo 0
  fi
}

# Self-cancel days remaining, honouring FLEET_WEEKLY_FAKE_NOW so the
# golden file's countdown stays stable. Echoes a possibly-negative integer
# (negative = past) or empty when SELF_CANCEL is unset / unparseable.
weekly_self_cancel_days() {  # $1 = YYYYMMDD
  local sc="$1"
  case "$sc" in
    ''|*[!0-9]*) echo ""; return 0 ;;
  esac
  local target; target=$(date -u -j -f "%Y%m%d" "$sc" +%s 2>/dev/null) || { echo ""; return 0; }
  local now_epoch="${FLEET_WEEKLY_FAKE_NOW:-$(date -u +%s)}"
  local today_iso today_epoch
  today_iso="$(date -u -r "$now_epoch" +%Y%m%d 2>/dev/null || date -u -d "@$now_epoch" +%Y%m%d)"
  today_epoch=$(date -u -j -f "%Y%m%d" "$today_iso" +%s 2>/dev/null) \
    || today_epoch=$(date -u -d "$today_iso" +%s 2>/dev/null) || today_epoch=0
  echo $(( (target - today_epoch) / 86400 ))
}

# Pad a string to a fixed DISPLAY width, treating the few non-ASCII glyphs
# we render (↑, ⚠, ✗, – en-dash) as 1 display column even though they
# take 3 UTF-8 bytes each. bash printf's %-Ns counts bytes, so without
# this helper the DRAFTS↑ header and the SELF-CANCEL "EXPIRED ✗" cells
# would mis-align under their column boundaries.
weekly_pad() {  # $1 = string, $2 = display width
  local s="$1" w="$2"
  local stripped="$s"
  stripped="${stripped//↑/X}"
  stripped="${stripped//⚠/X}"
  stripped="${stripped//✗/X}"
  stripped="${stripped//–/X}"
  local len="${#stripped}"
  local pad=$(( w - len ))
  [ "$pad" -lt 0 ] && pad=0
  printf '%s%*s' "$s" "$pad" ''
}

# Render one row (header or data). Eight columns, fixed widths. The
# DRAFTS, SELF-CANCEL columns may carry unicode glyphs — we route through
# weekly_pad so the byte-width arithmetic stays display-correct.
weekly_render_row() {
  local project="$1" shipped="$2" spend="$3" drafts="$4"
  local heal="$5" infra="$6" paused="$7" self_cancel="$8"
  weekly_pad "$project" 14;     printf ' '
  weekly_pad "$shipped" 8;      printf ' '
  weekly_pad "$spend" 8;        printf ' '
  weekly_pad "$drafts" 8;       printf ' '
  weekly_pad "$heal" 5;         printf ' '
  weekly_pad "$infra" 6;        printf ' '
  weekly_pad "$paused" 7;       printf ' '
  printf '%s\n' "$self_cancel"
}

weekly() {
  shift  # drop the leading "weekly"
  local want_json=0 slug_filter="" since="7d"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)    want_json=1; shift ;;
      --slug)    slug_filter="${2:-}"; shift 2 ;;
      --slug=*)  slug_filter="${1#--slug=}"; shift ;;
      --since)   since="${2:-}"; shift 2 ;;
      --since=*) since="${1#--since=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet weekly — Sunday ROI rollup, one row per project.

Usage:
  fleet weekly                 default --since 7d window
  fleet weekly --since 14d     biweekly view (also accepts Nh)
  fleet weekly --slug NAME     restrict to one project (no ALL: line)
  fleet weekly --json          one JSON object per project + one summary

Columns:
  PROJECT      slug from manifest
  SHIPPED      count of merged agent PRs in window (SHIP-prefixed runs)
  \$SPEND       sum of runs.jsonl total_cost_usd in window
  DRAFTS↑      lesson_draft_emitted events in window (suffix * when > 0)
  HEAL         gate_failed events in window
  INFRA        infra_flake_rerun events in window
  PAUSED       "Nd!" if agent-ship label is disabled, else "no"
  SELF-CANCEL  days remaining (Nd / Nd ⚠ if ≤7 / EXPIRED ✗ if past)

Trailing lines:
  N* drafts waiting on you...  (only when sum(DRAFTS) > 0)
  ALL: P PRs shipped, \$S spent (\$avg/PR avg), H heal, I infra-flake
       rerun, P paused, E expired.  (suppressed when --slug given)

JSON schema (per-project):
  {slug, shipped, spend, drafts, heal, infra, paused_days,
   self_cancel_days, self_cancel_state}  self_cancel_state in ok|warn|expired
JSON schema (summary):
  {summary:true, prs, spend, avg_per_pr, heal, infra, paused, expired,
   window_days}

Read-only — no commits, no PRs, no new event types.
USAGE
        exit 0 ;;
      *) echo "fleet weekly: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  local since_seconds
  if ! since_seconds="$(digest_parse_since "$since")"; then
    echo "weekly: invalid --since \"$since\" (use Nh or Nd)" >&2
    exit 2
  fi
  local now cutoff
  now="${FLEET_WEEKLY_FAKE_NOW:-$(date -u +%s)}"
  cutoff=$(( now - since_seconds ))
  local window_days=$(( since_seconds / 86400 ))
  [ "$window_days" -lt 1 ] && window_days=1

  # Header banner — only printed in human mode.
  if [ "$want_json" != "1" ]; then
    local from_iso to_iso
    from_iso="$(date -u -r "$cutoff" +%F 2>/dev/null || date -u -d "@$cutoff" +%F)"
    to_iso="$(date -u -r "$now" +%F 2>/dev/null || date -u -d "@$now" +%F)"
    printf 'WEEK OF %s – %s (%dd)\n' "$from_iso" "$to_iso" "$window_days"
    printf '\n'
    weekly_render_row "PROJECT" "SHIPPED" "\$SPEND" "DRAFTS↑" "HEAL" "INFRA" "PAUSED" "SELF-CANCEL"
    # Underline. 73 = total printable width of the row (14+1+8+1+8+1+8+1+5+1+6+1+7+1+11 = 74).
    printf -- '%s\n' "─────────────────────────────────────────────────────────────────────────"
  fi

  # Aggregate per-project, accumulating totals for the ALL: line.
  local total_prs=0 total_drafts=0 total_heal=0 total_infra=0
  local total_paused=0 total_expired=0
  # We sum spend in awk (float).
  local total_spend_dollars="0.00"

  local json_rows=""
  local slug manifest
  while IFS=$'\t' read -r slug manifest; do
    [ -z "$slug" ] && continue
    [ -n "$slug_filter" ] && [ "$slug" != "$slug_filter" ] && continue

    # Manifest probe — fetch namespace + self-cancel.
    local probe namespace self_cancel
    probe=$(
      # shellcheck disable=SC1090
      ( source "$manifest" 2>/dev/null
        echo "NAMESPACE=${NAMESPACE:-com.fleet.${SLUG:-x}}"
        echo "SELF_CANCEL=${SELF_CANCEL:-}"
      ) 2>/dev/null
    ) || true
    namespace="$(echo "$probe" | sed -n 's/^NAMESPACE=//p')"
    self_cancel="$(echo "$probe" | sed -n 's/^SELF_CANCEL=//p')"

    local cache_dir="$HOME/.cache/${slug}-agent"
    local runs="$cache_dir/runs.jsonl"
    local events="$cache_dir/events.jsonl"

    local shipped spend drafts heal infra
    shipped="$(weekly_ship_count_since        "$runs"   "$cutoff")"
    spend="$(  digest_spend_since             "$runs"   "$cutoff")"
    drafts="$( weekly_draft_count_since       "$events" "$cutoff")"
    heal="$(   weekly_heal_count_since        "$events" "$cutoff")"
    infra="$(  weekly_infra_flake_count_since "$events" "$cutoff")"

    # PAUSED + paused_days.
    local is_paused paused_days paused_cell
    is_paused="$(weekly_is_paused "$namespace")"
    if [ "$is_paused" = "1" ]; then
      paused_days="$(weekly_paused_days "$namespace")"
      [ -z "$paused_days" ] && paused_days=0
      paused_cell="${paused_days}d!"
      total_paused=$(( total_paused + 1 ))
    else
      paused_days=""
      paused_cell="no"
    fi

    # SELF-CANCEL cell + state.
    local sc_days sc_cell sc_state
    sc_days="$(weekly_self_cancel_days "$self_cancel")"
    if [ -z "$sc_days" ]; then
      sc_cell="—"; sc_state="ok"
    elif [ "$sc_days" -lt 0 ]; then
      sc_cell="EXPIRED ✗"; sc_state="expired"
      total_expired=$(( total_expired + 1 ))
    elif [ "$sc_days" -le 7 ]; then
      sc_cell="${sc_days}d ⚠"; sc_state="warn"
    else
      sc_cell="${sc_days}d"; sc_state="ok"
    fi

    # DRAFTS cell: append `*` when > 0 to draw the eye (per AC#2).
    local drafts_cell="$drafts"
    [ "$drafts" -gt 0 ] && drafts_cell="${drafts}*"

    # Accumulate totals (drafts numeric, not with asterisk).
    total_prs=$(( total_prs + shipped ))
    total_drafts=$(( total_drafts + drafts ))
    total_heal=$(( total_heal + heal ))
    total_infra=$(( total_infra + infra ))
    total_spend_dollars="$(awk -v a="$total_spend_dollars" -v b="$spend" \
      'BEGIN { printf("%.2f", a + b) }')"

    if [ "$want_json" = "1" ]; then
      local esc_slug
      esc_slug="$(doctor_json_escape "$slug")"
      local paused_days_json="null"
      [ -n "$paused_days" ] && paused_days_json="$paused_days"
      local sc_days_json="null"
      [ -n "$sc_days" ] && sc_days_json="$sc_days"
      [ -n "$json_rows" ] && json_rows+=$'\n'
      json_rows+="{\"slug\":\"$esc_slug\""
      json_rows+=",\"shipped\":$shipped"
      json_rows+=",\"spend\":$spend"
      json_rows+=",\"drafts\":$drafts"
      json_rows+=",\"heal\":$heal"
      json_rows+=",\"infra\":$infra"
      json_rows+=",\"paused_days\":$paused_days_json"
      json_rows+=",\"self_cancel_days\":$sc_days_json"
      json_rows+=",\"self_cancel_state\":\"$sc_state\"}"
    else
      weekly_render_row "$slug" "$shipped" "\$$spend" "$drafts_cell" \
                        "$heal" "$infra" "$paused_cell" "$sc_cell"
    fi
  done < <(weekly_discover)

  # Avg cost per PR. Empty / null when no PRs shipped this window.
  local avg_per_pr="" avg_per_pr_json="null"
  if [ "$total_prs" -gt 0 ]; then
    avg_per_pr="$(awk -v s="$total_spend_dollars" -v p="$total_prs" \
      'BEGIN { printf("%.2f", s / p) }')"
    avg_per_pr_json="$avg_per_pr"
  fi

  if [ "$want_json" = "1" ]; then
    # Stream one JSON object per line, project rows first, then summary.
    [ -n "$json_rows" ] && printf '%s\n' "$json_rows"
    printf '{"summary":true'
    printf ',"prs":%s' "$total_prs"
    printf ',"spend":%s' "$total_spend_dollars"
    printf ',"avg_per_pr":%s' "$avg_per_pr_json"
    printf ',"heal":%s' "$total_heal"
    printf ',"infra":%s' "$total_infra"
    printf ',"paused":%s' "$total_paused"
    printf ',"expired":%s' "$total_expired"
    printf ',"window_days":%s' "$window_days"
    printf '}\n'
    exit 0
  fi

  # Human-mode trailing lines.
  # Drafts hint: only when sum > 0.
  if [ "$total_drafts" -gt 0 ]; then
    printf '\n%d* drafts waiting on you. Promote in <repo>/docs/LESSONS.md or run\n' "$total_drafts"
    printf '`fleet digest --slug <slug>` for the per-project event tail.\n'
  fi

  # ALL: summary. Suppressed when --slug filter is set.
  if [ -z "$slug_filter" ]; then
    printf '\n'
    if [ "$total_prs" -gt 0 ]; then
      printf 'ALL: %d PRs shipped, $%s spent ($%s/PR avg), %d heal attempts,\n' \
        "$total_prs" "$total_spend_dollars" "$avg_per_pr" "$total_heal"
    else
      printf 'ALL: %d PRs shipped, $%s spent, %d heal attempts,\n' \
        "$total_prs" "$total_spend_dollars" "$total_heal"
    fi
    printf '     %d infra-flake rerun, %d paused, %d expired.\n' \
      "$total_infra" "$total_paused" "$total_expired"
  fi

  exit 0
}

if [ "$CMD" = "weekly" ]; then
  weekly "$@"
fi

# --- badge (ticket 0027) -------------------------------------------------
# `fleet badge <slug> [--since 30d] [--format md|svg|txt] [--repo <URL>]`
# emits one line summarising the project's last-N-day fleet output as a
# pastable artifact for the project's own README. Three output shapes:
#
#   md (default)  shields.io image wrapped in a markdown link to REPO_URL,
#                 with an HTML comment marker so a cron can sed-replace it.
#   svg           self-contained raw SVG (no network round-trip) using a
#                 fixed flat-style template. The shields.io URL is NOT
#                 fetched — the SVG is rendered locally.
#   txt           plain-string ntfy/email body:
#                 `<slug>: <prs> PRs, $<spend>, <since> (last ship <age>)`
#
# Pure consumer of telemetry — no new event types (P-6), no
# fleet_emit_event calls, no fleet_* signature changes, no lib/ or
# prompts/ changes. Network-free: every byte comes from the local
# runs.jsonl + events.jsonl + log mtimes. The test runs with `gh` and
# `curl` stubbed to fail-on-invoke to keep this guarantee structural.
#
# Naming clash check (LESSONS 2026-05-26): `badge` is not a coreutils
# binary on macOS or Linux; no `_cmd` suffix needed.

# Resolve slug → manifest path. Same union pattern as rollback /
# kickstart / weekly_discover, kept independent so future churn in
# either site does not ripple. Echoes the manifest path, or empty when
# the slug is not found.
badge_resolve_manifest() {
  local want="$1"
  local roots=("${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}" "$HOME/.local/share/agent-fleet/projects")
  local root m slug
  for root in "${roots[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      # shellcheck disable=SC1090
      slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
      if [ "$slug" = "$want" ]; then
        echo "$m"
        return 0
      fi
    done < <(find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)
  done
}

# URL-encode the variable-bytes portion of the shields.io label/value
# segment. Translation table per the engineering notes:
#
#   ` ` → `%20`     `$` → `%24`     `/` → `%2F`
#   `(` → `%28`     `)` → `%29`     `:` → `%3A`
#   `-` → `--`      (shields.io convention — a single dash separates
#                    the label, value, and color segments, so an
#                    intra-segment dash MUST be doubled to survive)
#
# Pure shell + sed — no `python3` dep (the kit's `lessons_sync` falls
# back to shell-only too — ticket 0009). The order matters: `-`
# doubling must run FIRST, because the other escapes don't introduce
# any `-` characters into the stream. URL escapes use `%XX` which
# cannot collide with `--`.
badge_url_encode() {
  local s="$1"
  # Step 1: double every literal dash. Step 2: percent-encode the
  # punctuation set. sed handles every byte we care about.
  printf -- '%s' "$s" | sed -e 's/-/--/g' \
                            -e 's/ /%20/g' \
                            -e 's/\$/%24/g' \
                            -e 's|/|%2F|g' \
                            -e 's/(/%28/g' \
                            -e 's/)/%29/g' \
                            -e 's/:/%3A/g'
}

# Compose the shields.io URL for a label/value/color triple. Both
# `label` and `value` are passed through badge_url_encode so the
# shields convention (`--` for `-`, `%20` for ` `, etc.) is honoured.
badge_shields_url() {
  local label="$1" value="$2" color="$3"
  local enc_label enc_value
  enc_label="$(badge_url_encode "$label")"
  enc_value="$(badge_url_encode "$value")"
  printf -- 'https://img.shields.io/badge/%s-%s-%s' "$enc_label" "$enc_value" "$color"
}

# Render the markdown image-with-link. The trailing HTML comment is a
# deterministic regenerate marker: a future ticket / a cron can
# sed-replace any line matching `<!-- generated by fleet badge -->`
# without touching the rest of the README. LESSONS 2026-05-28: `printf
# -- '%s'` guards against a `--repo` value that starts with `-`.
badge_render_md() {
  local slug="$1" value="$2" repo_url="$3"
  local shields
  shields="$(badge_shields_url "$slug" "$value" "blue")"
  printf -- '[![fleet](%s)](%s) <!-- generated by fleet badge -->\n' \
    "$shields" "$repo_url"
}

# Render the plain-text one-liner. Shape:
#   `<slug>: <prs> PRs, $<spend>, <since> (last ship <Nh|Nd> ago)`
# Singular form `1 PR` when prs == 1 (per AC#6). The `age` argument
# already includes the trailing " ago" (it comes straight from
# human_age()) so the format string interpolates it verbatim.
badge_render_txt() {
  local slug="$1" prs="$2" spend="$3" since="$4" age="$5"
  local noun="PRs"
  [ "$prs" = "1" ] && noun="PR"
  printf -- '%s: %s %s, $%s, %s (last ship %s)\n' \
    "$slug" "$prs" "$noun" "$spend" "$since" "$age"
}

# Render the self-contained SVG. Shields-style "flat" template, hand-
# rolled. Width = (len(label)+len(value))*6 + 20 px per the
# engineering notes — close enough to shields.io's metrics for the
# badge to render legibly without measuring glyph widths. The label
# is rendered on a grey ribbon and the value on a blue ribbon, as
# the canonical shields.io flat preset.
badge_render_svg() {
  local label="$1" value="$2"
  local label_len=${#label} value_len=${#value}
  local label_w=$(( label_len * 6 + 10 ))
  local value_w=$(( value_len * 6 + 10 ))
  local total_w=$(( label_w + value_w ))
  local label_mid=$(( label_w * 10 / 2 ))
  local value_mid=$(( label_w * 10 + value_w * 10 / 2 ))
  local label_textlen=$(( label_len * 60 ))
  local value_textlen=$(( value_len * 60 ))
  cat <<SVG
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="${total_w}" height="20" role="img" aria-label="${label}: ${value}">
  <linearGradient id="s" x2="0" y2="100%">
    <stop offset="0" stop-color="#bbb" stop-opacity=".1"/>
    <stop offset="1" stop-opacity=".1"/>
  </linearGradient>
  <clipPath id="r"><rect width="${total_w}" height="20" rx="3" fill="#fff"/></clipPath>
  <g clip-path="url(#r)">
    <rect width="${label_w}" height="20" fill="#555"/>
    <rect x="${label_w}" width="${value_w}" height="20" fill="#007ec6"/>
    <rect width="${total_w}" height="20" fill="url(#s)"/>
  </g>
  <g fill="#fff" text-anchor="middle" font-family="Verdana,Geneva,sans-serif" font-size="11">
    <text x="${label_mid}" y="140" transform="scale(.1)" textLength="${label_textlen}">${label}</text>
    <text x="${value_mid}" y="140" transform="scale(.1)" textLength="${value_textlen}">${value}</text>
  </g>
</svg>
SVG
}

# Format the last-ship age. Reuses human_age() (line ~58) with
# newest_log_epoch() (line ~72). Returns the human_age string verbatim
# ("Xh ago" / "Xd ago" / "—") so the txt template's "(last ship %s)"
# slot interpolates the full token. When no log files exist, the
# helper returns "—" (em-dash) — same convention as human_age.
badge_last_ship_age() {
  local logs_dir="$1"
  local epoch
  epoch="$(newest_log_epoch "$logs_dir")"
  if [ -z "$epoch" ]; then
    # human_age("") echoes "—"; preserve that signal without going via
    # the function so the empty-args path can't accidentally drift.
    echo "—"
    return 0
  fi
  human_age "$epoch"
}

badge() {
  shift  # drop the leading "badge"
  local slug_arg="" since="30d" format="md" repo_override=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since)    since="${2:-}"; shift 2 ;;
      --since=*)  since="${1#--since=}"; shift ;;
      --format)   format="${2:-}"; shift 2 ;;
      --format=*) format="${1#--format=}"; shift ;;
      --repo)     repo_override="${2:-}"; shift 2 ;;
      --repo=*)   repo_override="${1#--repo=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet badge — one-line shareable ROI shield for a project README.

Usage:
  fleet badge <slug>                       default --since 30d --format md
  fleet badge <slug> --since 7d            narrower window (Nh or Nd)
  fleet badge <slug> --format svg          self-contained SVG (no network)
  fleet badge <slug> --format txt          ntfy/email plain string
  fleet badge <slug> --repo <URL>          override the manifest's REPO_URL

Flags:
  --since <Nh|Nd>     trailing window for PRs + spend (default 30d)
  --format md|svg|txt output shape (default md)
  --repo  <URL>       override the manifest's REPO_URL anchor target
  --help              print this banner and exit

Examples:
  md:   [![fleet](https://img.shields.io/badge/<slug>-<value>-blue)](<repo>)
  svg:  <?xml version="1.0" encoding="UTF-8"?>...</svg>
  txt:  <slug>: <prs> PRs, \$<spend>, <since> (last ship <age>)

Read-only — no commits, no PRs, no network calls, no new event types.
Pastable into the project's README; safe to regenerate on a cron via
the trailing <!-- generated by fleet badge --> marker on the md form.
USAGE
        exit 0 ;;
      --*) echo "fleet badge: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then slug_arg="$1"; shift
        else echo "fleet badge: unexpected positional '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$slug_arg" ]; then
    echo "fleet badge: missing <slug> argument (try --help)" >&2
    exit 2
  fi

  # --since parse via the shared helper (line ~1138).
  local since_seconds
  if ! since_seconds="$(digest_parse_since "$since")"; then
    echo "badge: invalid --since \"$since\" (use Nh or Nd)" >&2
    exit 2
  fi

  # --format must be one of the three documented shapes.
  case "$format" in
    md|svg|txt) ;;
    *) echo "badge: invalid --format \"$format\" (use md, svg, or txt)" >&2; exit 2 ;;
  esac

  # Resolve slug → manifest. Mirror the rollback / kickstart error
  # string so the operator sees a familiar "where did I look?" trail.
  local manifest
  manifest="$(badge_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
    echo "badge: no project with SLUG=$slug_arg found (looked under FLEET_DISCOVERY_ROOT=$root)" >&2
    exit 2
  fi

  # Probe manifest for REPO_URL.
  local probe repo_url
  probe=$(
    # shellcheck disable=SC1090
    ( source "$manifest" 2>/dev/null
      echo "REPO_URL=${REPO_URL:-}"
    ) 2>/dev/null
  ) || true
  repo_url="$(echo "$probe" | sed -n 's/^REPO_URL=//p')"
  if [ -n "$repo_override" ]; then repo_url="$repo_override"; fi

  # Compute metrics from the local cache. No `gh api`, no curl.
  local cache_dir="$HOME/.cache/${slug_arg}-agent"
  local runs="$cache_dir/runs.jsonl"
  local events="$cache_dir/events.jsonl"
  local logs_dir="$cache_dir/logs"
  : "$events"  # reserved for future signal (color thresholds — see Out of scope)

  local now cutoff
  now=$(date -u +%s)
  cutoff=$(( now - since_seconds ))

  local prs spend age
  prs="$(weekly_ship_count_since "$runs" "$cutoff")"
  spend="$(digest_spend_since "$runs" "$cutoff")"
  age="$(badge_last_ship_age "$logs_dir")"

  local prs_noun="PRs"; [ "$prs" = "1" ] && prs_noun="PR"
  local value="$prs $prs_noun / \$$spend / $since"

  case "$format" in
    md)  badge_render_md "$slug_arg" "$value" "$repo_url" ;;
    svg) badge_render_svg "$slug_arg" "$value" ;;
    txt) badge_render_txt "$slug_arg" "$prs" "$spend" "$since" "$age" ;;
  esac
  exit 0
}

if [ "$CMD" = "badge" ]; then
  badge "$@"
fi

# --- inbox (ticket 0026) -------------------------------------------------
# `fleet inbox` answers the daily question "what does my fleet need from
# me today?" by reading the existing telemetry channel (events.jsonl,
# LESSONS.md draft markers, launchd disabled list, gh PR list) and
# rendering a single ordered TODO list with remediation hints inline.
#
# Five sections, fixed order:
#   1. drafts to promote          — count of `<!-- DRAFT: ` markers in
#                                   each project's docs/LESSONS.md.
#   2. self-cancel expiring (<=7d) — SELF_CANCEL between today and +7d,
#                                    or already expired.
#   3. paused projects            — agent-ship label disabled in launchctl.
#   4. budget tripped today       — budget_block events in today's UTC day.
#   5. in-flight agent PRs >24h old — gh pr list filtered by head ref +
#                                     createdAt < now-24h.
#
# Pure consumer of telemetry — no new event types (P-6), no fleet_emit_event
# calls, no fleet_* signature changes. Read-only side effects: writes a
# single epoch line to $XDG_CACHE_HOME/fleet/inbox-state on each run via
# temp-file + mv (per LESSONS 2026-05-27 — no `$(cat …)` round-trip).

# Test seam: FLEET_INBOX_FAKE_NOW (epoch seconds) overrides "now" so the
# golden file's banner DATE column stays stable.
inbox_now() {
  echo "${FLEET_INBOX_FAKE_NOW:-$(date -u +%s)}"
}

# Path of the inbox-state marker (one epoch-second line per run).
inbox_state_path() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/fleet"
  mkdir -p "$cache" 2>/dev/null || true
  echo "$cache/inbox-state"
}

# Path of the last-weekly-run marker (touched by `fleet weekly` in a
# future patch; today, we just probe its mtime — absence = never).
inbox_weekly_marker_path() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/fleet"
  echo "$cache/last-weekly-run"
}

# Atomic write: temp-file + `mv`. Per LESSONS 2026-05-27, never use
# $(cat …) to round-trip content; here we just emit a single epoch line.
inbox_write_state() {
  local path="$1" epoch="$2"
  local tmp; tmp="$(mktemp -t inbox-state.XXXXXX)" || return 0
  printf '%s\n' "$epoch" > "$tmp"
  mv -f "$tmp" "$path" 2>/dev/null || rm -f "$tmp"
}

# Count <!-- DRAFT: reviewer send-back, PR #N, DATE --> markers in a
# project's docs/LESSONS.md. v1 uses the marker count directly (the events
# channel is the cross-check, not the source, per the AC).
# $1 = project dir. Echoes 0 when file is absent.
inbox_count_drafts() {
  local proj_dir="$1"
  local lf
  for lf in "$proj_dir/docs/LESSONS.md" "$proj_dir/LESSONS.md"; do
    [ -f "$lf" ] || continue
    # LESSONS 2026-05-30: grep -F with a leading-dash-safe pattern uses --.
    # grep -c exits 1 on zero matches, which would chain `|| echo 0` and
    # produce "0\n0" — use awk so the exit code is always 0 and the count
    # is the only thing on stdout.
    awk '/<!-- DRAFT: / { n++ } END { print (n+0) }' "$lf"
    return 0
  done
  echo 0
}

# Days until a YYYYMMDD self-cancel date. Echoes a possibly-negative int
# or empty when SELF_CANCEL is unset / unparseable. Honours
# FLEET_INBOX_FAKE_NOW so the golden file's countdown stays stable.
inbox_self_cancel_days() {
  local sc="$1"
  case "$sc" in
    ''|*[!0-9]*) echo ""; return 0 ;;
  esac
  local target; target=$(date -u -j -f "%Y%m%d" "$sc" +%s 2>/dev/null) || { echo ""; return 0; }
  local now_epoch; now_epoch="$(inbox_now)"
  local today_iso today_epoch
  today_iso="$(date -u -r "$now_epoch" +%Y%m%d 2>/dev/null || date -u -d "@$now_epoch" +%Y%m%d)"
  today_epoch=$(date -u -j -f "%Y%m%d" "$today_iso" +%s 2>/dev/null) \
    || today_epoch=$(date -u -d "$today_iso" +%s 2>/dev/null) || today_epoch=0
  echo $(( (target - today_epoch) / 86400 ))
}

# Count budget_block events in TODAY's UTC window for one project.
# $1 = events.jsonl path. Echoes integer.
inbox_budget_block_today() {
  local events="$1"
  [ -f "$events" ] || { echo 0; return 0; }
  local now today_iso
  now="$(inbox_now)"
  today_iso="$(date -u -r "$now" +%Y-%m-%d 2>/dev/null || date -u -d "@$now" +%Y-%m-%d)"
  # Match lines where type=budget_block and ts begins with today's UTC date.
  awk -v day="$today_iso" '
    {
      ts=""; type=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (type != "budget_block") next
      if (index(ts, day) != 1) next
      n++
    }
    END { print (n+0) }
  ' "$events"
}

# Pull the most recent budget_block event's spent + cap for the today
# window. Echoes "SPENT\tCAP" or empty. Used to render "$<spent>/$<cap>".
inbox_budget_block_today_amounts() {
  local events="$1"
  [ -f "$events" ] || return 0
  local now today_iso
  now="$(inbox_now)"
  today_iso="$(date -u -r "$now" +%Y-%m-%d 2>/dev/null || date -u -d "@$now" +%Y-%m-%d)"
  awk -v day="$today_iso" '
    {
      ts=""; type=""; spent=""; cap=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (match($0, /"spent"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        spent=substr($0, RSTART, RLENGTH)
        sub(/.*"spent"[[:space:]]*:[[:space:]]*"/, "", spent); sub(/".*/, "", spent)
      }
      if (match($0, /"cap"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        cap=substr($0, RSTART, RLENGTH)
        sub(/.*"cap"[[:space:]]*:[[:space:]]*"/, "", cap); sub(/".*/, "", cap)
      }
      if (type != "budget_block") next
      if (index(ts, day) != 1) next
      last_spent = spent; last_cap = cap
    }
    END { if (last_spent != "" || last_cap != "") printf("%s\t%s", last_spent, last_cap) }
  ' "$events"
}

# Query open agent PRs older than 24h for one project. Echoes one
# "NUMBER\tAGE_LABEL" line per PR. Caller is responsible for skipping
# this section entirely when gh is unavailable.
# $1 = REPO (owner/name), $2 = now_epoch.
inbox_stuck_prs_for_repo() {
  local repo="$1" now_epoch="$2"
  [ -n "$repo" ] || return 0
  command -v gh >/dev/null 2>&1 || return 0
  local cutoff=$(( now_epoch - 24 * 3600 ))
  local json
  json=$(gh pr list --repo "$repo" --state open --base main \
           --json headRefName,number,createdAt 2>/dev/null) || return 0
  [ -z "$json" ] && return 0
  printf '%s' "$json" | awk -v cutoff="$cutoff" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    function age_label(diff,    d, h) {
      if (diff < 0) diff = 0
      d = int(diff / 86400)
      if (d >= 1) return d "d"
      h = int(diff / 3600)
      return h "h"
    }
    {
      # Tokenize the single-line JSON into PR records. The gh CLI emits a
      # JSON array; we split on "},{" plus the brackets.
      buf = $0
      gsub(/^\[/, "", buf); gsub(/\]$/, "", buf)
      n = split(buf, recs, /\},\{/)
      for (i = 1; i <= n; i++) {
        rec = recs[i]
        gsub(/^\{/, "", rec); gsub(/\}$/, "", rec)
        head=""; num=""; created=""
        if (match(rec, /"headRefName"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
          head = substr(rec, RSTART, RLENGTH)
          sub(/.*"headRefName"[[:space:]]*:[[:space:]]*"/, "", head); sub(/".*/, "", head)
        }
        if (match(rec, /"number"[[:space:]]*:[[:space:]]*[0-9]+/)) {
          num = substr(rec, RSTART, RLENGTH)
          sub(/.*:[[:space:]]*/, "", num)
        }
        if (match(rec, /"createdAt"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
          created = substr(rec, RSTART, RLENGTH)
          sub(/.*"createdAt"[[:space:]]*:[[:space:]]*"/, "", created); sub(/".*/, "", created)
        }
        if (head == "" || num == "" || created == "") continue
        if (head !~ /^(feat\/|chore\/gtm-|eng\/)/) continue
        ep = iso2ep(created)
        if (ep == 0 || ep > cutoff) continue
        diff = cutoff + 86400 - ep  # = now - created (cutoff = now - 86400)
        printf("%s\t%s\n", num, age_label(diff))
      }
    }
  '
}

# Render one "two-column-with-hint" data row. Slug column 14ch wide (same
# as weekly_render_row), then the descriptor + hint padded. LESSONS
# 2026-05-28 — values starting with `-` would trip printf; we always
# precede the format with `--`.
inbox_render_row() {
  local slug="$1" descriptor="$2" hint="$3"
  # 14ch slug col, 15ch descriptor col, then hint flows.
  printf -- '  %-14s %-15s %s\n' "$slug" "$descriptor" "$hint"
}

# Build the JSON object for one section. Echoes a single line to stdout.
inbox_emit_json_section() {
  local section="$1" count="$2" items_json="$3"
  printf -- '{"section":"%s","count":%s,"items":[%s]}\n' \
    "$section" "$count" "$items_json"
}

# Append a `{"slug":..,"count":..,"hint":..}` JSON item to a comma-joined
# accumulator. Echoes the new accumulator value.
inbox_append_item_json() {
  local acc="$1" slug="$2" count="$3" hint="$4"
  local esc_slug esc_hint
  esc_slug="$(doctor_json_escape "$slug")"
  esc_hint="$(doctor_json_escape "$hint")"
  local row="{\"slug\":\"$esc_slug\",\"count\":$count,\"hint\":\"$esc_hint\"}"
  if [ -z "$acc" ]; then printf '%s' "$row"
  else                    printf '%s,%s' "$acc" "$row"
  fi
}

inbox() {
  shift  # drop the leading "inbox"
  local want_json=0 slug_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)    want_json=1; shift ;;
      --slug)
        if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
          echo "fleet inbox: --slug requires a non-empty value" >&2
          exit 2
        fi
        slug_filter="$2"; shift 2 ;;
      --slug=*)
        slug_filter="${1#--slug=}"
        if [ -z "$slug_filter" ]; then
          echo "fleet inbox: --slug requires a non-empty value" >&2
          exit 2
        fi
        shift ;;
      -h|--help)
        cat <<USAGE
fleet inbox — daily TODO list the operator owes the loop.

Usage:
  fleet inbox                   default human output
  fleet inbox --slug NAME       restrict every section to one project
  fleet inbox --json            one JSON object per section + 1 summary

Sections (always in this order; renders headline count when zero):
  drafts to promote             <!-- DRAFT: --> markers in docs/LESSONS.md
  self-cancel expiring (<=7d)   SELF_CANCEL within today + 7d (or EXPIRED)
  paused projects               agent-ship label disabled in launchctl
  budget tripped today          budget_block events in today's UTC day
  in-flight agent PRs >24h old  open feat/, chore/gtm-, eng/ PRs >24h old

Read-only — no commits, no PRs, no new event types.
Exit code: 0 always (it is a report); 2 on usage error.
USAGE
        exit 0 ;;
      *) echo "fleet inbox: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  local now_epoch; now_epoch="$(inbox_now)"
  local today_iso
  today_iso="$(date -u -r "$now_epoch" +%F 2>/dev/null || date -u -d "@$now_epoch" +%F)"

  # "since last run" header — read inbox-state mtime, then immediately
  # write the marker for the NEXT invocation (atomic temp-file + mv).
  local state_path; state_path="$(inbox_state_path)"
  local since_label="never" since_seconds_json="null"
  if [ -f "$state_path" ]; then
    local prev_mtime
    prev_mtime="$(stat -f %m "$state_path" 2>/dev/null || stat -c %Y "$state_path" 2>/dev/null)"
    if [ -n "$prev_mtime" ]; then
      local diff=$(( now_epoch - prev_mtime ))
      [ "$diff" -lt 0 ] && diff=0
      since_seconds_json="$diff"
      if   [ "$diff" -lt 3600 ];  then since_label="$(( diff / 60 ))m ago"
      elif [ "$diff" -lt 86400 ]; then since_label="$(( diff / 3600 ))h ago"
      else                              since_label="$(( diff / 86400 ))d ago"
      fi
    fi
  fi
  inbox_write_state "$state_path" "$now_epoch"

  # Banner (human only).
  if [ "$want_json" != "1" ]; then
    if [ "$since_label" = "never" ]; then
      printf 'FLEET INBOX — %s (since last run never)\n' "$today_iso"
    else
      printf 'FLEET INBOX — %s (since last run %s)\n' "$today_iso" "$since_label"
    fi
    printf '\n'
  fi

  # ----- Aggregation pass -----------------------------------------------
  # Discover (slug, manifest) rows. Reuse weekly_discover for consistency.
  local drafts_total=0 drafts_proj_count=0
  local sc_total=0 paused_total=0 budget_total=0 stuck_total=0
  local drafts_rows="" sc_rows="" paused_rows="" budget_rows="" stuck_rows=""
  local drafts_json="" sc_json="" paused_json="" budget_json="" stuck_json=""

  local slug manifest proj_dir
  local gh_available=1
  command -v gh >/dev/null 2>&1 || gh_available=0

  while IFS=$'\t' read -r slug manifest; do
    [ -z "$slug" ] && continue
    [ -n "$slug_filter" ] && [ "$slug" != "$slug_filter" ] && continue
    proj_dir="$(dirname "$manifest")"

    # Manifest probe — fetch SELF_CANCEL + NAMESPACE + REPO_URL.
    local probe namespace self_cancel repo_url
    probe=$(
      # shellcheck disable=SC1090
      ( source "$manifest" 2>/dev/null
        echo "NAMESPACE=${NAMESPACE:-com.fleet.${SLUG:-x}}"
        echo "SELF_CANCEL=${SELF_CANCEL:-}"
        echo "REPO_URL=${REPO_URL:-}"
      ) 2>/dev/null
    ) || true
    namespace="$(echo "$probe" | sed -n 's/^NAMESPACE=//p')"
    self_cancel="$(echo "$probe" | sed -n 's/^SELF_CANCEL=//p')"
    repo_url="$(echo "$probe" | sed -n 's/^REPO_URL=//p')"
    local repo_slug
    repo_slug="$(echo "$repo_url" | sed -E 's#https?://github.com/##; s#\.git$##')"

    local cache_dir="$HOME/.cache/${slug}-agent"
    local events="$cache_dir/events.jsonl"

    # --- Section 1: drafts ---
    local n_drafts
    n_drafts="$(inbox_count_drafts "$proj_dir")"
    if [ "$n_drafts" -gt 0 ]; then
      drafts_total=$(( drafts_total + n_drafts ))
      drafts_proj_count=$(( drafts_proj_count + 1 ))
      local d_word="drafts"
      [ "$n_drafts" = "1" ] && d_word="draft"
      drafts_rows+="$slug"$'\t'"$n_drafts $d_word"$'\t'"docs/LESSONS.md"$'\n'
      drafts_json="$(inbox_append_item_json "$drafts_json" "$slug" "$n_drafts" "docs/LESSONS.md")"
    fi

    # --- Section 2: self-cancel ---
    local sc_days
    sc_days="$(inbox_self_cancel_days "$self_cancel")"
    if [ -n "$sc_days" ]; then
      if [ "$sc_days" -lt 0 ]; then
        sc_total=$(( sc_total + 1 ))
        sc_rows+="$slug"$'\t'"EXPIRED"$'\t'"bump SELF_CANCEL in agents.config.sh"$'\n'
        sc_json="$(inbox_append_item_json "$sc_json" "$slug" "$sc_days" "bump SELF_CANCEL in agents.config.sh")"
      elif [ "$sc_days" -le 7 ]; then
        sc_total=$(( sc_total + 1 ))
        sc_rows+="$slug"$'\t'"${sc_days}d"$'\t'"bump SELF_CANCEL in agents.config.sh"$'\n'
        sc_json="$(inbox_append_item_json "$sc_json" "$slug" "$sc_days" "bump SELF_CANCEL in agents.config.sh")"
      fi
    fi

    # --- Section 3: paused ---
    local is_paused
    is_paused="$(weekly_is_paused "$namespace")"
    if [ "$is_paused" = "1" ]; then
      paused_total=$(( paused_total + 1 ))
      local paused_days
      paused_days="$(weekly_paused_days "$namespace")"
      [ -z "$paused_days" ] && paused_days=0
      paused_rows+="$slug"$'\t'"paused ${paused_days}d ago"$'\t'"launchctl enable gui/\$UID/${namespace}.agent-ship"$'\n'
      paused_json="$(inbox_append_item_json "$paused_json" "$slug" "$paused_days" "launchctl enable gui/\$UID/${namespace}.agent-ship")"
    fi

    # --- Section 4: budget tripped today ---
    local n_bg
    n_bg="$(inbox_budget_block_today "$events")"
    if [ "$n_bg" -gt 0 ]; then
      budget_total=$(( budget_total + 1 ))
      local amounts spent cap descriptor
      amounts="$(inbox_budget_block_today_amounts "$events")"
      spent="$(printf '%s' "$amounts" | cut -f1)"
      cap="$(  printf '%s' "$amounts" | cut -f2)"
      [ -z "$spent" ] && spent="0.00"
      [ -z "$cap" ]   && cap="0.00"
      descriptor="\$$spent/\$$cap"
      budget_rows+="$slug"$'\t'"$descriptor"$'\t'"bump MAX_DAILY_USD or wait for tomorrow"$'\n'
      budget_json="$(inbox_append_item_json "$budget_json" "$slug" "$n_bg" "bump MAX_DAILY_USD or wait for tomorrow")"
    fi

    # --- Section 5: stuck PRs (skip silently when gh unavailable) ---
    if [ "$gh_available" = "1" ] && [ -n "$repo_slug" ]; then
      local prs
      prs="$(inbox_stuck_prs_for_repo "$repo_slug" "$now_epoch")"
      if [ -n "$prs" ]; then
        local pr_line pr_num pr_age
        while IFS=$'\t' read -r pr_num pr_age; do
          [ -z "$pr_num" ] && continue
          stuck_total=$(( stuck_total + 1 ))
          stuck_rows+="$slug"$'\t'"PR #${pr_num} ${pr_age}"$'\t'"gh pr view ${pr_num}"$'\n'
          stuck_json="$(inbox_append_item_json "$stuck_json" "$slug" "$pr_num" "gh pr view ${pr_num}")"
          : "$pr_line"
        done <<EOF
$prs
EOF
      fi
    fi
  done < <(weekly_discover)

  # ----- Render --------------------------------------------------------
  if [ "$want_json" = "1" ]; then
    inbox_emit_json_section "drafts"      "$drafts_total"  "$drafts_json"
    inbox_emit_json_section "self_cancel" "$sc_total"      "$sc_json"
    inbox_emit_json_section "paused"      "$paused_total"  "$paused_json"
    inbox_emit_json_section "budget"      "$budget_total"  "$budget_json"
    inbox_emit_json_section "stuck_prs"   "$stuck_total"   "$stuck_json"
    local total_items=$(( drafts_total + sc_total + paused_total + budget_total + stuck_total ))
    printf -- '{"summary":true,"sections":5,"items":%s,"since_last_run_seconds":%s}\n' \
      "$total_items" "$since_seconds_json"
    exit 0
  fi

  # Human output. Each section headline always prints (even zero).
  local headline
  if [ "$drafts_total" -gt 0 ]; then
    headline="$drafts_total across $drafts_proj_count project"
    [ "$drafts_proj_count" -gt 1 ] && headline="${headline}s"
  else
    headline="0"
  fi
  printf -- '%-34s%s\n' "drafts to promote" "$headline"
  if [ -n "$drafts_rows" ]; then
    while IFS=$'\t' read -r slug descriptor hint; do
      [ -z "$slug" ] && continue
      inbox_render_row "$slug" "$descriptor" "$hint"
    done <<EOF
$drafts_rows
EOF
  fi
  printf '\n'

  printf -- '%-34s%s\n' "self-cancel expiring (<=7d)" "$sc_total"
  if [ -n "$sc_rows" ]; then
    while IFS=$'\t' read -r slug descriptor hint; do
      [ -z "$slug" ] && continue
      inbox_render_row "$slug" "$descriptor" "$hint"
    done <<EOF
$sc_rows
EOF
  fi
  printf '\n'

  printf -- '%-34s%s\n' "paused projects" "$paused_total"
  if [ -n "$paused_rows" ]; then
    while IFS=$'\t' read -r slug descriptor hint; do
      [ -z "$slug" ] && continue
      inbox_render_row "$slug" "$descriptor" "$hint"
    done <<EOF
$paused_rows
EOF
  fi
  printf '\n'

  printf -- '%-34s%s\n' "budget tripped today" "$budget_total"
  if [ -n "$budget_rows" ]; then
    while IFS=$'\t' read -r slug descriptor hint; do
      [ -z "$slug" ] && continue
      inbox_render_row "$slug" "$descriptor" "$hint"
    done <<EOF
$budget_rows
EOF
  fi
  printf '\n'

  if [ "$gh_available" = "0" ]; then
    printf -- '%-34s%s\n' "in-flight agent PRs >24h old" "0"
    printf -- '  (skipped: gh not available)\n'
  else
    printf -- '%-34s%s\n' "in-flight agent PRs >24h old" "$stuck_total"
    if [ -n "$stuck_rows" ]; then
      while IFS=$'\t' read -r slug descriptor hint; do
        [ -z "$slug" ] && continue
        inbox_render_row "$slug" "$descriptor" "$hint"
      done <<EOF
$stuck_rows
EOF
    fi
  fi
  printf '\n'

  # Trailing "nothing else owes you a click. last weekly: <age>" line.
  local weekly_marker; weekly_marker="$(inbox_weekly_marker_path)"
  local weekly_age="never"
  if [ -f "$weekly_marker" ]; then
    local wm_mtime
    wm_mtime="$(stat -f %m "$weekly_marker" 2>/dev/null || stat -c %Y "$weekly_marker" 2>/dev/null)"
    if [ -n "$wm_mtime" ]; then
      local wm_diff=$(( now_epoch - wm_mtime ))
      [ "$wm_diff" -lt 0 ] && wm_diff=0
      if   [ "$wm_diff" -lt 3600 ];  then weekly_age="$(( wm_diff / 60 ))m ago"
      elif [ "$wm_diff" -lt 86400 ]; then weekly_age="$(( wm_diff / 3600 ))h ago"
      else                                 weekly_age="$(( wm_diff / 86400 ))d ago"
      fi
    fi
  fi
  if [ "$weekly_age" = "never" ]; then
    printf -- 'nothing else owes you a click. last weekly: never — try `fleet weekly`.\n'
  else
    printf -- 'nothing else owes you a click. last weekly: %s — try `fleet weekly`.\n' "$weekly_age"
  fi

  exit 0
}

if [ "$CMD" = "inbox" ]; then
  inbox "$@"
fi

# --- prompts-score (ticket 0024) -----------------------------------------
# `fleet prompts-score <slug> [--since Nh|Nd] [--json]` grades each prompt
# revision the project ran against, using events.jsonl + runs.jsonl as the
# rear-view mirror. Group key is the PROMPTS_SHA in effect at each run's
# ts_start; the timeline comes from `prompts_pin_changed` events emitted
# by lib/install.sh (this ticket) with `prompts_drift` events as the
# fallback for projects that haven't re-installed since the new pin
# tracking landed.
#
# Output (human): one header row, one row per revision, optional trend
# line when ≥2 revisions are present. The current revision (the SHA in
# effect at the latest event timestamp) carries a trailing `← current`
# marker. JSON output (--json) is one JSON object per line.
#
# Reuses digest_parse_since / digest_iso_to_epoch from the digest helpers
# above; the JSON-line awk patterns mirror digest_event_count_since.

# Test seam: FLEET_PROMPTS_SCORE_FAKE_NOW (epoch seconds) overrides "now"
# so the golden file's DATE column stays stable.
prompts_score_now() {
  echo "${FLEET_PROMPTS_SCORE_FAKE_NOW:-$(date -u +%s)}"
}

# Build the (epoch \t sha) timeline of prompt-pin transitions from
# events.jsonl, sorted ascending by epoch. prompts_pin_changed events are
# authoritative (the `new` field is the SHA going forward).
# prompts_drift events are the fallback for projects that haven't yet
# re-installed under the new code path: they carry `actual` as the SHA
# the runner observed.
#
# $1 = path to events.jsonl. Emits one "EPOCH<TAB>SHA" line per
# transition to stdout. No file = empty output.
prompts_score_assemble_timeline() {
  local events="$1"
  [ -f "$events" ] || return 0
  awk '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    function field(line, key,    s) {
      if (match(line, "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\"")) {
        s = substr(line, RSTART, RLENGTH)
        sub(".*\"" key "\"[[:space:]]*:[[:space:]]*\"", "", s)
        sub("\".*", "", s)
        return s
      }
      return ""
    }
    {
      type = field($0, "type"); if (type == "") next
      ts   = field($0, "ts");   if (ts   == "") next
      sha  = ""
      if (type == "prompts_pin_changed") {
        sha = field($0, "new")
      } else if (type == "prompts_drift") {
        sha = field($0, "actual")
      } else {
        next
      }
      if (sha == "") next
      ep = iso2ep(ts)
      if (ep == 0) next
      printf("%d\t%s\n", ep, sha)
    }
  ' "$events" | sort -n -k1,1
}

# Resolve every event of interest (pr_opened, gate_failed,
# lesson_draft_emitted, infra_flake_rerun) to its SHA via the timeline,
# and aggregate per-SHA counters. Inputs:
#   $1 = path to events.jsonl
#   $2 = path to a tmp file containing the timeline (epoch\tsha lines)
#   $3 = cutoff epoch (events with ts < cutoff are skipped)
# Emits one "SHA<TAB>PRS<TAB>DRAFTS<TAB>HEAL<TAB>INFRA" line per SHA seen.
prompts_score_aggregate_events() {
  local events="$1" timeline="$2" cutoff="$3"
  [ -f "$events" ] || return 0
  awk -v cutoff="$cutoff" -v timeline="$timeline" '
    BEGIN {
      n = 0
      while ((getline line < timeline) > 0) {
        split(line, a, "\t")
        tl_ep[n]  = a[1] + 0
        tl_sha[n] = a[2]
        n++
      }
      close(timeline)
    }
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    function field(line, key,    s) {
      if (match(line, "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\"")) {
        s = substr(line, RSTART, RLENGTH)
        sub(".*\"" key "\"[[:space:]]*:[[:space:]]*\"", "", s)
        sub("\".*", "", s)
        return s
      }
      return ""
    }
    function sha_at(ep,    i, found) {
      found = ""
      for (i = 0; i < n; i++) {
        if (tl_ep[i] <= ep) { found = tl_sha[i] }
        else break
      }
      return found
    }
    {
      type = field($0, "type"); if (type == "") next
      if (type != "pr_opened" && type != "gate_failed" \
          && type != "lesson_draft_emitted" && type != "infra_flake_rerun") next
      ts = field($0, "ts"); if (ts == "") next
      ep = iso2ep(ts)
      if (ep < cutoff + 0) next
      sha = sha_at(ep)
      if (sha == "") next
      if (type == "pr_opened")            prs[sha]++
      else if (type == "lesson_draft_emitted") drafts[sha]++
      else if (type == "gate_failed")     heal[sha]++
      else if (type == "infra_flake_rerun") infra[sha]++
      seen[sha] = 1
    }
    END {
      for (sha in seen) {
        printf("%s\t%d\t%d\t%d\t%d\n",
               sha, prs[sha]+0, drafts[sha]+0, heal[sha]+0, infra[sha]+0)
      }
    }
  ' "$events"
}

# Aggregate runs.jsonl into per-SHA RUNS count + summed spend. Same
# timeline-lookup pattern. Emits "SHA<TAB>RUNS<TAB>SPEND" per SHA.
prompts_score_aggregate_runs() {
  local runs="$1" timeline="$2" cutoff="$3"
  [ -f "$runs" ] || return 0
  awk -v cutoff="$cutoff" -v timeline="$timeline" '
    BEGIN {
      n = 0
      while ((getline line < timeline) > 0) {
        split(line, a, "\t")
        tl_ep[n]  = a[1] + 0
        tl_sha[n] = a[2]
        n++
      }
      close(timeline)
    }
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    function sha_at(ep,    i, found) {
      found = ""
      for (i = 0; i < n; i++) {
        if (tl_ep[i] <= ep) { found = tl_sha[i] }
        else break
      }
      return found
    }
    {
      ts = ""; cost = 0
      if (match($0, /"ts_start"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts = substr($0, RSTART, RLENGTH)
        sub(/.*"ts_start"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"total_cost_usd"[[:space:]]*:[[:space:]]*-?[0-9.eE+-]+/)) {
        c = substr($0, RSTART, RLENGTH); sub(/.*:[[:space:]]*/, "", c); cost = c + 0
      }
      if (ts == "") next
      ep = iso2ep(ts)
      if (ep < cutoff + 0) next
      sha = sha_at(ep)
      if (sha == "") next
      runs_n[sha]++
      spend[sha] += cost
      seen[sha] = 1
    }
    END {
      for (sha in seen) {
        printf("%s\t%d\t%.6f\n", sha, runs_n[sha]+0, spend[sha]+0)
      }
    }
  ' "$runs"
}

# Format a row. Args: sha date runs prs sendback_pct drafts heal_per_pr
# infra_flake spend_per_pr is_current.
prompts_score_render_row() {
  local sha="$1" date="$2" runs="$3" prs="$4" sendback="$5" drafts="$6"
  local heal="$7" infra="$8" spend="$9" is_current="${10}"
  local marker=""
  [ "$is_current" = "1" ] && marker="  ← current"
  # Column widths chosen to match the AC sample header:
  # SHA(7) DATE(10) RUNS(4) PRS(4) SENDBACK%(9) DRAFTS(6) HEAL/PR(7) INFRA-FLK(9) $/PR(5)
  printf -- '%-7s  %-10s  %4s  %4s  %9s  %6s  %7s  %9s  %5s%s\n' \
    "$sha" "$date" "$runs" "$prs" "$sendback" "$drafts" "$heal" "$infra" "$spend" "$marker"
}

prompts_score() {
  shift  # drop "prompts-score"
  local slug="" since="7d" want_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)     want_json=1; shift ;;
      --since)    since="${2:-}"; shift 2 ;;
      --since=*)  since="${1#--since=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet prompts-score — grade each prompt revision against the event log.

Usage:
  fleet prompts-score <slug>                   default --since 7d, table
  fleet prompts-score <slug> --since 30d       widen the window (Nh or Nd)
  fleet prompts-score <slug> --json            one JSON object per revision

Columns:
  SHA | DATE | RUNS | PRS | SENDBACK% | DRAFTS | HEAL/PR | INFRA-FLK | \$/PR

Per-revision metrics, drawn from events.jsonl + runs.jsonl under
\$HOME/.cache/<slug>-agent/. The current revision (SHA in effect at the
latest event timestamp) is marked with a trailing 'left-arrow current'.
USAGE
        exit 0 ;;
      --)         shift ;;
      -*)
        echo "prompts-score: unknown flag '$1'" >&2
        exit 2 ;;
      *)
        if [ -z "$slug" ]; then slug="$1"; shift
        else echo "prompts-score: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$slug" ]; then
    echo "prompts-score: missing <slug> argument" >&2
    exit 2
  fi

  local since_seconds
  if ! since_seconds="$(digest_parse_since "$since")"; then
    echo "prompts-score: invalid --since \"$since\" (use Nh or Nd)" >&2
    exit 2
  fi

  local cache_dir="$HOME/.cache/${slug}-agent"
  local events="$cache_dir/events.jsonl"
  local runs="$cache_dir/runs.jsonl"

  # Empty/missing events is not an error — it's a fresh project. Print the
  # documented message to stderr and exit 0.
  if [ ! -s "$events" ]; then
    echo "prompts-score: no events found for $slug (cache: $events)" >&2
    exit 0
  fi

  local now cutoff
  now="$(prompts_score_now)"
  cutoff=$(( now - since_seconds ))

  # Assemble the full timeline (every transition ever recorded). We need
  # the entries BEFORE the cutoff to seed each row's "what SHA was in
  # effect when this event landed?" lookup — without them, the row that
  # spans the cutoff would have no SHA. We pre-filter aggregation by
  # cutoff inside the awk passes.
  local timeline_file; timeline_file="$(mktemp -t prompts-score-tl.XXXXXX)"
  prompts_score_assemble_timeline "$events" > "$timeline_file"
  if [ ! -s "$timeline_file" ]; then
    rm -f "$timeline_file"
    echo "prompts-score: no events found for $slug (cache: $events)" >&2
    exit 0
  fi

  # Aggregate events + runs by SHA.
  local events_agg runs_agg
  events_agg="$(prompts_score_aggregate_events "$events" "$timeline_file" "$cutoff")"
  runs_agg="$(prompts_score_aggregate_runs "$runs" "$timeline_file" "$cutoff")"

  # Determine the current SHA — the last entry in the timeline.
  local current_sha
  current_sha="$(tail -n 1 "$timeline_file" | awk -F'\t' '{print $2}')"

  # Build the union of SHAs that have at least one event or one run in window.
  # Use a temp file so we can preserve order via the timeline's epoch sort.
  local union_file; union_file="$(mktemp -t prompts-score-u.XXXXXX)"
  {
    [ -n "$events_agg" ] && echo "$events_agg" | awk -F'\t' '{print $1}'
    [ -n "$runs_agg" ]   && echo "$runs_agg"   | awk -F'\t' '{print $1}'
  } | sort -u > "$union_file"

  # If nothing fell in the window, treat that like "no events found" so a
  # too-tight --since doesn't produce an empty table.
  if [ ! -s "$union_file" ]; then
    rm -f "$timeline_file" "$union_file"
    echo "prompts-score: no events found for $slug (cache: $events)" >&2
    exit 0
  fi

  # Order SHAs by their first-appearance epoch in the timeline. SHAs not
  # in the timeline (data-only) sort last.
  local ordered_shas
  ordered_shas="$(
    while IFS= read -r sha; do
      [ -z "$sha" ] && continue
      local ep
      ep="$(awk -F'\t' -v s="$sha" '$2 == s { print $1; exit }' "$timeline_file")"
      [ -z "$ep" ] && ep=9999999999
      printf '%s\t%s\n' "$ep" "$sha"
    done < "$union_file" | sort -n -k1,1 | awk -F'\t' '{print $2}'
  )"

  # Render. Human mode prints the header + a separator + one row per SHA;
  # JSON mode skips the header and emits one JSON object per line.
  local header sep_line
  header='SHA      DATE        RUNS  PRS   SENDBACK%  DRAFTS  HEAL/PR  INFRA-FLK  $/PR'
  # 77 box-drawing chars to underline the header — counts the same as the
  # AC sample. Pure ASCII to keep `LC_ALL=C` safe.
  sep_line="$(printf '%.0s-' $(seq 1 77))"

  if [ "$want_json" != "1" ]; then
    printf '%s\n' "$header"
    printf '%s\n' "$sep_line"
  fi

  # Track the previous row's metrics for the trend line.
  local rows_emitted=0
  local prev_sendback="" prev_heal="" prev_spend=""
  local cur_sendback="" cur_heal="" cur_spend=""
  local sha
  while IFS= read -r sha; do
    [ -z "$sha" ] && continue
    local row_prs row_drafts row_heal row_infra row_runs row_spend
    row_prs=0; row_drafts=0; row_heal=0; row_infra=0
    row_runs=0; row_spend=0
    if [ -n "$events_agg" ]; then
      local er
      er="$(echo "$events_agg" | awk -F'\t' -v s="$sha" '$1 == s { print; exit }')"
      if [ -n "$er" ]; then
        row_prs="$(echo "$er" | awk -F'\t' '{print $2}')"
        row_drafts="$(echo "$er" | awk -F'\t' '{print $3}')"
        row_heal="$(echo "$er" | awk -F'\t' '{print $4}')"
        row_infra="$(echo "$er" | awk -F'\t' '{print $5}')"
      fi
    fi
    if [ -n "$runs_agg" ]; then
      local rr
      rr="$(echo "$runs_agg" | awk -F'\t' -v s="$sha" '$1 == s { print; exit }')"
      if [ -n "$rr" ]; then
        row_runs="$(echo "$rr" | awk -F'\t' '{print $2}')"
        row_spend="$(echo "$rr" | awk -F'\t' '{print $3}')"
      fi
    fi

    # DATE — the YYYY-MM-DD of this SHA's first appearance in the
    # timeline. Falls back to "—" if the SHA never appears (shouldn't
    # happen given the union construction, but defensive).
    local sha_epoch row_date
    sha_epoch="$(awk -F'\t' -v s="$sha" '$2 == s { print $1; exit }' "$timeline_file")"
    if [ -n "$sha_epoch" ]; then
      row_date="$(date -u -r "$sha_epoch" +%F 2>/dev/null \
                  || date -u -d "@$sha_epoch" +%F 2>/dev/null \
                  || echo "—")"
    else
      row_date="—"
    fi

    # Derived metrics. Guard against divide-by-zero when PRS=0.
    local sendback_pct heal_per_pr spend_per_pr sendback_rate_json heal_per_pr_json spend_per_pr_json
    if [ "$row_prs" -gt 0 ]; then
      sendback_pct="$(awk -v d="$row_drafts" -v p="$row_prs" \
                       'BEGIN { printf("%.1f%%", (d/p)*100) }')"
      heal_per_pr="$(awk -v h="$row_heal" -v p="$row_prs" \
                       'BEGIN { printf("%.1f", h/p) }')"
      spend_per_pr="$(awk -v s="$row_spend" -v p="$row_prs" \
                       'BEGIN { printf("$%.2f", s/p) }')"
      sendback_rate_json="$(awk -v d="$row_drafts" -v p="$row_prs" \
                       'BEGIN { printf("%.4f", d/p) }')"
      heal_per_pr_json="$(awk -v h="$row_heal" -v p="$row_prs" \
                       'BEGIN { printf("%.4f", h/p) }')"
      spend_per_pr_json="$(awk -v s="$row_spend" -v p="$row_prs" \
                       'BEGIN { printf("%.4f", s/p) }')"
    else
      sendback_pct="0.0%"
      heal_per_pr="0.0"
      spend_per_pr="\$0.00"
      sendback_rate_json="0.0000"
      heal_per_pr_json="0.0000"
      spend_per_pr_json="0.0000"
    fi

    local is_current=0
    [ "$sha" = "$current_sha" ] && is_current=1

    if [ "$want_json" = "1" ]; then
      local is_current_json="false"
      [ "$is_current" = "1" ] && is_current_json="true"
      printf '{"sha":"%s","date":"%s","runs":%s,"prs":%s,"sendback_rate":%s,"drafts":%s,"heal_per_pr":%s,"infra_flake":%s,"spend_per_pr":%s,"is_current":%s}\n' \
        "$sha" "$row_date" "$row_runs" "$row_prs" "$sendback_rate_json" \
        "$row_drafts" "$heal_per_pr_json" "$row_infra" "$spend_per_pr_json" \
        "$is_current_json"
    else
      prompts_score_render_row "$sha" "$row_date" "$row_runs" "$row_prs" \
        "$sendback_pct" "$row_drafts" "$heal_per_pr" "$row_infra" \
        "$spend_per_pr" "$is_current"
    fi

    # Track for trend line (we use the LAST two rows in display order).
    prev_sendback="$cur_sendback"
    prev_heal="$cur_heal"
    prev_spend="$cur_spend"
    cur_sendback="$(echo "$sendback_pct" | sed 's/%$//')"
    cur_heal="$heal_per_pr"
    cur_spend="$(echo "$spend_per_pr" | sed 's/^\$//')"
    rows_emitted=$(( rows_emitted + 1 ))
  done <<< "$ordered_shas"

  # Trend line: only when ≥2 revisions present AND we're not in JSON mode.
  if [ "$want_json" != "1" ] && [ "$rows_emitted" -ge 2 ]; then
    local d_sendback d_heal d_spend
    d_sendback="$(awk -v c="$cur_sendback" -v p="$prev_sendback" \
                    'BEGIN { printf("%+.1fpp", c - p) }')"
    d_heal="$(awk -v c="$cur_heal" -v p="$prev_heal" \
                'BEGIN { printf("%+.1f", c - p) }')"
    d_spend="$(awk -v c="$cur_spend" -v p="$prev_spend" \
                'BEGIN { printf("$%+.2f", c - p) }')"
    printf 'trend: sendback %s, heal/PR %s, $/PR %s vs previous revision.\n' \
      "$d_sendback" "$d_heal" "$d_spend"
  fi

  rm -f "$timeline_file" "$union_file"
  exit 0
}

if [ "$CMD" = "prompts-score" ]; then
  prompts_score "$@"
fi

# --- tail -----------------------------------------------------------------
# Ticket 0015. `fleet tail` streams events.jsonl entries live, formatted for
# human eyes. With no arg it follows every discovered project concurrently;
# with a positional slug it restricts to one. Flags:
#   --since Ns|Nm|Nh|Nd   pre-roll events from the cutoff window before
#                         following live (per AGENTS.md § Telemetry, `ts` is
#                         ISO8601 UTC so the math is in UTC seconds).
#   --json                emit raw events.jsonl lines instead of the formatted
#                         "<HH:MM:SS>  <slug>/<phase>  <type>  <extras>" form.
#                         Useful for `fleet tail --json | jq .`.
#   --type a,b            comma-separated event-type allowlist. Lines whose
#                         `type` is not in the list are dropped.
#
# Discovery reuses doctor's two-root pattern: $FLEET_DISCOVERY_ROOT first,
# then ~/.local/share/agent-fleet/projects. Per slug we run one `tail -F`
# (capital F: survives rotation, important once ticket 0016 ships) into a
# small shell-only formatter — no `jq` dependency, consistent with the
# events.jsonl producer side (`fleet_emit_event` is also shell-only).
#
# SIGINT/SIGTERM trap kills every background `tail -F` PID so the operator
# can Ctrl-C without leaking processes. Per AGENTS.md § Telemetry, consumers
# MUST tolerate unknown event types — we never special-case `type`, so any
# new event lights up the tail output automatically.
#
# Test hook: $FLEET_TAIL_FAKE_NOW (epoch seconds) overrides the formatter's
# "now" so `--since` replay is deterministic in tests/tail.sh.

TAIL_ROOT="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
TAIL_INSTALLED="$HOME/.local/share/agent-fleet/projects"

# Parse "Ns" / "Nm" / "Nh" / "Nd" to seconds. Echoes the integer + returns 0
# on success; returns 1 + echoes nothing on bad input. Mirrors digest's unit
# parser shape but adds the s/m units the ticket calls for.
tail_parse_since() {
  local s="$1" n unit
  case "$s" in
    *s) unit=s; n="${s%s}" ;;
    *m) unit=m; n="${s%m}" ;;
    *h) unit=h; n="${s%h}" ;;
    *d) unit=d; n="${s%d}" ;;
    *)  return 1 ;;
  esac
  case "$n" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$unit" in
    s) echo "$n" ;;
    m) echo $(( n * 60 )) ;;
    h) echo $(( n * 3600 )) ;;
    d) echo $(( n * 86400 )) ;;
  esac
}

# Resolve discovered slug → events.jsonl path. Same union-by-SLUG pattern as
# the top-level `discover()` helper but standalone (we need the file path,
# not the manifest path) and tied to TAIL_ROOT so tests can override it.
tail_discover_events() {
  local _seen=""
  { find "$TAIL_ROOT" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$TAIL_INSTALLED" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    local slug; slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    [ -z "$slug" ] && continue
    case " $_seen " in *" $slug "*) continue ;; esac
    _seen="$_seen $slug"
    printf '%s\t%s\n' "$slug" "$HOME/.cache/${slug}-agent/events.jsonl"
  done
}

# Format one events.jsonl line for human consumption. Stdin gets the raw
# JSON line; stdout gets either the formatted "HH:MM:SS  slug/phase  type
# extras" string or the JSON line unchanged (when $1 is "json"). No `jq`.
# We pull the four required keys with a tiny awk; everything beyond becomes
# k=v extras in stable JSON-source order.
#
# $1: "json" | "human"
# $2: comma-separated type filter (empty = no filter)
tail_format_stream() {
  local mode="$1" type_filter="$2"
  awk -v mode="$mode" -v filter="$type_filter" '
    function strip_quotes(s) { gsub(/^"|"$/, "", s); return s }
    function field(line, name,    re, start, end, raw) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        # string value — find next unescaped quote.
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      # number/bool/null — read until comma or closing brace.
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    # iso2hms: extract HH:MM:SS from an ISO8601 ts. ts looks like
    # "2026-05-26T14:37:09Z" or "...Z" with fractional seconds. We just
    # find the T and grab the 8 chars after it.
    function iso2hms(ts,    p) {
      p = index(ts, "T")
      if (p == 0) return ts
      return substr(ts, p + 1, 8)
    }
    {
      if ($0 ~ /^[[:space:]]*$/) next
      # Skip control lines (like "waiting for ..." or the per-file headers
      # the OSes tail emits with ==> file <== ) — they come from stdin
      # already (the formatter is downstream of `tail -F`).
      if ($0 ~ /^==>/) next
      ty = field($0, "type")
      if (filter != "") {
        # Match against comma-separated list.
        found = 0
        n = split(filter, parts, ",")
        for (i = 1; i <= n; i++) if (parts[i] == ty) { found = 1; break }
        if (!found) next
      }
      if (mode == "json") { print $0; fflush(); next }
      ts    = field($0, "ts")
      slug  = field($0, "slug")
      phase = field($0, "phase")
      # Extras: every "key":"value" pair except the four required keys.
      extras = ""
      rest = $0
      while (match(rest, /"[^"]+"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        seg = substr(rest, RSTART, RLENGTH)
        rest = substr(rest, RSTART + RLENGTH)
        # Parse seg = "key":"value"
        kq = index(seg, "\""); seg2 = substr(seg, kq + 1)
        kq2 = index(seg2, "\""); k = substr(seg2, 1, kq2 - 1)
        v_part = substr(seg2, kq2 + 1)
        vq = index(v_part, "\""); v_part2 = substr(v_part, vq + 1)
        vq2 = index(v_part2, "\""); v = substr(v_part2, 1, vq2 - 1)
        if (k == "ts" || k == "slug" || k == "phase" || k == "type") continue
        if (extras == "") extras = k "=" v
        else              extras = extras " " k "=" v
      }
      hms = iso2hms(ts)
      if (extras == "") printf("%s  %s/%s  %s\n", hms, slug, phase, ty)
      else              printf("%s  %s/%s  %s  %s\n", hms, slug, phase, ty, extras)
      fflush()
    }
  '
}

# Replay all events in $1 (events.jsonl) whose ts ≥ cutoff_epoch. Stdout is
# raw JSON lines — caller pipes them through tail_format_stream. Tolerates
# a missing file (echoes nothing).
tail_replay_since() {
  local events="$1" cutoff="$2"
  [ -f "$events" ] || return 0
  awk -v cutoff="$cutoff" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      if ($0 ~ /^[[:space:]]*$/) next
      ts = ""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts = substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (ts == "") next
      if (iso2ep(ts) >= cutoff) print $0
    }
  ' "$events"
}

tail_cmd() {
  shift  # drop the leading "tail"
  local want_json=0 since="" type_filter="" slug_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      --since) since="${2:-}"; shift 2 ;;
      --since=*) since="${1#--since=}"; shift ;;
      --type) type_filter="${2:-}"; shift 2 ;;
      --type=*) type_filter="${1#--type=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet tail — stream events.jsonl entries live, formatted for human eyes.

Usage:
  fleet tail                   follow every discovered project concurrently
  fleet tail <slug>            restrict to one project
  fleet tail --since 5m        replay last 5 minutes before following live
  fleet tail --json            emit raw JSON lines (pipe into jq)
  fleet tail --type a,b        filter to a comma-separated type allowlist

Output (human form):
  <HH:MM:SS>  <slug>/<phase>  <type>  <extras k=v ...>

Exits 0 on SIGINT and cleans up background tail -F PIDs.
USAGE
        exit 0 ;;
      --) shift ;;
      -*) echo "fleet tail: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then slug_arg="$1"; shift
        else echo "fleet tail: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  # Resolve --since to a cutoff epoch (0 = no replay).
  local cutoff=0
  if [ -n "$since" ]; then
    local secs
    if ! secs="$(tail_parse_since "$since")"; then
      echo "fleet tail: --since must be Ns|Nm|Nh|Nd (got '$since')" >&2
      exit 2
    fi
    local now
    now="${FLEET_TAIL_FAKE_NOW:-$(date -u +%s)}"
    cutoff=$(( now - secs ))
  fi

  # Pick the format mode for downstream pipes.
  local mode="human"
  [ "$want_json" = "1" ] && mode="json"

  # Collect (slug, events_path) rows we plan to follow.
  local rows
  rows="$(tail_discover_events)"
  if [ -n "$slug_arg" ]; then
    rows="$(printf '%s\n' "$rows" | awk -F'\t' -v s="$slug_arg" '$1 == s')"
    if [ -z "$rows" ]; then
      echo "fleet tail: no project with SLUG=$slug_arg found under $TAIL_ROOT or $TAIL_INSTALLED" >&2
      exit 2
    fi
  fi
  if [ -z "$rows" ]; then
    echo "fleet tail: no projects discovered under $TAIL_ROOT" >&2
    exit 2
  fi

  # Background tail -F PIDs we'll need to clean up on SIGINT/SIGTERM.
  local -a pids=()
  cleanup() {
    local p
    for p in "${pids[@]:-}"; do
      [ -n "$p" ] && kill "$p" 2>/dev/null || true
    done
    # Best-effort: give them a beat, then SIGKILL the stragglers.
    sleep 0.1 2>/dev/null || true
    for p in "${pids[@]:-}"; do
      [ -n "$p" ] && kill -9 "$p" 2>/dev/null || true
    done
    exit 0
  }
  trap cleanup INT TERM

  # Replay phase: emit historical lines from every events.jsonl that exists,
  # in file order per slug. Run BEFORE starting tail -F so the replay output
  # lands before live lines on the formatter's stdin.
  local fifo
  fifo="$(mktemp -u -t fleet-tail.XXXXXX).fifo"
  mkfifo "$fifo"
  # Open the FIFO read end for the formatter. The formatter runs in the
  # foreground so the trap can fire when the operator hits Ctrl-C.
  tail_format_stream "$mode" "$type_filter" < "$fifo" &
  local fmt_pid=$!
  pids+=("$fmt_pid")

  # Open the FIFO write end on fd 3 so producers can append without each one
  # closing it (which would EOF the formatter prematurely).
  exec 3>"$fifo"
  # The FIFO file on disk is no longer needed once both ends are open.
  rm -f "$fifo"

  # Replay step (per slug, in discovery order). Skipped when cutoff == 0.
  if [ "$cutoff" -gt 0 ]; then
    while IFS=$'\t' read -r slug events; do
      [ -z "$slug" ] && continue
      [ -f "$events" ] || continue
      tail_replay_since "$events" "$cutoff" >&3 || true
    done <<<"$rows"
  fi

  # Live follow: one `tail -F` per slug, redirected to the formatter FIFO.
  # If the events.jsonl is missing we surface the wait message (human mode
  # only) and poll until it appears, then start the tailer.
  while IFS=$'\t' read -r slug events; do
    [ -z "$slug" ] && continue
    if [ ! -f "$events" ]; then
      [ "$mode" = "human" ] && echo "waiting for events.jsonl at $events..."
      # Spawn a background poller that waits, then starts tail -F. We DON'T
      # block here — multi-project mode must still follow projects whose
      # file does exist.
      (
        while [ ! -f "$events" ]; do sleep 1; done
        # Once the file appears, follow from offset 0 so we don't miss the
        # first lines (the producer may have written several before the
        # poller noticed).
        exec tail -n +1 -F "$events" >&3
      ) &
      pids+=("$!")
      continue
    fi
    # tail -n 0 -F: don't replay (we already did) — only the new lines.
    tail -n 0 -F "$events" >&3 &
    pids+=("$!")
  done <<<"$rows"

  # Wait for the formatter (the SIGINT trap kills children + exits 0).
  wait "$fmt_pid" 2>/dev/null || true
  cleanup
}

if [ "$CMD" = "tail" ]; then
  tail_cmd "$@"
fi

# --- rollback -------------------------------------------------------------
# Ticket 0017. `fleet rollback <slug>` identifies the most recent
# agent-authored merge (head:feat/ OR head:eng/) to main and opens a revert
# PR on `revert/<id>-<slug>`, with the same gating contract as any other
# agent PR. One subcommand, full audit trail.
#
# Discovery: the slug-to-repo resolver mirrors `tail`/`digest` (union of
# FLEET_DISCOVERY_ROOT and ~/.local/share/agent-fleet/projects, de-duped by
# SLUG). Once a slug resolves to a manifest, REPO_URL → owner/name is
# derived the same way `bin/fleet status` derives it.
#
# Flags:
#   --yes | -y         skip the "proceed with revert? [y/N]" prompt
#   --dry-run          print metadata + the exact git/gh commands; do nothing
#   --pr <N>           override auto-pick; revert the specific PR number
#                      (uses `gh pr view <N>` instead of `gh pr list`)
#
# Squash vs true merge: `gh pr view --json mergeMethod` tells us how the
# original PR landed. SQUASH → `git revert --no-edit <sha>` (single
# linear commit). MERGE → `git revert -m 1 <sha>` (true merge commits need
# the mainline-parent hint). The test covers both branches.
#
# Telemetry: emits `rollback_opened pr=<new> reverts=<orig>
# merge_commit=<sha>` to the slug's events.jsonl on success.
#
# Hard-NOs honoured: never pushes to main; never bypasses branch
# protection; the revert PR goes through the same `shellcheck` + `validate`
# gates as any other agent PR.

# Resolve slug → manifest path. Echoes the manifest path or empty.
rollback_resolve_manifest() {
  local want="$1"
  local roots=("${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}" "$HOME/.local/share/agent-fleet/projects")
  local root m slug
  for root in "${roots[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      # shellcheck disable=SC1090
      slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
      if [ "$slug" = "$want" ]; then
        echo "$m"
        return 0
      fi
    done < <(find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)
  done
}

# Extract a single string-value JSON field from a flat object. The kit's
# gh --json responses never embed objects beyond `mergeCommit.oid`, which
# we handle as a special case below. Echoes the bare value (no quotes).
rollback_json_string() {
  local json="$1" key="$2"
  printf '%s' "$json" | sed -nE "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]*)\".*/\\1/p" | head -1
}

# Extract a number value (PR number, etc.). Echoes the digits.
rollback_json_number() {
  local json="$1" key="$2"
  printf '%s' "$json" | sed -nE "s/.*\"$key\"[[:space:]]*:[[:space:]]*([0-9]+).*/\\1/p" | head -1
}

# Extract mergeCommit.oid (one-deep object) from a PR JSON object.
rollback_json_merge_oid() {
  local json="$1"
  printf '%s' "$json" | sed -nE 's/.*"mergeCommit"[[:space:]]*:[[:space:]]*\{[[:space:]]*"oid"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -1
}

# Parse the leading "<id>-<slug-tail>" out of an agent headRefName. Returns
# the part after the prefix (feat/, eng/) — e.g. "feat/0019-broken-thing"
# → "0019-broken-thing". Echoes empty if no recognised prefix.
rollback_branch_tail() {
  local head="$1"
  case "$head" in
    feat/*) echo "${head#feat/}" ;;
    eng/*)  echo "${head#eng/}" ;;
    *)      echo "" ;;
  esac
}

# Pick the most-recent agent-merged PR from a `gh pr list --json ...` JSON
# array. We split on `},{` (with optional whitespace) boundaries — safe
# because gh's JSON never nests braces inside string values without
# escaping AND we already have `mergeCommit` as the only nested object,
# which closes with `}` BEFORE the comma that starts the next top-level
# key. Picking the FIRST object yields the most recent merge because
# `gh pr list` returns mergedAt-desc by default.
rollback_first_pr_json() {
  local list_json="$1"
  # Normalize whitespace, strip the outer `[...]`, then replace `},{`
  # (with any inter-object whitespace) with a sentinel we can split on.
  printf '%s' "$list_json" \
    | tr -d '\n' \
    | sed -E 's/^[[:space:]]*\[[[:space:]]*//; s/[[:space:]]*\][[:space:]]*$//; s/\}[[:space:]]*,[[:space:]]*\{/}@@PRSPLIT@@{/g' \
    | awk 'BEGIN{RS="@@PRSPLIT@@"} NR==1 { gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print; exit }'
}

rollback() {
  shift  # drop the leading "rollback"
  local slug_arg="" want_yes=0 want_dry=0 pr_override=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y)   want_yes=1; shift ;;
      --dry-run)  want_dry=1; shift ;;
      --pr)       pr_override="${2:-}"; shift 2 ;;
      --pr=*)     pr_override="${1#--pr=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet rollback — revert the last agent-shipped commit on a project.

Usage:
  fleet rollback <slug>             interactive: pick the latest agent PR, prompt, revert
  fleet rollback <slug> --yes       skip the [y/N] prompt
  fleet rollback <slug> --dry-run   print metadata + planned commands; do nothing
  fleet rollback <slug> --pr <N>    revert the specific PR number (skips auto-pick)

Identifies the most recent merged PR whose head matches \`feat/\` or \`eng/\`
on \`main\`, opens a revert PR on branch \`revert/<id>-<slug>\`, and arms
\`gh pr merge --auto --squash\` so the standard gating CI checks decide if
the revert lands.
USAGE
        exit 0 ;;
      --) shift ;;
      -*) echo "fleet rollback: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then slug_arg="$1"; shift
        else echo "fleet rollback: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$slug_arg" ]; then
    echo "fleet rollback: missing <slug>" >&2
    echo "usage: fleet rollback <slug> [--yes|--dry-run|--pr <N>]" >&2
    exit 2
  fi

  # Resolve slug → manifest → REPO_URL → owner/name + CACHE_DIR.
  local manifest
  manifest="$(rollback_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    echo "fleet rollback: no project with SLUG=$slug_arg found" >&2
    exit 2
  fi
  local slug repo_url repo cache_dir
  # shellcheck disable=SC1090  # discovered at runtime
  eval "$(
    source "$manifest"
    echo "slug='${SLUG:-}'"
    echo "repo_url='${REPO_URL:-}'"
  )"
  repo="$(echo "$repo_url" | sed -E 's#https?://github.com/##; s#\.git$##')"
  cache_dir="$HOME/.cache/${slug}-agent"

  # Pick the target PR JSON.
  local target_json=""
  if [ -n "$pr_override" ]; then
    target_json="$(gh pr view "$pr_override" \
                     --repo "$repo" \
                     --json number,title,mergeCommit,headRefName,mergedAt,mergeMethod \
                     2>/dev/null || true)"
    if [ -z "$target_json" ] || [ "$target_json" = "{}" ]; then
      echo "fleet rollback: gh pr view $pr_override returned nothing" >&2
      exit 1
    fi
  else
    local list_json
    list_json="$(gh pr list \
                   --repo "$repo" \
                   --state merged \
                   --base main \
                   --limit 20 \
                   --search "head:feat/ OR head:eng/" \
                   --json number,title,mergeCommit,headRefName,mergedAt \
                   2>/dev/null || true)"
    if [ -z "$list_json" ] || [ "$list_json" = "[]" ]; then
      echo "no agent-merged feature PR found in the last 20 merges" >&2
      exit 1
    fi
    target_json="$(rollback_first_pr_json "$list_json")"
    if [ -z "$target_json" ]; then
      echo "no agent-merged feature PR found in the last 20 merges" >&2
      exit 1
    fi
  fi

  # Parse the target. mergeMethod only comes from `gh pr view`; when we got
  # the target from `gh pr list`, fetch it separately so the squash/merge
  # branch detection is always correct (AC#9).
  local pr_number title merge_oid head_ref merged_at merge_method
  pr_number="$(rollback_json_number "$target_json" "number")"
  title="$(rollback_json_string "$target_json" "title")"
  merge_oid="$(rollback_json_merge_oid "$target_json")"
  head_ref="$(rollback_json_string "$target_json" "headRefName")"
  merged_at="$(rollback_json_string "$target_json" "mergedAt")"
  merge_method="$(rollback_json_string "$target_json" "mergeMethod")"

  if [ -z "$merge_method" ]; then
    local view_json
    view_json="$(gh pr view "$pr_number" \
                   --repo "$repo" \
                   --json mergeMethod \
                   2>/dev/null || true)"
    merge_method="$(rollback_json_string "$view_json" "mergeMethod")"
  fi
  # Default: assume squash (the kit's standard merge style).
  [ -z "$merge_method" ] && merge_method="SQUASH"

  local branch_tail revert_branch
  branch_tail="$(rollback_branch_tail "$head_ref")"
  if [ -z "$branch_tail" ]; then
    echo "fleet rollback: PR #$pr_number head '$head_ref' is not an agent prefix (feat/, eng/)" >&2
    exit 1
  fi
  revert_branch="revert/${branch_tail}"

  # Pick the revert command form based on mergeMethod.
  local revert_cmd
  case "$merge_method" in
    SQUASH|REBASE) revert_cmd="git revert --no-edit $merge_oid" ;;
    MERGE)         revert_cmd="git revert -m 1 $merge_oid" ;;
    *)             revert_cmd="git revert --no-edit $merge_oid" ;;
  esac

  # Print target metadata. Same shape as the user-story callout in the ticket.
  echo "Last agent merge to main: $merged_at"
  echo "  commit:   $merge_oid"
  echo "  PR:       #$pr_number $head_ref"
  echo "  title:    $title"
  echo "  mergeMethod: $merge_method"

  local checkout="$cache_dir/rollback-checkout"
  local pr_body="Reverts #${pr_number}. Issued by fleet rollback ${slug}."
  local clone_cmd="git clone --depth 50 $repo_url $checkout"
  local create_cmd="gh pr create --fill --base main --head $revert_branch --body \"$pr_body\" --repo $repo"
  local merge_cmd="gh pr merge --auto --squash --repo $repo"

  if [ "$want_dry" = "1" ]; then
    echo
    echo "Planned (dry-run; nothing executed):"
    echo "  $clone_cmd"
    echo "  cd $checkout"
    echo "  git checkout -b $revert_branch"
    echo "  $revert_cmd"
    echo "  git push -u origin $revert_branch"
    echo "  $create_cmd"
    echo "  $merge_cmd"
    exit 0
  fi

  # Confirmation prompt (unless --yes).
  if [ "$want_yes" != "1" ]; then
    local reply=""
    # `read -r -p` writes the prompt to stderr in some shells; explicit echo
    # to stdout keeps the test's `grep <<< OUT` happy.
    echo -n "proceed with revert? [y/N] "
    read -r reply || reply=""
    case "$reply" in
      y|Y|yes|YES) : ;;
      *)
        echo "rollback cancelled."
        exit 0 ;;
    esac
  fi

  # --- Execute. ----------------------------------------------------------
  echo
  echo "Opening revert PR on branch $revert_branch..."

  # Fresh, isolated checkout under $CACHE_DIR/rollback-checkout. We do NOT
  # share state with the ship/groom/review checkouts so an in-flight ship
  # cannot race with the revert. Always start from a clean slate.
  rm -rf "$checkout"
  mkdir -p "$cache_dir"
  git clone --depth 50 "$repo_url" "$checkout" >/dev/null 2>&1 || {
    echo "fleet rollback: git clone failed" >&2
    exit 1
  }
  cd "$checkout" || { echo "fleet rollback: cd $checkout failed" >&2; exit 1; }
  git checkout -b "$revert_branch" >/dev/null 2>&1 || {
    echo "fleet rollback: git checkout -b $revert_branch failed" >&2
    exit 1
  }
  # shellcheck disable=SC2086  # revert_cmd intentionally word-splits the form
  $revert_cmd >/dev/null 2>&1 || {
    echo "fleet rollback: $revert_cmd failed (merge conflict? try --dry-run + manual revert)" >&2
    exit 1
  }
  git push -u origin "$revert_branch" >/dev/null 2>&1 || {
    echo "fleet rollback: git push failed" >&2
    exit 1
  }

  # Open the PR. Capture the URL → parse the new PR number from the trailing
  # /pull/<N> path component.
  local create_out new_pr_number=""
  create_out="$(gh pr create \
                  --fill \
                  --base main \
                  --head "$revert_branch" \
                  --body "$pr_body" \
                  --repo "$repo" \
                  2>&1 || true)"
  echo "$create_out"
  new_pr_number="$(echo "$create_out" | sed -nE 's#.*/pull/([0-9]+).*#\1#p' | head -1)"
  if [ -z "$new_pr_number" ]; then
    echo "fleet rollback: could not parse new PR number from 'gh pr create' output" >&2
    # Still arm auto-merge below if at all possible? No — without a PR number
    # we can't, and we'd skip the event emission too. Hard fail is right.
    exit 1
  fi

  gh pr merge "$new_pr_number" --auto --squash --repo "$repo" >/dev/null 2>&1 || true
  echo "Auto-merge armed for PR #$new_pr_number; waiting for CI green."

  # Emit telemetry. Initialize the cache dir + FLEET_PHASE so fleet_emit_event
  # routes the event to the right channel and tags it sensibly. We source
  # lib/common.sh from the repo this script lives in.
  local kit_root; kit_root="$( cd "$( dirname "$0" )/.." && pwd )"
  if [ -f "$kit_root/lib/common.sh" ]; then
    # shellcheck disable=SC1091
    (
      export SLUG="$slug"
      export CACHE_DIR="$cache_dir"
      export FLEET_PHASE="rollback"
      # shellcheck disable=SC1090
      source "$kit_root/lib/common.sh" >/dev/null 2>&1
      fleet_emit_event rollback_opened \
        "pr=$new_pr_number" \
        "reverts=$pr_number" \
        "merge_commit=$merge_oid"
    ) || true
  fi

  exit 0
}

if [ "$CMD" = "rollback" ]; then
  rollback "$@"
fi

# --- kickstart ------------------------------------------------------------
# Ticket 0010. `fleet kickstart <slug> <phase> [--dry-run]` is the operator's
# pre-flight check: it triggers a one-shot run of the per-slug launchd label
# matching the phase (`agent-ship`, `agent-groom`, `agent-review`, `agent-eng`).
# With `--dry-run`, the kickstart is prefixed by
# `launchctl setenv AGENT_DRY_RUN 1` so the runner gates `fleet_run_claude`
# into tool-locked mode (the prompt still runs end-to-end; only side-effects
# are blocked — see fleet_run_claude in lib/common.sh).
#
# We use `launchctl setenv` rather than `env AGENT_DRY_RUN=1 launchctl
# kickstart` because launchd jobs inherit the launchd user-session env, not
# the caller's. `setenv` writes into that session env so the spawned runner
# actually sees the variable. `unsetenv` after the kickstart call would
# leave a race window where a concurrent launchd fire (e.g. groom at :17
# while ship at :41) could also pick up the flag — so we intentionally
# leave the var set on the dry-run path. Operators can clear it themselves
# with `launchctl unsetenv AGENT_DRY_RUN` once they're done dry-running.
# Without `--dry-run`, we do NOT touch the launchd env at all, so the var
# stays unset across the kickstart call (verified by AC#6).
#
# Naming note (LESSONS 2026-05-26): we use `kickstart_cmd` rather than
# `kickstart` so the dispatch function never shadows any coreutils binary
# the same script might shell out to. No collision exists today, but
# `tail_cmd` set the precedent for any user-facing subcommand name.
#
# Discovery: slug → manifest via the same two-root pattern as rollback/tail/
# digest (FLEET_DISCOVERY_ROOT + ~/.local/share/agent-fleet/projects,
# de-duped by SLUG, working-tree manifest wins). NAMESPACE comes from the
# manifest; the label is "${NAMESPACE}.agent-${PHASE}".

# Resolve slug → manifest path. Echoes the manifest path or empty (same
# shape as rollback_resolve_manifest, kept independent so future churn in
# either doesn't ripple).
kickstart_resolve_manifest() {
  local want="$1"
  local roots=("${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}" "$HOME/.local/share/agent-fleet/projects")
  local root m slug
  for root in "${roots[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      # shellcheck disable=SC1090
      slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
      if [ "$slug" = "$want" ]; then
        echo "$m"
        return 0
      fi
    done < <(find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)
  done
}

# --- kickstart --demo cleanup helper (ticket 0023) ------------------------
# Module-level so the EXIT/INT/TERM trap can reference it after
# kickstart_demo's locals have gone out of scope. Reads three globals
# the demo sets up before installing the trap: FLEET_DEMO_KEEP,
# FLEET_DEMO_FIXTURE, FLEET_DEMO_STUB_DIR.
_demo_cleanup_run() {
  local rc=$?
  if [ "${FLEET_DEMO_KEEP:-0}" = "1" ]; then
    # --keep: preserve the fixture AND the stubs so the operator can
    # inspect both. The demo printed both paths at start.
    return $rc
  fi
  if [ -n "${FLEET_DEMO_FIXTURE:-}" ]; then
    rm -rf "$FLEET_DEMO_FIXTURE" 2>/dev/null || true
  fi
  if [ -n "${FLEET_DEMO_STUB_DIR:-}" ]; then
    rm -f "$FLEET_DEMO_STUB_DIR/gh" \
          "$FLEET_DEMO_STUB_DIR/claude" \
          "$FLEET_DEMO_STUB_DIR/git-push-stub" 2>/dev/null || true
  fi
  return $rc
}

# --- kickstart --demo (ticket 0023) ---------------------------------------
# kickstart_demo <keep:0|1> <tail_seconds:int>  — walks a credential-less
# synthetic ship/review loop against a one-off fixture project.
#
# Why this exists: the README's mental-model section is prose + a Mermaid
# diagram. A stranger evaluating the kit cannot see the loop run without
# installing launchd jobs, configuring `gh`, and waiting an hour. This
# subcommand collapses that into one command — fixture in $TMPDIR, stubs
# in $HOME/.local/bin, real events.jsonl + runs.jsonl under a per-demo
# cache dir, four event types emitted exactly once each, total wallclock
# well under a minute.
#
# Design choice (matters for AC#7): the demo does NOT shell out to
# `git`/`gh`/`claude`. It sources `lib/common.sh`, calls
# `fleet_load_manifest` against the fixture, then directly invokes
# `fleet_emit_event` and `_review_emit_lesson_draft` for the four
# required event types. This means the demo succeeds even when the
# operator's PATH is exclusively $HOME/.local/bin (per AC#7's test
# environment) — we never need the real binaries because we never
# call them. The stubs at $HOME/.local/bin exist for two reasons:
#   (1) they SHADOW any real binary the operator might have, proving
#       the synthetic loop is hermetic — if a real `gh` somehow gets
#       called, the stub records it instead;
#   (2) they prove the operator can copy this same pattern into a CI
#       smoke test without bootstrapping the Anthropic CLI.
#
# PATH note (LESSONS 2026-05-26): sourcing `lib/common.sh` resets PATH
# to `$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:...`.
# That's exactly what we want — the stubs at $HOME/.local/bin still win
# (they're first), but mktemp/cat/awk/etc. become resolvable. So we
# source common.sh BEFORE any external command other than the bash
# builtins above. The test invokes us with PATH=$HOME/.local/bin only
# to prove the restoration works.
#
# Cleanup: a single EXIT trap removes the fixture (unless --keep was
# passed) and the three demo stubs. The trap fires on normal exit AND
# on `FLEET_DEMO_FORCE_FAIL=1` (which short-circuits the synthetic loop
# with exit 1 — see AC#10).
kickstart_demo() {
  local keep="${1:-0}" tail_secs="${2:-0}"

  # Source common.sh to restore PATH and gain fleet_emit_event /
  # fleet_load_manifest. KIT_ROOT is derived from bin/fleet's location
  # (this script is at $KIT_ROOT/bin/fleet). We use bash parameter
  # expansion (no `dirname`) so the demo works even under the AC#7
  # test environment where PATH=$HOME/.local/bin only — `dirname` is
  # in /usr/bin and would NOT be on that PATH yet.
  local script_path bin_dir kit_root
  script_path="${BASH_SOURCE[0]}"
  # Resolve a relative invocation to an absolute path via the working
  # directory. We avoid `realpath` (not POSIX) and stick to PWD math.
  case "$script_path" in
    /*) ;;
    *)  script_path="$PWD/$script_path" ;;
  esac
  bin_dir="${script_path%/*}"     # strip /fleet
  kit_root="${bin_dir%/*}"        # strip /bin
  # shellcheck source=/dev/null
  source "$kit_root/lib/common.sh"

  # Resolve the bundled fixture. Lives under $kit_root/tests/fixtures/demo/.
  local fixture_src="$kit_root/tests/fixtures/demo"
  if [ ! -d "$fixture_src" ]; then
    echo "fleet kickstart --demo: fixture source $fixture_src not found" >&2
    return 2
  fi

  # Per-invocation random slug (5 lowercase alnum chars). Avoids cache
  # collisions when two demos race on the same $HOME. We avoid
  # `tr -dc … </dev/urandom | head -c N` because the SIGPIPE that kills
  # `tr` once `head` has its N chars races with bash's pipefail and can
  # leak partial output. Hex from $RANDOM is hermetic and good enough
  # for collision avoidance in a CLI demo.
  local rand demo_slug fixture_dir stub_dir
  rand="$(printf '%04x' "$RANDOM")"
  demo_slug="demo-$rand"
  fixture_dir="$(mktemp -d -t fleet-demo)"
  stub_dir="$HOME/.local/bin"
  mkdir -p "$stub_dir"

  echo "[demo] scaffolding fixture in $fixture_dir"
  echo "[demo] stubs in $stub_dir (gh, claude, git-push-stub)"

  # Cleanup trap. `keep` decides whether the fixture is wiped; stubs
  # are always removed (the operator did not have them before the demo
  # ran, so leaving them behind would surprise the next shell). Bake
  # the paths/keep flag into globals so the trap body can see them
  # AFTER kickstart_demo's locals have gone out of scope (`set -u` in
  # bin/fleet would otherwise blow up on the trap firing post-return).
  FLEET_DEMO_KEEP="$keep"
  FLEET_DEMO_FIXTURE="$fixture_dir"
  FLEET_DEMO_STUB_DIR="$stub_dir"
  export FLEET_DEMO_KEEP FLEET_DEMO_FIXTURE FLEET_DEMO_STUB_DIR
  trap '_demo_cleanup_run' EXIT INT TERM

  # ---- Write the fixture ------------------------------------------------
  # Per LESSONS 2026-05-27, we use `cp` (not $(cat template)) to copy
  # files we'll later sed-substitute, so trailing newlines survive the
  # round-trip.
  mkdir -p "$fixture_dir/docs/backlog"
  cp "$fixture_src/AGENTS.md"                       "$fixture_dir/AGENTS.md"
  cp "$fixture_src/docs/LESSONS.md"                 "$fixture_dir/docs/LESSONS.md"
  cp "$fixture_src/docs/backlog/README.md"          "$fixture_dir/docs/backlog/README.md"
  cp "$fixture_src/docs/backlog/0001-demo-hello-world.md" \
     "$fixture_dir/docs/backlog/0001-demo-hello-world.md"
  cp "$fixture_src/docs/backlog/0002-demo-second-ticket.md" \
     "$fixture_dir/docs/backlog/0002-demo-second-ticket.md"
  # Manifest needs the slug token substituted. sed in-place via a temp
  # file (POSIX-portable; macOS sed -i needs a backup arg).
  local manifest_tmp="$fixture_dir/agents.config.sh.tmp"
  sed -e "s/__DEMO_SLUG__/$demo_slug/g" \
      "$fixture_src/agents.config.sh" > "$manifest_tmp"
  mv "$manifest_tmp" "$fixture_dir/agents.config.sh"

  # ---- Install stubs ---------------------------------------------------
  # All three are exit-0 no-ops that echo to a fixture-local log so the
  # reader can inspect them with --keep. We deliberately overwrite any
  # pre-existing host stub the test harness installed — proving the
  # demo's install is unconditional.
  local stub_log="$fixture_dir/stub-calls.log"
  : > "$stub_log"
  local s
  for s in gh claude; do
    cat > "$stub_dir/$s" <<STUB
#!/bin/bash
# Stub installed by 'fleet kickstart --demo'. Logs argv to a fixture
# file so the operator (or test) can prove no real network call fired.
printf '%s %s\n' "$s" "\$*" >> "$stub_log" 2>/dev/null || true
exit 0
STUB
    chmod +x "$stub_dir/$s"
  done
  # git-push-stub is a sibling helper, not a replacement for git itself
  # (replacing git would break git diff / git log which any inner prompt
  # might read). The demo never invokes git, so this stub just records
  # its existence to satisfy AC#3's "three stubs installed" contract.
  cat > "$stub_dir/git-push-stub" <<STUB
#!/bin/bash
printf 'git-push-stub %s\n' "\$*" >> "$stub_log" 2>/dev/null || true
exit 0
STUB
  chmod +x "$stub_dir/git-push-stub"

  # ---- Synthetic loop --------------------------------------------------
  # Load the manifest under our fixture so CACHE_DIR/SLUG/etc. resolve
  # to the demo's isolated paths. fleet_load_manifest sets CACHE_DIR =
  # $HOME/.cache/${SLUG}-agent, so the demo's events.jsonl and
  # runs.jsonl naturally live under a per-slug cache that cannot collide
  # with any real project (the slug starts with `demo-`).
  fleet_load_manifest "$fixture_dir"
  # Tag every event with phase=demo. fleet_log_init usually does this
  # plus a log redirect; we skip the redirect because the demo wants
  # to talk to the operator's terminal, not a logfile.
  FLEET_PHASE="demo"; export FLEET_PHASE
  RUN_STARTED_UTC="$(date -u +%FT%TZ)"
  RUN_STARTED_EPOCH="$(date -u +%s)"
  export RUN_STARTED_UTC RUN_STARTED_EPOCH

  echo "[demo] slug=$SLUG  cache=$CACHE_DIR"
  echo "[demo] events at $CACHE_DIR/events.jsonl"

  # Force-fail hook (AC#10): exit before emitting any events so the test
  # can prove the trap still runs.
  if [ -n "${FLEET_DEMO_FORCE_FAIL:-}" ]; then
    echo "[demo] FLEET_DEMO_FORCE_FAIL=1 — aborting synthetic loop" >&2
    return 1
  fi

  # Emit the four required event types in narrative order. The user-
  # story prose in ticket 0023 walks the same sequence.
  echo "[demo] phase 1: heal — no in-flight PRs, falling through"
  echo "[demo] phase 2: ship — picking 0001-demo-hello-world (P1, groomed)"
  fleet_emit_event run_started "pid=$$" || true

  echo "[demo] stubbed claude returned SHIP — 1 file changed"
  echo "[demo] stubbed gh pr create #42 (feat/0001-demo-hello-world)"
  fleet_emit_event pr_opened "number=42" "branch=feat/0001-demo-hello-world" || true

  # Synthesize a reviewer body file and feed it through
  # _review_emit_lesson_draft so the seeded DRAFT block lands in the
  # fixture's LESSONS.md AND a `lesson_draft_emitted` event fires (the
  # helper emits the event itself per ticket 0022).
  local body_file="$fixture_dir/.demo-review-body.txt"
  {
    printf -- 'demo: stubbed reviewer send-back to surface the DRAFT-block artifact\n'
    printf -- '\n'
    printf -- 'The reviewer flagged the hello-world PR so the operator can see\n'
    printf -- 'what a real send-back looks like. Promote or delete this block.\n'
  } > "$body_file"
  # The helper writes to docs/LESSONS.md relative to cwd; cd into the
  # fixture so the right file is targeted.
  ( cd "$fixture_dir" && _review_emit_lesson_draft 42 "$body_file" "docs/LESSONS.md" >/dev/null )

  # Write the runs.jsonl row by hand (we never called claude, so
  # fleet_run_claude didn't run — but AC#9 wants exactly one phase=demo
  # row to prove the demo's synthetic cost (0.0) cannot pollute
  # `fleet digest` for any real project).
  mkdir -p "$CACHE_DIR"
  printf '{"slug":"%s","phase":"demo","ts_start":"%s","ts_end":"%s","exit":0,"model":"%s","total_cost_usd":0.0,"duration_ms":0,"result_head":"demo synthetic ship cycle"}\n' \
    "$SLUG" "$RUN_STARTED_UTC" "$(date -u +%FT%TZ)" "${MODEL:-claude-opus-4-7}" \
    >> "$CACHE_DIR/runs.jsonl"

  fleet_emit_event run_completed \
    "exit=0" "duration_ms=$(( ( $(date -u +%s) - RUN_STARTED_EPOCH ) * 1000 ))" \
    || true

  # ---- Replay / tail ---------------------------------------------------
  echo "[demo] events.jsonl now has $(wc -l < "$CACHE_DIR/events.jsonl" | tr -d ' ') events"
  if [ "$tail_secs" -gt 0 ]; then
    echo "[demo] tailing for ${tail_secs}s so you can read them..."
    # Best-effort: print whatever's already there, then wait. We don't
    # spawn a real `tail -F` since the synthetic loop is already done
    # writing — the window exists purely so the operator (or test) sees
    # the streaming-mode banner.
    cat "$CACHE_DIR/events.jsonl"
    sleep "$tail_secs"
  else
    # Without --tail, dump the events once at end of run.
    cat "$CACHE_DIR/events.jsonl"
  fi

  echo "[demo] runs.jsonl at $CACHE_DIR/runs.jsonl (phase=demo)"
  if [ "$keep" = "1" ]; then
    echo "[demo] done. fixture preserved at $fixture_dir — rm -rf when done."
  else
    echo "[demo] done. fixture wiped (pass --keep to inspect it next time)."
  fi
  return 0
}

kickstart_cmd() {
  shift  # drop the leading "kickstart"
  local slug_arg="" phase_arg="" dry=0 demo=0 demo_keep=0 demo_tail=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --demo) demo=1; shift ;;
      --keep) demo_keep=1; shift ;;
      --tail)
        # --tail takes an optional positive-integer window in seconds
        # (per ticket 0023 AC#5). Test runs pass `--tail 1` for speed.
        # If the next token isn't an integer, default to 5s.
        if [ -n "${2:-}" ] && printf '%s' "$2" | grep -qE '^[0-9]+$'; then
          demo_tail="$2"; shift 2
        else
          demo_tail=5; shift
        fi ;;
      -h|--help)
        cat <<USAGE
fleet kickstart — trigger a one-shot agent run, optionally in dry-run mode.

Usage:
  fleet kickstart <slug> <phase>             trigger the launchd label
  fleet kickstart <slug> <phase> --dry-run   set AGENT_DRY_RUN=1 first
  fleet kickstart --demo                     run a credential-less synthetic
                                             loop end-to-end (ticket 0023)
  fleet kickstart --demo --keep              keep the fixture on disk
  fleet kickstart --demo --tail [N]          stream events for N extra
                                             seconds (default 5) after the
                                             synthetic loop exits

<phase> is one of: ship, groom, review, eng.

In --dry-run mode the runner still calls claude end-to-end, but with
\`--allowedTools none\` so no side-effects (commits, pushes, gh calls)
land. The run emits \`run_dry_run plan_head=...\` to events.jsonl and
still appends to runs.jsonl with the real cost. Operator unsets the env
with: launchctl unsetenv AGENT_DRY_RUN

In --demo mode the runner scaffolds a fixture project under
\`\$TMPDIR/fleet-demo-XXXXXX\`, installs stubbed gh/claude/git-push
binaries under \$HOME/.local/bin, walks one synthetic ship+review cycle,
and emits the same four event types (\`run_started\`, \`pr_opened\`,
\`lesson_draft_emitted\`, \`run_completed\`) a real run would. The
fixture is wiped on exit unless --keep is passed.
USAGE
        exit 0 ;;
      --) shift ;;
      -*) echo "fleet kickstart: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if   [ -z "$slug_arg" ];  then slug_arg="$1";  shift
        elif [ -z "$phase_arg" ]; then phase_arg="$1"; shift
        else echo "fleet kickstart: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ "$demo" = "1" ]; then
    kickstart_demo "$demo_keep" "$demo_tail"
    exit $?
  fi

  if [ -z "$slug_arg" ] || [ -z "$phase_arg" ]; then
    echo "fleet kickstart: missing <slug> and/or <phase>" >&2
    echo "usage: fleet kickstart <slug> <phase> [--dry-run]" >&2
    exit 2
  fi
  case "$phase_arg" in
    ship|groom|review|eng) ;;
    *)
      echo "fleet kickstart: <phase> must be ship|groom|review|eng (got '$phase_arg')" >&2
      exit 2 ;;
  esac

  local manifest
  manifest="$(kickstart_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    echo "fleet kickstart: no project with SLUG=$slug_arg found" >&2
    exit 2
  fi
  local namespace
  # shellcheck disable=SC1090  # discovered at runtime
  namespace=$( (source "$manifest"; echo "${NAMESPACE:-com.fleet.${SLUG:-$slug_arg}}") 2>/dev/null )
  if [ -z "$namespace" ]; then
    echo "fleet kickstart: could not derive NAMESPACE from $manifest" >&2
    exit 2
  fi

  local uid="${UID:-$(id -u)}"
  local label="gui/${uid}/${namespace}.agent-${phase_arg}"

  # Dry-run: set the launchd session env so the spawned runner inherits it.
  # We deliberately do NOT unsetenv afterwards — see the module header.
  if [ "$dry" = "1" ]; then
    launchctl setenv AGENT_DRY_RUN 1 || true
  fi

  launchctl kickstart -k "$label"
  exit $?
}

if [ "$CMD" = "kickstart" ]; then
  kickstart_cmd "$@"
fi

# --- replay ---------------------------------------------------------------
# Ticket 0021. `fleet replay <slug> --pr <N> [--phase ship|review] [--out
# FILE] [--request-changes-ok]` re-runs the kit's CURRENT prompts against
# a past (merged OR open) PR in dry-run, so an operator who just edited
# `prompts/PRINCIPLES.md` or `prompts/ship.prompt.md` can sanity-check the
# change against real historical behavior BEFORE the live loop fires under
# it.
#
# Substrate: ticket 0010's `AGENT_DRY_RUN=1` already tool-locks `claude`
# with `--allowedTools none`. We invoke claude directly here (not
# `fleet_run_claude`) because:
#   - replay is operator-invoked, not a launchd runner — there's no
#     `fleet_log_init` to chain off of, and we don't want a log file in
#     `$LOG_DIR/replay-…` polluting log-mtime-based "last run" surfaces.
#   - We DO want the same runs.jsonl append shape (cost accounting per
#     AC#8), so we mirror the JSON layout `fleet_run_claude` writes today
#     but tag `phase=replay` so `fleet digest` can sort replay calls
#     from real ship runs.
#
# Prompt composition (per the ticket's "User → operator" lens):
#   --phase review → AGENTS.md + LESSONS.md + ticket + diff + the review
#                    contract ("VERDICT: sign-off | request-changes" + a
#                    rationale). The diff is the substance the prompt is
#                    grading.
#   --phase ship   → AGENTS.md + LESSONS.md + ticket (NO diff — ship is
#                    asked "what would you do?", not "is this good?").
#                    Verdict line: "ACTION: ship | heal | wait | noop".
#
# Verdict parsing: we grep the claude `.result` for the first line
# matching the phase's regex. If no line matches, replay prints
# `VERDICT: unknown` (or `ACTION: unknown`) and exits 1 — the operator
# sees the raw output in the saved file.
#
# Exit codes:
#   0  — verdict matches the success condition for the phase.
#   1  — verdict missing OR doesn't match (the default success is
#        sign-off/ship/heal; --request-changes-ok flips this).
#   2  — usage error: PR head isn't an agent feature prefix, missing
#        flag value, slug not resolved.
#
# Naming (LESSONS 2026-05-26): the dispatcher is named `replay()` — no
# coreutils binary by that name (we checked: `man replay` / `which replay`
# come up empty on macOS). The function shells out to `claude`, `gh`, and
# `git` only; nothing collides.

# Resolve slug → manifest path. Echoes the manifest or empty. Reuses the
# same two-root union pattern as rollback/kickstart (per ticket 0017's
# engineering notes). We declare a thin wrapper around
# `rollback_resolve_manifest` rather than duplicating the body so a future
# discovery-shape change ripples through one site.
replay_resolve_manifest() {
  rollback_resolve_manifest "$1"
}

# Parse the leading "<id>-<slug-tail>" out of an agent headRefName so the
# operator's "the ticket file is docs/backlog/<NNNN>-…" derivation has a
# stable input. Returns the part after the feat/ prefix, or empty.
replay_branch_tail() {
  local head="$1"
  case "$head" in
    feat/*) echo "${head#feat/}" ;;
    eng/*)  echo "${head#eng/}" ;;
    *)      echo "" ;;
  esac
}

# Compose the prompt body for one phase. Reads files from $checkout (the
# fresh agent-fleet checkout the function created) and the PR metadata
# from environment locals the caller already has in scope.
#
# Args: $1 phase, $2 checkout dir, $3 ticket-file path (may not exist),
# $4 diff (already on disk at this path), $5 pr_number, $6 pr_title,
# $7 head_ref, $8 pr_body, $9 merged_at.
replay_compose_prompt() {
  local phase="$1" checkout="$2" ticket_path="$3" diff_path="$4"
  local pr_number="$5" pr_title="$6" head_ref="$7" pr_body="$8" merged_at="$9"

  # Top matter: shared across phases.
  printf 'You are replaying the kit'\''s CURRENT %s prompt against a past PR.\n' "$phase"
  printf 'This is a dry-run: produce only a verdict + rationale.\n\n'

  printf '## PR metadata\n'
  # Use `printf -- 'fmt' arg` so a leading '-' in the format-line body is
  # not interpreted as a flag by some printf implementations.
  printf -- '- number: #%s\n' "$pr_number"
  printf -- '- title: %s\n' "$pr_title"
  printf -- '- head: %s\n' "$head_ref"
  printf -- '- merged_at: %s\n' "${merged_at:-(open)}"
  printf '\n'

  if [ -f "$checkout/AGENTS.md" ]; then
    printf '## AGENTS.md (current tree)\n'
    cat "$checkout/AGENTS.md"
    printf '\n'
  fi
  if [ -f "$checkout/docs/LESSONS.md" ]; then
    printf '## docs/LESSONS.md (current tree)\n'
    cat "$checkout/docs/LESSONS.md"
    printf '\n'
  fi
  if [ -n "$ticket_path" ] && [ -f "$ticket_path" ]; then
    printf '## Ticket\n'
    cat "$ticket_path"
    printf '\n'
  fi
  if [ -n "$pr_body" ]; then
    printf '## PR body\n%s\n\n' "$pr_body"
  fi

  case "$phase" in
    review)
      if [ -f "$diff_path" ]; then
        printf '## Diff (the substance to grade)\n'
        printf '```\n'
        cat "$diff_path"
        printf '\n```\n\n'
      fi
      printf '## Review contract\n'
      printf 'Read prompts/PRINCIPLES.md and AGENTS.md § Hard NOs. Decide whether\n'
      printf 'this diff would land cleanly under the current rules. Respond with\n'
      printf 'EXACTLY one line of the form:\n'
      printf '\n'
      printf '  VERDICT: sign-off\n'
      printf '  VERDICT: request-changes\n'
      printf '\n'
      printf 'followed by a one-paragraph rationale citing the principle id\n'
      printf '(P-N) you are acting under, if any.\n'
      ;;
    ship)
      printf '## Ship contract\n'
      printf 'Read prompts/PRINCIPLES.md, AGENTS.md, docs/LESSONS.md, and the\n'
      printf 'ticket above. Decide what the ship runner would do RIGHT NOW for\n'
      printf 'this ticket. Respond with EXACTLY one line of the form:\n'
      printf '\n'
      printf '  ACTION: ship\n'
      printf '  ACTION: heal\n'
      printf '  ACTION: wait\n'
      printf '  ACTION: noop\n'
      printf '\n'
      printf 'followed by a one-paragraph rationale.\n'
      ;;
  esac
}

# Append a runs.jsonl row for the replay call. Mirrors the shape
# fleet_run_claude emits (slug/phase/ts_start/ts_end/exit/model/
# session_id/total_cost_usd/duration_ms/num_turns/usage/is_error/
# result_head) so cost accounting + `fleet digest` ingest it without
# special-casing. Best-effort: missing jq → no append, no error.
replay_append_runs() {
  local runs_file="$1" claude_json="$2" slug="$3" phase="$4"
  local ts_start="$5" ts_end="$6" model="$7" claude_exit="$8"
  command -v jq >/dev/null 2>&1 || return 0
  jq -e . "$claude_json" >/dev/null 2>&1 || return 0
  local rec
  rec="$(jq -c \
    --arg slug "$slug" --arg phase "$phase" --arg exit "$claude_exit" \
    --arg s "$ts_start" --arg e "$ts_end" --arg model "$model" \
    '{slug:$slug,phase:$phase,ts_start:$s,ts_end:$e,exit:($exit|tonumber),model:$model,
      session_id:.session_id, total_cost_usd:.total_cost_usd, duration_ms:.duration_ms,
      num_turns:.num_turns, usage:.usage, is_error:.is_error, result_head:((.result//"")[0:500])}' \
    "$claude_json" 2>/dev/null)"
  if [ -n "$rec" ]; then
    mkdir -p "$(dirname "$runs_file")" 2>/dev/null || true
    printf '%s\n' "$rec" >> "$runs_file"
  fi
}

# --- ticket 0034: counterfactual prompt regression over the last N PRs ----
#
# `replay --batch` enumerates the slug's agent-merged + closed-with-changes-
# requested PRs in the --since window, replays each through the kit's
# current prompts in dry-run, and renders a matrix of past vs. dry-run
# verdicts. Exit code encodes the % delta: 0 OK (<10%), 1 WARN (<30%),
# 2 FAIL (≥30%). Pure consumer — no new event types, no signature
# changes to common.sh, no prompts/ edits.
#
# LESSONS we explicitly defend against here:
#   2026-05-28 — every printf of a title/branch/slug uses `printf -- '%s'`
#                so a value beginning with `-` is not treated as a flag.
#   2026-05-30 — any grep -F over a value that might start with `-` uses
#                the POSIX `--` end-of-options marker.
#   2026-06-01 — rationale values (which CAN be multi-line) go through a
#                tmp file, never `awk -v rationale=`. The JSON renderer
#                escapes them via provenance_json_escape (the UTF-8-safe
#                per-byte path from ticket 0029; LESSONS 2026-06-03).
#   2026-06-01 — counts use `awk ... END { print n+0 }` instead of
#                `grep -c file || echo 0` (which double-prints on zero).
#   2026-06-01 — every code path in this function ends with explicit
#                exit 0/1/2 so a fall-through never hits the default
#                fleet status block.

# UTF-8-safe JSON escaper. Byte-identical clone of provenance_json_escape
# (defined further down in the file). We can't call that function from
# here because the dispatcher `if [ "$CMD" = "replay" ]; then replay
# "$@"; fi` block at the end of the replay() definition fires BEFORE
# provenance_json_escape is parsed — bash parses top-to-bottom and the
# dispatcher runs as a top-level statement. Per LESSONS 2026-06-03 the
# `code -ge 0` guard defuses the sign-extended UTF-8 high-byte trap.
replay_batch_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *)
        printf -v code '%d' "'$ch"
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v out '%s\\u%04x' "$out" "$code"
        else
          out+="$ch"
        fi
        ;;
    esac
  done
  printf -- '%s' "$out"
}

# Parse one PR record out of the `gh pr list --json` payload. The JSON
# is an array of flat objects with `number, title, headRefName, state,
# closedAt, mergedAt`. We split on `},{` boundaries (safe — no nested
# objects in this projection) and emit one TSV line per PR:
#   number<TAB>title<TAB>headRefName<TAB>past
# where `past` is `merged` (state=MERGED) or `rejected` (state=CLOSED
# with mergedAt=null — i.e. closed without merging, which in practice
# means a request-changes review the operator did not override).
replay_batch_parse_list() {
  local list_json="$1"
  # Empty or `[]` → emit nothing.
  case "$list_json" in
    ""|"[]"|"[ ]") return 0 ;;
  esac
  printf '%s' "$list_json" \
    | tr -d '\n' \
    | sed -E 's/^[[:space:]]*\[[[:space:]]*//; s/[[:space:]]*\][[:space:]]*$//; s/\}[[:space:]]*,[[:space:]]*\{/}@@PRSPLIT@@{/g' \
    | awk 'BEGIN{RS="@@PRSPLIT@@"} { gsub(/^[[:space:]]+|[[:space:]]+$/, ""); print }' \
    | while IFS= read -r obj; do
        [ -z "$obj" ] && continue
        local n t h state merged_at past
        n="$(printf '%s' "$obj" | sed -nE 's/.*"number"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -1)"
        t="$(printf '%s' "$obj" | sed -nE 's/.*"title"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -1)"
        h="$(printf '%s' "$obj" | sed -nE 's/.*"headRefName"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -1)"
        state="$(printf '%s' "$obj" | sed -nE 's/.*"state"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -1)"
        merged_at="$(printf '%s' "$obj" | sed -nE 's/.*"mergedAt"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' | head -1)"
        [ -z "$n" ] && continue
        if [ "$state" = "MERGED" ] || [ -n "$merged_at" ]; then
          past="merged"
        else
          past="rejected"
        fi
        # Filter to agent branch prefixes only.
        case "$h" in
          feat/*|eng/*|chore/gtm-*) ;;
          *) continue ;;
        esac
        printf '%s\t%s\t%s\t%s\n' "$n" "$t" "$h" "$past"
      done
}

# Replay one PR through claude in dry-run and echo a single JSON line:
#   {"pr":N,"title":"...","past":"merged|rejected","dry_run":"sign-off|reject",
#    "delta":"=|!","rationale":"<first-200-chars>"}
#
# The function reuses the same prompt-compose + claude-call pattern as
# the single-PR replay() body, but condenses it into one JSON-line emit
# so the batch loop can accumulate without intermediate scratch files.
#
# Args: $1 phase, $2 checkout dir, $3 repo (owner/name for `gh pr view`),
# $4 pr_number, $5 pr_title, $6 head_ref, $7 past (`merged`|`rejected`),
# $8 cache_dir, $9 slug, $10 model.
# Echoes ONE JSON line on stdout. Returns 0 on success, non-zero only
# on a fatal error (claude exec failure); caller treats non-zero as a
# skip and continues the loop.
replay_one_pr_json_line() {
  local phase="$1" checkout="$2" repo="$3"
  local pr_number="$4" pr_title="$5" head_ref="$6" past="$7"
  local cache_dir="$8" slug="$9" model="${10}"

  # Pull PR body + mergedAt from gh pr view — fields the composed prompt
  # uses to mirror the single-PR replay body's call shape.
  local pr_view_json pr_body merged_at branch_tail ticket_id ticket_path
  pr_view_json="$(gh pr view "$pr_number" \
                    --repo "$repo" \
                    --json number,title,headRefName,body,mergeCommit,mergedAt,files,state \
                    2>/dev/null || true)"
  pr_body="$(rollback_json_string "$pr_view_json" "body")"
  merged_at="$(rollback_json_string "$pr_view_json" "mergedAt")"

  branch_tail="$(replay_branch_tail "$head_ref")"
  if [ -z "$branch_tail" ]; then
    # Non-agent prefix slipped through — skip silently.
    return 1
  fi
  ticket_id="${branch_tail%%-*}"
  ticket_path=""
  local cand
  for cand in "$checkout/docs/backlog/${ticket_id}-"*.md; do
    if [ -f "$cand" ]; then
      ticket_path="$cand"
      break
    fi
  done

  local diff_path="$cache_dir/replay-batch-pr${pr_number}.diff"
  if [ "$phase" = "review" ]; then
    gh pr diff "$pr_number" --repo "$repo" > "$diff_path" 2>/dev/null || true
  fi

  local prompt_file claude_out_json
  prompt_file="$(mktemp -t fleet-replay-batch-prompt.XXXXXX)"
  claude_out_json="$(mktemp -t fleet-replay-batch-claude.XXXXXX)"
  replay_compose_prompt \
    "$phase" "$checkout" "$ticket_path" "$diff_path" \
    "$pr_number" "$pr_title" "$head_ref" "$pr_body" "$merged_at" \
    > "$prompt_file"

  local ts_start ts_end claude_exit
  ts_start="$(date -u +%FT%TZ)"
  AGENT_DRY_RUN=1 claude \
    --print \
    --output-format json \
    --dangerously-skip-permissions \
    --model "$model" \
    --allowedTools none \
    < "$prompt_file" \
    > "$claude_out_json" 2>/dev/null
  claude_exit=$?
  ts_end="$(date -u +%FT%TZ)"

  local result_text=""
  if command -v jq >/dev/null 2>&1 && jq -e . "$claude_out_json" >/dev/null 2>&1; then
    result_text="$(jq -r '.result // empty' "$claude_out_json")"
  else
    result_text="$(cat "$claude_out_json")"
  fi

  # Append a runs.jsonl row per AC#5 (one row per replayed PR).
  replay_append_runs \
    "$cache_dir/runs.jsonl" "$claude_out_json" \
    "$slug" "replay" "$ts_start" "$ts_end" "$model" "$claude_exit"

  # Persist the rationale to a tmp file (per LESSONS 2026-06-01 — multi-
  # line values must NEVER be passed through `awk -v`). The JSON
  # rendering reads from disk and escapes via the UTF-8-safe per-byte
  # path.
  local rationale_file
  rationale_file="$(mktemp -t fleet-replay-batch-rationale.XXXXXX)"
  printf '%s' "$result_text" > "$rationale_file"

  # Classify dry-run verdict.
  local dry_run="unknown"
  case "$phase" in
    review)
      if grep -qE '^VERDICT:[[:space:]]+sign-off' "$rationale_file"; then
        dry_run="sign-off"
      elif grep -qE '^VERDICT:[[:space:]]+request-changes' "$rationale_file"; then
        dry_run="reject"
      fi
      ;;
    ship)
      if grep -qE '^ACTION:[[:space:]]+(ship|heal)' "$rationale_file"; then
        dry_run="sign-off"
      elif grep -qE '^ACTION:[[:space:]]+(wait|noop)' "$rationale_file"; then
        dry_run="reject"
      fi
      ;;
  esac

  # Compute delta.
  local delta="="
  case "$past:$dry_run" in
    merged:sign-off|rejected:reject)   delta="=" ;;
    merged:reject|rejected:sign-off)   delta="!" ;;
    *)                                  delta="!" ;;  # unknown verdict counts as a delta
  esac

  # Render the JSON line. First-200-chars of rationale via head -c (byte-
  # accurate; no bash ${s:0:200} which would be locale-sensitive per
  # LESSONS 2026-06-05).
  local rationale_head
  rationale_head="$(LC_ALL=C head -c 200 "$rationale_file")"
  rm -f "$rationale_file" "$prompt_file" "$claude_out_json"

  local title_esc rationale_esc
  title_esc="$(replay_batch_json_escape "$pr_title")"
  rationale_esc="$(replay_batch_json_escape "$rationale_head")"
  # Use `printf '%s'` (no `--`) for the final assembled JSON line; the
  # format string starts with a literal `{`, no leading dash trap.
  printf '{"pr":%s,"title":"%s","past":"%s","dry_run":"%s","delta":"%s","rationale":"%s"}\n' \
    "$pr_number" "$title_esc" "$past" "$dry_run" "$delta" "$rationale_esc"
  return 0
}

# Render the matrix table per the User-lens example. Reads JSON lines on
# stdin (one per PR plus optional trailing summary metadata via $@). We
# do not pass any per-row JSON value through `awk -v` — the rationale
# field stays in the line and is never extracted on the text path.
replay_batch_render_text() {
  local rows_file="$1" verdict="$2" replayed="$3" deltas="$4" window="$5"
  local unchanged=$(( replayed - deltas ))
  printf 'PR    TITLE                                              PAST      DRY-RUN   DELTA\n'
  # Print one row per JSON line. Extract `pr`, `title`, `past`, `dry_run`,
  # `delta` via sed regex — locked to the explicit field positions our
  # renderer emits, so the parse is deterministic.
  local line pr title past dry_run delta
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    pr="$(printf '%s' "$line" | sed -nE 's/.*"pr":([0-9]+).*/\1/p')"
    title="$(printf '%s' "$line" | sed -nE 's/.*"title":"([^"]*)".*/\1/p')"
    past="$(printf '%s' "$line" | sed -nE 's/.*"past":"([^"]*)".*/\1/p')"
    dry_run="$(printf '%s' "$line" | sed -nE 's/.*"dry_run":"([^"]*)".*/\1/p')"
    delta="$(printf '%s' "$line" | sed -nE 's/.*"delta":"([^"]*)".*/\1/p')"
    # Truncate title to a fixed width for readability.
    local title_trim="$title"
    if [ "${#title_trim}" -gt 48 ]; then
      title_trim="${title_trim:0:45}..."
    fi
    # `printf -- '%s'` per LESSONS 2026-05-28 (title may begin with `-`).
    printf -- '#%-4s %-50s %-9s %-9s %s\n' "$pr" "$title_trim" "$past" "$dry_run" "$delta"
  done < "$rows_file"
  printf '\n'
  printf 'summary: %d/%d unchanged, %d DELTA\n' "$unchanged" "$replayed" "$deltas"
  local pct=0
  if [ "$replayed" -gt 0 ]; then
    pct=$(( deltas * 100 / replayed ))
  fi
  case "$verdict" in
    OK)   printf 'verdict: OK — %d%% delta is within the noise floor.\n' "$pct" ;;
    WARN) printf 'verdict: WARN — %d%% of past good PRs would now flip.\n' "$pct" ;;
    FAIL) printf 'verdict: FAIL — %d%% of past good PRs would now flip.\n' "$pct" ;;
  esac
  # Suppress unused-var warning — window is part of the summary contract
  # and consumed by the JSON renderer; the text path doesn't print it.
  : "$window"
}

# Render the JSON output: one line per PR row + one summary object on the
# trailing line. Reads pre-built per-PR JSON lines from $rows_file and
# appends a summary object.
replay_batch_render_json() {
  local rows_file="$1" verdict="$2" replayed="$3" deltas="$4" window="$5"
  cat "$rows_file"
  printf '{"summary":true,"replayed":%d,"deltas":%d,"verdict":"%s","window":"%s"}\n' \
    "$replayed" "$deltas" "$verdict" "$(replay_batch_json_escape "$window")"
}

# `replay_batch` — the dispatcher entrypoint. Owns arg parsing for the
# batch path, the `gh pr list` enumeration, the per-PR loop, the matrix
# render, and the OK/WARN/FAIL exit code. Mirrors the single-PR replay()
# in style and reuses every existing helper.
replay_batch() {
  local slug_arg="" since="" limit=20 phase="review" want_json=0
  local _saw_batch=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --batch)     _saw_batch=1; shift ;;
      --since)     since="${2:-}"; shift 2 ;;
      --since=*)   since="${1#--since=}"; shift ;;
      --limit)     limit="${2:-20}"; shift 2 ;;
      --limit=*)   limit="${1#--limit=}"; shift ;;
      --phase)     phase="${2:-review}"; shift 2 ;;
      --phase=*)   phase="${1#--phase=}"; shift ;;
      --json)      want_json=1; shift ;;
      --dry)       shift ;;
      --) shift ;;
      -*) printf 'replay --batch: unknown flag %s\n' "$1" >&2; exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then slug_arg="$1"; shift
        else printf 'replay --batch: unexpected extra argument %s\n' "$1" >&2; exit 2
        fi ;;
    esac
  done

  : "$_saw_batch"  # quiet the linter; the pre-pass already guaranteed it

  if [ -z "$slug_arg" ] || [ -z "$since" ]; then
    echo "replay --batch: missing <slug> or --since <Nh|Nd>" >&2
    echo "usage: fleet replay <slug> --batch --since <Nh|Nd> [--limit N] [--phase review|ship] [--json]" >&2
    exit 2
  fi
  case "$phase" in
    review|ship) ;;
    *)
      printf 'replay --batch: --phase must be review or ship (got %s)\n' "$phase" >&2
      exit 2 ;;
  esac

  # --since via the shared digest_parse_since helper.
  local window_seconds
  if ! window_seconds="$(digest_parse_since "$since" 2>/dev/null)"; then
    printf -- 'replay --batch: invalid --since "%s" (use Nh or Nd)\n' "$since" >&2
    exit 2
  fi
  : "$window_seconds"

  # Clamp --limit. Default 20; max 50 (per AC#4).
  case "$limit" in
    ''|*[!0-9]*) limit=20 ;;
  esac
  if [ "$limit" -lt 1 ]; then limit=1; fi
  if [ "$limit" -gt 50 ]; then limit=50; fi

  # Resolve slug → manifest → REPO_URL + CACHE_DIR.
  local manifest
  manifest="$(replay_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    printf -- 'replay --batch: no project with SLUG=%s found\n' "$slug_arg" >&2
    exit 2
  fi
  local slug repo_url repo cache_dir model
  # shellcheck disable=SC1090
  eval "$(
    source "$manifest"
    echo "slug='${SLUG:-}'"
    echo "repo_url='${REPO_URL:-}'"
    echo "model='${MODEL:-claude-opus-4-7}'"
  )"
  repo="$(echo "$repo_url" | sed -E 's#https?://github.com/##; s#\.git$##')"
  cache_dir="$HOME/.cache/${slug}-agent"
  mkdir -p "$cache_dir"

  # ----------------------------------------------------------------
  # Enumerate candidate PRs. We ask `gh pr list` for ALL state in
  # one shot and let replay_batch_parse_list filter to merged +
  # closed-unmerged on agent prefixes. Limit×2 keeps the query
  # within budget even when half the window is rejected PRs.
  # ----------------------------------------------------------------
  local list_json fetch_limit=$(( limit * 2 ))
  if [ "$fetch_limit" -lt 4 ]; then fetch_limit=4; fi
  list_json="$(gh pr list \
                 --repo "$repo" \
                 --state all \
                 --base main \
                 --limit "$fetch_limit" \
                 --search "head:feat/ OR head:chore/gtm- OR head:eng/" \
                 --json number,title,headRefName,state,closedAt,mergedAt \
                 2>/dev/null || true)"

  # Parse into a TSV stream of (pr<TAB>title<TAB>head<TAB>past).
  local prs_tsv
  prs_tsv="$(mktemp -t fleet-replay-batch-prs.XXXXXX)"
  replay_batch_parse_list "$list_json" > "$prs_tsv"
  local n_prs
  n_prs="$(awk 'END { print NR+0 }' "$prs_tsv")"

  if [ "$n_prs" -eq 0 ]; then
    rm -f "$prs_tsv"
    printf -- 'replay --batch: no PRs matched in the last %s for slug=%s\n' "$since" "$slug" >&2
    exit 0
  fi

  # Cap to --limit (most-recent first; gh pr list already returns
  # closedAt-desc when --search includes no order hint).
  if [ "$n_prs" -gt "$limit" ]; then
    head -n "$limit" "$prs_tsv" > "$prs_tsv.cap" && mv "$prs_tsv.cap" "$prs_tsv"
    n_prs="$limit"
  fi

  # Fresh checkout once (shared across all per-PR replays — this
  # mirrors the single-PR replay() pattern but amortizes the clone).
  local checkout="$cache_dir/replay-batch-checkout"
  rm -rf "$checkout"
  mkdir -p "$(dirname "$checkout")"
  if ! git clone --depth 1 "$repo_url" "$checkout" >/dev/null 2>&1; then
    rm -f "$prs_tsv"
    printf -- 'replay --batch: git clone %s failed\n' "$repo_url" >&2
    exit 1
  fi

  # Accumulate per-PR JSON lines.
  local rows_file
  rows_file="$(mktemp -t fleet-replay-batch-rows.XXXXXX)"
  : > "$rows_file"
  local line pr title head past
  while IFS=$'\t' read -r pr title head past; do
    [ -z "$pr" ] && continue
    line="$(replay_one_pr_json_line \
              "$phase" "$checkout" "$repo" \
              "$pr" "$title" "$head" "$past" \
              "$cache_dir" "$slug" "$model" || true)"
    if [ -n "$line" ]; then
      printf '%s\n' "$line" >> "$rows_file"
    fi
  done < "$prs_tsv"
  rm -f "$prs_tsv"

  # Count deltas (LESSONS 2026-06-01: awk for counts, never `grep -c
  # … || echo 0`).
  local replayed deltas
  replayed="$(awk 'END { print NR+0 }' "$rows_file")"
  deltas="$(awk '/"delta":"!"/ { n++ } END { print n+0 }' "$rows_file")"

  # Verdict.
  local verdict pct=0
  if [ "$replayed" -gt 0 ]; then
    pct=$(( deltas * 100 / replayed ))
  fi
  if [ "$pct" -ge 30 ]; then
    verdict="FAIL"
  elif [ "$pct" -ge 10 ]; then
    verdict="WARN"
  else
    verdict="OK"
  fi

  # Render.
  if [ "$want_json" = "1" ]; then
    replay_batch_render_json "$rows_file" "$verdict" "$replayed" "$deltas" "$since"
  else
    replay_batch_render_text "$rows_file" "$verdict" "$replayed" "$deltas" "$since"
  fi
  rm -f "$rows_file"

  # OK / WARN / FAIL → 0 / 1 / 2.
  case "$verdict" in
    OK)   exit 0 ;;
    WARN) exit 1 ;;
    FAIL) exit 2 ;;
  esac
  exit 0  # unreachable; defensive per LESSONS 2026-06-01.
}

replay() {
  shift  # drop the leading "replay"
  # ----------------------------------------------------------------
  # Ticket 0034: `--batch` pre-pass. Scan the remaining args; if
  # `--batch` is present, route to replay_batch() and return — the
  # single-PR code path below is intentionally untouched so its
  # byte-identical regression (tests/replay.sh) keeps passing.
  # ----------------------------------------------------------------
  local _arg
  for _arg in "$@"; do
    if [ "$_arg" = "--batch" ]; then
      # replay_batch always exits; defensive return 0 below is unreachable
      # but satisfies shellcheck SC2319 (avoids reading $? after a test).
      replay_batch "$@"
      return 0
    fi
  done
  local slug_arg="" pr_number="" phase="review" out_path="" want_rc_ok=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pr)        pr_number="${2:-}";  shift 2 ;;
      --pr=*)      pr_number="${1#--pr=}"; shift ;;
      --phase)     phase="${2:-review}"; shift 2 ;;
      --phase=*)   phase="${1#--phase=}"; shift ;;
      --out)       out_path="${2:-}"; shift 2 ;;
      --out=*)     out_path="${1#--out=}"; shift ;;
      --request-changes-ok) want_rc_ok=1; shift ;;
      --dry)       shift ;;  # the default; accepted for symmetry
      -h|--help)
        cat <<USAGE
fleet replay — re-run the kit's current prompts against a past PR in dry-run.

Usage:
  fleet replay <slug> --pr <N>                          phase=review (default)
  fleet replay <slug> --pr <N> --phase ship             phase=ship
  fleet replay <slug> --pr <N> --request-changes-ok     succeed iff verdict is request-changes
  fleet replay <slug> --pr <N> --out FILE               write the full claude result to FILE
  fleet replay <slug> --batch --since <Nh|Nd>           grade current prompts against the last N merged PRs (ticket 0034)
  fleet replay <slug> --batch --since <Nh|Nd> --limit N cap the number of replayed PRs (default 20, max 50)
  fleet replay <slug> --batch --since <Nh|Nd> --json    machine-readable JSON-Lines output (consumed by fleet prompts-score)

Composes a prompt input from the PR's metadata + diff (review) or just
metadata + ticket (ship), the AGENTS.md and docs/LESSONS.md from a fresh
kit checkout, then invokes claude with --allowedTools none so no
side-effects land. Prints the parsed verdict line (VERDICT: ... for
review, ACTION: ... for ship); exit 0 on success, 1 on a missing/wrong
verdict, 2 on usage error. --batch wraps the same primitive in a loop
over agent-merged PRs in the window and exits 0/1/2 by OK/WARN/FAIL
delta thresholds (<10% / <30% / ≥30%).
USAGE
        exit 0 ;;
      --) shift ;;
      -*) echo "fleet replay: unknown flag '$1'" >&2; exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then slug_arg="$1"; shift
        else echo "fleet replay: unexpected extra argument '$1'" >&2; exit 2
        fi ;;
    esac
  done

  if [ -z "$slug_arg" ] || [ -z "$pr_number" ]; then
    echo "fleet replay: missing <slug> or --pr <N>" >&2
    echo "usage: fleet replay <slug> --pr <N> [--phase review|ship] [--out FILE] [--request-changes-ok]" >&2
    exit 2
  fi
  case "$phase" in
    review|ship) ;;
    *)
      echo "fleet replay: --phase must be 'review' or 'ship' (got '$phase')" >&2
      exit 2 ;;
  esac

  # Resolve slug → manifest → REPO_URL + CACHE_DIR.
  local manifest
  manifest="$(replay_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    echo "fleet replay: no project with SLUG=$slug_arg found" >&2
    exit 2
  fi
  local slug repo_url repo cache_dir model
  # shellcheck disable=SC1090  # discovered at runtime
  eval "$(
    source "$manifest"
    echo "slug='${SLUG:-}'"
    echo "repo_url='${REPO_URL:-}'"
    echo "model='${MODEL:-claude-opus-4-7}'"
  )"
  repo="$(echo "$repo_url" | sed -E 's#https?://github.com/##; s#\.git$##')"
  cache_dir="$HOME/.cache/${slug}-agent"
  mkdir -p "$cache_dir"

  # Fetch PR metadata. We pull more fields than we strictly need so the
  # composed prompt has every relevant header for the verdict-rendering
  # subagent (title/body matter; mergeCommit/mergedAt confirm the
  # merged-vs-open state).
  local pr_view_json
  pr_view_json="$(gh pr view "$pr_number" \
                    --repo "$repo" \
                    --json number,title,headRefName,body,mergeCommit,mergedAt,files,state \
                    2>/dev/null || true)"
  if [ -z "$pr_view_json" ] || [ "$pr_view_json" = "{}" ]; then
    echo "fleet replay: gh pr view $pr_number returned nothing" >&2
    exit 1
  fi

  # Parse the PR fields. We reuse the rollback_json_* helpers — they're
  # robust enough for flat-string fields and the one-deep mergeCommit oid.
  local pr_title head_ref pr_body merged_at
  pr_title="$(rollback_json_string "$pr_view_json" "title")"
  head_ref="$(rollback_json_string "$pr_view_json" "headRefName")"
  # `body` may contain quoted JSON characters; we only echo it into the
  # prompt, never re-emit it as JSON, so the shallow extractor is fine.
  pr_body="$(rollback_json_string "$pr_view_json" "body")"
  merged_at="$(rollback_json_string "$pr_view_json" "mergedAt")"

  local branch_tail
  branch_tail="$(replay_branch_tail "$head_ref")"
  if [ -z "$branch_tail" ]; then
    echo "not an agent feature PR; replay is scoped to feat/ and eng/ branches" >&2
    exit 2
  fi

  # Identify the linked ticket by the PR title's `feat/<id>-` prefix
  # convention. The branch_tail looks like "0017-fleet-rollback"; we
  # split on the first dash to get the 4-digit id.
  local ticket_id="${branch_tail%%-*}"

  # Fresh checkout to read AGENTS.md, LESSONS.md, and the ticket file at
  # the CURRENT tree's state (the whole point of "replay against current
  # prompts"). Uses $CACHE_DIR/replay-checkout — a separate dir from
  # ship/groom/review so a running ship can't race with a replay.
  local checkout="$cache_dir/replay-checkout"
  rm -rf "$checkout"
  mkdir -p "$(dirname "$checkout")"
  if ! git clone --depth 1 "$repo_url" "$checkout" >/dev/null 2>&1; then
    echo "fleet replay: git clone $repo_url failed" >&2
    exit 1
  fi

  # Find the ticket file by 4-digit id. We glob rather than assume the
  # exact slug-tail so a renamed-on-merge ticket still resolves.
  local ticket_path=""
  local cand
  for cand in "$checkout/docs/backlog/${ticket_id}-"*.md; do
    if [ -f "$cand" ]; then
      ticket_path="$cand"
      break
    fi
  done

  # Pull the diff for review phase. We only need this when the prompt
  # grades the diff; ship doesn't, per the ticket's AC#2.
  local diff_path="$cache_dir/replay-pr${pr_number}.diff"
  if [ "$phase" = "review" ]; then
    gh pr diff "$pr_number" --repo "$repo" > "$diff_path" 2>/dev/null || true
  fi

  # Compose the prompt body into a tmpfile, then pipe it to claude with
  # tool-lock. We do NOT shell out to fleet_run_claude — see the header.
  local prompt_file claude_out_json
  prompt_file="$(mktemp -t fleet-replay-prompt.XXXXXX)"
  claude_out_json="$(mktemp -t fleet-replay-claude.XXXXXX)"
  replay_compose_prompt \
    "$phase" "$checkout" "$ticket_path" "$diff_path" \
    "$pr_number" "$pr_title" "$head_ref" "$pr_body" "$merged_at" \
    > "$prompt_file"

  local ts_start ts_end claude_exit
  ts_start="$(date -u +%FT%TZ)"
  # AGENT_DRY_RUN is the kit's standard tool-lock env var — set it for
  # the duration of the claude call so any consumer that inspects env
  # (e.g. a future telemetry hook) sees we were in dry-run.
  AGENT_DRY_RUN=1 claude \
    --print \
    --output-format json \
    --dangerously-skip-permissions \
    --model "$model" \
    --allowedTools none \
    < "$prompt_file" \
    > "$claude_out_json" 2>/dev/null
  claude_exit=$?
  ts_end="$(date -u +%FT%TZ)"

  # Parse `result` from the claude JSON. Best-effort: missing jq → fall
  # back to the raw text.
  local result_text=""
  if command -v jq >/dev/null 2>&1 && jq -e . "$claude_out_json" >/dev/null 2>&1; then
    result_text="$(jq -r '.result // empty' "$claude_out_json")"
  else
    result_text="$(cat "$claude_out_json")"
  fi

  # Persist the full result to disk so the operator can `cat` it later.
  if [ -z "$out_path" ]; then
    local stamp; stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    out_path="$cache_dir/replay-${slug}-pr${pr_number}-${phase}-${stamp}.txt"
  fi
  mkdir -p "$(dirname "$out_path")" 2>/dev/null || true
  printf '%s\n' "$result_text" > "$out_path"

  # Append to runs.jsonl with phase=replay (per AC#8).
  replay_append_runs \
    "$cache_dir/runs.jsonl" "$claude_out_json" \
    "$slug" "replay" "$ts_start" "$ts_end" "$model" "$claude_exit"

  # --- render summary -----------------------------------------------------
  echo "Replaying $phase prompt against $slug PR #$pr_number ($branch_tail)"
  [ -n "$ticket_path" ] && echo "  ticket: ${ticket_path#"$checkout/"} (${merged_at:-open})"
  echo "  prompt: composed at $prompt_file"
  echo "  result: $out_path"
  echo

  # Truncate the printed body to ~400 chars per AC#1.
  local head_400="${result_text:0:400}"
  echo "$head_400"
  [ "${#result_text}" -gt 400 ] && echo "[... truncated; full result at $out_path]"
  echo

  # Parse the verdict line.
  local verdict_re verdict
  case "$phase" in
    review) verdict_re='^VERDICT:[[:space:]]+(sign-off|request-changes)' ;;
    ship)   verdict_re='^ACTION:[[:space:]]+(heal|ship|wait|noop)' ;;
  esac
  verdict="$(printf '%s\n' "$result_text" \
              | grep -E -m1 "$verdict_re" \
              | head -1)"

  # Print the parsed verdict line on its own — the test grep relies on
  # this exact prefix (^VERDICT: / ^ACTION:) anchored at the start of a
  # line in stdout.
  if [ -n "$verdict" ]; then
    printf '%s\n' "$verdict"
  else
    case "$phase" in
      review) echo "VERDICT: unknown" ;;
      ship)   echo "ACTION: unknown" ;;
    esac
  fi

  # Compute exit code from the verdict + --request-changes-ok flag.
  local verdict_kind=""
  if [ -n "$verdict" ]; then
    verdict_kind="$(printf '%s' "$verdict" \
                    | sed -nE 's/^(VERDICT|ACTION):[[:space:]]+([a-zA-Z_-]+).*/\2/p')"
  fi

  rm -f "$prompt_file" "$claude_out_json"

  case "$phase" in
    review)
      if [ "$want_rc_ok" = "1" ]; then
        [ "$verdict_kind" = "request-changes" ] && exit 0 || exit 1
      else
        [ "$verdict_kind" = "sign-off" ] && exit 0 || exit 1
      fi
      ;;
    ship)
      # Success = "would do real work" (ship or heal). wait/noop/unknown → 1.
      # --request-changes-ok is review-only; on ship we ignore it.
      case "$verdict_kind" in
        ship|heal) exit 0 ;;
        *)         exit 1 ;;
      esac
      ;;
  esac
}

if [ "$CMD" = "replay" ]; then
  replay "$@"
fi

# --- provenance (ticket 0029) --------------------------------------------
# `fleet provenance <slug> <pr> [--format text|json|md]` prints a one-page
# audit receipt joining the prompts SHA, prompts CHANGELOG entry, heal
# attempts, infra-flake reruns, review verdict, lesson-draft count, the
# cross-fleet LESSONS sha+count at merge time, budget-block events, and
# spend for one shipped PR. Pure consumer of the existing telemetry
# channel + the kit's git history — emits NO new event types per P-6,
# touches NO `lib/` or `prompts/` files, makes NO `gh api` call.
#
# Test seams (consumed only by tests/provenance.sh):
#   FLEET_DISCOVERY_ROOT — slug→manifest root (already shared with badge).
#   FLEET_KIT_ROOT       — kit checkout the prompts CHANGELOG walker reads.
#   FLEET_GIT_REPLAY_DIR — replay tree the synthetic git stub reads.
#
# All three default to the real-world paths when unset, so the production
# code path is what the test exercises (no parallel "test mode").

# Resolve slug → manifest. Mirrors the rollback / badge helpers' union
# scan over FLEET_DISCOVERY_ROOT + the installed projects tree so a
# project on either side resolves identically.
provenance_resolve_manifest() {
  badge_resolve_manifest "$1"
}

# Read the slug's events.jsonl, scan for the pr_opened {number=<pr>}
# event AND the run_completed event whose ts most-immediately follows it
# (and which carries pr=<pr> or merge_sha when present). Echoes a
# tab-separated `<open_ts>\t<merge_ts>\t<merge_sha>` triple or empty when
# either bound is missing. The empty echo is the "unknown PR" signal —
# AC#11 turns it into an exit-2 error.
provenance_find_pr_window() {
  local events="$1" want_pr="$2"
  [ -f "$events" ] || return 0
  awk -v want="$want_pr" '
    function jv(line, key,    re, val) {
      re = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
      if (match(line, re)) {
        val = substr(line, RSTART, RLENGTH)
        sub(/.*:[[:space:]]*"/, "", val); sub(/".*/, "", val)
        return val
      }
      return ""
    }
    {
      t = jv($0, "type")
      ts = jv($0, "ts")
      num = jv($0, "number")
      pr  = jv($0, "pr")
      ms  = jv($0, "merge_sha")
      if (t == "pr_opened" && num == want && open_ts == "") {
        open_ts = ts
      }
      if (open_ts != "" && t == "run_completed" && merge_ts == "") {
        # A run_completed without pr= still terminates the window for
        # the run that owned this PR — but a run_completed whose pr is
        # set MUST match. Honour both shapes per AGENTS.md "consumers
        # MUST tolerate unknown extras gracefully".
        if (pr == "" || pr == want) {
          merge_ts = ts
          merge_sha = ms
        }
      }
    }
    END {
      if (open_ts != "" && merge_ts != "") {
        printf "%s\t%s\t%s\n", open_ts, merge_ts, merge_sha
      }
    }
  ' "$events"
}

# prompts SHA resolution. Walk events between [open_ts, merge_ts] for the
# last `prompts_drift` — if one fires the `actual` field is the SHA that
# ran. Otherwise read PROMPTS_SHA= out of `git show <merge>:agents.config.sh`
# through whatever git is on PATH (the test's stub returns from the replay
# dir; production resolves against the project repo's history). The second
# return value (the "source": `drift` or `manifest`) is needed for the
# `(drift recorded at ...)` annotation in the text/md renderers and for
# the JSON `prompts_sha_source` field — echoed on the SECOND tab-separated
# field of the output line.
provenance_prompts_sha() {
  local events="$1" open_ts="$2" merge_ts="$3" merge_sha="$4"
  local drift_sha=""
  if [ -f "$events" ]; then
    # awk-side window filter on lexicographic ISO-8601 comparison — every
    # ts we read is normalized to the same `YYYY-MM-DDTHH:MM:SSZ` shape
    # (the channel writer in lib/common.sh strips sub-second fractions).
    drift_sha="$(awk -v lo="$open_ts" -v hi="$merge_ts" '
      function jv(line, key,    re, val) {
        re = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
        if (match(line, re)) {
          val = substr(line, RSTART, RLENGTH)
          sub(/.*:[[:space:]]*"/, "", val); sub(/".*/, "", val)
          return val
        }
        return ""
      }
      {
        t = jv($0, "type"); ts = jv($0, "ts")
        if (t == "prompts_drift" && ts <= hi) {
          last_actual = jv($0, "actual")
          last_ts = ts
        }
      }
      END { if (last_actual != "") printf "%s\t%s\n", last_actual, last_ts }
    ' "$events")"
  fi
  if [ -n "$drift_sha" ]; then
    local sha ts
    sha="$(printf '%s' "$drift_sha" | awk -F'\t' '{print $1}')"
    ts="$(printf '%s' "$drift_sha"  | awk -F'\t' '{print $2}')"
    printf '%s\tdrift\t%s\n' "$sha" "$ts"
    return 0
  fi
  # No drift → fall back to the manifest the merge SHA shipped against.
  # Test stub honours FLEET_GIT_REPLAY_DIR; production resolves via the
  # operator's local git checkout. A failure here is non-fatal — we echo
  # an empty SHA so the renderer can print "(unknown)" instead.
  local manifest_sha=""
  if [ -n "$merge_sha" ]; then
    manifest_sha="$(git show "$merge_sha:agents.config.sh" 2>/dev/null \
                     | sed -nE 's/^PROMPTS_SHA="?([0-9a-f]+)"?.*/\1/p' \
                     | head -1)"
  fi
  printf '%s\tmanifest\t\n' "$manifest_sha"
}

# Walk the kit's prompts/CHANGELOG.md for the `## YYYY-MM-DD` heading
# whose date is the LATEST one not exceeding the merge date. Echoes the
# heading body (`<YYYY-MM-DD> — <title>`) or empty when no entry matches.
# Honours FLEET_KIT_ROOT (test) → falls back to the kit the bin runs from.
provenance_changelog_entry() {
  local merge_ts="$1"
  local kit_root="${FLEET_KIT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
  local changelog="$kit_root/prompts/CHANGELOG.md"
  [ -f "$changelog" ] || return 0
  [ -s "$changelog" ] || return 0
  # Extract just the YYYY-MM-DD prefix from the merge ts for lexicographic
  # comparison. The CHANGELOG headings are pure dates so a string `<=`
  # gives the right ordering without any date-math.
  local merge_date="${merge_ts%%T*}"
  awk -v cutoff="$merge_date" '
    /^## [0-9]{4}-[0-9]{2}-[0-9]{2}/ {
      body = substr($0, 4)        # strip leading "## "
      d = substr(body, 1, 10)
      if (d <= cutoff && (best == "" || d > best_date)) {
        best = body
        best_date = d
      }
    }
    END { if (best != "") print best }
  ' "$changelog"
}

# Count subject lines beginning with `heal:` on the merge SHA's branch
# range. The test stub returns from the synthetic replay; production
# resolves against the project's git history. Caps at 2 (the AGENTS.md
# heal-attempt hard cap — surfaces >2 as 2 with a data-bug hint
# rendered inline). Echoes a single integer.
provenance_heal_count() {
  local merge_sha="$1"
  [ -n "$merge_sha" ] || { echo 0; return 0; }
  # Use `merge_sha^..merge_sha` shape: the stub keys on the suffix after
  # ".." so any base is fine. Real production git accepts the form too.
  local raw
  raw="$(git log --format=%s "${merge_sha}^..${merge_sha}" 2>/dev/null \
          || git log --format=%s "${merge_sha}" 2>/dev/null)"
  local n
  n="$(printf '%s\n' "$raw" | awk '/^heal:/ { n++ } END { print n+0 }')"
  if [ "$n" -gt 2 ]; then n=2; fi
  echo "$n"
}

# Walk the events channel between [open_ts, merge_ts] for
# infra_flake_rerun events whose pr=<pr> matches. Echoes
# `<count>\t<pattern1,pattern2,...>\t<ts1>` — the renderer reads the
# count for the int and the FIRST pattern + ts for the parenthetical.
provenance_infra_flakes() {
  local events="$1" open_ts="$2" merge_ts="$3" want_pr="$4"
  [ -f "$events" ] || { printf '0\t\t\n'; return 0; }
  awk -v lo="$open_ts" -v hi="$merge_ts" -v want="$want_pr" '
    function jv(line, key,    re, val) {
      re = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
      if (match(line, re)) {
        val = substr(line, RSTART, RLENGTH)
        sub(/.*:[[:space:]]*"/, "", val); sub(/".*/, "", val)
        return val
      }
      return ""
    }
    {
      t = jv($0, "type"); ts = jv($0, "ts"); pr = jv($0, "pr")
      if (t == "infra_flake_rerun" && pr == want && ts >= lo && ts <= hi) {
        n++
        pat = jv($0, "pattern")
        if (patterns == "") patterns = pat; else patterns = patterns "," pat
        if (first_ts == "") first_ts = ts
      }
    }
    END { printf "%d\t%s\t%s\n", n+0, patterns, first_ts }
  ' "$events"
}

# Count lesson_draft_emitted events whose pr=<pr> falls in the window.
# >0 ⇒ review verdict is `--request-changes`; ==0 ⇒ `--comment`.
provenance_lesson_draft_count() {
  local events="$1" open_ts="$2" merge_ts="$3" want_pr="$4"
  [ -f "$events" ] || { echo 0; return 0; }
  awk -v lo="$open_ts" -v hi="$merge_ts" -v want="$want_pr" '
    function jv(line, key,    re, val) {
      re = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
      if (match(line, re)) {
        val = substr(line, RSTART, RLENGTH)
        sub(/.*:[[:space:]]*"/, "", val); sub(/".*/, "", val)
        return val
      }
      return ""
    }
    {
      t = jv($0, "type"); ts = jv($0, "ts"); pr = jv($0, "pr")
      if (t == "lesson_draft_emitted" && pr == want && ts >= lo && ts <= hi) n++
    }
    END { print n+0 }
  ' "$events"
}

# Count budget_block events in the window for this slug. Per AC#1 we
# always render the count even when zero — the operator wants the
# explicit "0" rather than absence-as-signal.
provenance_budget_block_count() {
  local events="$1" open_ts="$2" merge_ts="$3"
  [ -f "$events" ] || { echo 0; return 0; }
  awk -v lo="$open_ts" -v hi="$merge_ts" '
    function jv(line, key,    re, val) {
      re = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
      if (match(line, re)) {
        val = substr(line, RSTART, RLENGTH)
        sub(/.*:[[:space:]]*"/, "", val); sub(/".*/, "", val)
        return val
      }
      return ""
    }
    {
      t = jv($0, "type"); ts = jv($0, "ts")
      if (t == "budget_block" && ts >= lo && ts <= hi) n++
    }
    END { print n+0 }
  ' "$events"
}

# Cross-fleet LESSONS at PHASE 0 — count of `^### ` lines in
# CROSS_LESSONS.md at the merge ts. Walks `git log -1 --until=<ts>
# --format=%H -- CROSS_LESSONS.md` then `git show <sha>:CROSS_LESSONS.md`.
# Falls back to the kit's current file when no replay dir / git history.
# Echoes `<count>\t<sha-or-current>` on one line. Per LESSONS 2026-05-27
# the file body is awk-counted directly — never captured to a variable
# that later gets written back to disk.
provenance_cross_lessons() {
  local merge_ts="$1"
  local kit_root="${FLEET_KIT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
  local count="0" sha=""
  # Replay branch: git stub returns a sha for the CROSS_LESSONS.md path.
  if [ -n "${FLEET_GIT_REPLAY_DIR:-}" ] && [ -d "${FLEET_GIT_REPLAY_DIR}" ]; then
    sha="$(git log -1 --until="$merge_ts" --format=%H -- CROSS_LESSONS.md 2>/dev/null \
            | head -1)"
    if [ -n "$sha" ]; then
      count="$(git show "$sha:CROSS_LESSONS.md" 2>/dev/null \
                | awk '/^### / { n++ } END { print n+0 }')"
      printf '%s\t%s\n' "$count" "$sha"
      return 0
    fi
  fi
  # Fallback branch: the kit's current CROSS_LESSONS.md (or "current"
  # marker when neither path exists — count stays 0).
  local cf="$kit_root/CROSS_LESSONS.md"
  if [ -f "$cf" ]; then
    count="$(awk '/^### / { n++ } END { print n+0 }' "$cf")"
    sha="current"
  fi
  printf '%s\t%s\n' "$count" "$sha"
}

# Resolve ticket id + (best-effort) title from a branch like
# `feat/0028-fleet-lessons-promote`. The id is the leading 4-digit
# prefix; the title is the hyphen-joined tail with hyphens turned into
# spaces and the leading "fleet " preserved as-is (matches the AC
# sample `0028 — fleet lessons-promote`). When the branch shape does
# not match, echoes `\t\t`. Echoes `<id>\t<title>` on one line.
provenance_ticket_from_branch() {
  local branch="$1"
  local tail
  case "$branch" in
    feat/*|eng/*) tail="${branch#*/}" ;;
    *) printf '\t\n'; return 0 ;;
  esac
  case "$tail" in
    [0-9][0-9][0-9][0-9]-*)
      local id title_raw title
      id="${tail%%-*}"
      title_raw="${tail#*-}"
      # Convert the kebab tail into a human-ish phrase: `fleet-lessons-
      # promote` → `fleet lessons-promote`. Only the FIRST hyphen
      # becomes a space; the rest stay as multi-word command names
      # (`lessons-promote`, `prompts-diff`, etc.) the operator wrote.
      case "$title_raw" in
        *-*) title="${title_raw%%-*} ${title_raw#*-}" ;;
        *)   title="$title_raw" ;;
      esac
      printf '%s\t%s\n' "$id" "$title" ;;
    *) printf '\t\n' ;;
  esac
}

# Render the text block. Keys in fixed order per AC#1. The key column is
# width 32 (the widest key — `cross-fleet lessons at PHASE 0:` — fits in
# 31 chars, +1 trailing space). Output is reused verbatim inside the md
# fenced block per AC#2.
provenance_render_kv() {
  local k="$1" v="$2"
  # 32-char left-aligned key + space-separated value. printf -- guards
  # any value that happens to start with `-` per LESSONS 2026-05-28.
  printf -- '%-32s%s\n' "$k:" "$v"
}

provenance_render_text() {
  # Positional args mirror the JSON renderer so any later refactor can
  # share one struct. Order matches AC#1.
  local pr="$1" slug="$2" shipped_at="$3" merge_sha="$4"
  local ticket_id="$5" ticket_title="$6" branch="$7"
  local sha_display="$8" sha_annot="$9"; shift 9
  local chg_entry="$1" heal="$2" infra_n="$3" infra_annot="$4"
  local verdict="$5" verdict_annot="$6" drafts="$7"
  local cross_n="$8" cross_sha="$9"; shift 9
  local budget_n="$1" spend="$2"

  printf -- 'Provenance — %s PR #%s\n' "$slug" "$pr"
  provenance_render_kv "shipped" "$shipped_at (squash $merge_sha)"
  if [ -n "$ticket_id" ]; then
    provenance_render_kv "ticket" "$ticket_id — $ticket_title"
  else
    provenance_render_kv "ticket" "(no ticket — non-agent branch)"
  fi
  provenance_render_kv "branch" "$branch"
  if [ -n "$sha_annot" ]; then
    provenance_render_kv "prompts SHA" "$sha_display ($sha_annot)"
  else
    provenance_render_kv "prompts SHA" "$sha_display"
  fi
  if [ -n "$chg_entry" ]; then
    provenance_render_kv "prompts version" "changelog entry $chg_entry"
  else
    provenance_render_kv "prompts version" "(no changelog entry — pre-CHANGELOG ship)"
  fi
  provenance_render_kv "heal attempts" "$heal"
  if [ "$infra_n" = "0" ]; then
    provenance_render_kv "infra-flake reruns" "0"
  else
    provenance_render_kv "infra-flake reruns" "$infra_n ($infra_annot)"
  fi
  if [ -n "$verdict_annot" ]; then
    provenance_render_kv "review verdict" "$verdict ($verdict_annot)"
  else
    provenance_render_kv "review verdict" "$verdict"
  fi
  provenance_render_kv "lesson drafts emitted" "$drafts"
  provenance_render_kv "cross-fleet lessons at PHASE 0" "$cross_n (sha $cross_sha)"
  provenance_render_kv "budget block events" "$budget_n"
  provenance_render_kv "spend" "\$$spend"
}

provenance_render_md() {
  local pr="$1" slug="$2"
  shift 2
  printf -- '# Provenance — %s PR #%s\n\n' "$slug" "$pr"
  printf -- '```\n'
  provenance_render_text "$pr" "$slug" "$@"
  # The first line of render_text is the `Provenance — …` header — strip
  # it from the fenced block by re-rendering only the kv portion. The
  # easiest path is to capture and chop, but `tail -n +2` requires a
  # subshell. Inline the kv block instead by re-calling the helpers — but
  # that doubles maintenance. Compromise: rely on the text renderer's
  # contract (first line == header, rest == kv) and tail the captured
  # output once. We re-render via a function call to avoid duplicating
  # the key list.
  : # the above printf chain already emitted the full text block; strip
    # in caller via the fence + tail invocation below.
}

# md is text minus its first line + a fenced wrapper + the trailing HTML
# comment marker. Re-using the text renderer is the cleanest way to keep
# the two formats byte-identical in the key/value portion.
provenance_format_md() {
  local pr="$1" slug="$2"
  shift 2
  printf -- '# Provenance — %s PR #%s\n\n' "$slug" "$pr"
  printf -- '```\n'
  provenance_render_text "$pr" "$slug" "$@" | tail -n +2
  printf -- '```\n'
  printf -- '<!-- generated by fleet provenance -->\n'
}

# UTF-8-safe JSON string escape. The in-file `doctor_json_escape` (line
# ~702) and `_json_escape` in lib/common.sh both use `printf -v code
# '%d' "'$ch"` which, under LC_ALL=C, sign-extends a multi-byte UTF-8
# byte into a negative integer and emits a bogus `\u......` sequence.
# JSON does not require escaping of bytes >= 0x80 — raw UTF-8 is legal
# in a JSON string — so we just pass any byte >= 32 through verbatim
# and only escape the structural / control chars JSON forbids
# unescaped. Per LESSONS 2026-06-01 the JSON path stays awk-free for
# multi-line safety; per LESSONS 2026-05-28 the printf format gets
# `--` to defuse a leading-dash value.
provenance_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *)
        printf -v code '%d' "'$ch"
        # Negative = high UTF-8 byte (sign-extended under LC_ALL=C);
        # >= 32 = printable ASCII or already-safe high byte; < 32 =
        # a control char that needs `\u00xx`.
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v out '%s\\u%04x' "$out" "$code"
        else
          out+="$ch"
        fi
        ;;
    esac
  done
  printf -- '%s' "$out"
}

# Render JSON. Composed via printf + `provenance_json_escape` per
# LESSONS 2026-06-01 (awk -v rejects newlines — multi-line values go
# through the per-byte escape, not `awk -v`). The infra_flake_patterns
# array is built by splitting the comma-separated patterns string.
# `prompts_sha_source` is `drift` or `manifest` so machine consumers
# can decide whether to surface the annotation in their UI.
provenance_render_json() {
  local pr="$1" slug="$2" shipped_at="$3" merge_sha="$4"
  local ticket_id="$5" ticket_title="$6" branch="$7"
  local sha_display="$8" sha_source="$9"; shift 9
  local chg_entry="$1" heal="$2" infra_n="$3" infra_patterns="$4"
  local verdict="$5" drafts="$6" cross_n="$7" cross_sha="$8"
  local budget_n="$9"; shift 9
  local spend="$1"

  # Build the infra_flake_patterns array. Comma-separated → JSON list.
  local patterns_json="[]"
  if [ -n "$infra_patterns" ]; then
    patterns_json="["
    local first=1
    local IFS=','
    # shellcheck disable=SC2086  # intentional word-split on comma
    for p in $infra_patterns; do
      if [ "$first" = "1" ]; then
        patterns_json="$patterns_json\"$(provenance_json_escape "$p")\""
        first=0
      else
        patterns_json="$patterns_json,\"$(provenance_json_escape "$p")\""
      fi
    done
    patterns_json="$patterns_json]"
  fi

  # spend → numeric. Strip any leading "$" defensively (the field is
  # always rendered as `N.NN` from digest_spend_since, but be explicit).
  local spend_num="${spend#\$}"
  case "$spend_num" in ''|*[!0-9.]*) spend_num="0.00" ;; esac

  printf '{'
  printf '"slug":"%s"' "$(provenance_json_escape "$slug")"
  printf ',"pr":%s' "$pr"
  printf ',"shipped_at":"%s"' "$(provenance_json_escape "$shipped_at")"
  printf ',"merge_sha":"%s"' "$(provenance_json_escape "$merge_sha")"
  printf ',"ticket_id":"%s"' "$(provenance_json_escape "$ticket_id")"
  printf ',"ticket_title":"%s"' "$(provenance_json_escape "$ticket_title")"
  printf ',"branch":"%s"' "$(provenance_json_escape "$branch")"
  printf ',"prompts_sha":"%s"' "$(provenance_json_escape "$sha_display")"
  printf ',"prompts_sha_source":"%s"' "$(provenance_json_escape "$sha_source")"
  printf ',"prompts_changelog_entry":"%s"' "$(provenance_json_escape "$chg_entry")"
  printf ',"heal_attempts":%s' "$heal"
  printf ',"infra_flake_reruns":%s' "$infra_n"
  printf ',"infra_flake_patterns":%s' "$patterns_json"
  printf ',"review_verdict":"%s"' "$(provenance_json_escape "$verdict")"
  printf ',"lesson_drafts_emitted":%s' "$drafts"
  printf ',"cross_lessons_count":%s' "$cross_n"
  printf ',"cross_lessons_sha":"%s"' "$(provenance_json_escape "$cross_sha")"
  printf ',"budget_block_events":%s' "$budget_n"
  printf ',"spend_usd":%s' "$spend_num"
  printf '}'
}

# Find the slug's events.jsonl, scan for the branch name that landed on
# pr_opened. Echoes the branch or empty.
provenance_branch_for_pr() {
  local events="$1" want_pr="$2"
  [ -f "$events" ] || return 0
  awk -v want="$want_pr" '
    function jv(line, key,    re, val) {
      re = "\"" key "\"[[:space:]]*:[[:space:]]*\"[^\"]*\""
      if (match(line, re)) {
        val = substr(line, RSTART, RLENGTH)
        sub(/.*:[[:space:]]*"/, "", val); sub(/".*/, "", val)
        return val
      }
      return ""
    }
    {
      t = jv($0, "type")
      if (t == "pr_opened" && jv($0, "number") == want) {
        print jv($0, "branch"); exit
      }
    }
  ' "$events"
}

provenance() {
  shift  # drop the leading "provenance"
  local slug_arg="" pr_arg="" format="text"
  while [ $# -gt 0 ]; do
    case "$1" in
      --format)   format="${2:-}"; shift 2 ;;
      --format=*) format="${1#--format=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet provenance — one-command audit receipt for a shipped PR.

Usage:
  fleet provenance <slug> <pr>                default --format text
  fleet provenance <slug> <pr> --format md    paste-friendly markdown
  fleet provenance <slug> <pr> --format json  machine-readable receipt

Reads the slug's local events.jsonl + runs.jsonl, joins them with the
kit's prompts/CHANGELOG.md and the project's git history, and prints a
fixed-key block answering: which prompts SHA shipped, which CHANGELOG
entry that maps to, how many heal commits + infra-flake reruns fired,
whether the review signed off or sent back, how many lesson drafts
landed, the cross-fleet LESSONS sha at merge time, the in-window
budget-block count, and the spend.

Flags:
  --format text|md|json   output shape (default text)
  --help                  print this banner and exit

Example:
  fleet provenance agent-fleet 57 --format md \\
    | gh pr comment 57 --body-file -

Read-only — no commits, no PRs, no \`gh api\` call, no new event types.
Pure consumer of the existing telemetry channel + git history.
USAGE
        exit 0 ;;
      --) shift ;;
      -*)
        printf -- 'fleet provenance: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then slug_arg="$1"; shift
        elif [ -z "$pr_arg" ]; then pr_arg="$1"; shift
        else
          printf -- 'fleet provenance: unexpected extra argument %s\n' "$1" >&2
          exit 2
        fi ;;
    esac
  done

  if [ -z "$slug_arg" ] || [ -z "$pr_arg" ]; then
    echo "fleet provenance: missing <slug> or <pr> (usage: fleet provenance <slug> <pr> [--format text|md|json])" >&2
    exit 2
  fi
  case "$format" in
    text|md|json) ;;
    *) echo "fleet provenance: invalid --format \"$format\" (use text, md, or json)" >&2; exit 2 ;;
  esac
  case "$pr_arg" in
    ''|*[!0-9]*)
      echo "fleet provenance: <pr> must be a positive integer (got \"$pr_arg\")" >&2
      exit 2 ;;
  esac

  # Resolve slug → manifest. The error string mirrors the badge / rollback
  # helpers so the operator's "where did I look?" trail is consistent.
  local manifest
  manifest="$(provenance_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
    echo "provenance: no project with SLUG=$slug_arg found (looked under FLEET_DISCOVERY_ROOT=$root)" >&2
    exit 2
  fi

  local cache_dir="$HOME/.cache/${slug_arg}-agent"
  local events="$cache_dir/events.jsonl"
  local runs="$cache_dir/runs.jsonl"

  # PR window — pr_opened.ts + run_completed.ts + merge_sha.
  local window
  window="$(provenance_find_pr_window "$events" "$pr_arg")"
  if [ -z "$window" ]; then
    echo "provenance: PR #$pr_arg not found in events.jsonl for $slug_arg (no pr_opened or run_completed event matched)" >&2
    exit 2
  fi
  local open_ts merge_ts merge_sha
  open_ts="$(printf '%s\n' "$window" | awk -F'\t' '{print $1}')"
  merge_ts="$(printf '%s\n' "$window" | awk -F'\t' '{print $2}')"
  merge_sha="$(printf '%s\n' "$window" | awk -F'\t' '{print $3}')"

  # Branch + ticket id/title from the pr_opened event.
  local branch ticket_pair ticket_id ticket_title
  branch="$(provenance_branch_for_pr "$events" "$pr_arg")"
  ticket_pair="$(provenance_ticket_from_branch "$branch")"
  ticket_id="$(printf '%s\n' "$ticket_pair" | awk -F'\t' '{print $1}')"
  ticket_title="$(printf '%s\n' "$ticket_pair" | awk -F'\t' '{print $2}')"

  # prompts SHA — drift wins; manifest is the fallback. Echo shape:
  # `<sha>\t<source>\t<drift_ts-or-empty>`.
  local sha_line sha_full sha_source sha_ts sha_display sha_annot
  sha_line="$(provenance_prompts_sha "$events" "$open_ts" "$merge_ts" "$merge_sha")"
  sha_full="$(printf '%s\n'  "$sha_line" | awk -F'\t' '{print $1}')"
  sha_source="$(printf '%s\n' "$sha_line" | awk -F'\t' '{print $2}')"
  sha_ts="$(printf '%s\n'    "$sha_line" | awk -F'\t' '{print $3}')"
  # Truncate to 8 chars for display (matches the AC sample's
  # `7a3e1c0…` ellipsis style — but we drop the ellipsis so the text
  # render stays grep-friendly).
  sha_display="${sha_full:0:8}"
  if [ -z "$sha_display" ]; then sha_display="(unknown)"; fi
  case "$sha_source" in
    drift)    sha_annot="drift recorded at $sha_ts" ;;
    *)        sha_annot="" ;;
  esac

  # prompts CHANGELOG entry — the latest `## YYYY-MM-DD …` whose date
  # does not exceed the merge date.
  local chg_entry
  chg_entry="$(provenance_changelog_entry "$merge_ts")"

  # heal attempts — capped at 2 per AGENTS.md heal hard cap.
  local heal_count
  heal_count="$(provenance_heal_count "$merge_sha")"

  # infra-flake reruns + patterns.
  local infra_line infra_n infra_patterns infra_ts infra_annot
  infra_line="$(provenance_infra_flakes "$events" "$open_ts" "$merge_ts" "$pr_arg")"
  infra_n="$(printf '%s\n'        "$infra_line" | awk -F'\t' '{print $1}')"
  infra_patterns="$(printf '%s\n' "$infra_line" | awk -F'\t' '{print $2}')"
  infra_ts="$(printf '%s\n'       "$infra_line" | awk -F'\t' '{print $3}')"
  if [ -n "$infra_patterns" ] && [ -n "$infra_ts" ]; then
    # First pattern + first ts; multi-rerun PRs surface the additional
    # patterns through --format json (infra_flake_patterns array).
    local first_pat="${infra_patterns%%,*}"
    infra_annot="$first_pat at $infra_ts"
  else
    infra_annot=""
  fi

  # review verdict — lesson_draft_emitted ⇒ --request-changes.
  local draft_count verdict verdict_annot
  draft_count="$(provenance_lesson_draft_count "$events" "$open_ts" "$merge_ts" "$pr_arg")"
  if [ "$draft_count" -gt 0 ]; then
    verdict="--request-changes"
    verdict_annot="lesson draft emitted"
  else
    verdict="--comment"
    verdict_annot=""
  fi

  # cross-fleet LESSONS at PHASE 0 — count + sha.
  local cross_line cross_n cross_sha
  cross_line="$(provenance_cross_lessons "$merge_ts")"
  cross_n="$(printf '%s\n'   "$cross_line" | awk -F'\t' '{print $1}')"
  cross_sha="$(printf '%s\n' "$cross_line" | awk -F'\t' '{print $2}')"
  [ -z "$cross_sha" ] && cross_sha="current"

  # budget block events in the window.
  local budget_n
  budget_n="$(provenance_budget_block_count "$events" "$open_ts" "$merge_ts")"

  # spend over the [open_ts, merge_ts] window. `digest_spend_since` only
  # takes a single floor — we need a second pass to clip the ceiling.
  # Compute by passing the merge ts through a tmp runs file: every row
  # whose ts_start <= merge_ts AND ts_start >= open_ts contributes.
  local open_epoch merge_epoch
  open_epoch="$(digest_iso_to_epoch "$open_ts")"
  merge_epoch="$(digest_iso_to_epoch "$merge_ts")"
  local spend="0.00"
  if [ -n "$open_epoch" ] && [ -n "$merge_epoch" ] && [ -f "$runs" ]; then
    spend="$(awk -v lo="$open_epoch" -v hi="$merge_epoch" '
      function iso2ep(ts,    cmd, out) {
        gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
        cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
        cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
        if ((cmd | getline out) <= 0) out = 0
        close(cmd)
        return out + 0
      }
      {
        ts=""; cost=0
        if (match($0, /"ts_start"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
          ts=substr($0, RSTART, RLENGTH)
          sub(/.*"ts_start"[[:space:]]*:[[:space:]]*"/, "", ts)
          sub(/".*/, "", ts)
        }
        if (match($0, /"total_cost_usd"[[:space:]]*:[[:space:]]*-?[0-9.eE+-]+/)) {
          c=substr($0, RSTART, RLENGTH)
          sub(/.*:[[:space:]]*/, "", c)
          cost = c + 0
        }
        if (ts == "") next
        ep = iso2ep(ts)
        if (ep >= lo && ep <= hi) total += cost
      }
      END { printf("%.2f", total + 0) }
    ' "$runs")"
  fi

  # ---- emit -------------------------------------------------------------
  case "$format" in
    text)
      provenance_render_text \
        "$pr_arg" "$slug_arg" "$merge_ts" "$merge_sha" \
        "$ticket_id" "$ticket_title" "$branch" \
        "$sha_display" "$sha_annot" \
        "$chg_entry" "$heal_count" "$infra_n" "$infra_annot" \
        "$verdict" "$verdict_annot" "$draft_count" \
        "$cross_n" "$cross_sha" "$budget_n" "$spend"
      ;;
    md)
      provenance_format_md \
        "$pr_arg" "$slug_arg" "$merge_ts" "$merge_sha" \
        "$ticket_id" "$ticket_title" "$branch" \
        "$sha_display" "$sha_annot" \
        "$chg_entry" "$heal_count" "$infra_n" "$infra_annot" \
        "$verdict" "$verdict_annot" "$draft_count" \
        "$cross_n" "$cross_sha" "$budget_n" "$spend"
      ;;
    json)
      provenance_render_json \
        "$pr_arg" "$slug_arg" "$merge_ts" "$merge_sha" \
        "$ticket_id" "$ticket_title" "$branch" \
        "$sha_full" "$sha_source" \
        "$chg_entry" "$heal_count" "$infra_n" "$infra_patterns" \
        "$verdict" "$draft_count" "$cross_n" "$cross_sha" \
        "$budget_n" "$spend"
      ;;
  esac

  exit 0
}

if [ "$CMD" = "provenance" ]; then
  provenance "$@"
fi

# --- overview -------------------------------------------------------------
# Ticket 0019. `fleet overview` prints a single cross-project table answering
# "what is the fleet doing right now?" One row per discovered project, columns:
#
#   PROJECT  SHIP  REVIEW  SENDBK  $TODAY  IN-FLIGHT  STATE
#
# It is the cross-project subtraction the operator wants on day 2 with 3-7
# projects installed: instead of running `fleet doctor`, `fleet digest`, and
# `gh pr list` per repo, one command renders the fleet's pulse.
#
# Read-only: never mutates a manifest, never opens a PR, never touches gh
# beyond `gh pr list` per project. Discovery uses the same two-root pattern
# as doctor/digest/tail (FLEET_DISCOVERY_ROOT first, then
# ~/.local/share/agent-fleet/projects), de-duped by SLUG. No new lib/ helpers.
#
# STATE priority order (per the ticket):
#   EXPIRED > PAUSED > OVER-BUDGET > STUCK > HEAL > OK
# The first three reuse `digest_state`'s predicates verbatim. STUCK and HEAL
# need `gh` and are computed in a second pass inside this function (gracefully
# skipped when gh is offline — AC#7).
#
# Naming (LESSONS 2026-05-26): the dispatcher is named `overview()` — no
# coreutils binary by that name, so no `_cmd` suffix needed. The function
# does NOT shell out to anything called `overview`.
#
# Test hook: $FLEET_OVERVIEW_FAKE_NOW (epoch seconds) overrides "now" so
# SHIP-age math in tests/overview.sh is deterministic.

OVERVIEW_ROOT="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
OVERVIEW_INSTALLED="$HOME/.local/share/agent-fleet/projects"

# Discover (slug, manifest_path, repo_url) rows union of the two roots,
# de-duped by SLUG, in slug-alpha order. Working-tree manifests win over
# installed copies (same convention as `discover()` at the top of this file).
overview_discover() {
  local _seen="" m slug repo_url
  { find "$OVERVIEW_ROOT"      -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$OVERVIEW_INSTALLED" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    [ -z "$slug" ] && continue
    case " $_seen " in *" $slug "*) continue ;; esac
    _seen="$_seen $slug"
    # shellcheck disable=SC1090
    repo_url=$( (source "$m"; echo "${REPO_URL:-}") 2>/dev/null )
    printf '%s\t%s\t%s\n' "$slug" "$m" "$repo_url"
  done | sort -t $'\t' -k1,1
}

# Pluck the open agent PR for one project. Echoes "NUMBER|STATE|UPDATED_EPOCH"
# or empty when no PR is open (or gh fails). STATE is one of
# GREEN/RED/PENDING/BEHIND/DIRTY derived from mergeStateStatus + the rollup.
overview_inflight() {
  local repo="$1"
  command -v gh >/dev/null 2>&1 || { echo ""; return 0; }
  [ -n "$repo" ] || { echo ""; return 0; }
  # `gh pr list --search "head:feat/ head:eng/"` excludes chore/gtm-* (per
  # the engineering notes). The result is one PR per row in JSON; we take
  # the lowest-numbered (Phase 1 convention in lib/ship.sh).
  local raw
  raw="$(gh pr list \
            --repo "$repo" \
            --state open \
            --base main \
            --search "head:feat/ head:eng/" \
            --json number,mergeStateStatus,statusCheckRollup,headRefName,updatedAt \
            --limit 5 \
            2>/dev/null)" || true
  [ -z "$raw" ] || [ "$raw" = "[]" ] && { echo ""; return 0; }
  # Pick the lowest PR number. Use node if it's available; fall back to a
  # tiny sed scan when not.
  local picked=""
  if command -v node >/dev/null 2>&1; then
    picked="$(node -e '
      try {
        const arr = JSON.parse(require("fs").readFileSync(0, "utf8"));
        if (!Array.isArray(arr) || arr.length === 0) process.exit(0);
        arr.sort((a, b) => a.number - b.number);
        const p = arr[0];
        // Reduce statusCheckRollup → derived state. GitHub conclusions:
        // SUCCESS/FAILURE/CANCELLED/SKIPPED/NEUTRAL (and null while pending).
        const rollup = Array.isArray(p.statusCheckRollup) ? p.statusCheckRollup : [];
        let derived = "GREEN";
        let anyPending = false, anyFail = false;
        for (const c of rollup) {
          const v = (c.conclusion || c.status || "").toUpperCase();
          if (v === "FAILURE" || v === "FAILED" || v === "CANCELLED" || v === "TIMED_OUT") anyFail = true;
          if (v === "" || v === "IN_PROGRESS" || v === "QUEUED" || v === "PENDING") anyPending = true;
        }
        if (anyFail) derived = "RED";
        else if (anyPending) derived = "PENDING";
        // mergeStateStatus overrides for BEHIND/DIRTY (which are about the
        // branch, not the checks).
        const mss = (p.mergeStateStatus || "").toUpperCase();
        if (mss === "BEHIND") derived = "BEHIND";
        if (mss === "DIRTY") derived = "DIRTY";
        // Epoch seconds for updatedAt (used by STUCK detection).
        let epoch = 0;
        if (p.updatedAt) epoch = Math.floor(Date.parse(p.updatedAt) / 1000) || 0;
        process.stdout.write(`${p.number}|${derived}|${epoch}`);
      } catch (e) { /* drop */ }
    ' <<<"$raw")"
  else
    # Pure-shell fallback. Pick the first PR's number, treat status as GREEN
    # unless mergeStateStatus says otherwise. Good enough for the offline
    # fallback; the test rig has node.
    local n mss
    n="$(printf '%s' "$raw" | sed -nE 's/.*"number"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -1)"
    mss="$(printf '%s' "$raw" | sed -nE 's/.*"mergeStateStatus"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -1)"
    local derived="GREEN"
    case "$mss" in
      BEHIND) derived="BEHIND" ;;
      DIRTY)  derived="DIRTY" ;;
      BLOCKED) derived="RED" ;;
    esac
    [ -n "$n" ] && picked="${n}|${derived}|0"
  fi
  echo "$picked"
}

# Count `--request-changes` reviews in the trailing 24h via gh fallback.
# The ticket explicitly authorises using `gh pr list --search
# "review:changes-requested"` when no `review_blocked` event type exists.
overview_sendback_count() {
  local repo="$1"
  command -v gh >/dev/null 2>&1 || { echo 0; return 0; }
  [ -n "$repo" ] || { echo 0; return 0; }
  local raw
  raw="$(gh pr list \
            --repo "$repo" \
            --search "review:changes-requested updated:>$(date -u -v-1d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '24 hours ago' +%Y-%m-%dT%H:%M:%SZ) head:feat/ head:eng/" \
            --json number \
            --limit 20 \
            2>/dev/null)" || true
  [ -z "$raw" ] || [ "$raw" = "[]" ] && { echo 0; return 0; }
  # Count objects. node when available; cheap brace count otherwise.
  if command -v node >/dev/null 2>&1; then
    node -e '
      try { const a = JSON.parse(require("fs").readFileSync(0, "utf8")); process.stdout.write(String(a.length || 0)); }
      catch (e) { process.stdout.write("0"); }
    ' <<<"$raw"
  else
    printf '%s' "$raw" | tr -cd '{' | wc -c | tr -d ' '
  fi
}

# Best-effort: last review verdict for a project, expressed as "ok Nh" /
# "block Nh" / "-". Sourced from gh pr list with the appropriate review
# filter, picking the most-recent updatedAt. When gh is offline we echo "-".
overview_last_review() {
  local repo="$1" now="$2"
  command -v gh >/dev/null 2>&1 || { echo "—"; return 0; }
  [ -n "$repo" ] || { echo "—"; return 0; }
  local raw
  raw="$(gh pr list \
            --repo "$repo" \
            --state open \
            --search "head:feat/ head:eng/" \
            --json number,reviewDecision,updatedAt \
            --limit 5 \
            2>/dev/null)" || true
  [ -z "$raw" ] || [ "$raw" = "[]" ] && { echo "—"; return 0; }
  if ! command -v node >/dev/null 2>&1; then
    # Pure-shell: read reviewDecision of the first PR.
    local rd
    rd="$(printf '%s' "$raw" | sed -nE 's/.*"reviewDecision"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -1)"
    case "$rd" in
      CHANGES_REQUESTED) echo "block" ;;
      APPROVED|COMMENTED) echo "ok" ;;
      *) echo "—" ;;
    esac
    return 0
  fi
  node -e '
    try {
      const arr = JSON.parse(require("fs").readFileSync(0, "utf8"));
      if (!Array.isArray(arr) || arr.length === 0) { process.stdout.write("—"); process.exit(0); }
      // Pick most recent updatedAt.
      arr.sort((a, b) => Date.parse(b.updatedAt || 0) - Date.parse(a.updatedAt || 0));
      const p = arr[0];
      const rd = (p.reviewDecision || "").toUpperCase();
      const ts = Date.parse(p.updatedAt || 0) / 1000 || 0;
      const now = parseInt(process.argv[1] || "0", 10) || 0;
      const diff = Math.max(0, now - ts);
      let age;
      if (diff < 3600) age = Math.floor(diff / 60) + "m";
      else if (diff < 86400) age = Math.floor(diff / 3600) + "h";
      else age = Math.floor(diff / 86400) + "d";
      let tag;
      if (rd === "CHANGES_REQUESTED") tag = "block";
      else if (rd === "APPROVED" || rd === "COMMENTED") tag = "ok";
      else { process.stdout.write("—"); process.exit(0); }
      process.stdout.write(tag + " " + age);
    } catch (e) { process.stdout.write("—"); }
  ' "$now" <<<"$raw"
}

# Compute the STATE for one project. Reuses digest_state for
# EXPIRED/PAUSED/OVER-BUDGET (and THROTTLED, which we collapse into OK for
# this surface — the ticket lists STATE as exactly six values, no THROTTLED).
# Then we add STUCK (open PR >24h old with no commit in 6h, when gh works)
# and HEAL (in-flight PR has a `heal:` commit).
overview_state() {
  local self_cancel="$1" spend_today="$2" cap="$3" namespace="$4" cache_dir="$5"
  local repo="$6" inflight_number="$7" inflight_epoch="$8" now="$9"
  # Reuse digest_state for the first three.
  local base
  base="$(digest_state "$self_cancel" "$spend_today" "$cap" "$namespace" "$cache_dir")"
  case "$base" in
    EXPIRED|PAUSED|OVER-BUDGET) echo "$base"; return 0 ;;
    THROTTLED) ;;  # not part of overview's STATE vocabulary → fall through
  esac
  # STUCK: open agent PR older than 24h with no commit in the last 6h.
  # "no commit in the last 6h" is approximated by updatedAt — `gh pr list`'s
  # updatedAt advances on every push, so an old PR with a stale updatedAt
  # qualifies. We require both: (PR_age > 24h) AND (updated_age > 6h).
  if [ -n "$inflight_number" ] && [ -n "$inflight_epoch" ] && [ "$inflight_epoch" -gt 0 ]; then
    # PR age is computed from createdAt, which we don't have in the cached
    # JSON — proxy with `updatedAt < (now - 24h)`. If updatedAt is more than
    # 24h ago, the PR is necessarily older than 24h AND has been quiet for
    # 24h+ (which is a strict superset of "no commit in 6h"). Cheap, correct
    # for the day-2 surface.
    local updated_age=$(( now - inflight_epoch ))
    if [ "$updated_age" -gt 86400 ]; then
      echo "STUCK"; return 0
    fi
  fi
  # HEAL: in-flight PR has a `heal:` commit. We use `gh pr view --json
  # commits` when gh is available; otherwise skip.
  if command -v gh >/dev/null 2>&1 && [ -n "$inflight_number" ] && [ -n "$repo" ]; then
    local commits
    commits="$(gh pr view "$inflight_number" \
                 --repo "$repo" \
                 --json commits \
                 2>/dev/null)" || true
    if [ -n "$commits" ] && echo "$commits" | grep -q '"messageHeadline"[[:space:]]*:[[:space:]]*"heal:'; then
      echo "HEAL"; return 0
    fi
  fi
  echo "OK"
}

# Human-form table row.
overview_render_human() {
  local slug="$1" ship_age="$2" review="$3" sendbk="$4" spend="$5"
  local inflight_label="$6" state="$7"
  printf '%-14s %-10s %-10s %-7s %-9s %-16s %s\n' \
    "$slug" "$ship_age" "$review" "$sendbk" "\$$spend" "$inflight_label" "$state"
}

overview() {
  shift  # drop the leading "overview"
  local want_json=0 slug_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      --slug) slug_filter="${2:-}"; shift 2 ;;
      --slug=*) slug_filter="${1#--slug=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet overview — single-glance cross-project health table.

Usage:
  fleet overview                 survey every discovered project
  fleet overview --slug NAME     restrict to one project
  fleet overview --json          machine-readable array

Columns:
  PROJECT   slug from manifest
  SHIP      age of newest ~/.cache/<slug>-agent/logs/ship-*.log
  REVIEW    last review verdict (ok N / block N) or "—"
  SENDBK    count of --request-changes reviews on agent PRs (trailing 24h)
  \$TODAY    today's UTC sum from runs.jsonl
  IN-FLIGHT lowest open feat/ or eng/ PR + GREEN/RED/PENDING/BEHIND/DIRTY
            ("—" when gh is offline/unauthenticated)
  STATE     one of OK / HEAL / PAUSED / OVER-BUDGET / EXPIRED / STUCK

JSON schema (one object per project):
  { slug, ship: {last_run_epoch, age_label},
    review: {last_verdict, age_label}, sendbk, spend_today_usd,
    inflight: {number, state, updated_epoch},
    state: {code, reason} }

Exit code: 1 when any project is EXPIRED, OVER-BUDGET, or STUCK; else 0.
HEAL and PAUSED are not red.
USAGE
        exit 0 ;;
      *) echo "fleet overview: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  local now
  now="${FLEET_OVERVIEW_FAKE_NOW:-$(date -u +%s)}"

  # Print human header. The widths match overview_render_human's printf so
  # the columns line up under their labels.
  if [ "$want_json" != "1" ]; then
    printf '%-14s %-10s %-10s %-7s %-9s %-16s %s\n' \
      "PROJECT" "SHIP" "REVIEW" "SENDBK" "\$TODAY" "IN-FLIGHT" "STATE"
  fi

  local any_red=0
  local json_rows=""
  while IFS=$'\t' read -r slug manifest repo_url; do
    [ -z "$slug" ] && continue
    [ -n "$slug_filter" ] && [ "$slug" != "$slug_filter" ] && continue

    # Manifest probe — fetch what we need.
    local probe namespace self_cancel cap
    probe=$(
      # shellcheck disable=SC1090
      ( source "$manifest" 2>/dev/null
        echo "NAMESPACE=${NAMESPACE:-com.fleet.${SLUG:-x}}"
        echo "SELF_CANCEL=${SELF_CANCEL:-}"
        echo "MAX_DAILY_USD=${MAX_DAILY_USD:-}"
      ) 2>/dev/null
    ) || true
    namespace="$(echo "$probe" | sed -n 's/^NAMESPACE=//p')"
    self_cancel="$(echo "$probe" | sed -n 's/^SELF_CANCEL=//p')"
    cap="$(echo "$probe" | sed -n 's/^MAX_DAILY_USD=//p')"

    local cache_dir="$HOME/.cache/${slug}-agent"
    local runs="$cache_dir/runs.jsonl"
    local logs_dir="$cache_dir/logs"

    # SHIP: age of newest log file.
    local ship_epoch ship_age
    ship_epoch="$(newest_log_epoch "$logs_dir")"
    if [ -n "$ship_epoch" ]; then
      local diff=$(( now - ship_epoch ))
      if   [ "$diff" -lt 3600 ];  then ship_age="$(( diff/60 ))m ago"
      elif [ "$diff" -lt 86400 ]; then ship_age="$(( diff/3600 ))h ago"
      else ship_age="$(( diff/86400 ))d ago"; fi
    else
      ship_age="—"
    fi

    # Derive owner/repo from REPO_URL (https://github.com/owner/name[.git]).
    local repo
    repo="$(echo "$repo_url" | sed -E 's#https?://github.com/##; s#\.git$##')"

    # IN-FLIGHT: gh pr list. Returns "NUMBER|STATE|EPOCH" or empty.
    local inflight inflight_number="" inflight_state="" inflight_epoch=0
    inflight="$(overview_inflight "$repo")"
    if [ -n "$inflight" ]; then
      inflight_number="$(echo "$inflight" | cut -d'|' -f1)"
      inflight_state="$(echo "$inflight" | cut -d'|' -f2)"
      inflight_epoch="$(echo "$inflight" | cut -d'|' -f3)"
    fi

    # REVIEW + SENDBK: gh fallback (the `review_blocked` event type does not
    # exist yet — engineering note in the ticket; documented in the
    # implementation log). When gh is offline both gracefully degrade.
    local review_label sendbk
    review_label="$(overview_last_review "$repo" "$now")"
    sendbk="$(overview_sendback_count "$repo")"

    # $TODAY: today's UTC spend from runs.jsonl.
    local spend_today
    spend_today="$(digest_spend_today "$runs")"

    # STATE: digest_state for the first three; overview_state adds STUCK/HEAL.
    local state
    state="$(overview_state \
              "$self_cancel" "$spend_today" "$cap" "$namespace" "$cache_dir" \
              "$repo" "$inflight_number" "$inflight_epoch" "$now")"

    case "$state" in
      EXPIRED|OVER-BUDGET|STUCK) any_red=1 ;;
    esac

    # IN-FLIGHT human label. "#N STATE" or "—" when no PR / gh offline.
    local inflight_label
    if [ -n "$inflight_number" ]; then
      inflight_label="#${inflight_number} ${inflight_state}"
    else
      inflight_label="—"
    fi

    if [ "$want_json" = "1" ]; then
      local esc_slug esc_state esc_review esc_inflight_state
      esc_slug="$(doctor_json_escape "$slug")"
      esc_state="$(doctor_json_escape "$state")"
      esc_review="$(doctor_json_escape "$review_label")"
      esc_inflight_state="$(doctor_json_escape "$inflight_state")"
      local ship_epoch_json="${ship_epoch:-0}"
      local inflight_number_json="null"
      [ -n "$inflight_number" ] && inflight_number_json="$inflight_number"
      local inflight_epoch_json="${inflight_epoch:-0}"
      [ -n "$json_rows" ] && json_rows+=","
      json_rows+="{\"slug\":\"$esc_slug\""
      json_rows+=",\"ship\":{\"last_run_epoch\":$ship_epoch_json,\"age_label\":\"$(doctor_json_escape "$ship_age")\"}"
      json_rows+=",\"review\":{\"last_verdict\":\"$esc_review\"}"
      json_rows+=",\"sendbk\":$sendbk"
      json_rows+=",\"spend_today_usd\":$spend_today"
      json_rows+=",\"inflight\":{\"number\":$inflight_number_json,\"state\":\"$esc_inflight_state\",\"updated_epoch\":$inflight_epoch_json}"
      json_rows+=",\"state\":{\"code\":\"$esc_state\",\"reason\":\"\"}"
      json_rows+="}"
    else
      overview_render_human \
        "$slug" "$ship_age" "$review_label" "$sendbk" "$spend_today" \
        "$inflight_label" "$state"
    fi
  done < <(overview_discover)

  if [ "$want_json" = "1" ]; then
    printf '[%s]\n' "$json_rows"
  fi

  [ "$any_red" = "1" ] && exit 1
  exit 0
}

if [ "$CMD" = "overview" ]; then
  overview "$@"
fi

# --- atlas ----------------------------------------------------------------
# Ticket 0031. `fleet atlas` joins the hand-curated infra-flake catalog at
# `lib/heal-catalog.sh` with the `infra_flake_rerun` events across every
# discovered project's `events.jsonl` and renders one table answering
# "which catalog patterns are actually firing in the wild, how often,
# when, and where."
#
#   PATTERN              FIRED  LAST SEEN     PROJECTS         LESSON
#   actions_silent           4  2h ago        agent-fleet      2026-05-26
#   supabase_port_bind       0  —             —                2026-05-25
#   ...
#
# Pure reader: NO new event types, NO mutation of the catalog. The catalog
# stays hand-curated and PR-gated (per the ticket's "Out of scope" clause).
#
# Defensive habits (LESSONS to defend against, per the ticket):
# - 2026-05-26 (`tail` shadow): the dispatcher is named `atlas` — no
#   coreutils binary by that name (`command -v atlas` is empty).
# - 2026-05-27 ($(cat) trap): every file read uses awk or cp — never
#   `$(cat …)` for content later written back.
# - 2026-05-28 (printf leading-dash trap): every printf of a slug or
#   pattern token starts with `printf -- '%s'`.
# - 2026-05-30 (grep -F -- dash trap): grep callers in the test file
#   already use `grep -qF --`; production code here does not pattern-match
#   on user-provided strings beyond catalog tokens (which never start
#   with `-`), but we still use `--` where shellcheck would warn.
# - 2026-06-01 (awk -v newline trap): every `awk -v` value below is a
#   single-line token (slug, ISO8601 ts, pattern token); the catalog body
#   is read by file path, not via -v.
# - 2026-06-01 (`grep -c file || echo 0` double-print trap): counts use
#   awk with `END { print n+0 }` — never grep -c.
# - 2026-06-01 (dispatcher fall-through trap): every code path in atlas()
#   ends with explicit `exit 0` or `exit 2`.

ATLAS_DEFAULT_WINDOW="30d"

# Resolve the catalog path the same way fleet_match_infra_flake (common.sh
# ~1033) does — honour FLEET_HEAL_CATALOG when set, else fall back to the
# kit's lib/heal-catalog.sh next to this script.
atlas_catalog_path() {
  if [ -n "${FLEET_HEAL_CATALOG:-}" ]; then
    printf -- '%s\n' "$FLEET_HEAL_CATALOG"
    return 0
  fi
  local self; self="$( cd "$( dirname "$0" )" && pwd )"
  printf -- '%s\n' "$self/../lib/heal-catalog.sh"
}

# Parse the catalog file as text. Echoes one `<token>\t<lesson-date>` line
# per pattern in catalog (declaration) order. <lesson-date> is the
# YYYY-MM-DD captured from the inline `# LESSON: <repo> YYYY-MM-DD …`
# comment immediately preceding the pattern entry — empty when no such
# comment exists for that pattern.
#
# Implementation: awk walks the file linearly. On each non-comment, non-
# blank line, we look for the trailing `"<token>|<regex>"` entry shape.
# We buffer the LATEST `# LESSON: … YYYY-MM-DD …` date we have seen
# since the last array close (or the array open `(`) and emit it with
# the next pattern entry. The buffer is cleared every time we emit so a
# pattern without its own LESSON comment renders empty.
#
# No `awk -v` multi-line trap (LESSONS 2026-06-01) — we pass the file
# path, not the body.
atlas_parse_catalog() {
  local catalog="$1"
  [ -f "$catalog" ] || return 0
  awk '
    # Buffer the most recent LESSON date we have read since emitting the
    # last pattern. Cleared on emit.
    {
      line = $0
      # Capture LESSON date from a comment line.
      if (match(line, /^[[:space:]]*#[[:space:]]*LESSON:.*[0-9]{4}-[0-9]{2}-[0-9]{2}/)) {
        # Pull the first YYYY-MM-DD on the line.
        if (match(line, /[0-9]{4}-[0-9]{2}-[0-9]{2}/)) {
          last_lesson = substr(line, RSTART, RLENGTH)
        }
        next
      }
      # Skip other comments and blank lines (they do not clear the buffer).
      if (line ~ /^[[:space:]]*#/) next
      if (line ~ /^[[:space:]]*$/) next
      # Pattern entry: `"<token>|<regex>"` somewhere on the line.
      if (match(line, /"[A-Za-z0-9_]+\|/)) {
        entry = substr(line, RSTART + 1, RLENGTH - 2)
        # entry currently ends with `|` — strip it.
        gsub(/\|$/, "", entry)
        printf("%s\t%s\n", entry, last_lesson)
        last_lesson = ""
      }
    }
  ' "$catalog"
}

# Count infra_flake_rerun events with pattern=<token> across one or more
# events.jsonl files, restricted to ts >= cutoff_epoch. Echoes one integer.
# Reuses the inbox_budget_block_today JSON-scan awk shape (no jq).
#
# Args:
#   $1 — catalog token (single line, no newline)
#   $2 — cutoff_epoch
#   $3..N — events.jsonl paths (any missing files silently skipped)
atlas_count_pattern() {
  local token="$1" cutoff="$2"; shift 2
  local files=()
  local f
  for f in "$@"; do
    [ -f "$f" ] && files+=("$f")
  done
  if [ "${#files[@]}" -eq 0 ]; then
    echo 0
    return 0
  fi
  awk -v cutoff="$cutoff" -v want="$token" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; type=""; pat=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (match($0, /"pattern"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        pat=substr($0, RSTART, RLENGTH)
        sub(/.*"pattern"[[:space:]]*:[[:space:]]*"/, "", pat); sub(/".*/, "", pat)
      }
      if (type != "infra_flake_rerun") next
      if (pat != want) next
      if (iso2ep(ts) < cutoff) next
      n++
    }
    END { print (n+0) }
  ' "${files[@]}"
}

# Emit the newest matching event's ts (ISO8601) on stdout, or empty when no
# match. Args identical to atlas_count_pattern.
atlas_last_seen_pattern() {
  local token="$1" cutoff="$2"; shift 2
  local files=()
  local f
  for f in "$@"; do
    [ -f "$f" ] && files+=("$f")
  done
  if [ "${#files[@]}" -eq 0 ]; then
    return 0
  fi
  awk -v cutoff="$cutoff" -v want="$token" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; type=""; pat=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (match($0, /"pattern"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        pat=substr($0, RSTART, RLENGTH)
        sub(/.*"pattern"[[:space:]]*:[[:space:]]*"/, "", pat); sub(/".*/, "", pat)
      }
      if (type != "infra_flake_rerun") next
      if (pat != want) next
      ep = iso2ep(ts)
      if (ep < cutoff) next
      if (ep > best_ep) { best_ep = ep; best_ts = ts }
    }
    END { if (best_ts != "") print best_ts }
  ' "${files[@]}"
}

# Compose the PROJECTS column. Echoes a sorted, comma-joined list of slugs
# that contributed at least one matching event in the window. Cap at 3 and
# append " +N" when more match (per AC#4).
#
# Args:
#   $1 — token, $2 — cutoff_epoch, then tab-separated `<slug>\t<events_path>`
#        rows on stdin (one per line). We feed in the discovered project
#        set so this helper does not have to re-walk it.
atlas_projects_for_pattern() {
  local token="$1" cutoff="$2"
  local hits=""
  local slug events
  while IFS=$'\t' read -r slug events; do
    [ -z "$slug" ] && continue
    [ -f "$events" ] || continue
    local n
    n="$(atlas_count_pattern "$token" "$cutoff" "$events")"
    if [ "${n:-0}" -gt 0 ]; then
      hits+="$slug"$'\n'
    fi
  done
  # Sort, de-dup, count, truncate.
  local sorted
  sorted="$(printf -- '%s' "$hits" | awk 'NF { print }' | sort -u)"
  if [ -z "$sorted" ]; then
    return 0
  fi
  local total head_count overflow
  total="$(printf -- '%s\n' "$sorted" | awk 'NF { n++ } END { print (n+0) }')"
  if [ "$total" -le 3 ]; then
    # Comma-join.
    printf -- '%s' "$sorted" | awk 'NF { if (out) out = out "," $0; else out = $0 } END { print out }'
  else
    head_count=3
    overflow=$(( total - head_count ))
    printf -- '%s' "$sorted" \
      | awk -v cap=3 -v overflow="$overflow" '
          NF { n++; if (n <= cap) { if (out) out = out "," $0; else out = $0 } }
          END { print out " +" overflow }
        '
  fi
}

# Render one row in text mode. Args:
#   $1 token, $2 fired, $3 last_seen_label, $4 projects_label, $5 lesson_label
atlas_render_row_text() {
  local token="$1" fired="$2" last_seen="$3" projects="$4" lesson="$5"
  printf -- '%-20s %5s  %-12s  %-16s  %s\n' \
    "$token" "$fired" "$last_seen" "$projects" "$lesson"
}

# Render one row in JSON mode. Args:
#   $1 token, $2 fired (int), $3 last_seen_ts (iso8601 or empty),
#   $4 projects_csv (empty or "a,b,c" without overflow marker),
#   $5 lesson_date (YYYY-MM-DD or empty)
atlas_render_row_json() {
  local token="$1" fired="$2" last_seen_ts="$3" projects_csv="$4" lesson_date="$5"
  local last_seen_json="null"
  if [ -n "$last_seen_ts" ]; then
    last_seen_json="\"$(doctor_json_escape "$last_seen_ts")\""
  fi
  local lesson_json="null"
  if [ -n "$lesson_date" ]; then
    lesson_json="\"$(doctor_json_escape "$lesson_date")\""
  fi
  # projects_csv → JSON array. Split on comma; empty CSV → [].
  local projects_json="[]"
  if [ -n "$projects_csv" ]; then
    projects_json="$(printf -- '%s' "$projects_csv" \
      | awk 'BEGIN { FS = "," }
             { for (i = 1; i <= NF; i++) {
                 v = $i
                 gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v)
                 out = (out ? out "," : "") "\"" v "\""
               } }
             END { print "[" out "]" }')"
  fi
  printf -- '{"pattern":"%s","fired":%s,"last_seen_ts":%s,"projects":%s,"lesson_date":%s}\n' \
    "$(doctor_json_escape "$token")" "$fired" "$last_seen_json" \
    "$projects_json" "$lesson_json"
}

# Convert an ISO8601 ts → human age relative to FLEET_ATLAS_FAKE_NOW or
# current time. Mirrors human_age (~line 64) but starts from an ISO string.
atlas_human_age_iso() {
  local ts="$1"
  [ -z "$ts" ] && { echo "—"; return 0; }
  local now ep
  now="${FLEET_ATLAS_FAKE_NOW:-$(date -u +%s)}"
  ep="$(digest_iso_to_epoch "$ts")"
  [ -z "$ep" ] && { echo "—"; return 0; }
  local diff=$(( now - ep ))
  [ "$diff" -lt 0 ] && diff=0
  if   [ "$diff" -lt 3600 ];  then echo "$(( diff/60 ))m ago"
  elif [ "$diff" -lt 86400 ]; then echo "$(( diff/3600 ))h ago"
  else echo "$(( diff/86400 ))d ago"; fi
}

# Discover (slug, events_path) rows under FLEET_DISCOVERY_ROOT. Same
# two-root pattern as overview_discover, de-duped by SLUG. Skips slugs
# without an events.jsonl on disk only at the count step — the row still
# qualifies for the survey (just contributes 0 fires).
atlas_discover() {
  local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
  local installed="$HOME/.local/share/agent-fleet/projects"
  local _seen="" m slug
  { find "$root"      -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$installed" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    [ -z "$slug" ] && continue
    case " $_seen " in *" $slug "*) continue ;; esac
    _seen="$_seen $slug"
    printf -- '%s\t%s\n' "$slug" "$HOME/.cache/${slug}-agent/events.jsonl"
  done | sort -t $'\t' -k1,1
}

atlas() {
  shift  # drop the leading "atlas"
  local want_json=0 slug_filter="" since="$ATLAS_DEFAULT_WINDOW"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) want_json=1; shift ;;
      --slug)
        if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
          echo "atlas: --slug requires a non-empty value" >&2
          exit 2
        fi
        slug_filter="$2"; shift 2 ;;
      --slug=*)
        slug_filter="${1#--slug=}"
        if [ -z "$slug_filter" ]; then
          echo "atlas: --slug requires a non-empty value" >&2
          exit 2
        fi
        shift ;;
      --since)
        if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
          echo "atlas: --since requires a value (use Nh or Nd)" >&2
          exit 2
        fi
        since="$2"; shift 2 ;;
      --since=*)
        since="${1#--since=}"
        if [ -z "$since" ]; then
          echo "atlas: --since requires a value (use Nh or Nd)" >&2
          exit 2
        fi
        shift ;;
      -h|--help)
        cat <<USAGE
fleet atlas — fleet-wide infra-flake catalog with per-pattern frequency.

Usage:
  fleet atlas                   default --since 30d, every project
  fleet atlas --since 7d        restrict window (Nh or Nd)
  fleet atlas --slug NAME       restrict survey to one project
  fleet atlas --json            one JSON object per pattern + 1 summary
  fleet atlas --help            this message

Columns:
  PATTERN     catalog token from lib/heal-catalog.sh
  FIRED       count of infra_flake_rerun events in the window
  LAST SEEN   human_age of newest matching event, or "—"
  PROJECTS    comma-joined sorted slugs (capped at 3 + " +N" overflow)
  LESSON      YYYY-MM-DD from the inline LESSON comment, or "(no lesson)"

Read-only — no commits, no PRs, no new event types. The catalog file at
lib/heal-catalog.sh is hand-curated; this command READS it. Set
FLEET_HEAL_CATALOG=<path> to point at an alternate catalog.

Exit code: 0 on success; 2 on invalid --since / unknown --slug /
missing catalog.
USAGE
        exit 0 ;;
      *)
        echo "atlas: unknown flag '$1'" >&2
        exit 2 ;;
    esac
  done

  # Parse --since via the shared digest_parse_since helper (bin/fleet ~1140).
  local window_seconds
  if ! window_seconds="$(digest_parse_since "$since" 2>/dev/null)"; then
    printf -- 'atlas: invalid --since "%s" (use Nh or Nd)\n' "$since" >&2
    exit 2
  fi

  # Resolve catalog path; refuse to proceed if missing/unreadable.
  local catalog
  catalog="$(atlas_catalog_path)"
  if [ ! -f "$catalog" ] || [ ! -r "$catalog" ]; then
    printf -- 'atlas: heal catalog not found at %s (set FLEET_HEAL_CATALOG to override)\n' \
      "$catalog" >&2
    exit 2
  fi

  # Compute the cutoff epoch.
  local now cutoff
  now="${FLEET_ATLAS_FAKE_NOW:-$(date -u +%s)}"
  cutoff=$(( now - window_seconds ))

  # Discover the surveyed project set (slug, events-path) lines. If a slug
  # filter is set, restrict; if the filter has no match under the discovery
  # root, exit 2 with the documented stderr message.
  local discovered
  discovered="$(atlas_discover)"
  if [ -n "$slug_filter" ]; then
    local restricted
    restricted="$(printf -- '%s\n' "$discovered" | awk -F'\t' -v want="$slug_filter" '$1 == want { print }')"
    if [ -z "$restricted" ]; then
      printf -- 'atlas: no project with SLUG=%s found (looked under FLEET_DISCOVERY_ROOT=%s)\n' \
        "$slug_filter" "${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}" >&2
      exit 2
    fi
    discovered="$restricted"
  fi

  # Header (text mode only).
  if [ "$want_json" != "1" ]; then
    printf -- '%-20s %5s  %-12s  %-16s  %s\n' \
      "PATTERN" "FIRED" "LAST SEEN" "PROJECTS" "LESSON"
  fi

  # Walk catalog patterns in declaration order.
  local fired_total=0
  local token lesson_date entry
  while IFS=$'\t' read -r token lesson_date; do
    [ -z "$token" ] && continue

    # FIRED: sum across every discovered project's events.jsonl.
    local total_fired=0
    local files_list=""
    local slug events_path
    while IFS=$'\t' read -r slug events_path; do
      [ -z "$slug" ] && continue
      files_list+="$events_path"$'\n'
    done <<EOF
$discovered
EOF
    # Count across files. Pass each file individually since atlas_count_pattern
    # handles missing files internally.
    local files_args=()
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      files_args+=("$f")
    done <<EOF
$files_list
EOF
    if [ "${#files_args[@]}" -gt 0 ]; then
      total_fired="$(atlas_count_pattern "$token" "$cutoff" "${files_args[@]}")"
    fi
    [ -z "$total_fired" ] && total_fired=0
    fired_total=$(( fired_total + total_fired ))

    # LAST SEEN ts (ISO8601). Walk files; pick newest across all.
    local last_ts="" candidate
    if [ "${#files_args[@]}" -gt 0 ]; then
      candidate="$(atlas_last_seen_pattern "$token" "$cutoff" "${files_args[@]}")"
      [ -n "$candidate" ] && last_ts="$candidate"
    fi

    # PROJECTS: ask atlas_projects_for_pattern with our discovered set.
    local projects_label="—" projects_csv=""
    local projects_raw
    projects_raw="$(printf -- '%s\n' "$discovered" | atlas_projects_for_pattern "$token" "$cutoff")"
    if [ -n "$projects_raw" ]; then
      projects_label="$projects_raw"
      # JSON wants the slug-only CSV without the overflow marker.
      projects_csv="$(printf -- '%s' "$projects_raw" | sed -E 's/ \+[0-9]+$//')"
    fi

    # LESSON column (text label vs date).
    local lesson_label
    if [ -n "$lesson_date" ]; then
      lesson_label="$lesson_date"
    else
      lesson_label="(no lesson)"
    fi

    if [ "$want_json" = "1" ]; then
      atlas_render_row_json "$token" "$total_fired" "$last_ts" "$projects_csv" "$lesson_date"
    else
      local last_seen_label="—"
      if [ -n "$last_ts" ]; then
        last_seen_label="$(atlas_human_age_iso "$last_ts")"
      fi
      atlas_render_row_text "$token" "$total_fired" "$last_seen_label" \
        "$projects_label" "$lesson_label"
    fi
  done < <(atlas_parse_catalog "$catalog")

  # Summary row (JSON only).
  if [ "$want_json" = "1" ]; then
    local patterns_count
    patterns_count="$(atlas_parse_catalog "$catalog" | awk 'NF { n++ } END { print (n+0) }')"
    printf -- '{"summary":true,"patterns":%s,"window":"%s","fired_total":%s}\n' \
      "$patterns_count" "$since" "$fired_total"
  fi

  exit 0
}

if [ "$CMD" = "atlas" ]; then
  atlas "$@"
fi

# --- morning (ticket 0036) ----------------------------------------------
# `fleet morning` composes the daily briefing: digest + inbox + (Sunday-only)
# weekly + atlas top-3, with a single VERDICT line and a NEXT footer hint.
# Pure composition — no new readers, no new event types, no manifest fields.
# The body sits BELOW digest(), inbox(), weekly(), atlas() (LESSONS 2026-06-05
# dispatcher forward-reference trap) and inlines `morning_json_escape` as a
# bit-for-bit copy of `provenance_json_escape` (which is defined LATER in
# the file at ~line 6371) — same workaround ticket 0034 used for
# `replay_batch_json_escape`. Every code path exits explicitly (LESSONS
# 2026-06-01 dispatcher fall-through trap).

# Test seam: morning_clock_now reads FLEET_NOW_OVERRIDE if set, else the
# current UTC clock. Format: "YYYY-MM-DD HH:MM". Same shape as
# weekly's FLEET_WEEKLY_FAKE_NOW (epoch) but a friendlier string for the
# verdict line.
morning_clock_now() {
  if [ -n "${FLEET_NOW_OVERRIDE:-}" ]; then
    printf -- '%s\n' "$FLEET_NOW_OVERRIDE"
  else
    date -u '+%Y-%m-%d %H:%M'
  fi
}

# Day-of-week from a "YYYY-MM-DD HH:MM" or "YYYY-MM-DD" string.
# Uses BSD `date -j -f` on macOS and falls back to GNU `date -d` on Linux.
morning_dow() {
  local s="$1"
  local datepart="${s%% *}"
  date -j -f '%Y-%m-%d' "$datepart" '+%a' 2>/dev/null \
    || date -d "$datepart" '+%a' 2>/dev/null \
    || echo '?'
}

# UTF-8-safe JSON escaper (LESSONS 2026-06-03 sign-extension guard).
# Bit-for-bit copy of `provenance_json_escape` (defined later in this file
# at ~line 6371). Inlining is the workaround for the dispatcher forward-
# reference trap (LESSONS 2026-06-05); ticket 0034's
# replay_batch_json_escape uses the same shape.
morning_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *)
        printf -v code '%d' "'$ch"
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v out '%s\\u%04x' "$out" "$code"
        else
          out+="$ch"
        fi
        ;;
    esac
  done
  printf -- '%s' "$out"
}

# Count the inbox rows that "owe the operator a click" by reading
# `inbox --json` (one JSON object per section + 1 summary). Returns N
# as a plain integer. Uses `awk … END { print n+0 }` per LESSONS
# 2026-06-01 (`grep -c file || echo 0` double-print trap).
#
# Optional $1: slug filter, passed through to inbox.
morning_count_owes_click() {
  local slug_filter="${1-}"
  local n
  if [ -n "$slug_filter" ]; then
    n="$(
      ( inbox inbox --json --slug "$slug_filter" 2>/dev/null ) \
        | awk -F'"items":' '/"summary":true/ { sub(/[^0-9].*$/, "", $2); print $2+0; exit }'
    )"
  else
    n="$(
      ( inbox inbox --json 2>/dev/null ) \
        | awk -F'"items":' '/"summary":true/ { sub(/[^0-9].*$/, "", $2); print $2+0; exit }'
    )"
  fi
  [ -z "$n" ] && n=0
  printf -- '%s\n' "$n"
}

# Count paused projects (verdict P value). Same source as the inbox's
# `paused projects` section: the count of section objects with section=paused.
morning_count_paused() {
  local slug_filter="${1-}"
  local n
  if [ -n "$slug_filter" ]; then
    n="$(
      ( inbox inbox --json --slug "$slug_filter" 2>/dev/null ) \
        | awk -F'"count":' '/"section":"paused"/ { sub(/[^0-9].*$/, "", $2); print $2+0; exit }'
    )"
  else
    n="$(
      ( inbox inbox --json 2>/dev/null ) \
        | awk -F'"count":' '/"section":"paused"/ { sub(/[^0-9].*$/, "", $2); print $2+0; exit }'
    )"
  fi
  [ -z "$n" ] && n=0
  printf -- '%s\n' "$n"
}

# Discover at least one project under FLEET_DISCOVERY_ROOT (the cheap
# "is the fleet empty?" check). Same root convention as digest/weekly/inbox.
morning_any_projects() {
  local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
  find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | head -1
}

# Build the NEXT footer hint per the priority ordering in AC#7:
#   paused → fleet resume <slug>
#   draft  → fleet lessons-promote
#   self-cancel ≤7d → bump SELF_CANCEL in <slug>/agents.config.sh
#   budget tripped today → inspect <slug>'s spend or raise MAX_DAILY_USD
#   stuck PR >24h → gh pr view <N> --comment
#   else → nothing else owes you a click. enjoy your day.
#
# Reads the same `inbox --json` stream the verdict counts use. First match
# wins; we walk the sections in priority order.
morning_next_hint() {
  local slug_filter="${1-}"
  # Capture the JSON stream once; subsequent passes are file reads.
  local inbox_json
  if [ -n "$slug_filter" ]; then
    inbox_json="$( ( inbox inbox --json --slug "$slug_filter" 2>/dev/null ) )"
  else
    inbox_json="$( ( inbox inbox --json 2>/dev/null ) )"
  fi
  local first_slug
  # paused — first item under section=paused.
  first_slug="$(printf -- '%s\n' "$inbox_json" \
    | awk -F'"section":"paused"' '/"section":"paused"/ { print $2; exit }' \
    | awk -F'"slug":"' 'NF>1 { sub(/".*$/, "", $2); print $2; exit }')"
  if [ -n "$first_slug" ]; then
    printf -- 'fleet resume %s\n' "$first_slug"
    return 0
  fi
  # draft — first item under section=drafts.
  first_slug="$(printf -- '%s\n' "$inbox_json" \
    | awk -F'"section":"drafts"' '/"section":"drafts"/ { print $2; exit }' \
    | awk -F'"slug":"' 'NF>1 { sub(/".*$/, "", $2); print $2; exit }')"
  if [ -n "$first_slug" ]; then
    printf -- 'fleet lessons-promote %s\n' "$first_slug"
    return 0
  fi
  # self-cancel — first item under section=self_cancel.
  first_slug="$(printf -- '%s\n' "$inbox_json" \
    | awk -F'"section":"self_cancel"' '/"section":"self_cancel"/ { print $2; exit }' \
    | awk -F'"slug":"' 'NF>1 { sub(/".*$/, "", $2); print $2; exit }')"
  if [ -n "$first_slug" ]; then
    printf -- 'bump SELF_CANCEL in %s/agents.config.sh\n' "$first_slug"
    return 0
  fi
  # budget — first item under section=budget.
  first_slug="$(printf -- '%s\n' "$inbox_json" \
    | awk -F'"section":"budget"' '/"section":"budget"/ { print $2; exit }' \
    | awk -F'"slug":"' 'NF>1 { sub(/".*$/, "", $2); print $2; exit }')"
  if [ -n "$first_slug" ]; then
    printf -- "inspect %s's spend or raise MAX_DAILY_USD\n" "$first_slug"
    return 0
  fi
  # stuck PR — first item under section=stuck_prs.
  local first_pr
  first_pr="$(printf -- '%s\n' "$inbox_json" \
    | awk -F'"section":"stuck_prs"' '/"section":"stuck_prs"/ { print $2; exit }' \
    | awk -F'"count":' 'NF>1 { sub(/[^0-9].*$/, "", $2); print $2; exit }')"
  if [ -n "$first_pr" ] && [ "$first_pr" != "0" ]; then
    printf -- 'gh pr view %s --comment\n' "$first_pr"
    return 0
  fi
  printf -- 'nothing else owes you a click. enjoy your day.\n'
}

# Pull the top-3 atlas patterns (text mode) from an atlas --json invocation.
# We use --since 7d to mirror the WEEKLY block's window. Returns a one-line
# `pattern (count)  pattern (count)  pattern (count)` string or empty when
# nothing fired.
morning_atlas_top3() {
  local atlas_json
  atlas_json="$( ( atlas atlas --since 7d --json 2>/dev/null ) )"
  # Each non-summary line: {"pattern":"...","fired":N,...}. Sort desc by
  # fired, take top 3 with fired>0. Use awk for the parse.
  printf -- '%s\n' "$atlas_json" \
    | awk -F'"pattern":"' '
        /"summary":true/ { next }
        NF>1 {
          patt = $2; sub(/".*$/, "", patt);
          fired_idx = index($0, "\"fired\":")
          if (fired_idx == 0) next
          rest = substr($0, fired_idx + length("\"fired\":"))
          n = rest + 0
          if (n > 0) printf("%d\t%s\n", n, patt)
        }' \
    | sort -t $'\t' -k1,1nr \
    | head -3 \
    | awk -F'\t' '{ printf("%s%s (%s)", (NR==1?"":"  "), $2, $1) } END { if (NR>0) printf("\n") }'
}

morning() {
  shift  # drop "morning"
  local want_json=0 slug_filter=""
  local weekly_mode="auto"   # auto | force | suppress
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)       want_json=1; shift ;;
      --no-weekly)  weekly_mode="suppress"; shift ;;
      --weekly)     weekly_mode="force"; shift ;;
      --slug)
        if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
          echo "fleet morning: --slug requires a non-empty value" >&2
          exit 2
        fi
        slug_filter="$2"; shift 2 ;;
      --slug=*)
        slug_filter="${1#--slug=}"
        if [ -z "$slug_filter" ]; then
          echo "fleet morning: --slug requires a non-empty value" >&2
          exit 2
        fi
        shift ;;
      -h|--help)
        cat <<USAGE
fleet morning — one-command daily briefing (digest + inbox [+ Sunday weekly]).

Usage:
  fleet morning                   default: verdict + digest + inbox
                                  (+ WEEKLY block + atlas top-3 on Sunday)
  fleet morning --no-weekly       suppress the WEEKLY block even on Sunday
  fleet morning --weekly          force the WEEKLY block on a non-Sunday
  fleet morning --slug NAME       narrow digest + inbox to one project
  fleet morning --json            machine-readable composed object

Output (text mode):
  MORNING — YYYY-MM-DD <Dow> · N owes you a click · P paused · fleet <band>

  DIGEST (24h)
    <one row per project — same as 'fleet digest'>

  INBOX
    <five sections — same as 'fleet inbox'>

  WEEKLY (Sunday-only — last 7d)        # suppressed on non-Sunday
    <summary line + top-3 atlas patterns>

  NEXT: <one concrete next action, or 'nothing else owes you a click.'>

Verdict band: OK when N==0 AND P==0; WARN when N>=1 AND P==0;
              FAIL when P>=1.

Composition only — calls digest(), inbox(), weekly(), atlas() in process
(no bin/fleet subprocesses). No new event types. Read-only.

Exit code: 0 on success; 2 on usage error.
USAGE
        exit 0 ;;
      *) echo "fleet morning: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  # Empty fleet — exit 0 with a stderr hint (matches AC#8 + replay --batch).
  if [ -z "$(morning_any_projects)" ]; then
    local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
    printf -- 'morning: no projects found under FLEET_DISCOVERY_ROOT=%s — run install.sh on at least one repo first.\n' \
      "$root" >&2
    exit 0
  fi

  local now date_part dow
  now="$(morning_clock_now)"
  date_part="${now%% *}"
  dow="$(morning_dow "$now")"

  # Decide whether the WEEKLY block prints.
  local show_weekly=0
  case "$weekly_mode" in
    suppress) show_weekly=0 ;;
    force)    show_weekly=1 ;;
    auto)     [ "$dow" = "Sun" ] && show_weekly=1 ;;
  esac

  # Compute the verdict counters once (cheap; both helpers read inbox --json
  # in subshells — no extra subprocess churn from re-invoking bin/fleet).
  local n_owes n_paused band
  n_owes="$(morning_count_owes_click "$slug_filter")"
  n_paused="$(morning_count_paused "$slug_filter")"
  if [ "$n_paused" -ge 1 ]; then
    band="FAIL"
  elif [ "$n_owes" -ge 1 ]; then
    band="WARN"
  else
    band="OK"
  fi

  # Pre-render the section bodies. Each reader exits at the end of its
  # function, so we call them in subshells to capture stdout without
  # killing morning(). LESSONS 2026-06-01 (awk -v multiline trap): the
  # bodies can carry newlines; we accumulate to a tmp file and read back.
  local tmp_dir
  tmp_dir="$(mktemp -d -t fleet-morning.XXXXXX)"
  trap 'rm -rf "$tmp_dir"' RETURN

  local digest_body="$tmp_dir/digest.txt"
  local inbox_body="$tmp_dir/inbox.txt"
  local weekly_body="$tmp_dir/weekly.txt"
  local atlas_top="$tmp_dir/atlas.txt"

  # digest — `digest --since 24h` (default) so the column is consistent
  # with the heading. Exit is captured but ignored (digest exits 1 if any
  # project is in a red state; morning doesn't bubble that up because the
  # verdict line already encodes posture).
  if [ -n "$slug_filter" ]; then
    ( digest digest --slug "$slug_filter" ) > "$digest_body" 2>/dev/null || true
    ( inbox  inbox  --slug "$slug_filter" ) > "$inbox_body"  2>/dev/null || true
  else
    ( digest digest ) > "$digest_body" 2>/dev/null || true
    ( inbox  inbox  ) > "$inbox_body"  2>/dev/null || true
  fi

  if [ "$show_weekly" = "1" ]; then
    ( weekly weekly --since 7d ) > "$weekly_body" 2>/dev/null || true
    morning_atlas_top3 > "$atlas_top" 2>/dev/null || true
  else
    : > "$weekly_body"
    : > "$atlas_top"
  fi

  local next_hint
  next_hint="$(morning_next_hint "$slug_filter")"

  if [ "$want_json" = "1" ]; then
    morning_render_json "$date_part" "$dow" "$band" "$n_owes" "$n_paused" \
      "$show_weekly" "$slug_filter" "$digest_body" "$inbox_body" \
      "$weekly_body" "$atlas_top" "$next_hint"
    exit 0
  fi

  morning_render_text "$date_part" "$dow" "$band" "$n_owes" "$n_paused" \
    "$show_weekly" "$digest_body" "$inbox_body" "$weekly_body" "$atlas_top" \
    "$next_hint"
  exit 0
}

# Text renderer. All printfs use `printf -- '...'` per LESSONS 2026-05-28
# (printf leading-dash trap) since the format strings start with literals
# but the values may start with `-`.
morning_render_text() {
  local date_part="$1" dow="$2" band="$3" n_owes="$4" n_paused="$5"
  local show_weekly="$6"
  local digest_body="$7" inbox_body="$8" weekly_body="$9"
  local atlas_top="${10}" next_hint="${11}"

  printf -- 'MORNING — %s %s · %s owes you a click · %s paused · fleet %s\n' \
    "$date_part" "$dow" "$n_owes" "$n_paused" "$band"
  printf -- '\n'

  printf -- 'DIGEST (24h)\n'
  if [ -s "$digest_body" ]; then
    # Indent two spaces so the digest output reads as a sub-block.
    sed 's/^/  /' "$digest_body"
  else
    printf -- '  (no projects in window)\n'
  fi
  printf -- '\n'

  printf -- 'INBOX\n'
  if [ -s "$inbox_body" ]; then
    # Strip inbox's own banner (first 2 lines: "FLEET INBOX — ..." + blank)
    # and trailing footer ("nothing else owes you a click. last weekly: ..."
    # line) since morning has its own verdict header and NEXT footer.
    # Per LESSONS 2026-06-01 (awk -v multiline trap) we read the file
    # directly with awk, not via -v.
    awk '
      NR <= 2 { next }
      /^nothing else owes you a click\. last weekly:/ { next }
      { print "  " $0 }
    ' "$inbox_body"
  else
    printf -- '  (no inbox items)\n'
  fi
  printf -- '\n'

  if [ "$show_weekly" = "1" ]; then
    printf -- 'WEEKLY (Sunday-only — last 7d)\n'
    if [ -s "$weekly_body" ]; then
      sed 's/^/  /' "$weekly_body"
    fi
    if [ -s "$atlas_top" ]; then
      printf -- '  top atlas patterns: '
      cat "$atlas_top"
    fi
    printf -- '\n'
  fi

  printf -- 'NEXT: %s\n' "$next_hint"
}

# JSON renderer — one composed object. Per LESSONS 2026-06-01 (awk -v
# multiline trap), digest/inbox text bodies are NOT passed inline; instead
# we surface a structural summary (digest = parsed slug:state pairs from
# the text body, inbox = section counts). For a fully machine-readable
# digest/inbox payload, callers can still invoke `fleet digest --json` /
# `fleet inbox --json` directly. This composed object's goal is the
# at-a-glance verdict, not the full per-row data.
morning_render_json() {
  local date_part="$1" dow="$2" band="$3" n_owes="$4" n_paused="$5"
  local show_weekly="$6" slug_filter="$7"
  local digest_body="$8" inbox_body="$9" weekly_body="${10}"
  local atlas_top="${11}" next_hint="${12}"

  # digest JSON array — call digest --json directly (it already escapes).
  local digest_json
  if [ -n "$slug_filter" ]; then
    digest_json="$( ( digest digest --slug "$slug_filter" --json ) 2>/dev/null || true )"
  else
    digest_json="$( ( digest digest --json ) 2>/dev/null || true )"
  fi
  [ -z "$digest_json" ] && digest_json="[]"

  # inbox JSON object — bundle the per-section objects into one object
  # keyed by section name.
  local inbox_raw
  if [ -n "$slug_filter" ]; then
    inbox_raw="$( ( inbox inbox --slug "$slug_filter" --json ) 2>/dev/null || true )"
  else
    inbox_raw="$( ( inbox inbox --json ) 2>/dev/null || true )"
  fi
  local inbox_obj
  inbox_obj="$(printf -- '%s\n' "$inbox_raw" | awk '
    BEGIN { first = 1; printf("{") }
    /"summary":true/ {
      sub(/^\{/, "", $0); sub(/\}[ \t]*$/, "", $0);
      if (!first) printf(","); printf("%s", $0); first = 0; next
    }
    /"section":/ {
      match($0, /"section":"[^"]+"/); sname = substr($0, RSTART+11, RLENGTH-12);
      if (!first) printf(","); first = 0;
      printf("\"%s\":%s", sname, $0)
    }
    END { printf("}") }')"
  [ -z "$inbox_obj" ] && inbox_obj="{}"

  # weekly JSON — null on non-Sunday/no-weekly; else the streamed objects.
  local weekly_json="null"
  if [ "$show_weekly" = "1" ]; then
    local weekly_raw
    weekly_raw="$( ( weekly weekly --since 7d --json ) 2>/dev/null || true )"
    # Normalize the streamed JSON lines into an array.
    weekly_json="$(printf -- '%s\n' "$weekly_raw" | awk '
      BEGIN { first = 1; printf("[") }
      NF { if (!first) printf(","); printf("%s", $0); first = 0 }
      END { printf("]") }')"
    [ -z "$weekly_json" ] && weekly_json="null"
  fi

  # atlas_top JSON — null on non-Sunday/no-weekly; else the parsed top-3.
  local atlas_top_json="null"
  if [ "$show_weekly" = "1" ]; then
    atlas_top_json="["
    local first=1 line
    if [ -s "$atlas_top" ]; then
      # The text body is `patt1 (n)  patt2 (n)  patt3 (n)`. Split on two
      # spaces, then parse each `name (count)`.
      while IFS= read -r line; do
        local IFS_BAK="$IFS"
        local segs
        # Replace double-space with newline, then iterate.
        segs="$(printf -- '%s\n' "$line" | sed 's/  /\n/g')"
        local s
        while IFS= read -r s; do
          [ -z "$s" ] && continue
          # s = "name (count)"
          local pname pcnt
          pname="$(printf -- '%s' "$s" | sed -E 's/ \(([0-9]+)\)$//')"
          pcnt="$(printf -- '%s' "$s" | sed -nE 's/.* \(([0-9]+)\)$/\1/p')"
          [ -z "$pcnt" ] && pcnt=0
          if [ "$first" = "1" ]; then
            atlas_top_json+="{\"pattern\":\"$(morning_json_escape "$pname")\",\"fired\":$pcnt}"
            first=0
          else
            atlas_top_json+=",{\"pattern\":\"$(morning_json_escape "$pname")\",\"fired\":$pcnt}"
          fi
        done <<EOS
$segs
EOS
        IFS="$IFS_BAK"
      done < "$atlas_top"
    fi
    atlas_top_json+="]"
  fi

  local esc_date esc_hint
  esc_date="$(morning_json_escape "$date_part")"
  esc_hint="$(morning_json_escape "$next_hint")"

  printf -- '{"date":"%s","dow":"%s","verdict":"%s","owes_click":%s,"paused":%s,"digest":%s,"inbox":%s,"weekly":%s,"atlas_top":%s,"next":"%s"}\n' \
    "$esc_date" "$dow" "$band" "$n_owes" "$n_paused" \
    "$digest_json" "$inbox_obj" "$weekly_json" "$atlas_top_json" "$esc_hint"

  # Silence shellcheck on $digest_body / $inbox_body / $weekly_body / $next_hint
  # in this scope — we use them indirectly via subshell re-invocation, but
  # static analysis flags them as unread.
  : "$digest_body" "$inbox_body" "$weekly_body"
}

if [ "$CMD" = "morning" ]; then
  morning "$@"
  exit $?
fi

# --- diff (ticket 0038) --------------------------------------------------
# `fleet diff <slug-a> <slug-b> [--since Nh|Nd] [--json]` renders a
# side-by-side ROI/posture comparison of two projects and calls out the
# metrics where one is >=2x the other. Pure consumer of events.jsonl +
# runs.jsonl + agents.config.sh; no new event types, no fleet_* signature
# changes, no lib/ or prompts/ edits (per ticket 0038 § Engineering notes).
#
# Body placement: BELOW digest_parse_since (line ~1988), digest_spend_since
# (~2017), digest_event_count_since (~2050), weekly_ship_count_since
# (~2391), atlas_count_pattern (~7246), and provenance_json_escape (~6376)
# — every helper diff_cmd reaches is already parsed by the time the
# dispatcher fires (LESSONS 2026-06-05 forward-reference trap).
#
# Naming: the dispatcher function is `diff_cmd` (NOT `diff`) per LESSONS
# 2026-05-26 — bin/fleet shells out to `/usr/bin/diff` from prompts_diff_
# trees, so a `diff()` shell function would shadow it.
#
# Every code path exits explicitly per LESSONS 2026-06-01 (dispatcher
# fall-through trap). Every printf with a value that might start with `-`
# uses `printf -- '%s'` per LESSONS 2026-05-28. Every count uses
# `awk … END { print n+0 }` per LESSONS 2026-06-01 (grep -c double-print
# trap). Help-text grep in the test uses `grep -qF --` per LESSONS
# 2026-05-30. JSON escaping uses the UTF-8-safe high-byte pass-through
# per LESSONS 2026-06-03 (sign-extension trap).

# Resolve slug → (manifest, events.jsonl, runs.jsonl, prompts_sha). Echoes
# four tab-separated values, or empty when the slug is not installed.
diff_resolve_slug() {
  local want="$1"
  local roots=("${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}" "$HOME/.local/share/agent-fleet/projects")
  local root m slug pin
  for root in "${roots[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      # shellcheck disable=SC1090
      slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
      if [ "$slug" = "$want" ]; then
        # shellcheck disable=SC1090
        pin=$( (source "$m"; echo "${PROMPTS_SHA:-}") 2>/dev/null )
        local cache_dir="$HOME/.cache/${slug}-agent"
        printf -- '%s\t%s\t%s\t%s\n' \
          "$m" "$cache_dir/events.jsonl" "$cache_dir/runs.jsonl" "$pin"
        return 0
      fi
    done < <(find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)
  done
  return 0
}

# Count `pr_opened` events in events.jsonl whose ts >= cutoff.
diff_count_pr_opened() {  # $1 = events.jsonl, $2 = cutoff epoch
  digest_event_count_since "$1" "$2" "pr_opened"
}

# Sum the time slug spent paused. Walks the event stream within the
# window; every ship_paused opens an interval, every ship_resumed closes
# the most recent open interval; an unclosed interval is closed at
# end_epoch. Echoes hours (integer floor). Pairs across the window
# boundary are clipped to the window.
diff_paused_hours() {  # $1 = events.jsonl, $2 = start_epoch, $3 = end_epoch
  local events="$1" start_epoch="$2" end_epoch="$3"
  [ -f "$events" ] || { echo 0; return 0; }
  awk -v lo="$start_epoch" -v hi="$end_epoch" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    BEGIN { count = 0 }
    {
      ts=""; type=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (type != "ship_paused" && type != "ship_resumed") next
      ep = iso2ep(ts)
      if (ep <= 0) next
      events_ts[count] = ep
      events_ty[count] = type
      count++
    }
    END {
      # Insertion sort by timestamp — small N (paused/resumed pairs).
      for (i=0; i<count; i++) order[i]=i
      for (i=1; i<count; i++) {
        k = order[i]; j = i
        while (j>0 && events_ts[order[j-1]] > events_ts[k]) { order[j]=order[j-1]; j-- }
        order[j] = k
      }
      total_seconds = 0
      pause_start = 0
      for (i=0; i<count; i++) {
        idx = order[i]
        ep = events_ts[idx]; ty = events_ty[idx]
        if (ty == "ship_paused") {
          if (pause_start == 0) pause_start = ep
        } else if (ty == "ship_resumed") {
          if (pause_start > 0) {
            s = pause_start
            e = ep
            if (s < lo) s = lo
            if (e > hi) e = hi
            if (e > s) total_seconds += (e - s)
            pause_start = 0
          }
        }
      }
      # Unclosed pause — clip to end_epoch.
      if (pause_start > 0) {
        s = pause_start
        e = hi
        if (s < lo) s = lo
        if (e > s) total_seconds += (e - s)
      }
      print int(total_seconds / 3600)
    }
  ' "$events"
}

# Count lesson_draft_emitted events in window whose text_sha has NO
# matching lesson_promoted event with the same text_sha anywhere in the
# events.jsonl (not just the window — once promoted, the debt is paid).
diff_draft_debt() {  # $1 = events.jsonl, $2 = cutoff epoch
  local events="$1" cutoff="$2"
  [ -f "$events" ] || { echo 0; return 0; }
  awk -v cutoff="$cutoff" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; type=""; sha=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (match($0, /"text_sha"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        sha=substr($0, RSTART, RLENGTH)
        sub(/.*"text_sha"[[:space:]]*:[[:space:]]*"/, "", sha); sub(/".*/, "", sha)
      }
      if (type == "lesson_promoted") {
        if (sha != "") promoted[sha] = 1
      } else if (type == "lesson_draft_emitted") {
        if (iso2ep(ts) < cutoff) next
        if (sha == "") sha = "_anon_" NR
        drafts[sha] = 1
      }
    }
    END {
      n = 0
      for (k in drafts) if (!(k in promoted)) n++
      print n+0
    }
  ' "$events"
}

# Find the infra_flake_rerun pattern with the most fires in the window.
# Echo `<pattern>:<n>` (e.g. `gh_graphql_502:2`) or `none` when none fired.
diff_top_atlas_pattern() {  # $1 = events.jsonl, $2 = cutoff epoch
  local events="$1" cutoff="$2"
  [ -f "$events" ] || { echo "none"; return 0; }
  local top
  top="$(awk -v cutoff="$cutoff" '
    function iso2ep(ts,    cmd, out) {
      gsub(/\.[0-9]+Z$/, "Z", ts); sub(/Z$/, "", ts)
      cmd = "date -u -j -f %Y-%m-%dT%H:%M:%S \"" ts "\" +%s 2>/dev/null"
      cmd = cmd " || date -u -d \"" ts "Z\" +%s 2>/dev/null"
      if ((cmd | getline out) <= 0) out = 0
      close(cmd)
      return out + 0
    }
    {
      ts=""; type=""; pat=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (match($0, /"pattern"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        pat=substr($0, RSTART, RLENGTH)
        sub(/.*"pattern"[[:space:]]*:[[:space:]]*"/, "", pat); sub(/".*/, "", pat)
      }
      if (type != "infra_flake_rerun") next
      if (pat == "") next
      if (iso2ep(ts) < cutoff) next
      counts[pat]++
    }
    END {
      best = ""; best_n = 0
      for (p in counts) {
        if (counts[p] > best_n || (counts[p] == best_n && (best == "" || p < best))) {
          best = p; best_n = counts[p]
        }
      }
      if (best == "") print "none"
      else printf("%s:%d", best, best_n)
    }
  ' "$events")"
  printf -- '%s' "$top"
}

# Render a short (7-char) prompts SHA for display, or `—` when empty.
diff_short_sha() {
  local s="${1-}"
  if [ -z "$s" ]; then printf -- '—'; return 0; fi
  printf -- '%s' "${s:0:7}"
}

# Compute the Δ column value for two numeric values.
# Args: a, b. Echoes `<delta> (<pct>%)` or `=` when equal or `∞` when
# one side is zero and the other is not.
diff_delta_numeric() {
  local a="$1" b="$2"
  # Treat floats and ints uniformly via awk.
  awk -v a="$a" -v b="$b" '
    BEGIN {
      a_n = a + 0; b_n = b + 0
      if (a_n == b_n) { print "="; exit }
      diff = b_n - a_n
      # Format with sign.
      sign = (diff >= 0) ? "+" : ""
      # Percent change relative to |a|; guard with max(|a|, 1).
      base = a_n; if (base < 0) base = -base
      if (base < 1) base = 1
      pct = int(100 * diff / base)
      pct_sign = (pct >= 0) ? "+" : ""
      # When a==0 and b!=0, mark percent as ∞.
      if (a_n == 0 && b_n != 0) {
        printf("%s%g (∞)", sign, diff); exit
      }
      # Avoid trailing .0 — print as integer when both are whole numbers.
      ai = int(a_n); bi = int(b_n)
      if (ai == a_n && bi == b_n) printf("%s%d (%s%d%%)", sign, diff, pct_sign, pct)
      else                         printf("%s%.2f (%s%d%%)", sign, diff, pct_sign, pct)
    }
  '
}

# Compute the divergence ratio for two numeric values.
# Returns `max(a,b) / max(min(a,b), 1)` as a float with 1 decimal.
# When both equal zero, returns 0.0 (no divergence).
diff_ratio() {
  local a="$1" b="$2"
  awk -v a="$a" -v b="$b" '
    BEGIN {
      a_n = a + 0; b_n = b + 0
      mx = (a_n > b_n) ? a_n : b_n
      mn = (a_n < b_n) ? a_n : b_n
      if (mn < 1) mn = 1
      if (mx == 0 && mn == 1) { printf("0.0"); exit }
      printf("%.1f", mx / mn)
    }
  '
}

# Direction of divergence: `b>a`, `a>b`, or `equal`.
diff_direction() {
  local a="$1" b="$2"
  awk -v a="$a" -v b="$b" '
    BEGIN {
      a_n = a + 0; b_n = b + 0
      if (a_n == b_n) print "equal"
      else if (b_n > a_n) print "b>a"
      else print "a>b"
    }
  '
}

# Inline UTF-8-safe JSON escape (LESSONS 2026-06-03 sign-extension trap).
# Bit-for-bit copy of provenance_json_escape — duplicated because
# provenance_json_escape is defined LATER in bin/fleet (~line 6376) and
# the dispatcher block for diff fires before that helper is parsed when
# the dispatcher is positioned mid-file. Note: in our actual placement
# diff_cmd sits ABOVE provenance_json_escape so this duplicate avoids a
# forward-reference trap.
diff_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *)
        printf -v code '%d' "'$ch"
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v out '%s\\u%04x' "$out" "$code"
        else
          out+="$ch"
        fi
        ;;
    esac
  done
  printf -- '%s' "$out"
}

# Load all 8 metrics for one slug; output one line per metric as
# `<name>\t<value>` to a tmp file path. Uses helpers defined above
# (and digest_spend_since / weekly_ship_count_since defined earlier).
diff_load_slug_metrics() {  # $1 = events, $2 = runs, $3 = prompts_sha, $4 = start, $5 = end, $6 = out_file
  local events="$1" runs="$2" pin="$3" start_epoch="$4" end_epoch="$5" out_file="$6"
  local ships merges sendbacks spend paused_h drafts top
  ships="$(diff_count_pr_opened "$events" "$start_epoch")"
  merges="$(weekly_ship_count_since "$runs" "$start_epoch")"
  sendbacks="$(digest_event_count_since "$events" "$start_epoch" "lesson_draft_emitted")"
  spend="$(digest_spend_since "$runs" "$start_epoch")"
  paused_h="$(diff_paused_hours "$events" "$start_epoch" "$end_epoch")"
  drafts="$(diff_draft_debt "$events" "$start_epoch")"
  top="$(diff_top_atlas_pattern "$events" "$start_epoch")"
  {
    printf -- 'ships\t%s\n'                "$ships"
    printf -- 'merges\t%s\n'               "$merges"
    printf -- 'sendbacks\t%s\n'            "$sendbacks"
    printf -- 'spend ($)\t%s\n'            "$spend"
    printf -- 'paused hours\t%s\n'         "$paused_h"
    printf -- 'draft promotion debt\t%s\n' "$drafts"
    printf -- 'prompts SHA\t%s\n'          "$(diff_short_sha "$pin")"
    printf -- 'top atlas pattern (fires)\t%s\n' "$top"
  } > "$out_file"
}

# Hypothesize root causes from the divergence set + the two metric files.
# Emits up to 4 hypothesis lines on stdout, in deterministic order.
# Args: a_file, b_file, divergence_file (one metric name per line).
diff_hypothesize() {
  local a_file="$1" b_file="$2" div_file="$3"
  local a_ships b_ships
  a_ships="$(awk -F'\t' '$1 == "ships" { print $2 }' "$a_file")"
  b_ships="$(awk -F'\t' '$1 == "ships" { print $2 }' "$b_file")"

  local prompts_diverges=0 atlas_diverges=0 sendbacks_diverges=0 spend_diverges=0
  while IFS= read -r m; do
    case "$m" in
      "prompts SHA")               prompts_diverges=1 ;;
      "top atlas pattern (fires)") atlas_diverges=1 ;;
      "sendbacks")                 sendbacks_diverges=1 ;;
      'spend ($)')                 spend_diverges=1 ;;
    esac
  done < "$div_file"

  # Ships "similar" = ratio < 2x.
  local ships_ratio ships_similar=0
  ships_ratio="$(diff_ratio "$a_ships" "$b_ships")"
  if awk -v r="$ships_ratio" 'BEGIN { exit !(r + 0 < 2.0) }'; then
    ships_similar=1
  fi

  local out=""
  if [ "$prompts_diverges" -eq 1 ]; then
    out+="prompts revision regression; run \`fleet prompts-score\` per slug"$'\n'
  fi
  if [ "$atlas_diverges" -eq 1 ]; then
    out+="per-project CI/infra drift; investigate <slug>'s gh actions, not the kit"$'\n'
  fi
  if [ "$sendbacks_diverges" -eq 1 ] && [ "$prompts_diverges" -eq 0 ]; then
    out+="per-project AGENTS.md drift; compare \`<slug-a>/AGENTS.md\` and \`<slug-b>/AGENTS.md\` § Hard NOs"$'\n'
  fi
  if [ "$spend_diverges" -eq 1 ] && [ "$ships_similar" -eq 1 ]; then
    out+="per-project manifest drift; compare MAX_DAILY_USD and model choice in the two \`agents.config.sh\`"$'\n'
  fi

  if [ -z "$out" ]; then
    # No keyed hypothesis fired. If the divergence set itself is empty
    # there's nothing to explain — emit nothing. If divergence is
    # non-empty but no hypothesis branch keyed off it, emit the
    # fallback per AC#3.
    if [ -s "$div_file" ]; then
      printf -- 'no hypotheses surface from the divergence; inspect by hand.\n'
    fi
  else
    printf -- '%s' "$out"
  fi
}

# Compute the Δ column for one metric row. For numeric metrics, returns
# a `+N (+P%)` string; for non-numeric (prompts SHA, top atlas pattern),
# returns `=` or `differ`.
diff_delta_for_metric() {
  local name="$1" va="$2" vb="$3"
  case "$name" in
    "prompts SHA"|"top atlas pattern (fires)")
      if [ "$va" = "$vb" ]; then printf -- '=' ; else printf -- 'differ'; fi
      ;;
    *)
      diff_delta_numeric "$va" "$vb"
      ;;
  esac
}

# Detect whether a metric row "diverges". Non-numeric: differ. Numeric:
# ratio >= 2.0. Echoes "1" diverges, "0" otherwise.
diff_metric_diverges() {
  local name="$1" va="$2" vb="$3"
  case "$name" in
    "prompts SHA"|"top atlas pattern (fires)")
      if [ "$va" = "$vb" ]; then echo 0; else echo 1; fi
      ;;
    *)
      local r; r="$(diff_ratio "$va" "$vb")"
      if awk -v r="$r" 'BEGIN { exit !(r + 0 >= 2.0) }'; then
        echo 1
      else
        echo 0
      fi
      ;;
  esac
}

# Render the text table + DIVERGENCE + HYPOTHESES sections.
diff_render_text() {
  local slug_a="$1" slug_b="$2" a_file="$3" b_file="$4" div_file="$5"
  local start_iso="$6" end_iso="$7" window_label="$8"

  # Header.
  printf -- 'DIFF %s — %s vs %s (%s → %s)\n' \
    "$window_label" "$slug_a" "$slug_b" "$start_iso" "$end_iso"
  printf -- '\n'

  # Column widths. Long metric names ("top atlas pattern (fires)") take
  # 25 chars + 1 padding; slug columns need to fit "actions_silent:5"
  # type values plus a few chars headroom.
  local col_metric=26 col_val=18
  # Slug header is at least as wide as the slug name.
  local len_a=${#slug_a}; local len_b=${#slug_b}
  [ "$len_a" -gt "$col_val" ] && col_val="$len_a"
  [ "$len_b" -gt "$col_val" ] && col_val="$len_b"

  # Header row.
  printf -- '%-*s %-*s %-*s %s\n' \
    "$col_metric" "METRIC" "$col_val" "$slug_a" "$col_val" "$slug_b" "Δ"
  # Underline.
  local total_len=$(( col_metric + 1 + col_val + 1 + col_val + 1 + 30 ))
  printf -- '%*s\n' "$total_len" '' | tr ' ' '-'

  # Metric rows in order (stable: paste together by line number).
  local name va vb delta
  while IFS=$'\t' read -r name va; do
    vb="$(awk -F'\t' -v n="$name" '$1 == n { print $2 }' "$b_file")"
    delta="$(diff_delta_for_metric "$name" "$va" "$vb")"
    printf -- '%-*s %-*s %-*s %s\n' \
      "$col_metric" "$name" \
      "$col_val" "$va" \
      "$col_val" "$vb" \
      "$delta"
  done < "$a_file"

  # DIVERGENCE section.
  printf -- '\n'
  printf -- 'DIVERGENCE (>=2x)\n'
  if [ ! -s "$div_file" ]; then
    printf -- '  no metric diverges; the two projects are behaving similarly.\n'
  else
    while IFS= read -r m; do
      [ -z "$m" ] && continue
      va="$(awk -F'\t' -v n="$m" '$1 == n { print $2 }' "$a_file")"
      vb="$(awk -F'\t' -v n="$m" '$1 == n { print $2 }' "$b_file")"
      case "$m" in
        "prompts SHA"|"top atlas pattern (fires)")
          printf -- '  %s: differs (%s vs %s)\n' "$m" "$va" "$vb"
          ;;
        *)
          local r; r="$(diff_ratio "$va" "$vb")"
          local dir; dir="$(diff_direction "$va" "$vb")"
          if [ "$dir" = "b>a" ]; then
            printf -- '  %s: %s is %sx %s\n' "$m" "$slug_b" "$r" "$slug_a"
          elif [ "$dir" = "a>b" ]; then
            printf -- '  %s: %s is %sx %s\n' "$m" "$slug_a" "$r" "$slug_b"
          else
            printf -- '  %s: differs\n' "$m"
          fi
          ;;
      esac
    done < "$div_file"
  fi

  # HYPOTHESES section.
  printf -- '\n'
  printf -- 'HYPOTHESES\n'
  local hyp
  hyp="$(diff_hypothesize "$a_file" "$b_file" "$div_file")"
  # Substitute the literal `<slug-a>` / `<slug-b>` placeholders for the
  # concrete slug names — keeps hypothesize() free of slug-arg plumbing.
  hyp="${hyp//<slug-a>/$slug_a}"
  hyp="${hyp//<slug-b>/$slug_b}"
  # Indent every line by 2 spaces.
  printf -- '%s' "$hyp" | awk 'NF { print "  " $0 } !NF { print }'
}

# Render the JSON shape per AC#8.
diff_render_json() {
  local slug_a="$1" slug_b="$2" a_file="$3" b_file="$4" div_file="$5"
  local start_iso="$6" end_iso="$7"
  local esc_a esc_b
  esc_a="$(diff_json_escape "$slug_a")"
  esc_b="$(diff_json_escape "$slug_b")"

  printf -- '{"window":{"start":"%s","end":"%s"},"a":"%s","b":"%s"' \
    "$start_iso" "$end_iso" "$esc_a" "$esc_b"

  # metrics array.
  printf -- ',"metrics":['
  local first=1 name va vb delta
  while IFS=$'\t' read -r name va; do
    vb="$(awk -F'\t' -v n="$name" '$1 == n { print $2 }' "$b_file")"
    [ "$first" -eq 1 ] || printf -- ','
    first=0
    case "$name" in
      "prompts SHA"|"top atlas pattern (fires)")
        # Non-numeric metrics: a/b are strings.
        local pct
        if [ "$va" = "$vb" ]; then pct='='; else pct='differ'; fi
        printf -- '{"name":"%s","a":"%s","b":"%s","delta":null,"pct":"%s"}' \
          "$(diff_json_escape "$name")" \
          "$(diff_json_escape "$va")" \
          "$(diff_json_escape "$vb")" \
          "$pct"
        ;;
      *)
        # Numeric metrics.
        delta="$(awk -v a="$va" -v b="$vb" 'BEGIN { printf("%g", b-a) }')"
        local pct
        pct="$(diff_delta_for_metric "$name" "$va" "$vb")"
        # Numeric a/b — escape just in case but they should be numeric.
        printf -- '{"name":"%s","a":%s,"b":%s,"delta":%s,"pct":"%s"}' \
          "$(diff_json_escape "$name")" \
          "$va" "$vb" "$delta" \
          "$(diff_json_escape "$pct")"
        ;;
    esac
  done < "$a_file"
  printf -- ']'

  # divergence array.
  printf -- ',"divergence":['
  first=1
  while IFS= read -r m; do
    [ -z "$m" ] && continue
    va="$(awk -F'\t' -v n="$m" '$1 == n { print $2 }' "$a_file")"
    vb="$(awk -F'\t' -v n="$m" '$1 == n { print $2 }' "$b_file")"
    [ "$first" -eq 1 ] || printf -- ','
    first=0
    case "$m" in
      "prompts SHA"|"top atlas pattern (fires)")
        printf -- '{"metric":"%s","ratio":null,"direction":"differ"}' \
          "$(diff_json_escape "$m")"
        ;;
      *)
        local r d
        r="$(diff_ratio "$va" "$vb")"
        d="$(diff_direction "$va" "$vb")"
        printf -- '{"metric":"%s","ratio":%s,"direction":"%s"}' \
          "$(diff_json_escape "$m")" "$r" "$d"
        ;;
    esac
  done < "$div_file"
  printf -- ']'

  # hypotheses array.
  printf -- ',"hypotheses":['
  local hyp
  hyp="$(diff_hypothesize "$a_file" "$b_file" "$div_file")"
  hyp="${hyp//<slug-a>/$slug_a}"
  hyp="${hyp//<slug-b>/$slug_b}"
  first=1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$first" -eq 1 ] || printf -- ','
    first=0
    printf -- '"%s"' "$(diff_json_escape "$line")"
  done <<< "$hyp"
  printf -- ']'

  printf -- '}\n'
}

# Compute the divergence set from the two metric files — one metric
# name per line on stdout (only the names that diverge).
diff_compute_divergence() {  # $1 = a_file, $2 = b_file
  local a_file="$1" b_file="$2"
  local name va vb
  while IFS=$'\t' read -r name va; do
    vb="$(awk -F'\t' -v n="$name" '$1 == n { print $2 }' "$b_file")"
    if [ "$(diff_metric_diverges "$name" "$va" "$vb")" = "1" ]; then
      printf -- '%s\n' "$name"
    fi
  done < "$a_file"
}

diff_cmd() {
  shift  # drop the leading "diff"
  local want_json=0 since="14d"
  local positional=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)    want_json=1; shift ;;
      --since)   since="${2:-}"; shift 2 ;;
      --since=*) since="${1#--since=}"; shift ;;
      -h|--help)
        cat <<'USAGE'
fleet diff — side-by-side ROI / posture comparison of two projects.

Usage:
  fleet diff <slug-a> <slug-b>             default --since 14d window
  fleet diff <slug-a> <slug-b> --since 7d  override window (Nh or Nd)
  fleet diff <slug-a> <slug-b> --json      machine-readable object

Output (text mode):
  DIFF <window> — <slug-a> vs <slug-b> (<iso-start> → <iso-end>)
  METRIC                     <slug-a>    <slug-b>    Δ
  ships                      ...
  merges                     ...
  sendbacks                  ...
  spend ($)                  ...
  paused hours               ...
  draft promotion debt       ...
  prompts SHA                ...
  top atlas pattern (fires)  ...

  DIVERGENCE (>=2x)
    <metric>: <slug> is <ratio>x <other>

  HYPOTHESES
    <one short root-cause line per diverging metric>

Delta column: <delta> (<pct>%) for numeric metrics; "=" when identical;
"differ" for non-numeric pairs that disagree; infinity when one side is zero.

Pure consumer of events.jsonl + runs.jsonl + agents.config.sh -
no new event types, no fleet_* signature changes, no lib/ or
prompts/ edits.

Exit code: 0 on success; 2 on usage error.
USAGE
        exit 0 ;;
      --)        shift; while [ $# -gt 0 ]; do positional+=("$1"); shift; done ;;
      -*)
        printf -- 'fleet diff: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        positional+=("$1"); shift ;;
    esac
  done

  if [ "${#positional[@]}" -lt 2 ]; then
    printf -- 'diff: usage: bin/fleet diff <slug-a> <slug-b> [--since Nh|Nd] [--json]\n' >&2
    exit 2
  fi

  local slug_a="${positional[0]}" slug_b="${positional[1]}"

  if [ "$slug_a" = "$slug_b" ]; then
    printf -- 'diff: <slug-a> and <slug-b> must differ; use `fleet weekly --slug <slug>` for the same-project historical comparison\n' >&2
    exit 2
  fi

  # Parse --since.
  local since_seconds
  if ! since_seconds="$(digest_parse_since "$since")"; then
    printf -- 'diff: invalid --since "%s" (use Nh or Nd)\n' "$since" >&2
    exit 2
  fi

  # Resolve slugs. Both must exist; missing-slug branch names which side.
  local rec_a rec_b
  rec_a="$(diff_resolve_slug "$slug_a")"
  rec_b="$(diff_resolve_slug "$slug_b")"
  if [ -z "$rec_a" ] || ! [ -f "$(printf -- '%s' "$rec_a" | awk -F'\t' '{print $2}')" ]; then
    printf -- 'diff: slug "%s" not installed (no events.jsonl found)\n' "$slug_a" >&2
    exit 2
  fi
  if [ -z "$rec_b" ] || ! [ -f "$(printf -- '%s' "$rec_b" | awk -F'\t' '{print $2}')" ]; then
    printf -- 'diff: slug "%s" not installed (no events.jsonl found)\n' "$slug_b" >&2
    exit 2
  fi

  local events_a runs_a pin_a events_b runs_b pin_b
  events_a="$(printf -- '%s' "$rec_a" | awk -F'\t' '{print $2}')"
  runs_a="$(printf -- '%s' "$rec_a" | awk -F'\t' '{print $3}')"
  pin_a="$(printf -- '%s' "$rec_a" | awk -F'\t' '{print $4}')"
  events_b="$(printf -- '%s' "$rec_b" | awk -F'\t' '{print $2}')"
  runs_b="$(printf -- '%s' "$rec_b" | awk -F'\t' '{print $3}')"
  pin_b="$(printf -- '%s' "$rec_b" | awk -F'\t' '{print $4}')"

  # Resolve window.
  local end_epoch start_epoch
  end_epoch="${FLEET_NOW_OVERRIDE:-$(date -u +%s)}"
  start_epoch=$(( end_epoch - since_seconds ))
  local start_iso end_iso
  start_iso="$(date -u -r "$start_epoch" +%FT%TZ 2>/dev/null || date -u -d "@$start_epoch" +%FT%TZ)"
  end_iso="$(date -u -r "$end_epoch" +%FT%TZ 2>/dev/null || date -u -d "@$end_epoch" +%FT%TZ)"

  # Load metrics for both slugs.
  local tmp_dir
  tmp_dir="$(mktemp -d -t fleet-diff.XXXXXX)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp_dir'" RETURN
  local a_file="$tmp_dir/a.tsv" b_file="$tmp_dir/b.tsv" div_file="$tmp_dir/divergence.txt"
  diff_load_slug_metrics "$events_a" "$runs_a" "$pin_a" "$start_epoch" "$end_epoch" "$a_file"
  diff_load_slug_metrics "$events_b" "$runs_b" "$pin_b" "$start_epoch" "$end_epoch" "$b_file"
  diff_compute_divergence "$a_file" "$b_file" > "$div_file"

  if [ "$want_json" = "1" ]; then
    diff_render_json "$slug_a" "$slug_b" "$a_file" "$b_file" "$div_file" \
      "$start_iso" "$end_iso"
  else
    diff_render_text "$slug_a" "$slug_b" "$a_file" "$b_file" "$div_file" \
      "$start_iso" "$end_iso" "$since"
  fi
  exit 0
}

if [ "$CMD" = "diff" ]; then
  diff_cmd "$@"
  exit $?
fi

# --- incident (ticket 0037) ----------------------------------------------
# `fleet incident --since <Nh|Nd> [--slug NAME] [--json] [--out FILE]`
# assembles a structured post-mortem from the event channel: timeline +
# cluster summary + open recovery actions. Pure consumer of events.jsonl
# (+ `gh pr view` for the one network-touching open-action check). No new
# event types — the reader CONSUMES the contract, does not extend it.
#
# Body placement: BELOW digest_parse_since (line ~1985); inlines
# `incident_json_escape` (bit-for-bit copy of `provenance_json_escape`
# at ~line 6373) and `incident_render_event_line` (a per-event formatter
# in the same shape `tail_format_stream` uses for the live stream) per
# LESSONS 2026-06-05 (dispatcher forward-reference trap). Every code
# path exits explicitly per LESSONS 2026-06-01 (dispatcher fall-through
# trap). Every printf with a value that might start with `-` uses
# `printf -- '%s'` per LESSONS 2026-05-28. Every awk -v with a value
# that might contain newlines uses `getline … < file` per LESSONS
# 2026-06-01 (awk -v multiline trap). Every count uses
# `awk … END { print n+0 }` per LESSONS 2026-06-01 (grep -c double-print
# trap). Help-text grep uses `grep -qF --` per LESSONS 2026-05-30.

# UTF-8-safe JSON escaper (LESSONS 2026-06-03 sign-extension guard).
# Bit-for-bit copy of provenance_json_escape; inlined here because the
# original is defined LATER in the file at ~line 6373 and the dispatcher
# block fires at execution time (LESSONS 2026-06-05).
incident_json_escape() {
  local s="${1-}" out="" i ch code
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    case "$ch" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *)
        printf -v code '%d' "'$ch"
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v out '%s\\u%04x' "$out" "$code"
        else
          out+="$ch"
        fi
        ;;
    esac
  done
  printf -- '%s' "$out"
}

# Discover project (slug, events.jsonl) pairs. Same union-by-SLUG pattern
# as tail_discover_events but standalone so incident is self-contained.
incident_discover_events() {
  local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
  local installed="$HOME/.local/share/agent-fleet/projects"
  local _seen="" m slug
  { find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$installed" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    [ -z "$slug" ] && continue
    case " $_seen " in *" $slug "*) continue ;; esac
    _seen="$_seen $slug"
    printf '%s\t%s\n' "$slug" "$HOME/.cache/${slug}-agent/events.jsonl"
  done
}

# Walk every surveyed project's events.jsonl (+ archive files per the
# 0016 rotation contract) and emit one JSON line per event whose ts is
# in [start_iso, end_iso]. Output is ISO-chronologically sorted across
# all slugs. Reads file paths off stdin (tab-separated slug<TAB>events
# rows, same shape as incident_discover_events).
#
# $1: start_iso ($2: end_iso) — inclusive bounds.
incident_walk_events() {
  local start_iso="$1" end_iso="$2"
  local slug events archive_dir tmp_all
  tmp_all="$(mktemp -t fleet-incident-walk.XXXXXX)"
  while IFS=$'\t' read -r slug events; do
    [ -z "$slug" ] && continue
    # Main events.jsonl.
    if [ -f "$events" ]; then
      awk -v start="$start_iso" -v stop="$end_iso" '
        {
          if ($0 ~ /^[[:space:]]*$/) next
          ts = ""
          if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
            ts = substr($0, RSTART, RLENGTH)
            sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
          }
          if (ts == "") next
          # ISO8601 strings are lexically sortable — no date math needed.
          if (ts >= start && ts <= stop) print ts "\t" $0
        }
      ' "$events" >> "$tmp_all"
    fi
    # Archive files (ticket 0016 rotation).
    archive_dir="$(dirname "$events")/events.jsonl.archive"
    if [ -d "$archive_dir" ]; then
      local af
      for af in "$archive_dir"/*.jsonl; do
        [ -f "$af" ] || continue
        awk -v start="$start_iso" -v stop="$end_iso" '
          {
            if ($0 ~ /^[[:space:]]*$/) next
            ts = ""
            if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
              ts = substr($0, RSTART, RLENGTH)
              sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
            }
            if (ts == "") next
            if (ts >= start && ts <= stop) print ts "\t" $0
          }
        ' "$af" >> "$tmp_all"
      done
    fi
  done
  # Sort by ISO8601 ts (column 1) then by the JSON payload itself so the
  # output is deterministic across re-runs even when two events share a
  # ts. Strip the leading ts column on output — readers use the ts that
  # is already inside the JSON line.
  sort -k1,1 -k2,2 "$tmp_all" | cut -f2-
  rm -f "$tmp_all"
}

# Extract a "name" field's string value from a JSON line. Echoes the
# value with no quotes, or empty when the key is absent. Lightweight
# replacement for jq — same algorithm tail_format_stream's `field()`
# uses inside awk.
incident_field() {
  local line="$1" name="$2"
  printf -- '%s' "$line" | awk -v name="$name" '
    {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match($0, re)
      if (start == 0) { print ""; exit }
      raw = substr($0, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) { print ""; exit }
        print substr(raw, 2, end - 1); exit
      }
      end = match(raw, /[,}]/)
      if (end == 0) { print raw; exit }
      print substr(raw, 1, end - 1); exit
    }
  '
}

# Render one event line for the Timeline section. Format:
#   - <iso-ts> — `<type>` <payload-render>
# Mirrors the shape tail_format_stream uses for the live stream.
incident_render_event_line() {
  local line="$1"
  local ts type
  ts="$(incident_field "$line" "ts")"
  type="$(incident_field "$line" "type")"
  [ -z "$ts" ] && return 0
  [ -z "$type" ] && type="(unknown)"

  # Per-type payload renders. Keep them short and stable so they round-
  # trip into golden tests. Unknown types fall through to a generic
  # k=v render of every key except the four required ones.
  local payload=""
  case "$type" in
    pr_opened)
      local num br
      num="$(incident_field "$line" "number")"
      br="$(incident_field "$line" "branch")"
      payload="#${num} ${br}"
      ;;
    lesson_draft_emitted)
      local pr hd
      pr="$(incident_field "$line" "pr")"
      hd="$(incident_field "$line" "headline")"
      payload="PR #${pr} \"${hd}\""
      ;;
    ship_paused)
      local reason cnt prs
      reason="$(incident_field "$line" "reason")"
      cnt="$(incident_field "$line" "count")"
      prs="$(incident_field "$line" "prs")"
      payload="reason=${reason} count=${cnt}"
      [ -n "$prs" ] && payload="${payload} prs=${prs}"
      ;;
    ship_resumed)
      local src forced
      src="$(incident_field "$line" "source")"
      forced="$(incident_field "$line" "forced")"
      payload="source=${src} forced=${forced}"
      ;;
    rollback_opened)
      local pr rev mc
      pr="$(incident_field "$line" "pr")"
      rev="$(incident_field "$line" "reverts")"
      mc="$(incident_field "$line" "merge_commit")"
      payload="pr=${pr} reverts=${rev} merge_commit=${mc}"
      ;;
    prompts_drift)
      local pinned actual
      pinned="$(incident_field "$line" "pinned")"
      actual="$(incident_field "$line" "actual")"
      payload="pinned=${pinned} actual=${actual}"
      ;;
    prompts_reverted)
      local frm to pr
      frm="$(incident_field "$line" "from")"
      to="$(incident_field "$line" "to")"
      pr="$(incident_field "$line" "pr")"
      payload="from=${frm} to=${to} pr=${pr}"
      ;;
    prompts_pin_changed)
      local old new
      old="$(incident_field "$line" "old")"
      new="$(incident_field "$line" "new")"
      payload="old=${old} new=${new}"
      ;;
    budget_block)
      local reason spent cap
      reason="$(incident_field "$line" "reason")"
      spent="$(incident_field "$line" "spent")"
      cap="$(incident_field "$line" "cap")"
      payload="reason=${reason} spent=${spent} cap=${cap}"
      ;;
    lesson_promoted)
      local source_slug text_sha scope
      source_slug="$(incident_field "$line" "source")"
      text_sha="$(incident_field "$line" "text_sha")"
      scope="$(incident_field "$line" "scope")"
      payload="source=${source_slug} text_sha=${text_sha} scope=${scope}"
      ;;
    run_started)
      payload="pid=$(incident_field "$line" "pid")"
      ;;
    run_completed)
      local ex dur
      ex="$(incident_field "$line" "exit")"
      dur="$(incident_field "$line" "duration_ms")"
      payload="exit=${ex} duration_ms=${dur}"
      ;;
    *)
      payload="(raw payload — see events.jsonl)"
      ;;
  esac

  if [ -n "$payload" ]; then
    printf -- '- %s — `%s` %s\n' "$ts" "$type" "$payload"
  else
    printf -- '- %s — `%s`\n' "$ts" "$type"
  fi
}

# Cluster detector: sendback_streak. Looks for >=3 lesson_draft_emitted
# events on DIFFERENT PRs within 24h ending in a ship_paused, per slug.
# Reads JSON lines (one per event) from stdin; writes one tab-delimited
# cluster row per detection:
#   sendback_streak<TAB><slug><TAB><pr,pr,...><TAB><first_ts><TAB><last_ts>
incident_detect_sendback_streak() {
  awk '
    function field(line, name,    re, start, raw, end) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    {
      ts = field($0, "ts"); slug = field($0, "slug"); type = field($0, "type")
      if (slug == "" || ts == "") next
      if (type == "lesson_draft_emitted") {
        pr = field($0, "pr")
        if (pr == "") next
        # Track first/last ts and distinct PRs per slug.
        if (drafts_first[slug] == "") drafts_first[slug] = ts
        drafts_last[slug] = ts
        key = slug "|" pr
        if (!(key in seen_pr)) {
          seen_pr[key] = 1
          if (drafts_prs[slug] == "") drafts_prs[slug] = pr
          else                          drafts_prs[slug] = drafts_prs[slug] "," pr
          drafts_count[slug]++
        }
      } else if (type == "ship_paused") {
        # Only fire when there are >=3 distinct-PR drafts and the pause
        # is reason=sendback_streak (or count>=3).
        reason = field($0, "reason")
        if ((drafts_count[slug] + 0) >= 3) {
          printf("sendback_streak\t%s\t%s\t%s\t%s\n",
                 slug, drafts_prs[slug], drafts_first[slug], ts)
          # Mark used so a later second ship_paused does not double-fire
          # on the same draft set.
          drafts_count[slug] = 0
          drafts_prs[slug]   = ""
          drafts_first[slug] = ""
          # Reference reason once so awk does not complain about unread.
          if (reason == "") {}
        }
      }
    }
  '
}

# Cluster detector: rollback_after_merge. A rollback_opened event whose
# `reverts` field names a PR that earlier emitted pr_opened in the window.
# Emits:
#   rollback_after_merge<TAB><slug><TAB><orig_pr,revert_pr><TAB><orig_ts><TAB><rollback_ts>
incident_detect_rollback_after_merge() {
  awk '
    function field(line, name,    re, start, raw, end) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    {
      ts = field($0, "ts"); slug = field($0, "slug"); type = field($0, "type")
      if (slug == "" || ts == "") next
      if (type == "pr_opened") {
        num = field($0, "number")
        if (num != "") {
          key = slug "|" num
          opened_ts[key] = ts
        }
      } else if (type == "rollback_opened") {
        pr = field($0, "pr"); rev = field($0, "reverts")
        key = slug "|" rev
        if (key in opened_ts) {
          printf("rollback_after_merge\t%s\t%s,%s\t%s\t%s\n",
                 slug, rev, pr, opened_ts[key], ts)
        }
      }
    }
  '
}

# Cluster detector: prompts_revision_walk. A prompts_drift OR
# prompts_pin_changed followed by a prompts_reverted within 7 days
# (all in the window). Emits one row per detection:
#   prompts_revision_walk<TAB><slug><TAB><revert_pr><TAB><first_ts><TAB><revert_ts>
incident_detect_prompts_revision_walk() {
  awk '
    function field(line, name,    re, start, raw, end) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    {
      ts = field($0, "ts"); slug = field($0, "slug"); type = field($0, "type")
      if (slug == "" || ts == "") next
      if (type == "prompts_drift" || type == "prompts_pin_changed") {
        if (first_ts[slug] == "") first_ts[slug] = ts
      } else if (type == "prompts_reverted") {
        if (first_ts[slug] != "") {
          pr = field($0, "pr")
          printf("prompts_revision_walk\t%s\t%s\t%s\t%s\n",
                 slug, pr, first_ts[slug], ts)
          first_ts[slug] = ""  # consume the pairing
        }
      }
    }
  '
}

# Cluster detector: budget_block_recurrence. >=2 budget_block events on
# different UTC days within the window. Emits one row per slug:
#   budget_block_recurrence<TAB><slug><TAB>—<TAB><first_ts><TAB><last_ts>
incident_detect_budget_block_recurrence() {
  awk '
    function field(line, name,    re, start, raw, end) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    {
      ts = field($0, "ts"); slug = field($0, "slug"); type = field($0, "type")
      if (slug == "" || ts == "") next
      if (type != "budget_block") next
      # UTC date = first 10 chars of ts (YYYY-MM-DD).
      day = substr(ts, 1, 10)
      key = slug "|" day
      if (!(key in seen_day)) {
        seen_day[key] = 1
        distinct_days[slug]++
      }
      if (first_ts[slug] == "") first_ts[slug] = ts
      last_ts[slug] = ts
    }
    END {
      for (s in distinct_days) {
        if (distinct_days[s] >= 2) {
          printf("budget_block_recurrence\t%s\t—\t%s\t%s\n",
                 s, first_ts[s], last_ts[s])
        }
      }
    }
  '
}

# Open-action detector: resume actions. For every ship_paused without a
# later ship_resumed in the window, emit one row:
#   resume<TAB><slug><TAB>fleet resume <slug>
incident_open_resume_actions() {
  awk '
    function field(line, name,    re, start, raw, end) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    {
      ts = field($0, "ts"); slug = field($0, "slug"); type = field($0, "type")
      if (slug == "" || ts == "") next
      if (type == "ship_paused")   paused[slug] = ts
      if (type == "ship_resumed")  resumed[slug] = ts
    }
    END {
      for (s in paused) {
        if (!(s in resumed) || resumed[s] < paused[s]) {
          printf("resume\t%s\tfleet resume %s\n", s, s)
        }
      }
    }
  '
}

# Open-action detector: lesson promote actions. For every
# lesson_draft_emitted without a later lesson_promoted whose text_sha
# matches, emit one row per outstanding draft:
#   promote<TAB><slug><TAB>fleet lessons-promote <slug>
incident_open_promote_actions() {
  awk '
    function field(line, name,    re, start, raw, end) {
      re = "\"" name "\"[[:space:]]*:[[:space:]]*"
      start = match(line, re)
      if (start == 0) return ""
      raw = substr(line, start + RLENGTH)
      if (substr(raw, 1, 1) == "\"") {
        end = index(substr(raw, 2), "\"")
        if (end == 0) return ""
        return substr(raw, 2, end - 1)
      }
      end = match(raw, /[,}]/)
      if (end == 0) return raw
      return substr(raw, 1, end - 1)
    }
    {
      slug = field($0, "slug"); type = field($0, "type")
      if (slug == "") next
      if (type == "lesson_draft_emitted") {
        sha = field($0, "text_sha")
        # Without a text_sha we still count the draft (the cross-ref check
        # falls back to "any promote for this slug closes one draft").
        if (sha == "") sha = "draft-" (++anon[slug])
        key = slug "|" sha
        draft_open[key] = 1
        draft_slug[key] = slug
      } else if (type == "lesson_promoted") {
        sha = field($0, "text_sha")
        if (sha != "") {
          # Search any draft for this slug with matching sha.
          for (k in draft_open) {
            split(k, parts, "|")
            if (parts[1] == slug && parts[2] == sha) {
              delete draft_open[k]
            }
          }
        }
      }
    }
    END {
      for (k in draft_open) {
        s = draft_slug[k]
        printf("promote\t%s\tfleet lessons-promote %s\n", s, s)
      }
    }
  '
}

# Open-action detector: merge-or-close revert PR. For every
# rollback_opened, call `gh pr view <pr> --json state` and treat MERGED
# or CLOSED as resolved. Network-touching; skipped when AGENT_DRY_RUN=1.
# Emits one row per still-open revert:
#   merge_revert<TAB><slug><TAB>merge or close revert PR #<N>
incident_open_revert_merge_actions() {
  local stream_file="$1"
  [ -f "$stream_file" ] || return 0
  # First pass: collect (slug, pr) for every rollback_opened in the window.
  while IFS= read -r line; do
    local type slug pr
    type="$(incident_field "$line" "type")"
    [ "$type" = "rollback_opened" ] || continue
    slug="$(incident_field "$line" "slug")"
    pr="$(incident_field "$line" "pr")"
    [ -z "$slug" ] || [ -z "$pr" ] && continue
    if [ "${AGENT_DRY_RUN:-0}" = "1" ]; then
      # Dry-run: assume the revert is still open and surface it.
      printf -- 'merge_revert\t%s\tmerge or close revert PR #%s\n' "$slug" "$pr"
      continue
    fi
    local state
    state="$(gh pr view "$pr" --json state 2>/dev/null \
      | awk -F'"state":"' 'NF>1 { sub(/".*$/, "", $2); print $2; exit }')"
    case "$state" in
      MERGED|CLOSED) ;;                # resolved — skip
      *) printf -- 'merge_revert\t%s\tmerge or close revert PR #%s\n' "$slug" "$pr" ;;
    esac
  done < "$stream_file"
}

# Render the markdown post-mortem. Reads pre-computed pieces from files
# under $tmp_dir (so multi-line values never go through `awk -v`, per
# LESSONS 2026-06-01).
incident_render_markdown() {
  local start_iso="$1" end_iso="$2" slugs_csv="$3"
  local stream_file="$4" clusters_file="$5" actions_file="$6"

  # Header.
  printf -- '# INCIDENT — %s, %s → %s\n' "$slugs_csv" "$start_iso" "$end_iso"
  printf -- '\n'

  # Empty window: print the quiet message and stop.
  if [ ! -s "$stream_file" ]; then
    printf -- 'No events in window. fleet is quiet — this is normal.\n'
    return 0
  fi

  # Timeline.
  printf -- '## Timeline\n'
  printf -- '\n'
  local line
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    incident_render_event_line "$line"
  done < "$stream_file"
  printf -- '\n'

  # Cluster summary.
  printf -- '## Cluster summary\n'
  printf -- '\n'
  if [ -s "$clusters_file" ]; then
    local ctype cslug cprs cfirst clast
    while IFS=$'\t' read -r ctype cslug cprs cfirst clast; do
      [ -z "$ctype" ] && continue
      case "$ctype" in
        sendback_streak)
          printf -- '- `sendback_streak` (%s) — drafts on PRs %s ending in ship_paused at %s\n' \
            "$cslug" "$cprs" "$clast"
          ;;
        rollback_after_merge)
          printf -- '- `rollback_after_merge` (%s) — PRs %s (opened %s, rolled back %s)\n' \
            "$cslug" "$cprs" "$cfirst" "$clast"
          ;;
        prompts_revision_walk)
          printf -- '- `prompts_revision_walk` (%s) — prompts_drift/pin_changed at %s, reverted via PR #%s at %s\n' \
            "$cslug" "$cfirst" "$cprs" "$clast"
          ;;
        budget_block_recurrence)
          printf -- '- `budget_block_recurrence` (%s) — budget_block recurred between %s and %s\n' \
            "$cslug" "$cfirst" "$clast"
          ;;
        *)
          printf -- '- `%s` (%s)\n' "$ctype" "$cslug"
          ;;
      esac
    done < "$clusters_file"
  else
    printf -- '- No clusters detected — events are independent.\n'
  fi
  printf -- '\n'

  # Open recovery actions.
  printf -- '## Open recovery actions\n'
  printf -- '\n'
  if [ -s "$actions_file" ]; then
    # Group promote rows by slug so the operator sees one summary line
    # per slug rather than one row per outstanding draft. macOS bash 3.2
    # has no associative arrays, so we precompute a "slug<TAB>count"
    # table via awk and look up by grep.
    local promote_counts
    promote_counts="$(awk -F'\t' '$1 == "promote" { c[$2]++ } END { for (s in c) print s "\t" c[s] }' "$actions_file")"
    local seen_promote=""
    local akind aslug arem
    while IFS=$'\t' read -r akind aslug arem; do
      [ -z "$akind" ] && continue
      case "$akind" in
        resume)       printf -- '- `%s` — %s\n' "$aslug" "$arem" ;;
        merge_revert) printf -- '- `%s` — %s\n' "$aslug" "$arem" ;;
        promote)
          case " $seen_promote " in
            *" $aslug "*) ;;
            *)
              local cnt
              cnt="$(printf -- '%s\n' "$promote_counts" \
                | awk -F'\t' -v s="$aslug" '$1 == s { print $2; exit }')"
              [ -z "$cnt" ] && cnt=1
              printf -- '- `%s` — %s (%s outstanding draft(s))\n' \
                "$aslug" "$arem" "$cnt"
              seen_promote="$seen_promote $aslug"
              ;;
          esac
          ;;
        *) printf -- '- `%s` — %s\n' "$aslug" "$arem" ;;
      esac
    done < "$actions_file"
  else
    printf -- '- No open actions — every incident in the window has a recorded recovery.\n'
  fi
  printf -- '\n'

  return 0
}

# Render the JSON synthesis object. Timeline is intentionally OMITTED
# (operators wanting raw event lines use `fleet tail --json`). Per
# LESSONS 2026-06-01 (awk -v multiline trap), every multi-line value
# (none today, but defensive for future cluster types) goes through a
# tmp file via `getline line < file`.
incident_render_json() {
  local start_iso="$1" end_iso="$2" slugs_csv="$3"
  local clusters_file="$4" actions_file="$5"

  local esc_start esc_end
  esc_start="$(incident_json_escape "$start_iso")"
  esc_end="$(incident_json_escape "$end_iso")"

  # slugs array.
  local slugs_json="[" first=1 s
  local IFS_BAK="$IFS"
  IFS=','
  for s in $slugs_csv; do
    [ -z "$s" ] && continue
    local esc_s; esc_s="$(incident_json_escape "$s")"
    if [ "$first" = "1" ]; then slugs_json+="\"$esc_s\""; first=0
    else                         slugs_json+=",\"$esc_s\""; fi
  done
  IFS="$IFS_BAK"
  slugs_json+="]"

  # clusters array.
  local clusters_json="[" cfirst=1
  if [ -s "$clusters_file" ]; then
    local ctype cslug cprs ctfirst ctlast
    while IFS=$'\t' read -r ctype cslug cprs ctfirst ctlast; do
      [ -z "$ctype" ] && continue
      local esc_t esc_sl esc_f esc_l
      esc_t="$(incident_json_escape "$ctype")"
      esc_sl="$(incident_json_escape "$cslug")"
      esc_f="$(incident_json_escape "$ctfirst")"
      esc_l="$(incident_json_escape "$ctlast")"
      # PRs: comma-separated tokens → JSON array of strings. The em-dash
      # placeholder used by budget_block_recurrence renders as an empty
      # array.
      local prs_json="["
      if [ "$cprs" != "—" ] && [ -n "$cprs" ]; then
        local prfirst=1 p
        local pIFS="$IFS"
        IFS=','
        for p in $cprs; do
          [ -z "$p" ] && continue
          local esc_p; esc_p="$(incident_json_escape "$p")"
          if [ "$prfirst" = "1" ]; then prs_json+="\"$esc_p\""; prfirst=0
          else                            prs_json+=",\"$esc_p\""; fi
        done
        IFS="$pIFS"
      fi
      prs_json+="]"
      if [ "$cfirst" = "1" ]; then cfirst=0
      else                          clusters_json+=","; fi
      clusters_json+="{\"type\":\"$esc_t\",\"slug\":\"$esc_sl\",\"prs\":$prs_json,\"first_ts\":\"$esc_f\",\"last_ts\":\"$esc_l\"}"
    done < "$clusters_file"
  fi
  clusters_json+="]"

  # open_actions array.
  local actions_json="[" afirst=1
  if [ -s "$actions_file" ]; then
    local akind aslug arem
    while IFS=$'\t' read -r akind aslug arem; do
      [ -z "$akind" ] && continue
      local esc_k esc_sl esc_r
      esc_k="$(incident_json_escape "$akind")"
      esc_sl="$(incident_json_escape "$aslug")"
      esc_r="$(incident_json_escape "$arem")"
      if [ "$afirst" = "1" ]; then afirst=0
      else                          actions_json+=","; fi
      actions_json+="{\"kind\":\"$esc_k\",\"slug\":\"$esc_sl\",\"remediation\":\"$esc_r\"}"
    done < "$actions_file"
  fi
  actions_json+="]"

  printf -- '{"window":{"start":"%s","end":"%s"},"slugs":%s,"clusters":%s,"open_actions":%s}\n' \
    "$esc_start" "$esc_end" "$slugs_json" "$clusters_json" "$actions_json"
  return 0
}

incident() {
  shift  # drop "incident"
  local since="" slug_filter="" want_json=0 out_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since)   since="${2:-}"; shift 2 ;;
      --since=*) since="${1#--since=}"; shift ;;
      --slug)
        if [ $# -lt 2 ] || [ -z "${2:-}" ]; then
          echo "incident: --slug requires a non-empty value" >&2
          exit 2
        fi
        slug_filter="$2"; shift 2 ;;
      --slug=*)
        slug_filter="${1#--slug=}"
        if [ -z "$slug_filter" ]; then
          echo "incident: --slug requires a non-empty value" >&2
          exit 2
        fi
        shift ;;
      --json)    want_json=1; shift ;;
      --out)     out_file="${2:-}"; shift 2 ;;
      --out=*)   out_file="${1#--out=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet incident — assemble a post-mortem from the event channel.

Usage:
  fleet incident --since <Nh|Nd>            survey every project, default text
  fleet incident --since 72h --slug NAME    narrow to one project
  fleet incident --since 72h --json         machine-readable synthesis object
  fleet incident --since 72h --out FILE     write markdown to FILE (stderr line)

Output (text mode):
  # INCIDENT — <slug-list>, <iso-start> → <iso-end>

  ## Timeline
    - <iso-ts> — \`<type>\` <one-line-payload>

  ## Cluster summary
    - \`<cluster-token>\` (<slug>) — <one-line-summary>

  ## Open recovery actions
    - \`<slug>\` — <remediation command>

Cluster detectors:
  sendback_streak           >=3 lesson_draft_emitted on distinct PRs within
                             24h ending in a ship_paused
  rollback_after_merge      rollback_opened.reverts cross-references a
                             pr_opened in the window
  prompts_revision_walk     prompts_drift|prompts_pin_changed followed by a
                             prompts_reverted within 7 days
  budget_block_recurrence   >=2 budget_block events on distinct UTC days

Open-action detectors (event opener with no closer):
  ship_paused -> ship_resumed
  lesson_draft_emitted (text_sha) -> lesson_promoted (text_sha)
  rollback_opened -> revert PR state MERGED|CLOSED (via gh pr view)

--since is REQUIRED — incidents have no implicit window. Reuses
digest_parse_since for the Nh|Nd parser. Pure consumer of events.jsonl;
no new event types are emitted.

Exit code: 0 on success; 2 on usage error.
USAGE
        exit 0 ;;
      *) echo "incident: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  # --since required.
  if [ -z "$since" ]; then
    echo "incident: --since <Nh|Nd> is required" >&2
    exit 2
  fi
  local since_seconds
  if ! since_seconds="$(digest_parse_since "$since")"; then
    echo "incident: invalid --since \"$since\" (use Nh or Nd)" >&2
    exit 2
  fi

  # Resolve window: end = now (override-able for tests); start = end - since.
  local end_epoch start_epoch
  end_epoch="${FLEET_NOW_OVERRIDE:-$(date -u +%s)}"
  start_epoch=$(( end_epoch - since_seconds ))
  local start_iso end_iso
  start_iso="$(date -u -r "$start_epoch" +%FT%TZ 2>/dev/null || date -u -d "@$start_epoch" +%FT%TZ)"
  end_iso="$(date -u -r "$end_epoch" +%FT%TZ 2>/dev/null || date -u -d "@$end_epoch" +%FT%TZ)"

  # Discover project (slug, events.jsonl) pairs.
  local discover_rows
  discover_rows="$(incident_discover_events)"
  if [ -n "$slug_filter" ]; then
    discover_rows="$(printf -- '%s\n' "$discover_rows" | awk -F'\t' -v s="$slug_filter" '$1 == s')"
  fi

  # Build the slugs CSV (sorted, comma-joined).
  local slugs_csv
  slugs_csv="$(printf -- '%s\n' "$discover_rows" | awk -F'\t' 'NF>0 { print $1 }' \
    | sort -u | awk 'NR==1 { printf("%s", $0); next } { printf(",%s", $0) }')"
  if [ -z "$slugs_csv" ]; then
    if [ -n "$slug_filter" ]; then
      slugs_csv="$slug_filter"
    else
      slugs_csv="(none)"
    fi
  fi

  # Walk events in window — produces one JSON line per event, ISO-sorted.
  local tmp_dir
  tmp_dir="$(mktemp -d -t fleet-incident.XXXXXX)"
  trap 'rm -rf "$tmp_dir"' RETURN

  local stream_file="$tmp_dir/stream.jsonl"
  printf -- '%s\n' "$discover_rows" \
    | incident_walk_events "$start_iso" "$end_iso" > "$stream_file"

  # Run cluster detectors. Each detector reads the stream and emits zero
  # or more rows to its own file; we concatenate them in detector order.
  local clusters_file="$tmp_dir/clusters.tsv"
  : > "$clusters_file"
  incident_detect_sendback_streak           < "$stream_file" >> "$clusters_file"
  incident_detect_rollback_after_merge      < "$stream_file" >> "$clusters_file"
  incident_detect_prompts_revision_walk     < "$stream_file" >> "$clusters_file"
  incident_detect_budget_block_recurrence   < "$stream_file" >> "$clusters_file"

  # Run open-action detectors.
  local actions_file="$tmp_dir/actions.tsv"
  : > "$actions_file"
  incident_open_resume_actions   < "$stream_file" >> "$actions_file"
  incident_open_promote_actions  < "$stream_file" >> "$actions_file"
  incident_open_revert_merge_actions "$stream_file" >> "$actions_file"

  # Render.
  if [ "$want_json" = "1" ]; then
    if [ -n "$out_file" ]; then
      incident_render_json "$start_iso" "$end_iso" "$slugs_csv" \
        "$clusters_file" "$actions_file" > "$out_file"
      printf -- 'incident: wrote post-mortem to %s\n' "$out_file" >&2
    else
      incident_render_json "$start_iso" "$end_iso" "$slugs_csv" \
        "$clusters_file" "$actions_file"
    fi
    exit 0
  fi

  if [ -n "$out_file" ]; then
    incident_render_markdown "$start_iso" "$end_iso" "$slugs_csv" \
      "$stream_file" "$clusters_file" "$actions_file" > "$out_file"
    printf -- 'incident: wrote post-mortem to %s\n' "$out_file" >&2
  else
    incident_render_markdown "$start_iso" "$end_iso" "$slugs_csv" \
      "$stream_file" "$clusters_file" "$actions_file"
  fi
  exit 0
}

if [ "$CMD" = "incident" ]; then
  incident "$@"
  exit $?
fi

# --- lessons-sync ---------------------------------------------------------
# Ticket 0009. `fleet lessons-sync` walks every discovered project, reads
# its docs/LESSONS.md, and writes one merged file at
# $HOME/.local/share/agent-fleet/CROSS_LESSONS.md so the ship/groom prompts
# (and any human running `less`) can see what every project in the fleet
# has learned.
#
# Discovery reuses the same two-root pattern as `doctor`/`tail`/`rollback`:
#   1. $FLEET_DISCOVERY_ROOT (default ~/Desktop/projects)
#   2. ~/.local/share/agent-fleet/projects
# De-duped by SLUG, working-tree manifests winning over installed copies
# (so a project that's currently on a feature branch is read from the
# source tree, not the stale install).
#
# Output format:
#   # CROSS_LESSONS
#   <intro paragraph>
#
#   ## <slug-A>
#
#   <body of <slug-A>'s docs/LESSONS.md verbatim, MINUS its leading `# ...`
#    title and the introductory paragraph immediately after it — those are
#    boilerplate that would duplicate across every section. Subsection
#    headings (`## ...`) are demoted to `### ...` so the project heading
#    stays at the top of its block.>
#
#   ## <slug-B>
#   ...
#
# De-dup (AC#B): a paragraph (`\n\n`-separated block) whose body is
# byte-identical to one already emitted under another slug is dropped on
# the second appearance AND replaced with a single
# `> Already seen under ## <other-slug>` reference line under the current
# slug's heading. The lesson LINE inside that paragraph also picks up an
# `(also seen in <other-slug>)` annotation when first emitted, so an
# operator skimming the file sees the cross-project signal without having
# to grep.
#
# Idempotency (AC#C): we compute the proposed output in memory and only
# overwrite the destination when its sha differs. mtime stays put when
# bytes are unchanged — matters because consumers (fleet-control, the
# launchd label that triggers `tail -F`) may treat mtime as freshness.
#
# AC#G: a project without docs/LESSONS.md is silently skipped — no
# heading, no error, no entry in the merged file. The ticket calls this
# out explicitly.

lessons_sync_discover() {
  local discovery_root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
  local installed_root="$HOME/.local/share/agent-fleet/projects"
  local _seen="" m slug dir
  { find "$discovery_root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$installed_root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    [ -z "$slug" ] && continue
    case " $_seen " in *" $slug "*) continue ;; esac
    _seen="$_seen $slug"
    dir="$(dirname "$m")"
    printf '%s\t%s\n' "$slug" "$dir"
  done
}

# Strip the leading `# Title\n\n<intro paragraph>\n\n` boilerplate from a
# LESSONS.md body. The intro is everything before the FIRST `## ` heading
# (or the whole file if there are no `## ` headings — in that case we
# keep the body unchanged so a sparse LESSONS.md still surfaces).
lessons_sync_strip_intro() {
  awk '
    BEGIN { skipping = 1 }
    {
      if (skipping && $0 ~ /^## /) skipping = 0
      if (!skipping) print
    }
  '
}

# Demote `## X` → `### X` so each projects subsection sits under its own
# project heading without colliding with another `##` block.
lessons_sync_demote() {
  sed -E 's/^## /### /'
}

lessons_sync() {
  shift  # drop the leading "lessons-sync"
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        cat <<USAGE
fleet lessons-sync — merge every project's docs/LESSONS.md into one file.

Usage:
  fleet lessons-sync

Writes \$HOME/.local/share/agent-fleet/CROSS_LESSONS.md. Idempotent: the
file is only rewritten when content would change. Projects without a
docs/LESSONS.md are skipped silently.

Discovers projects via FLEET_DISCOVERY_ROOT (default ~/Desktop/projects)
AND ~/.local/share/agent-fleet/projects, de-duped by SLUG.
USAGE
        exit 0 ;;
      *) echo "fleet lessons-sync: unknown flag '$1'" >&2; exit 2 ;;
    esac
  done

  local dest_dir="$HOME/.local/share/agent-fleet"
  local dest="$dest_dir/CROSS_LESSONS.md"
  mkdir -p "$dest_dir"

  # Phase 1: collect (slug, lessons_path) rows for every project that has a
  # docs/LESSONS.md. Skip projects without one (AC#G).
  local rows=""
  while IFS=$'\t' read -r slug dir; do
    [ -z "$slug" ] && continue
    local lessons_file="$dir/docs/LESSONS.md"
    [ -f "$lessons_file" ] || continue
    rows="${rows}${slug}"$'\t'"${lessons_file}"$'\n'
  done < <(lessons_sync_discover)

  # Phase 2: render the merged document into a tmpfile, then atomically
  # compare against the existing file's sha. The rendering uses a small
  # python pass because the cross-slug dedup needs paragraph-level state
  # that awk handles badly across multiple files. python3 ships with
  # macOS via the Command Line Tools; if it's missing we fall back to a
  # shell-only implementation that omits the dedup annotation (still
  # passes AC#A, but logs a warning).
  local tmp; tmp="$(mktemp -t fleet-lessons.XXXXXX)"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$tmp" <<'PY' "$rows"
import hashlib, os, re, sys
out_path = sys.argv[1]
raw_rows = sys.argv[2] if len(sys.argv) > 2 else ""
rows = []
for line in raw_rows.splitlines():
    if not line.strip():
        continue
    parts = line.split("\t")
    if len(parts) < 2:
        continue
    rows.append((parts[0], parts[1]))

def strip_intro(text):
    """Drop everything before the first '## ' heading. If there is none,
    keep the body unchanged (sparse LESSONS.md still surfaces). The
    project-level `# Title` line + any intro paragraph are dropped.
    """
    lines = text.splitlines()
    out = []
    started = False
    for ln in lines:
        if not started and ln.startswith("## "):
            started = True
        if started:
            out.append(ln)
    return "\n".join(out) if started else text

def demote(text):
    return re.sub(r"(?m)^## ", "### ", text)

def split_paragraphs(text):
    # Paragraphs are blank-line separated blocks. We keep each block's
    # leading whitespace stripped for dedup hashing but emit the raw
    # block verbatim. Headings (### ...) start a new paragraph; we treat
    # the heading line as a paragraph of its own so two identical body
    # paragraphs under different headings still dedup correctly.
    paras = []
    cur = []
    for ln in text.splitlines():
        if ln.strip() == "":
            if cur:
                paras.append("\n".join(cur))
                cur = []
        else:
            cur.append(ln)
    if cur:
        paras.append("\n".join(cur))
    return paras

# Body-hash → slug-of-first-appearance. We dedup on the paragraph body
# minus a trailing `(also seen in ...)` annotation so re-runs are stable.
seen = {}
# Per-slug list of (kind, payload). kind is "para" (verbatim emit), or
# "ref" (emit a `> Already seen under ## <slug>` line).
per_slug = []

for slug, path in rows:
    try:
        body = open(path, encoding="utf-8").read()
    except OSError:
        continue
    body = strip_intro(body)
    body = demote(body)
    paras = split_paragraphs(body)
    emitted = []
    for p in paras:
        # Hash ignores any existing `(also seen in ...)` tag so reruns
        # don't keep adding nesting layers.
        key = re.sub(r"\s*\(also seen in [^)]+\)", "", p).strip()
        if not key:
            continue
        if key in seen and seen[key] != slug:
            emitted.append(("ref", seen[key]))
        else:
            if key not in seen:
                seen[key] = slug
                # Annotate the lesson line with "(also seen in ...)" if
                # we discover later that another project shares it. We
                # do that in a second pass below; for now stash the
                # paragraph verbatim.
                emitted.append(("para", p))
            else:
                # Same slug repeats the same paragraph (rare; keep once)
                pass
    per_slug.append((slug, emitted))

# Second pass: for every paragraph body that's referenced by a OTHER
# slug, collect the referrer slugs keyed by the paragraph body's hash.
# `seen[key]` is the FIRST emitter slug for that body; any other slug
# that hit the body emitted a ("ref", first_emitter) row, so the set of
# referrers is "every slug that emitted a ref pointing at the body's
# first emitter AND whose own body matches key".
para_referrers = {}  # body_key -> set(referrer_slugs)
# We need to know which body key each ref corresponds to. Rebuild the
# per_slug walk to capture that: any "ref" was preceded by a body that
# matched an already-seen key — store the key alongside the ref.
per_slug_v2 = []
seen_v2 = {}
for slug, path in rows:
    try:
        body = open(path, encoding="utf-8").read()
    except OSError:
        continue
    body = strip_intro(body)
    body = demote(body)
    paras = split_paragraphs(body)
    emitted = []
    for p in paras:
        key = re.sub(r"\s*\(also seen in [^)]+\)", "", p).strip()
        if not key:
            continue
        if key in seen_v2 and seen_v2[key] != slug:
            emitted.append(("ref", seen_v2[key], key))
            para_referrers.setdefault(key, set()).add(slug)
        elif key not in seen_v2:
            seen_v2[key] = slug
            emitted.append(("para", p, key))
    per_slug_v2.append((slug, emitted))

per_slug = per_slug_v2
seen = seen_v2

# Re-render per slug:
chunks = ["# CROSS_LESSONS",
          "",
          "Auto-generated by `fleet lessons-sync`. Do not edit by hand —",
          "your edits will be overwritten on the next sync. The source of",
          "truth is each project's `docs/LESSONS.md`.",
          ""]
for slug, emitted in per_slug:
    if not emitted:
        continue
    chunks.append(f"## {slug}")
    chunks.append("")
    for row in emitted:
        kind = row[0]
        if kind == "para":
            payload = row[1]
            key = row[2]
            # If THIS paragraph body is referenced by other slugs, annotate
            # its first non-heading content line with `(also seen in ...)`.
            others = sorted(para_referrers.get(key, set()) - {slug})
            if others:
                lines = payload.splitlines()
                for i, ln in enumerate(lines):
                    if ln.startswith("###") or ln.strip() == "":
                        continue
                    if "(also seen in" in ln:
                        break
                    lines[i] = ln.rstrip() + f" (also seen in {', '.join(others)})"
                    break
                payload = "\n".join(lines)
            chunks.append(payload)
            chunks.append("")
        elif kind == "ref":
            target_slug = row[1]
            chunks.append(f"> Already seen under ## {target_slug}")
            chunks.append("")

text = "\n".join(chunks).rstrip() + "\n"
open(out_path, "w", encoding="utf-8").write(text)
PY
  else
    # Shell-only fallback. AC#A still passes; AC#B's annotation does not.
    {
      printf '# CROSS_LESSONS\n\n'
      printf 'Auto-generated by `fleet lessons-sync`. Do not edit by hand —\n'
      printf 'your edits will be overwritten on the next sync. The source of\n'
      printf "truth is each project's \`docs/LESSONS.md\`.\n\n"
      while IFS=$'\t' read -r slug path; do
        [ -z "$slug" ] && continue
        printf '## %s\n\n' "$slug"
        lessons_sync_strip_intro < "$path" | lessons_sync_demote
        printf '\n'
      done <<<"$rows"
    } > "$tmp"
    echo "fleet lessons-sync: python3 not found — dedup annotation skipped" >&2
  fi

  # Idempotency: write only when content differs (AC#C).
  if [ -f "$dest" ]; then
    local old_sha new_sha
    old_sha=$(shasum "$dest" 2>/dev/null | awk '{print $1}')
    new_sha=$(shasum "$tmp"  2>/dev/null | awk '{print $1}')
    if [ "$old_sha" = "$new_sha" ]; then
      rm -f "$tmp"
      exit 0
    fi
  fi
  mv -f "$tmp" "$dest"
  exit 0
}

if [ "$CMD" = "lessons-sync" ]; then
  lessons_sync "$@"
fi

# --- lessons-promote ------------------------------------------------------
# Ticket 0028. `fleet lessons-promote <slug> --lesson "<substring>"
# [--scope <slug-or-all>] [--headline-exact "<headline>"] [--dry-run]`
# copies ONE lesson paragraph from a source project's docs/LESSONS.md
# and appends it under the slug's section in the shared
# `${FLEET_CROSS_LESSONS_ROOT:-$HOME/.local/share/agent-fleet}/
# CROSS_LESSONS.md` (when --scope=all, the default) OR writes it to
# `<root>/projects/<scope>/CROSS_LESSONS.md.override` (when --scope is
# a specific consumer slug).
#
# Why this exists alongside `fleet lessons-sync` (0009): sync rebuilds
# CROSS_LESSONS.md wholesale on its own cadence. `lessons-promote` is
# the operator's CURATION primitive — one explicit "this lesson
# generalizes; push it now" action whose effect lands BEFORE the next
# sync cycle. See the ticket for the longer rationale.
#
# Defences (per docs/LESSONS.md):
#   - 2026-05-26 (`tail` shadow): the dispatcher is `lessons_promote`,
#     not `promote` (safe by itself; we keep the prefix anyway for
#     consistency with `lessons_sync`).
#   - 2026-05-27 ($(cat …) strips trailing newlines): the insertion
#     path uses `awk` + `mv -f`, never `$(cat …)`. The source
#     paragraph is extracted via awk and written verbatim.
#   - 2026-05-28 (printf '-…' flag trap): all printf calls with
#     operator-controlled content use `printf -- '%s'`.
#   - 2026-05-30 (`grep -F -- pat` flag trap): every grep against a
#     possibly-leading-dash needle uses `grep -iF -- "$needle"`.
#
# Telemetry: emits `lesson_promoted {source, text_sha, scope,
# dup_under?}` with `phase=promote` to the SOURCE project's
# events.jsonl on every successful, non-idempotent promotion.
# Idempotent re-runs (same body already present under same slug
# section) are silent — no event. See AGENTS.md § Telemetry.

lessons_promote_discover_dir() {
  # $1 = slug → echoes the project dir whose agents.config.sh has
  # SLUG=<slug>. Exit 1 if no match. Mirrors lessons_sync_discover but
  # filtered to a single slug.
  local want="$1"
  local discovery_root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
  local installed_root="$HOME/.local/share/agent-fleet/projects"
  local m slug dir
  { find "$discovery_root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
    find "$installed_root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort
  } | while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
    if [ "$slug" = "$want" ]; then
      dir="$(dirname "$m")"
      printf '%s\n' "$dir"
      return 0
    fi
  done
  return 1
}

# Read $1 (LESSONS.md path), find the lesson whose `## YYYY-MM-DD —
# <headline>` line case-insensitively contains $2 (substring) OR exactly
# matches $3 (headline-exact text, if non-empty). Print:
#   line 1: matched-headline-count
#   line 2+: the headline lines (one per match)
# We need the count to drive the zero/multi/one branch in the dispatcher.
lessons_promote_match_headlines() {
  local path="$1" substr="$2" exact="$3"
  # Lowercase the substring once so awk only does substring compare.
  local needle_lc
  needle_lc=$(printf -- '%s' "$substr" | tr '[:upper:]' '[:lower:]')
  awk -v needle="$needle_lc" -v exact="$exact" '
    BEGIN { n = 0 }
    /^## [0-9]{4}-[0-9]{2}-[0-9]{2} / {
      # The headline text is everything after `## YYYY-MM-DD — `.
      # We do not assume the em-dash byte sequence; instead split on
      # the first run of non-space chars after the date and skip them.
      heading = $0
      if (exact != "") {
        # Strip the `## YYYY-MM-DD — ` prefix (up to and including the
        # first non-space token after the date and its surrounding spaces).
        # Then byte-compare against the exact arg.
        tail = heading
        sub(/^## [0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+/, "", tail)
        if (tail == exact) {
          n++
          headlines[n] = heading
        }
      } else {
        lc = tolower(heading)
        if (index(lc, needle) > 0) {
          n++
          headlines[n] = heading
        }
      }
    }
    END {
      print n
      for (i = 1; i <= n; i++) print headlines[i]
    }
  ' "$path"
}

# Read $1 (LESSONS.md path), extract the paragraph that starts with the
# heading line $2 verbatim, and print it (heading + body) up to but not
# including the next `## ` heading or EOF. The OUTPUT is fed straight
# into the target file under the slug section — sync's demote() pass
# converts `## ` → `### ` so the slug heading at level-2 stays distinct
# from the lesson heading at level-3.
lessons_promote_extract_paragraph() {
  local path="$1" heading="$2"
  awk -v want="$heading" '
    BEGIN { capture = 0 }
    {
      if (capture && $0 ~ /^## /) {
        # Reached the next sibling lesson — stop.
        exit
      }
      if ($0 == want) { capture = 1 }
      if (capture) {
        # Demote `## ` to `### ` so it nests under the slug section.
        line = $0
        if (line ~ /^## /) sub(/^## /, "### ", line)
        print line
      }
    }
  ' "$path"
}

# SHA-8 of the normalized paragraph body. Normalization: drop the
# heading line, strip trailing whitespace per line, drop leading AND
# trailing blank lines, collapse runs of internal blank lines into one.
# The dedup key is the BODY, so two identical bodies under different
# headings dedup correctly — same convention as lessons-sync's
# python-based dedup at line ~4972. Leading/trailing trims defend
# against the extracted paragraph having a trailing blank line under
# some sources and not others (it varies depending on whether the
# next `## ` heading was present).
lessons_promote_paragraph_sha() {
  awk '
    NR == 1 { next }    # drop the heading line
    {
      sub(/[[:space:]]+$/, "", $0)
      lines[++n] = $0
    }
    END {
      # Trim leading blanks.
      start = 1
      while (start <= n && lines[start] == "") start++
      # Trim trailing blanks.
      end = n
      while (end >= start && lines[end] == "") end--
      # Collapse internal blank runs.
      last_blank = 0
      for (i = start; i <= end; i++) {
        if (lines[i] == "") {
          if (last_blank) continue
          last_blank = 1
        } else {
          last_blank = 0
        }
        print lines[i]
      }
    }
  ' | shasum | awk '{print substr($1, 1, 8)}'
}

lessons_promote_target_path() {
  # $1 = scope (`all` or a consumer slug). Echoes the absolute path to
  # the destination file. Creates the parent dir lazily.
  local scope="$1"
  local root="${FLEET_CROSS_LESSONS_ROOT:-$HOME/.local/share/agent-fleet}"
  if [ "$scope" = "all" ]; then
    mkdir -p "$root"
    printf -- '%s\n' "$root/CROSS_LESSONS.md"
  else
    mkdir -p "$root/projects/$scope"
    printf -- '%s\n' "$root/projects/$scope/CROSS_LESSONS.md.override"
  fi
}

# Locate the `## <slug>` section in the target file. Echoes the line
# number of the section header on success, or 0 if absent. Used by the
# inserter to know whether to create-at-EOF or append-within.
lessons_promote_section_lineno() {
  local target="$1" slug="$2"
  [ -f "$target" ] || { echo 0; return 0; }
  awk -v want="## $slug" '
    BEGIN { lineno = 0 }
    $0 == want { lineno = NR; exit }
    END { print lineno }
  ' "$target"
}

# Insert $paragraph BEFORE the next sibling `## ` heading after the
# slug section, OR at EOF if the slug section is the last one. Creates
# the section at EOF if it does not exist. Awk-based per LESSONS
# 2026-05-27 (never $(cat …) the whole file).
lessons_promote_insert_under_section() {
  local target="$1" slug="$2" paragraph="$3"
  local section_line; section_line=$(lessons_promote_section_lineno "$target" "$slug")
  local tmp; tmp="$(mktemp -t fleet-lessons-promote.XXXXXX)"
  # The paragraph can contain newlines — pass it through a temp file
  # so awk reads it via getline instead of -v (which BSD awk rejects
  # when the value contains a literal newline).
  local para_tmp; para_tmp="$(mktemp -t fleet-lessons-promote-para.XXXXXX)"
  printf -- '%s\n' "$paragraph" > "$para_tmp"
  if [ "$section_line" = "0" ]; then
    # Section does not exist → create at EOF.
    if [ -f "$target" ]; then
      cp "$target" "$tmp"
      # Guarantee the existing file ends with a single trailing newline
      # so the new section starts on its own line.
      if [ -n "$(tail -c1 "$tmp" 2>/dev/null)" ]; then
        printf -- '\n' >> "$tmp"
      fi
    else
      : > "$tmp"
    fi
    printf -- '\n## %s\n\n' "$slug" >> "$tmp"
    cat "$para_tmp" >> "$tmp"
  else
    # Section exists → append paragraph BEFORE the next `## ` header.
    awk -v section_line="$section_line" -v para_file="$para_tmp" '
      function load_para(   line) {
        para = ""
        while ((getline line < para_file) > 0) {
          para = (para == "" ? line : para "\n" line)
        }
        close(para_file)
      }
      BEGIN { inserted = 0; load_para() }
      {
        if (!inserted && NR > section_line && /^## /) {
          print para
          print ""
          inserted = 1
        }
        print
      }
      END {
        if (!inserted) {
          # The slug section was the last one in the file — append at EOF.
          print para
        }
      }
    ' "$target" > "$tmp"
  fi
  rm -f "$para_tmp"
  mv -f "$tmp" "$target"
}

# Idempotency check: does the normalized paragraph body already appear
# in the target file under ANY section? Echoes the slug of the section
# the existing copy lives under, or empty if no copy exists. Used to
# drive the no-op + dup_under branches in the dispatcher.
#
# Strategy: walk the file in shell, accumulating one paragraph at a
# time into a temp file. At each paragraph boundary (next `### ` or
# next `## <slug>` or EOF), compute the body SHA and compare to
# $want_sha. The body extraction reuses
# lessons_promote_paragraph_sha's normalization (heading-drop +
# trailing-ws strip + blank-collapse).
lessons_promote_find_existing_section() {
  local target="$1" want_sha="$2"
  [ -f "$target" ] || { echo ""; return 0; }
  local cur_section="" cand_sha
  local para_tmp; para_tmp="$(mktemp -t fleet-lessons-promote-find.XXXXXX)"
  # awk emits a flat stream:
  #   SECTION\t<slug>
  #   HEAD\t<heading-line>
  #   BODY\t<body-line>
  # We consume that stream in shell so paragraph bodies (which may
  # contain blank lines) are not flattened into a single record.
  awk '
    /^## [^#]/ && !/^## [0-9]{4}-[0-9]{2}-[0-9]{2} / {
      printf("SECTION\t%s\n", substr($0, 4))
      next
    }
    /^### [0-9]{4}-[0-9]{2}-[0-9]{2} / {
      printf("HEAD\t%s\n", $0)
      next
    }
    {
      printf("BODY\t%s\n", $0)
    }
  ' "$target" > "$para_tmp"

  local match=""
  local body_file; body_file="$(mktemp -t fleet-lessons-promote-body.XXXXXX)"
  local in_para=0
  : > "$body_file"

  finalize_para() {
    if [ "$in_para" = "1" ] && [ -s "$body_file" ]; then
      # Normalize identically to lessons_promote_paragraph_sha (minus
      # the heading-skip — the find_existing_section walker already
      # delivered only the body lines).
      cand_sha=$(awk '
        {
          sub(/[[:space:]]+$/, "", $0)
          lines[++n] = $0
        }
        END {
          start = 1
          while (start <= n && lines[start] == "") start++
          end = n
          while (end >= start && lines[end] == "") end--
          last_blank = 0
          for (i = start; i <= end; i++) {
            if (lines[i] == "") {
              if (last_blank) continue
              last_blank = 1
            } else {
              last_blank = 0
            }
            print lines[i]
          }
        }
      ' "$body_file" | shasum | awk '{print substr($1, 1, 8)}')
      if [ "$cand_sha" = "$want_sha" ]; then
        match="$cur_section"
      fi
    fi
    in_para=0
    : > "$body_file"
  }

  while IFS=$'\t' read -r kind val; do
    case "$kind" in
      SECTION)
        finalize_para
        cur_section="$val"
        ;;
      HEAD)
        finalize_para
        in_para=1
        ;;
      BODY)
        if [ "$in_para" = "1" ]; then
          printf -- '%s\n' "$val" >> "$body_file"
        fi
        ;;
    esac
    if [ -n "$match" ]; then break; fi
  done < "$para_tmp"
  finalize_para
  rm -f "$para_tmp" "$body_file"
  printf -- '%s\n' "$match"
}

lessons_promote_emit_event() {
  # $1 = source slug, $2 = text_sha, $3 = scope, $4 = dup_under (may be "")
  local source="$1" text_sha="$2" scope="$3" dup="$4"
  local kit_root; kit_root="$( cd "$( dirname "$0" )/.." && pwd )"
  [ -f "$kit_root/lib/common.sh" ] || return 0
  local cache_dir="$HOME/.cache/${source}-agent"
  mkdir -p "$cache_dir"
  (
    export SLUG="$source"
    export CACHE_DIR="$cache_dir"
    export FLEET_PHASE="promote"
    # shellcheck disable=SC1090
    source "$kit_root/lib/common.sh" >/dev/null 2>&1
    if [ -n "$dup" ]; then
      fleet_emit_event lesson_promoted \
        "source=$source" "text_sha=$text_sha" "scope=$scope" "dup_under=$dup"
    else
      fleet_emit_event lesson_promoted \
        "source=$source" "text_sha=$text_sha" "scope=$scope"
    fi
  ) || true
}

lessons_promote() {
  shift  # drop the leading "lessons-promote"

  local source_slug="" needle="" exact="" scope="all" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        cat <<USAGE
fleet lessons-promote — push one local lesson into the cross-project feed.

Usage:
  fleet lessons-promote <slug> --lesson "<substring>" [--scope <slug-or-all>]
  fleet lessons-promote <slug> --headline-exact "<full headline>" [--scope ...]
  fleet lessons-promote <slug> --lesson "..." --dry-run

Reads <slug>'s docs/LESSONS.md, finds the lesson whose headline matches
--lesson (case-insensitive substring) or --headline-exact (literal),
and appends it under \`## <slug>\` in the cross-fleet
CROSS_LESSONS.md (scope=all, default) or to a consumer-scoped
override file (scope=<consumer-slug>). Idempotent: identical body
under the same section is a no-op.

Emits lesson_promoted {source, text_sha, scope, dup_under?} to the
source project's events.jsonl with phase=promote.

Defends against LESSONS 2026-05-{26,27,28,30} — see ticket 0028.
USAGE
        exit 0 ;;
      --lesson)
        needle="${2:-}"; shift 2 ;;
      --headline-exact)
        exact="${2:-}"; shift 2 ;;
      --scope)
        scope="${2:-}"; shift 2 ;;
      --dry-run)
        dry_run=1; shift ;;
      --)
        shift; break ;;
      -*)
        printf -- 'fleet lessons-promote: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        if [ -z "$source_slug" ]; then
          source_slug="$1"; shift
        else
          printf -- 'fleet lessons-promote: unexpected positional %s\n' "$1" >&2
          exit 2
        fi ;;
    esac
  done

  if [ -z "$source_slug" ]; then
    echo "fleet lessons-promote: missing <slug> (usage: fleet lessons-promote <slug> --lesson \"<substring>\")" >&2
    exit 2
  fi
  if [ -z "$needle" ] && [ -z "$exact" ]; then
    echo "fleet lessons-promote: --lesson \"<substring>\" or --headline-exact \"<headline>\" required" >&2
    exit 2
  fi

  # Resolve the source project's directory + docs/LESSONS.md.
  local source_dir; source_dir=$(lessons_promote_discover_dir "$source_slug") || true
  if [ -z "$source_dir" ]; then
    local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
    printf -- 'fleet lessons-promote: no project with SLUG=%s found under %s\n' "$source_slug" "$root" >&2
    exit 2
  fi
  local source_lessons="$source_dir/docs/LESSONS.md"
  if [ ! -f "$source_lessons" ]; then
    source_lessons="$source_dir/LESSONS.md"
  fi
  if [ ! -f "$source_lessons" ]; then
    printf -- 'fleet lessons-promote: no LESSONS.md in %s/docs or %s\n' "$source_dir" "$source_dir" >&2
    exit 2
  fi

  # Validate --scope: `all` or a discoverable slug.
  if [ "$scope" != "all" ]; then
    local scope_dir; scope_dir=$(lessons_promote_discover_dir "$scope") || true
    if [ -z "$scope_dir" ]; then
      local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
      printf -- 'fleet lessons-promote: no project with SLUG=%s found under %s\n' "$scope" "$root" >&2
      exit 2
    fi
  fi

  # Match headlines. Output: line 1 = count, lines 2..n+1 = headlines.
  local match_out; match_out=$(lessons_promote_match_headlines "$source_lessons" "$needle" "$exact")
  local match_count; match_count=$(printf -- '%s\n' "$match_out" | head -1)
  local headlines; headlines=$(printf -- '%s\n' "$match_out" | tail -n +2)

  if [ "$match_count" = "0" ]; then
    if [ -n "$exact" ]; then
      printf -- 'fleet lessons-promote: no lesson matched headline "%s" in %s\n' "$exact" "$source_lessons" >&2
    else
      printf -- 'fleet lessons-promote: no lesson matched "%s" in %s\n' "$needle" "$source_lessons" >&2
    fi
    exit 2
  fi
  if [ "$match_count" -gt 1 ]; then
    printf -- 'fleet lessons-promote: %s lessons matched "%s" in %s; refine the substring or use --headline-exact "<full headline>"\n' \
      "$match_count" "$needle" "$source_lessons" >&2
    printf -- '%s\n' "$headlines" >&2
    exit 2
  fi

  local heading; heading=$(printf -- '%s\n' "$headlines" | head -1)

  # Extract the paragraph (heading + body, demoted to ### , up to next `## `).
  local paragraph; paragraph=$(lessons_promote_extract_paragraph "$source_lessons" "$heading")
  if [ -z "$paragraph" ]; then
    printf -- 'fleet lessons-promote: failed to extract paragraph for "%s"\n' "$heading" >&2
    exit 1
  fi
  local text_sha; text_sha=$(printf -- '%s\n' "$paragraph" | lessons_promote_paragraph_sha)

  local target; target=$(lessons_promote_target_path "$scope")

  # Dry-run: print preview, no mutation, no event.
  if [ "$dry_run" = "1" ]; then
    printf -- 'fleet lessons-promote: --dry-run (no file mutation, no event)\n'
    printf -- '  source: %s\n' "$source_lessons"
    printf -- '  target: %s (scope=%s)\n' "$target" "$scope"
    printf -- '  text_sha: %s\n' "$text_sha"
    printf -- '  --- proposed append ---\n'
    printf -- '%s\n' "$paragraph"
    printf -- '  --- end ---\n'
    exit 0
  fi

  # Idempotency / cross-section dedup. We scan the target for any
  # paragraph whose normalized body SHA matches text_sha.
  local existing_section; existing_section=$(lessons_promote_find_existing_section "$target" "$text_sha" || true)
  if [ -n "$existing_section" ]; then
    if [ "$existing_section" = "$source_slug" ]; then
      printf -- 'fleet lessons-promote: lesson already present in CROSS_LESSONS.md (sha=%s) — no change.\n' "$text_sha"
      exit 0
    else
      # Cross-section dedup: append a reference line under source_slug's
      # section AND emit the event with dup_under=<other-slug>.
      local ref_line; ref_line="> Already seen under ## $existing_section"
      lessons_promote_insert_under_section "$target" "$source_slug" "$ref_line"
      lessons_promote_emit_event "$source_slug" "$text_sha" "$scope" "$existing_section"
      printf -- 'fleet lessons-promote: lesson already in CROSS_LESSONS.md under ## %s; wrote reference under ## %s.\n' \
        "$existing_section" "$source_slug"
      printf -- 'emitted lesson_promoted source=%s text_sha=%s scope=%s dup_under=%s\n' \
        "$source_slug" "$text_sha" "$scope" "$existing_section"
      exit 0
    fi
  fi

  # Normal append path.
  lessons_promote_insert_under_section "$target" "$source_slug" "$paragraph"
  lessons_promote_emit_event "$source_slug" "$text_sha" "$scope" ""

  printf -- 'fleet lessons-promote: matched 1 lesson in %s\n' "$source_lessons"
  printf -- '  %s\n' "$heading"
  printf -- 'appending to %s (scope=%s)\n' "$target" "$scope"
  printf -- 'emitted lesson_promoted source=%s text_sha=%s scope=%s\n' \
    "$source_slug" "$text_sha" "$scope"
  printf -- 'done — every project'\''s next PHASE 0 will read this lesson.\n'
  exit 0
}

if [ "$CMD" = "lessons-promote" ]; then
  lessons_promote "$@"
fi

# --- lessons-prune --------------------------------------------------------
# Ticket 0039. `bin/fleet lessons-prune --dry-run` walks
# `docs/LESSONS.md`, flags every paragraph whose `<!-- EXPIRES:
# YYYY-MM-DD -->` marker is <= today (today = $FLEET_NOW_OVERRIDE
# when set, else `date -u '+%Y-%m-%d'`), and prints a 4-column table.
# `--commit --cause "<one-line>"` moves those paragraphs from
# `docs/LESSONS.md` into `docs/LESSONS-ARCHIVE.md`, commits on a
# `chore/lessons-prune-<today>` branch, pushes, and opens a PR via
# `gh pr create`. Emits one `lessons_pruned` event per successful
# `--commit` (see AGENTS.md § Telemetry). Operator-invoked only.
#
# Hard NO: this command never touches `lib/` or `prompts/` — it is a
# pure caller of `fleet_emit_event` (lib/common.sh ~1196). Per LESSONS
# 2026-06-01 every code path ends with explicit `exit 0`/`exit 1`/
# `exit 2` to dodge the dispatcher fall-through trap. Per LESSONS
# 2026-05-28 every `printf` of `$cause` (which may begin with `-`)
# uses `printf -- '%s'`. Per LESSONS 2026-06-01 (awk -v multiline
# trap) paragraph bodies buffer to a tmp file and are pulled back in
# via `getline line < file`. Per LESSONS 2026-06-01 (`grep -c …`
# double-print trap) paragraph counts use `awk … END { print n+0 }`.
# Per LESSONS 2026-06-03 the `--cause` value is restricted to ASCII
# (same v1 constraint as ticket 0035's `--reason`).

lessons_prune_kit_root() {
  # FLEET_KIT_ROOT wins (test seam); else bin/fleet → .. .
  if [ -n "${FLEET_KIT_ROOT:-}" ]; then
    printf -- '%s\n' "$FLEET_KIT_ROOT"
  else
    ( cd "$( dirname "$0" )/.." && pwd )
  fi
}

# Resolve today as YYYY-MM-DD. Test seam: FLEET_NOW_OVERRIDE.
lessons_prune_today() {
  if [ -n "${FLEET_NOW_OVERRIDE:-}" ]; then
    # Accept either bare YYYY-MM-DD or "YYYY-MM-DD HH:MM" (the latter
    # is morning_clock_now's shape); trim to the date part.
    printf -- '%s\n' "${FLEET_NOW_OVERRIDE%% *}"
  else
    date -u '+%Y-%m-%d'
  fi
}

# Walk $1 (LESSONS.md path) and emit one line per paragraph in the
# format: `<head_line>\t<body_end_line>\t<orig_date>\t<expires_or_empty>\t<headline>`.
# The expires field is the verbatim value from the marker (so the
# caller can validate it as YYYY-MM-DD or warn). The headline is the
# heading-line text with the leading `## YYYY-MM-DD — ` prefix
# stripped. body_end_line is the LAST source line of the paragraph
# (inclusive of trailing blank line before the next `## ` heading).
#
# Per LESSONS 2026-06-01 (awk -v multiline trap) we never pass the
# paragraph BODIES through awk -v — we emit start/end line numbers
# and let the caller slice via `sed -n 'A,Bp'` (byte-exact).
lessons_prune_scan() {
  local lessons="$1"
  [ -f "$lessons" ] || return 0
  awk '
    BEGIN { head = 0; orig = ""; headline = ""; expires = "" }
    function flush(end_line) {
      if (head > 0) {
        # Emit "-" as the EXPIRES placeholder for unmarked paragraphs.
        # `read -r f1..f5` with non-whitespace IFS collapses adjacent
        # tabs, so an empty middle field would shift fields right by
        # one. The sentinel keeps every record at exactly 5 tab-
        # separated columns.
        out_exp = (expires == "" ? "-" : expires)
        printf("%d\t%d\t%s\t%s\t%s\n", head, end_line, orig, out_exp, headline)
      }
    }
    /^## [0-9]{4}-[0-9]{2}-[0-9]{2} / {
      # Close the previous paragraph at NR-1 (last line was before us).
      flush(NR - 1)
      head = NR
      orig = substr($0, 4, 10)   # `## YYYY-MM-DD`s `YYYY-MM-DD`
      # The headline is everything after `## YYYY-MM-DD ` + the
      # em-dash/separator + a space. We keep it simple: strip the
      # `## YYYY-MM-DD ` prefix (13 chars + space) and any leading
      # non-space token (the em-dash) + its trailing space.
      tail = $0
      sub(/^## [0-9]{4}-[0-9]{2}-[0-9]{2}[[:space:]]+[^[:space:]]+[[:space:]]+/, "", tail)
      headline = tail
      expires = ""
      next
    }
    # The EXPIRES marker can ONLY live on the line immediately after
    # the heading (NR == head + 1). We accept any whitespace before/
    # after the comment markers but require the EXPIRES: token.
    head > 0 && NR == head + 1 && /<!--[[:space:]]*EXPIRES:[[:space:]]*[^[:space:]]+[[:space:]]*-->/ {
      val = $0
      sub(/^.*<!--[[:space:]]*EXPIRES:[[:space:]]*/, "", val)
      sub(/[[:space:]]*-->.*$/, "", val)
      expires = val
    }
    END {
      # Final paragraph: end_line is the last line of the file (NR).
      flush(NR)
    }
  ' "$lessons"
}

# Given a scan line and today's YYYY-MM-DD, classify the paragraph as
# `prune` (expires <= today), `future` (expires > today), `unmarked`,
# or `malformed` (bad date format). Echoes one of those tokens.
lessons_prune_classify() {
  local expires="$1" today="$2"
  if [ -z "$expires" ]; then
    echo "unmarked"; return 0
  fi
  # YYYY-MM-DD shape check.
  case "$expires" in
    [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]) ;;
    *)
      echo "malformed"; return 0 ;;
  esac
  # Compare as strings — YYYY-MM-DD sorts lexicographically by date.
  if [ "$expires" \> "$today" ]; then
    echo "future"
  else
    echo "prune"
  fi
}

# Render the 4-column dry-run table given the filtered-prune list
# on stdin (one scan-line per match). Mirrors the example in
# ticket 0039 § "User (operator after ...)".
lessons_prune_render_dry_run() {
  local today="$1"
  awk -v today="$today" '
    BEGIN {
      printf("  %-10s  %-10s  %s\n", "EXPIRES", "DATE", "HEADLINE")
    }
    {
      # tab-separated: head end orig expires headline
      n = split($0, F, "\t")
      if (n < 5) next
      printf("  %-10s  %-10s  %s\n", F[4], F[3], F[5])
    }
  '
}

# Slice the byte-exact paragraph block from $lessons between line
# $head and $end (inclusive) and append it (wrapped in an
# `## archived <today> — originally <orig>` heading) to $archive.
# Per LESSONS 2026-05-27 we use `cp`-style file ops (no `$(cat …)`
# round-trips).
lessons_prune_append_archive() {
  local lessons="$1" archive="$2" today="$3" head="$4" end="$5" orig="$6"
  # Normalize the archive file to end with EXACTLY one blank line
  # before appending, so concatenated paragraphs are visually
  # separated by one blank line (not zero, not two). We strip any
  # trailing newlines via awk + temp, then re-add a single blank
  # line. Per LESSONS 2026-05-27 we use `cp`-style file ops here
  # (mv-over-tmp), not `$(cat …)`.
  if [ -f "$archive" ]; then
    local norm; norm="$(mktemp -t fleet-lessons-prune-norm.XXXXXX)"
    awk '
      { lines[NR] = $0 }
      END {
        end = NR
        while (end >= 1 && lines[end] == "") end--
        for (i = 1; i <= end; i++) print lines[i]
      }
    ' "$archive" > "$norm"
    mv -f "$norm" "$archive"
    # `print` adds a single `\n` per line so the file ends with `…text\n`.
    # Add one blank line so the next heading is visually separated.
    printf -- '\n' >> "$archive"
  fi
  {
    printf -- '## archived %s — originally %s\n\n' "$today" "$orig"
    sed -n "${head},${end}p" "$lessons"
  } >> "$archive"
}

# Drop every paragraph whose head..end range appears in the
# "prune list" file (one `head\tend` pair per line, sorted ascending)
# from $lessons in one pass. Writes the result to $tmp and renames
# atomically over $lessons. Per LESSONS 2026-05-27 we use `cp`-like
# ops (file → tmp → mv), never `$(cat …)`. Per LESSONS 2026-06-01
# we feed the prune-range list to awk via `getline … < file` rather
# than `-v` (the value would contain newlines).
lessons_prune_drop_paragraphs() {
  local lessons="$1" range_file="$2"
  local tmp; tmp="$(mktemp -t fleet-lessons-prune.XXXXXX)"
  # Single awk pass: drop in-range lines, accumulate the survivors,
  # then strip trailing blank lines in END so a paragraph removed
  # from the bottom doesn't leave a dangling blank line. We MUST
  # buffer into an array (the trim depends on knowing the end) —
  # this is fine for a docs file the operator hand-tends. Per
  # LESSONS 2026-06-01 the awk -v multiline trap does NOT apply
  # here (range_file is read via getline < file, not -v).
  # BEGIN { count = 0 } per LESSONS 2026-06-08 (POSIX awk's
  # implicit-empty-string-key trap).
  awk -v range_file="$range_file" '
    BEGIN {
      n = 0
      while ((getline line < range_file) > 0) {
        split(line, F, "\t")
        if (F[1] == "" || F[2] == "") continue
        n++
        starts[n] = F[1] + 0
        ends[n]   = F[2] + 0
      }
      close(range_file)
      kept = 0
    }
    {
      drop = 0
      for (i = 1; i <= n; i++) {
        if (NR >= starts[i] && NR <= ends[i]) { drop = 1; break }
      }
      if (!drop) {
        kept++
        out[kept] = $0
      }
    }
    END {
      # Strip trailing blank lines from the survivor list.
      while (kept >= 1 && out[kept] == "") kept--
      for (i = 1; i <= kept; i++) print out[i]
    }
  ' "$lessons" > "$tmp"
  mv -f "$tmp" "$lessons"
}

# Bootstrap the LESSONS-ARCHIVE.md file with the load-bearing
# preamble (per LESSONS 2026-05-25 — load-bearing docs are never
# committed empty). Idempotent: a no-op if the file already exists.
lessons_prune_ensure_archive_preamble() {
  local archive="$1"
  [ -f "$archive" ] && return 0
  cat > "$archive" <<'PREAMBLE'
# LESSONS — ARCHIVE

This file is the retirement target for `docs/LESSONS.md` paragraphs
whose `<!-- EXPIRES: YYYY-MM-DD -->` marker has come due and were
moved here by `bin/fleet lessons-prune --commit`. Pruning is
operator-invoked, append-only, and never deletes a lesson — the move
is the contract.

PHASE 0 readers DO NOT read this file. Only `docs/LESSONS.md` is on
the hot read path. See `AGENTS.md § Lessons` and ticket 0039.
PREAMBLE
}

# Emit the lessons_pruned event into the AGENT-FLEET kit-as-project
# events.jsonl. Mirrors prompts_revert_emit_event (line ~534) and
# lessons_promote_emit_event (line ~10476). Sources lib/common.sh in
# a subshell so SLUG/CACHE_DIR/FLEET_PHASE scope to this emit only.
lessons_prune_emit_event() {
  local archived_count="$1" since_date="$2" pr="$3" cause="$4"
  # The lib/common.sh source always comes from THIS script's
  # checkout (`bin/fleet → ..`), never FLEET_KIT_ROOT — that env
  # var is a test seam for redirecting the docs/LESSONS.md target,
  # not the engine. Mirrors prompts_revert_emit_event (~line 534).
  local lib_root; lib_root="$( cd "$( dirname "$0" )/.." && pwd )"
  [ -f "$lib_root/lib/common.sh" ] || return 0
  local cache_dir="$HOME/.cache/agent-fleet-agent"
  mkdir -p "$cache_dir"
  (
    export SLUG="agent-fleet"
    export CACHE_DIR="$cache_dir"
    export FLEET_PHASE="prune"
    # shellcheck disable=SC1090
    source "$lib_root/lib/common.sh" >/dev/null 2>&1
    fleet_emit_event lessons_pruned \
      "archived_count=$archived_count" \
      "since_date=$since_date" \
      "pr=$pr" \
      "cause=$cause"
  ) || true
}

lessons_prune() {
  shift  # drop the leading "lessons-prune"

  local mode="" cause=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)
        if [ -n "$mode" ] && [ "$mode" != "dry-run" ]; then
          echo "lessons-prune: --dry-run and --commit are mutually exclusive" >&2
          exit 2
        fi
        mode="dry-run"; shift ;;
      --commit)
        if [ -n "$mode" ] && [ "$mode" != "commit" ]; then
          echo "lessons-prune: --dry-run and --commit are mutually exclusive" >&2
          exit 2
        fi
        mode="commit"; shift ;;
      --cause)
        cause="${2:-}"; shift 2 ;;
      --cause=*)
        cause="${1#--cause=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet lessons-prune — operator-invoked archival of expired LESSONS.md entries.

Usage:
  fleet lessons-prune --dry-run
  fleet lessons-prune --commit --cause "<one-line>"
  fleet lessons-prune --help

Flags:
  --dry-run   List every paragraph in docs/LESSONS.md whose
              <!-- EXPIRES: YYYY-MM-DD --> marker is <= today
              (today = \$FLEET_NOW_OVERRIDE if set, else
              date -u '+%Y-%m-%d'). Read-only — no file mutation,
              no commit, no event.
  --commit    Same scan as --dry-run, then MOVE the expired
              paragraphs (byte-for-byte) from docs/LESSONS.md to
              docs/LESSONS-ARCHIVE.md, commit on branch
              chore/lessons-prune-<today>, push, and open a PR
              via gh pr create. Emits one lessons_pruned event.
  --cause     MANDATORY on --commit. One-line operator rationale
              ("kit defends at helper level", "superseded by
              ticket 0035", etc). Recorded verbatim in the PR
              body, the commit message, AND the event payload.
              ASCII only for v1 (LESSONS 2026-06-03).

Paragraphs WITHOUT an EXPIRES marker are NEVER listed (silent
paragraphs are append-only forever — never pruned). Paragraphs
whose EXPIRES is strictly > today are NEVER listed (future-dated
EXPIRES is a planned retirement, not a current one). Malformed
EXPIRES values warn to stderr without aborting.

The PHASE 0 LESSONS read target is docs/LESSONS.md, NOT the
archive — so the archive preserves history without paying the
every-run read cost. Restoration is standard git: revert the PR.

See AGENTS.md § Lessons and AGENTS.md § Telemetry (lessons_pruned).
USAGE
        exit 0 ;;
      --)
        shift ;;
      -*)
        printf -- 'lessons-prune: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        printf -- 'lessons-prune: unexpected positional %s\n' "$1" >&2
        exit 2 ;;
    esac
  done

  if [ -z "$mode" ]; then
    echo "lessons-prune: pick one of --dry-run / --commit (see --help)" >&2
    exit 2
  fi

  # --cause is MANDATORY on --commit.
  if [ "$mode" = "commit" ] && [ -z "$cause" ]; then
    echo 'lessons-prune: --commit requires --cause "<one-line>" explaining why these lessons are now safe to archive (e.g. "kit now defuses at helper level")' >&2
    exit 2
  fi

  # ASCII-only --cause for v1 per LESSONS 2026-06-03 (same as
  # prompts_revert's --reason guard).
  if [ -n "$cause" ] \
     && LC_ALL=C printf -- '%s' "$cause" \
        | LC_ALL=C grep -q '[^[:print:][:space:]]'; then
    echo "lessons-prune: --cause must be ASCII for v1 (see ticket 0039 note)" >&2
    exit 2
  fi

  local kit_root; kit_root="$(lessons_prune_kit_root)"
  local lessons="$kit_root/docs/LESSONS.md"
  local archive="$kit_root/docs/LESSONS-ARCHIVE.md"
  local today; today="$(lessons_prune_today)"

  if [ ! -f "$lessons" ]; then
    printf -- 'lessons-prune: %s not found\n' "$lessons" >&2
    exit 1
  fi

  # Scan + classify. Emit warnings for malformed markers on stderr.
  local scan_out; scan_out="$(lessons_prune_scan "$lessons")"
  local prune_list; prune_list="$(mktemp -t fleet-lessons-prune-list.XXXXXX)"
  local range_file; range_file="$(mktemp -t fleet-lessons-prune-ranges.XXXXXX)"
  : > "$prune_list"
  : > "$range_file"

  # Walk the scan output line by line. We cannot pipe directly into a
  # while loop because we need to update shell-side counters. The
  # scan emits "-" as a placeholder for unmarked paragraphs (bash's
  # `read` with non-whitespace IFS collapses adjacent tabs); we map
  # it back to empty before classification.
  while IFS=$'\t' read -r head end orig expires headline; do
    [ -z "$head" ] && continue
    [ "$expires" = "-" ] && expires=""
    local verdict
    verdict="$(lessons_prune_classify "$expires" "$today")"
    case "$verdict" in
      unmarked|future)
        : ;;  # never pruned
      malformed)
        # Per AC#4 we warn to stderr but DO NOT abort.
        printf -- 'lessons-prune: paragraph "%s" has invalid EXPIRES "%s" (use YYYY-MM-DD); skipped\n' \
          "$headline" "$expires" >&2
        ;;
      prune)
        printf -- '%s\t%s\t%s\t%s\t%s\n' "$head" "$end" "$orig" "$expires" "$headline" >> "$prune_list"
        printf -- '%s\t%s\n' "$head" "$end" >> "$range_file"
        ;;
    esac
  done <<EOF
$scan_out
EOF

  # Per LESSONS 2026-06-01 use awk for the count (grep -c || echo 0
  # double-prints on zero matches).
  local n; n="$(awk 'END { print NR+0 }' "$prune_list")"

  if [ "$mode" = "dry-run" ]; then
    if [ "$n" = "0" ]; then
      printf -- 'lessons-prune: no paragraphs expired as of %s\n' "$today"
      rm -f "$prune_list" "$range_file"
      exit 0
    fi
    printf -- 'lessons-prune: %s paragraphs expired as of %s\n\n' "$n" "$today"
    lessons_prune_render_dry_run "$today" < "$prune_list"
    printf -- '\n(re-run with --commit --cause "<text>" to archive)\n'
    rm -f "$prune_list" "$range_file"
    exit 0
  fi

  # --- commit path ---------------------------------------------------
  if [ "$n" = "0" ]; then
    printf -- 'lessons-prune: no paragraphs expired as of %s — nothing to do.\n' "$today"
    rm -f "$prune_list" "$range_file"
    exit 0
  fi

  # Bootstrap LESSONS-ARCHIVE.md with its preamble if absent.
  lessons_prune_ensure_archive_preamble "$archive"

  # Append every expired paragraph (byte-exact) to the archive.
  while IFS=$'\t' read -r head end orig expires headline; do
    [ -z "$head" ] && continue
    lessons_prune_append_archive "$lessons" "$archive" "$today" "$head" "$end" "$orig"
  done < "$prune_list"

  # Drop the expired paragraphs from LESSONS.md in one awk pass.
  lessons_prune_drop_paragraphs "$lessons" "$range_file"

  # Branch / commit / push / PR. Stub-friendly: each git step is its
  # own subshell so the test's $HOME/.local/bin/git stub records each
  # invocation independently. Failure on any step → exit 1.
  local branch="chore/lessons-prune-$today"
  if ! ( cd "$kit_root" && git checkout -b "$branch" ) >/dev/null 2>&1; then
    if ! ( cd "$kit_root" && git checkout "$branch" ) >/dev/null 2>&1; then
      echo "lessons-prune: could not create or switch to branch $branch" >&2
      rm -f "$prune_list" "$range_file"
      exit 1
    fi
  fi
  if ! ( cd "$kit_root" && git add docs/LESSONS.md docs/LESSONS-ARCHIVE.md ) >/dev/null 2>&1; then
    echo "lessons-prune: git add failed" >&2
    rm -f "$prune_list" "$range_file"
    exit 1
  fi

  # Compose the commit message via a tmp file (LESSONS 2026-06-01 —
  # `git commit -F` is the multi-line-safe path).
  local msg_file; msg_file="$(mktemp -t fleet-lessons-prune-msg.XXXXXX)"
  {
    printf -- 'chore: archive %s expired lessons (' "$n"
    printf -- '%s' "$cause"
    printf -- ')\n\n'
    printf -- 'since_date: %s\n' "$today"
    printf -- 'archived_count: %s\n' "$n"
    printf -- 'cause: '
    printf -- '%s' "$cause"
    printf -- '\n\n'
    printf -- 'Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>\n'
  } > "$msg_file"
  if ! ( cd "$kit_root" && git commit -F "$msg_file" ) >/dev/null 2>&1; then
    rm -f "$msg_file" "$prune_list" "$range_file"
    echo "lessons-prune: git commit failed" >&2
    exit 1
  fi
  rm -f "$msg_file"

  if ! ( cd "$kit_root" && git push -u origin "$branch" ) >/dev/null 2>&1; then
    echo "lessons-prune: git push -u origin $branch failed" >&2
    rm -f "$prune_list" "$range_file"
    exit 1
  fi

  # Compose the PR body via a tmp file (same multi-line guard).
  local body_file; body_file="$(mktemp -t fleet-lessons-prune-body.XXXXXX)"
  {
    printf -- '[FLEET lessons-prune] archive %s expired lesson(s) as of %s\n\n' "$n" "$today"
    printf -- 'cause: '
    printf -- '%s' "$cause"
    printf -- '\n\n'
    printf -- 'Moved the following paragraph(s) from docs/LESSONS.md to docs/LESSONS-ARCHIVE.md:\n\n'
    while IFS=$'\t' read -r head end orig expires headline; do
      [ -z "$head" ] && continue
      printf -- '  - %s — %s (EXPIRES %s)\n' "$orig" "$headline" "$expires"
    done < "$prune_list"
    printf -- '\n'
    printf -- 'PHASE 0 readers (`prompts/ship.prompt.md`, `prompts/groom.prompt.md`) read\n'
    printf -- 'ONLY docs/LESSONS.md — the archive is out of the hot read path.\n'
    printf -- '\n'
    printf -- 'Emitted lessons_pruned {archived_count, since_date, pr, cause} to the\n'
    printf -- 'agent-fleet kit-as-project events.jsonl. See AGENTS.md § Telemetry.\n'
  } > "$body_file"

  local create_out new_pr_number=""
  create_out="$(gh pr create \
                  --repo mutaaf/agent-fleet \
                  --head "mutaaf:$branch" \
                  --base main \
                  --title "[FLEET lessons-prune] archive $n expired lesson(s) as of $today" \
                  --body-file "$body_file" \
                  2>&1 || true)"
  rm -f "$body_file"
  echo "$create_out"
  new_pr_number="$(echo "$create_out" | sed -nE 's#.*/pull/([0-9]+).*#\1#p' | head -1)"
  if [ -z "$new_pr_number" ]; then
    echo "lessons-prune: could not parse new PR number from 'gh pr create' output" >&2
    rm -f "$prune_list" "$range_file"
    exit 1
  fi

  lessons_prune_emit_event "$n" "$today" "$new_pr_number" "$cause"

  printf -- '\nlessons-prune: archived %s paragraph(s) as of %s\n' "$n" "$today"
  printf -- '  branch:  %s\n' "$branch"
  printf -- '  PR:      #%s\n' "$new_pr_number"
  printf -- '  cause:   '
  printf -- '%s' "$cause"
  printf -- '\n'
  printf -- '\nemitted lessons_pruned archived_count=%s since_date=%s pr=%s cause=' \
    "$n" "$today" "$new_pr_number"
  printf -- '%s' "$cause"
  printf -- '\n'
  printf -- '\nNEXT: the review subagent will grade this PR like any other.\n'
  printf -- '      After merge, every project'\''s next PHASE 0 will read a\n'
  printf -- "      shorter docs/LESSONS.md. The archive preserves the moved entries.\n"
  rm -f "$prune_list" "$range_file"
  exit 0
}

if [ "$CMD" = "lessons-prune" ]; then
  lessons_prune "$@"
fi

# --- resume ---------------------------------------------------------------
# Ticket 0030. `bin/fleet resume <slug> [--reason "<one-line>"] [--force]`
# is the operator-facing inverse of `fleet_check_sendback_streak`
# (lib/common.sh ~330) — the helper that auto-disables the agent-ship
# launchd label when 3+ agent-branch PRs in the last 24h were
# request-changes'd. The pause emits `ship_paused`; this command emits
# `ship_resumed` and re-enables the same label, BUT only after
# re-running the streak check so an operator who never fixed the
# underlying flake cannot stumble back into the same hole. `--force`
# (with mandatory `--reason`) bypasses the streak check for the
# operator who knows better — both fields land in the event payload
# so the override is auditable.
#
# Hard NO: this command never touches lib/ or prompts/ — it is a pure
# caller of fleet_emit_event (lib/common.sh ~975). Per LESSONS
# 2026-06-01 every code path ends with explicit `exit 0`/`exit 1`/
# `exit 2` to dodge the dispatcher fall-through trap. Per LESSONS
# 2026-05-28 every `printf` of `$reason` (which may begin with `-`)
# uses `printf -- '%s'`. Per LESSONS 2026-06-01 the 24h send-back
# counter uses awk (never `grep -c … || echo 0` which double-prints).
# Naming: `resume` does not shadow any coreutils binary on macOS or
# Ubuntu (`command -v resume` returns nothing), so the dispatcher
# function name is safe per LESSONS 2026-05-26.

resume_resolve_manifest() {
  # Mirrors rollback_resolve_manifest / kickstart_resolve_manifest. Two
  # discovery roots, working-tree-first so a PR-branch manifest beats
  # the installed copy.
  local want="$1"
  local roots=("${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}" "$HOME/.local/share/agent-fleet/projects")
  local root m slug
  for root in "${roots[@]}"; do
    [ -d "$root" ] || continue
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      # shellcheck disable=SC1090
      slug=$( (source "$m"; echo "${SLUG:-}") 2>/dev/null )
      if [ "$slug" = "$want" ]; then
        echo "$m"
        return 0
      fi
    done < <(find "$root" -maxdepth 2 -name agents.config.sh 2>/dev/null | sort)
  done
}

resume_label_state() {
  # Wraps `launchctl print gui/$UID/<ns>.agent-ship` and parses the one
  # line we care about: `state = enabled` or `state = disabled`.
  # Echoes `enabled` / `disabled` / empty (label not loaded at all).
  local label="$1"
  launchctl print "$label" 2>/dev/null \
    | awk '/state[[:space:]]*=/ { for(i=1;i<=NF;i++) if($i=="="){print $(i+1); exit} }'
}

resume_sendback_count_24h() {
  # Counts lesson_draft_emitted events with ts in the last 24h on the
  # slug's events.jsonl. Reuses the awk pattern from
  # `inbox_budget_block_today` (line ~2248). awk is mandatory here per
  # LESSONS 2026-06-01 — `grep -c … || echo 0` double-prints on zero
  # matches and corrupts the integer the caller compares with `-ge 3`.
  local events="$1"
  [ -f "$events" ] || { echo 0; return 0; }
  local now cutoff_epoch
  now="$(date -u +%s)"
  cutoff_epoch=$(( now - 24 * 3600 ))
  awk -v cutoff="$cutoff_epoch" '
    function ts_to_epoch(ts,    yr, mo, da, hr, mi, se, t) {
      # Parse "YYYY-MM-DDTHH:MM:SSZ" → epoch seconds. Uses mktime in
      # UTC space (gawk supports a 6th systime arg; BSD awk does not).
      # We approximate via per-component math against a fixed anchor
      # so the function works under BSD awk too. Anchor: 1970-01-01
      # 00:00:00 UTC, computed via day-count from the year.
      if (length(ts) < 19) return 0
      yr = substr(ts, 1, 4) + 0
      mo = substr(ts, 6, 2) + 0
      da = substr(ts, 9, 2) + 0
      hr = substr(ts, 12, 2) + 0
      mi = substr(ts, 15, 2) + 0
      se = substr(ts, 18, 2) + 0
      # Day-of-year by month (non-leap). Add leap-year correction at end.
      mdays[1]=0; mdays[2]=31; mdays[3]=59; mdays[4]=90; mdays[5]=120
      mdays[6]=151; mdays[7]=181; mdays[8]=212; mdays[9]=243
      mdays[10]=273; mdays[11]=304; mdays[12]=334
      doy = mdays[mo] + (da - 1)
      if (mo > 2 && ((yr % 4 == 0 && yr % 100 != 0) || yr % 400 == 0)) doy += 1
      # Days from 1970 to start of `yr`.
      leaps = int((yr-1)/4) - int((yr-1)/100) + int((yr-1)/400)
      leaps -= int(1969/4) - int(1969/100) + int(1969/400)
      days_from_epoch = (yr - 1970) * 365 + leaps + doy
      t = days_from_epoch * 86400 + hr * 3600 + mi * 60 + se
      return t
    }
    {
      ts=""; type=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (type != "lesson_draft_emitted") next
      ep = ts_to_epoch(ts)
      if (ep < cutoff) next
      n++
    }
    END { print (n+0) }
  ' "$events"
}

resume_paused_for() {
  # Reads the slug's events.jsonl for the most recent `ship_paused` ts
  # and returns a human-formatted age string via `human_age`. Falls
  # back to `unknown` when no ship_paused event is present (operator
  # disabled the label out-of-band).
  local events="$1"
  [ -f "$events" ] || { echo "unknown"; return 0; }
  local last_ts
  last_ts="$(awk '
    {
      ts=""; type=""
      if (match($0, /"ts"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        ts=substr($0, RSTART, RLENGTH)
        sub(/.*"ts"[[:space:]]*:[[:space:]]*"/, "", ts); sub(/".*/, "", ts)
      }
      if (match($0, /"type"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        type=substr($0, RSTART, RLENGTH)
        sub(/.*"type"[[:space:]]*:[[:space:]]*"/, "", type); sub(/".*/, "", type)
      }
      if (type == "ship_paused") last = ts
    }
    END { print last }
  ' "$events")"
  if [ -z "$last_ts" ]; then
    echo "unknown"
    return 0
  fi
  # Convert ISO ts → epoch via `date -j -f`. BSD date on macOS,
  # GNU date on Ubuntu — both syntaxes tried.
  local epoch
  epoch="$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$last_ts" +%s 2>/dev/null \
          || date -u -d "$last_ts" +%s 2>/dev/null)"
  if [ -z "$epoch" ]; then
    echo "unknown"
    return 0
  fi
  # human_age (bin/fleet ~62) emits "Nm ago"/"Nh ago"/"Nd ago"; strip the
  # trailing " ago" so the event payload reads as a duration, not a
  # past-tense phrase.
  local age; age="$(human_age "$epoch")"
  age="${age% ago}"
  echo "$age"
}

resume() {
  shift  # drop the leading "resume"
  local slug_arg="" want_force=0 reason=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force)
        want_force=1; shift ;;
      --reason)
        reason="${2:-}"; shift 2 ;;
      --reason=*)
        reason="${1#--reason=}"; shift ;;
      -h|--help)
        cat <<USAGE
fleet resume — re-enable a ship_paused project's agent-ship launchd label.

Usage:
  fleet resume <slug>                              safety-checked resume
  fleet resume <slug> --force --reason "<text>"    auditable override
  fleet resume --help                              print this block, exit 0

Default path: re-runs the same 24h send-back check that triggered the
auto-pause (3+ \`lesson_draft_emitted\` events under
\`fleet_check_sendback_streak\` in lib/common.sh). When the streak has
cleared, runs \`launchctl enable gui/\$UID/<ns>.agent-ship\`, verifies
the label state flipped via \`launchctl print\`, emits one
\`ship_resumed {source, paused_for, reason, forced}\` event to the
project's events.jsonl, and exits 0.

Refusal path: when the streak has NOT cleared, prints the diagnose
hint to stderr and exits 2 without touching the launchd label or
emitting an event. \`--force\` skips the streak check but REQUIRES
\`--reason "<one-line>"\` so the override is auditable in the event
log.

Idempotent: if the label is already enabled, prints "not paused" and
exits 0 without calling launchctl or emitting an event.
USAGE
        exit 0 ;;
      --) shift ;;
      -*)
        printf -- 'fleet resume: unknown flag %s\n' "$1" >&2
        exit 2 ;;
      *)
        if [ -z "$slug_arg" ]; then
          slug_arg="$1"; shift
        else
          printf -- 'fleet resume: unexpected extra argument %s\n' "$1" >&2
          exit 2
        fi ;;
    esac
  done

  if [ -z "$slug_arg" ]; then
    echo "fleet resume: missing <slug>" >&2
    echo "usage: fleet resume <slug> [--force --reason \"<text>\"]" >&2
    exit 2
  fi

  # AC#5: --force without --reason is rejected (auditable override).
  if [ "$want_force" = "1" ] && [ -z "$reason" ]; then
    echo "fleet resume: --force requires --reason \"<one-line>\" (auditable override)" >&2
    exit 2
  fi

  # Resolve slug → manifest → SLUG + NAMESPACE + CACHE_DIR.
  local manifest
  manifest="$(resume_resolve_manifest "$slug_arg")"
  if [ -z "$manifest" ]; then
    local root="${FLEET_DISCOVERY_ROOT:-$HOME/Desktop/projects}"
    printf -- 'fleet resume: no project with SLUG=%s found (looked under FLEET_DISCOVERY_ROOT=%s)\n' \
      "$slug_arg" "$root" >&2
    exit 2
  fi
  local slug namespace
  # shellcheck disable=SC1090  # discovered at runtime
  eval "$(
    source "$manifest"
    printf "slug='%s'\n"      "${SLUG:-}"
    printf "namespace='%s'\n" "${NAMESPACE:-com.fleet.${SLUG:-$slug_arg}}"
  )"
  if [ -z "$slug" ] || [ -z "$namespace" ]; then
    echo "fleet resume: could not derive SLUG/NAMESPACE from $manifest" >&2
    exit 2
  fi

  local uid="${UID:-$(id -u)}"
  local label="gui/${uid}/${namespace}.agent-ship"
  local cache_dir="$HOME/.cache/${slug}-agent"
  local events="$cache_dir/events.jsonl"

  printf -- 'fleet resume: checking pause cause for %s …\n' "$slug"

  # AC#2: already-enabled is an idempotent no-op.
  local state_before
  state_before="$(resume_label_state "$label")"
  if [ "$state_before" = "enabled" ]; then
    printf -- 'fleet resume: %s is not paused (agent-ship label state: enabled) — nothing to do.\n' "$slug"
    exit 0
  fi

  # AC#3: re-run the streak check. Skipped on --force.
  local sb_count
  sb_count="$(resume_sendback_count_24h "$events")"
  if [ "$want_force" != "1" ] && [ "$sb_count" -ge 3 ]; then
    {
      printf -- 'fleet resume: REFUSING — %s still has %s send-backs in the last 24h\n' "$slug" "$sb_count"
      printf -- '  (the same condition that triggered ship_paused).\n'
      printf -- '  Diagnose with: gh pr list --state closed --search '\''review:changes-requested'\''\n'
      printf -- '  Override (only after manual triage): fleet resume %s --force --reason "…"\n' "$slug"
    } >&2
    exit 2
  fi

  # Render diagnostics. We always print the counts before issuing the
  # enable so the operator's terminal trail shows WHY the resume fired.
  printf -- '  last 24h send-backs: %s\n' "$sb_count"
  printf -- '  agent-ship label state: %s\n' "${state_before:-not loaded}"
  if [ "$want_force" = "1" ]; then
    printf -- 'proceeding (--force; reason: %s).\n' "$reason"
  else
    printf -- 'proceeding (--force not required).\n'
  fi

  # Execute the enable. launchctl enable echoes nothing on success; we
  # leak its stderr to the operator so unexpected failures surface.
  if ! launchctl enable "$label"; then
    printf -- 'fleet resume: launchctl enable %s failed\n' "$label" >&2
    exit 1
  fi
  printf -- 'launchctl enable %s — OK\n' "$label"

  # AC#10: verify the label state actually flipped. The two stubs sit
  # one user-session apart (launchd is async on real systems), so a
  # `launchctl enable` returning 0 does NOT guarantee the next
  # `launchctl print` will read enabled. Fail loud when they disagree.
  local state_after
  state_after="$(resume_label_state "$label")"
  if [ "$state_after" != "enabled" ]; then
    {
      printf -- 'fleet resume: launchctl enable returned 0 but agent-ship label is still disabled\n'
      printf -- '  — diagnose with: launchctl print %s\n' "$label"
    } >&2
    exit 1
  fi
  printf -- 'verified: agent-ship label state now: %s\n' "$state_after"

  # Compose the event payload. Source the kit's lib/common.sh in a
  # subshell so SLUG/CACHE_DIR/FLEET_PHASE scope to this emit only —
  # exact pattern rollback() uses (~line 3787). LESSONS 2026-05-28:
  # every printf of $reason uses `printf -- '%s'`.
  local paused_for forced reason_str
  paused_for="$(resume_paused_for "$events")"
  if [ "$want_force" = "1" ]; then
    forced=1
    reason_str="$reason"
  else
    forced=0
    reason_str="streak cleared"
  fi

  local kit_root; kit_root="$( cd "$( dirname "$0" )/.." && pwd )"
  if [ -f "$kit_root/lib/common.sh" ]; then
    # shellcheck disable=SC1091
    (
      export SLUG="$slug"
      export CACHE_DIR="$cache_dir"
      export FLEET_PHASE="resume"
      # shellcheck disable=SC1090
      source "$kit_root/lib/common.sh" >/dev/null 2>&1
      fleet_emit_event ship_resumed \
        "source=$slug" \
        "paused_for=$paused_for" \
        "reason=$reason_str" \
        "forced=$forced"
    ) || true
  fi

  printf -- 'emitted ship_resumed source=%s paused_for=%s reason=' \
    "$slug" "$paused_for"
  printf -- '%s' "$reason_str"
  printf -- ' forced=%s\n' "$forced"
  printf -- 'fleet resume: %s will pick up its next ship cycle at the next launchd interval.\n' "$slug"
  exit 0
}

if [ "$CMD" = "resume" ]; then
  resume "$@"
fi

if [ "$CMD" = "list" ]; then
  echo "${c_bld}fleet projects under $ROOT${c_rst}"
  while read -r m; do
    [ -z "$m" ] && continue
    # shellcheck disable=SC1090
    ( source "$m"; printf "  %-14s %s\n" "${SLUG:-?}" "$(dirname "$m")" )
  done < <(discover)
  exit 0
fi

printf "${c_bld}%-12s %-9s %-11s %-7s %-9s %s${c_rst}\n" \
  PROJECT INSTALLED "LAST RUN" PRS LESSONS "SELF-CANCEL"
echo "${c_dim}$(printf '%.0s─' {1..68})${c_rst}"

while read -r m; do
  [ -z "$m" ] && continue
  PROJECT_DIR="$(dirname "$m")"

  # Read manifest in a subshell so vars don't leak between projects.
  eval "$(
    # shellcheck disable=SC1090
    source "$m"
    echo "SLUG='${SLUG:-?}'"
    echo "NS='${NAMESPACE:-com.fleet.${SLUG:-x}}'"
    echo "REPO='$(echo "${REPO_URL:-}" | sed -E 's#https?://github.com/##; s#\.git$##')'"
    echo "SC='${SELF_CANCEL:-}'"
    echo "ENG='${ENG_ENABLED:-0}'"
  )"
  [ -n "$WANT" ] && [ "$WANT" != "$SLUG" ] && continue

  # installed? — count loaded launchd jobs for this namespace
  loaded=0
  for s in ship groom review eng; do
    launchctl print "$DOMAIN/$NS.agent-$s" >/dev/null 2>&1 && loaded=$(( loaded+1 ))
  done
  expected=3; [ "$ENG" = "1" ] && expected=4
  if   [ $loaded -eq 0 ];         then inst="${c_red}no${c_rst}      "
  elif [ $loaded -lt $expected ]; then inst="${c_ylw}$loaded/$expected${c_rst}     "
  else inst="${c_grn}yes${c_rst}     "; fi

  last="$(human_age "$(newest_log_epoch "$HOME/.cache/${SLUG}-agent/logs")")"

  # open agent PRs (best-effort; needs gh auth + network)
  prs="—"
  if command -v gh >/dev/null 2>&1 && [ -n "$REPO" ]; then
    n=$(gh pr list --repo "$REPO" --state open --base main \
          --json headRefName --jq \
          '[.[] | select(.headRefName | test("^(feat/|chore/gtm-|eng/)"))] | length' \
          2>/dev/null)
    [ -n "$n" ] && prs="$n"
  fi

  # lessons count — try the repo working tree, then the agent's fresh checkout
  # (so it resolves even when discovery used the installed manifest).
  les="—"
  for lf in "$PROJECT_DIR/docs/LESSONS.md" "$PROJECT_DIR/LESSONS.md" \
            "$HOME/.cache/${SLUG}-agent/checkout/docs/LESSONS.md" \
            "$HOME/.cache/${SLUG}-agent/checkout/LESSONS.md"; do
    [ -f "$lf" ] && { les=$(grep -cE '^(- |## )' "$lf" 2>/dev/null); break; }
  done

  # self-cancel
  if [ -n "$SC" ]; then
    d=$(days_until "$SC")
    if   [ "$d" -lt 0 ];  then sc="${c_red}EXPIRED ($SC)${c_rst}"
    elif [ "$d" -le 3 ];  then sc="${c_ylw}${d}d ($SC)${c_rst}"
    else sc="${c_dim}${d}d${c_rst}"; fi
  else sc="${c_dim}—${c_rst}"; fi

  printf "%-12s %b %-11s %-7s %-9s %b\n" "$SLUG" "$inst" "$last" "$prs" "$les" "$sc"
done < <(discover)

echo
echo "${c_dim}installed=launchd jobs loaded · last run=newest log · prs=open agent PRs · self-cancel=days left${c_rst}"
